fn ims_ifc_prepare_outbound(msg: string) -> string {
    return ims_identity_apply_privacy(msg)
}


// Cache env values that never change at runtime — env_get_or is not free at 10K+ CPS.
fn cached_env(cache: CMap, cache_key: string, env_key: string, fallback: string) -> string {
    if cmap_has(cache, cache_key) == 1 { return cmap_get(cache, cache_key) }
    // Check DB config cache (loaded by proxy_config_sync_db every 5s).
    // Config keys use lowercase with underscores; map env key to config key.
    let cfg_key = "_cfg|" + str_to_lower(env_key)
    if cmap_has(cache, cfg_key) == 1 {
        let db_val = cmap_get(cache, cfg_key)
        if len(db_val) > 0 {
            cmap_set(cache, cache_key, db_val)
            return db_val
        }
    }
    let v = env_get_or(env_key, fallback)
    cmap_set(cache, cache_key, v)
    return v
}

// TS 23.167: detect emergency URIs and well-known emergency numbers.
fn sip_is_emergency(ruri: string) -> int {
    let low = str_to_lower(ruri)
    if str_contains(low, "urn:service:sos") { return 1 }
    if str_contains(low, "urn:service:sos.") { return 1 }
    let user = sip_uri_user(ruri)
    if str_has_prefix(user, "911") { return 1 }
    if str_has_prefix(user, "112") { return 1 }
    if str_has_prefix(user, "999") { return 1 }
    if str_has_prefix(user, "000") { return 1 }
    if str_has_prefix(user, "110") { return 1 }
    if str_has_prefix(user, "119") { return 1 }
    // Configurable additional emergency numbers
    let extra = env_get_or("SIP_EMERGENCY_NUMBERS", "")
    if len(extra) > 0 {
        if str_contains("," + extra + ",", "," + user + ",") { return 1 }
    }
    return 0
}

fn sip_emergency_target(cache: CMap) -> string {
    return cached_env(cache, "_ecscf_target", "SIP_EMERGENCY_TARGET", "")
}

live fn process_sip_core(data: string, dl: int, reg: CMap, calls: CMap, ip: string, port: int, source_port: int, tr: string, forward_fd: int, db: SqlDB, db_ok: int, cache: CMap, realm: string, node_id: string, diameter_lock: Mutex) -> string {
    // Cache public IP — env_get_or is not free at 10K+ CPS.
    // Only cache if SIP_PUBLIC_IP is explicitly set; the fallback (source IP)
    // is per-message and must not be cached.
    let mut public_ip = ip
    if cmap_has(cache, "_public_ip") == 1 {
        public_ip = cmap_get(cache, "_public_ip")
    } else {
        let configured_ip = env_get_or("SIP_PUBLIC_IP", "")
        if len(configured_ip) > 0 {
            public_ip = configured_ip
            cmap_set(cache, "_public_ip", configured_ip)
        }
    }

    // --- Response processing (Section 16.7) ---
    if sip_is_response(data) == 1 {
        // Worker-originated third-party REGISTERs own their transactions; a
        // response must be consumed here, never proxied toward the Via the
        // builder stamped with our configured identity.
        if ims_ifc_3preg_branch(sip_via_branch(sip_header(data, "Via"))) == 1 {
            let _ = sip_client_txn_finish(data, cache)
            return ""
        }
        // A stateful proxy does not forward a downstream 100 Trying; it has
        // already generated the transaction-level 100 when appropriate.
        let response_txn = sip_transaction_key(data, len(data))
        let mut downstream_request = ""
        let mut downstream_target = ""
        let mut downstream_transport = "udp"
        if len(response_txn) > 2 && cmap_has(cache, "client_req|" + response_txn) == 1 {
            downstream_request = cmap_get(cache, "client_req|" + response_txn)
            if cmap_has(cache, "client_target|" + response_txn) == 1 { downstream_target = cmap_get(cache, "client_target|" + response_txn) }
            if cmap_has(cache, "client_transport|" + response_txn) == 1 { downstream_transport = cmap_get(cache, "client_transport|" + response_txn) }
        }
        if maf_worker_handle_outbound_response(db, db_ok, data, cache, forward_fd) == 1 {
            let _ = sip_client_txn_finish(data, cache)
            return ""
        }
        let b2_key = b2bua_lookup_out(data, cache)
        if len(b2_key) > 0 {
            let cseq_parts = data |> sip_header("CSeq") |> str_trim_space() |> str_split(" ")
            if len(cseq_parts) >= 2 && str_eq(cseq_parts[1] |> str_trim_space() |> str_to_upper(), "INVITE") {
                let original_cid = b2bua_in_cid(b2_key, cache)
                let original_from_tag = sip_addr_tag(b2bua_in_from(b2_key, cache))
                let remote_tag = data |> sip_header("To") |> sip_addr_tag()
                let media_response = rtp_process_answer(data, len(data), original_cid, original_from_tag, remote_tag, db, db_ok, cache)
                let mut translated = b2bua_translate_response(media_response, b2_key, cache)
                let mut app_drop = 0
                if len(translated) > 0 {
                    let app_raw = app_gateway_call(translated, ip, port, tr, "response")
                    let app_id = app_gateway_request_id_for(translated, "response")
                    let app_action = app_gateway_action(app_raw, app_id, 1)
                    if str_eq(app_action, "fail") || str_eq(app_action, "drop") { app_drop = 1 }
                    if str_eq(app_action, "replace") || str_eq(app_action, "reply") {
                        if app_gateway_command_valid(app_raw, app_id, 1) == 1 { translated = app_command_reply(translated, app_raw) }
                    }
                    if len(app_raw) > 0 && str_eq(app_action, "continue") && app_gateway_command_valid(app_raw, app_id, 1) == 1 {
                        let changed = app_command_apply(translated, app_raw)
                        if not str_eq(changed, "__APP_INVALID_MESSAGE__") { translated = changed }
                        else { if app_gateway_fail_closed() == 1 { app_drop = 1 } }
                    }
                }
                let code = sip_status_code(data)
                if code >= 300 && code < 700 {
                    let ack = b2bua_non2xx_ack(data, b2_key, cache)
                    if len(ack) > 0 { let _ = sip_forward_target(b2bua_target(b2_key, cache), ack, b2bua_transport(b2_key, cache), cache, forward_fd) }
                    let _ = b2bua_cleanup(b2_key, cache)
                }
                let _ = sip_client_txn_finish(data, cache)
                if app_drop == 1 { return "" }
                if len(translated) > 0 { return translated }
            } else {
                let _ = sip_client_txn_finish(data, cache)
                if len(cseq_parts) >= 2 && str_eq(cseq_parts[1] |> str_trim_space() |> str_to_upper(), "BYE") { let _ = b2bua_cleanup(b2_key, cache) }
                return ""
            }
        }
        let _ = sip_client_txn_finish(data, cache)
        let app_raw = app_gateway_call(data, ip, port, tr, "response")
        let app_id = app_gateway_request_id_for(data, "response")
        let app_action = app_gateway_action(app_raw, app_id, 1)
        if str_eq(app_action, "fail") || str_eq(app_action, "drop") { return "" }
        let mut response_input = data
        if str_eq(app_action, "replace") || str_eq(app_action, "reply") {
            if app_gateway_command_valid(app_raw, app_id, 1) == 1 { response_input = app_command_reply(data, app_raw) }
            else { if app_gateway_fail_closed() == 1 { return "" } }
        } else {
            if len(app_raw) > 0 && str_eq(app_action, "continue") && app_gateway_command_valid(app_raw, app_id, 1) == 1 {
                let changed = app_command_apply(data, app_raw)
                if str_eq(changed, "__APP_INVALID_MESSAGE__") {
                    if app_gateway_fail_closed() == 1 { return "" }
                } else { response_input = changed }
            }
        }
        let response_code = sip_status_code(response_input)
        if response_code == 100 { return "" }
        if len(downstream_request) > 0 && str_eq(madis_method(downstream_request), "CANCEL") { return "" }
        let response_branch = sip_via_branch(sip_header(response_input, "Via"))
        let mut response_data = response_input
        if len(downstream_request) > 0 && response_code >= 180 && response_code < 200 {
            let _ = sip_relprov_record(response_input, cache)
        }
        if len(downstream_request) > 0 && response_code >= 200 && response_code < 700 {
            let _ = sip_relprov_close(response_input, cache)
        }
        // Early-dialog PRACK must return to the UAS that produced the
        // provisional response. Bind by Call-ID + To-tag. Forked legs use the
        // fork target map; non-fork legs reuse the existing dialog_dst.
        if response_code >= 180 && response_code < 300 {
            let early_to_tag = response_input |> sip_header("To") |> sip_addr_tag()
            let early_cid = sip_header(response_input, "Call-ID")
            if len(early_to_tag) > 0 && len(early_cid) > 0 {
                let mut early_target = ""
                if cmap_has(cache, "fork_branch|" + response_branch) == 1 {
                    let fork_cid = cmap_get(cache, "fork_branch|" + response_branch)
                    early_target = cmap_get(cache, "fork_target|" + fork_cid + "|" + response_branch)
                }
                if len(early_target) == 0 && cmap_has(cache, "dialog_dst|" + early_cid) == 1 {
                    early_target = cmap_get(cache, "dialog_dst|" + early_cid)
                }
                if len(early_target) > 0 {
                    let _ = bounded_cache_set(cache, "dialog_seq", "dialog_ring|", "dialog_dst|" + early_cid + "|" + early_to_tag, early_target, 131072)
                }
            }
        }
        if response_code >= 200 && response_code < 300 {
            if cmap_has(cache, "fork_branch|" + response_branch) == 1 {
                let fork_cid = cmap_get(cache, "fork_branch|" + response_branch)
                let fork_target = cmap_get(cache, "fork_target|" + fork_cid + "|" + response_branch)
                let _ = bounded_cache_set(cache, "dialog_seq", "dialog_ring|", "dialog_dst|" + fork_cid, fork_target, 131072)
                let _ = bounded_cache_set(cache, "dialog_seq", "dialog_ring|", "dialog_branch|" + fork_cid, response_branch, 131072)
                if sip_fork_mark_selected(fork_cid, response_branch, cache) == 1 {
                    let _ = sip_send_fork_cancels(fork_cid, response_branch, cache, forward_fd)
                }
            }
        }
        if response_code >= 300 {
            if cmap_has(cache, "fork_branch|" + response_branch) == 1 {
                if response_code >= 600 {
                    let fork_cid = cmap_get(cache, "fork_branch|" + response_branch)
                    let _ = sip_send_fork_cancels(fork_cid, response_branch, cache, forward_fd)
                }
                let selected = sip_fork_collect_response(response_input, cache)
                if len(selected) == 0 { return "" }
                response_data = selected
            }
        }
        // A non-2xx INVITE final response completes the downstream INVITE
        // transaction only after its matching ACK. Generate that ACK locally
        // before the client transaction record is discarded.
        if response_code >= 300 && response_code < 700 && len(downstream_request) > 0 {
            if str_eq(madis_method(downstream_request), "INVITE") {
                let ack = sip_build_ack_non2xx(downstream_request)
                if len(ack) > 0 && len(downstream_target) > 0 {
                    let _ = sip_forward_target(downstream_target, ack, downstream_transport, cache, forward_fd)
                }
            }
        }
        // RFC 3261 §16.7 step 6: recurse on 3xx. If the downstream UAS
        // redirects us, re-INVITE the Contact target instead of forwarding
        // the 3xx upstream. Limited to one redirect to prevent loops.
        if response_code >= 300 && response_code < 400 && len(downstream_request) > 0 && str_eq(madis_method(downstream_request), "INVITE") {
            let redir_contact = sip_contact_addr(sip_header(response_input, "Contact"))
            let redir_cid = sip_header(downstream_request, "Call-ID")
            let redir_key = "redir_done|" + redir_cid
            if len(redir_contact) > 0 && sip_uri_syntax_valid(redir_contact) == 1 && cmap_has(cache, redir_key) == 0 {
                let _ = bounded_cache_set(cache, "redir_seq", "redir_ring|", redir_key, "1", 8192)
                let redir_tr = sip_transport_param(redir_contact, downstream_transport)
                // Rewrite Request-URI to the redirect target
                let redir_rline_end = str_index(downstream_request, "\r\n")
                let redir_sp1 = str_index(downstream_request, " ")
                let redir_rline = downstream_request[0:redir_rline_end]
                let redir_sp2 = str_index(redir_rline[redir_sp1 + 1:], " ")
                let redir_msg = if redir_sp1 > 0 && redir_sp2 > 0 && redir_rline_end > 0 { downstream_request[0:redir_sp1 + 1] + redir_contact + downstream_request[redir_sp1 + 1 + redir_sp2:] } else { "" }
                if len(redir_msg) > 0 {
                    let redir_fwd = proxy_hop(redir_msg, ip, port, redir_tr)
                    let redir_ok = sip_forward_target(redir_contact, redir_fwd, redir_tr, cache, forward_fd)
                    if redir_ok == 1 { return "" }
                }
            }
        }
        let response_cid = sip_header(response_input, "Call-ID")
        if response_code >= 200 && response_code < 700 {
            let response_cseq = response_input |> sip_header("CSeq") |> str_trim_space() |> str_split(" ")
            let mut response_method = ""
            if len(response_cseq) >= 2 { response_method = response_cseq[1] |> str_trim_space() |> str_to_upper() }
            if str_eq(response_method, "BYE") || str_eq(response_method, "CANCEL") {
                let _ = sip_call_state_cleanup(calls, response_cid, response_input |> sip_header("From") |> sip_addr_tag(), response_input |> sip_header("To") |> sip_addr_tag())
                let _ = sip_dialog_cache_cleanup(cache, response_cid, response_input)
            }
        }
        response_data = ims_session_timer_apply_response(cache, response_cid, downstream_request, response_data)
        // RFC 4028 §10: record session interval from 2xx for refresh tracking.
        let _ = ims_session_timer_bind_from_response(cache, response_cid, downstream_request, response_data)
        let mut resp = sip_strip_top_via(response_data)
        if len(sip_header(resp, "Via")) == 0 { return "" }
        resp = nat_fix_sdp(resp, len(resp), public_ip)
        let resp_cid = sip_header(resp, "Call-ID")
        let resp_from_tag = resp |> sip_header("From") |> sip_addr_tag()
        let resp_to_tag = resp |> sip_header("To") |> sip_addr_tag()
        resp = rtp_process_answer(resp, len(resp), resp_cid, resp_from_tag, resp_to_tag, db, db_ok, cache)
        let resp_code = string(response_code)
        let resp_code_int = response_code
        if resp_code_int >= 300 && resp_code_int < 700 {
            let _ = bounded_cache_set(cache, "dialog_seq", "dialog_ring|", "dialog_non2xx|" + resp_cid, "1", 131072)
        }
        if resp_code_int >= 200 && resp_code_int < 300 {
            let _ = cmap_del(cache, "dialog_non2xx|" + resp_cid)
        }
        let _ = db_sip_tx(db, db_ok, resp_cid, "recv", resp_code, 0, ip, "proxy")
        return resp
    }

    // Classify method with first-char dispatch to avoid 8 str_eq on every msg.
    let mut is_register = 0
    let mut is_invite = 0
    let mut is_ack = 0
    let mut is_bye = 0
    let mut is_cancel = 0
    let mut is_options = 0
    let mut is_prack = 0
    let mut is_update = 0
    let method = madis_method(data)
    if len(method) > 0 {
        let mc = int(method[0])
        if mc == 82 && str_eq(method, "REGISTER") { is_register = 1 }
        else if mc == 73 && str_eq(method, "INVITE") { is_invite = 1 }
        else if mc == 65 && str_eq(method, "ACK") { is_ack = 1 }
        else if mc == 66 && str_eq(method, "BYE") { is_bye = 1 }
        else if mc == 67 && str_eq(method, "CANCEL") { is_cancel = 1 }
        else if mc == 79 && str_eq(method, "OPTIONS") { is_options = 1 }
        else if mc == 80 && str_eq(method, "PRACK") { is_prack = 1 }
        else if mc == 85 && str_eq(method, "UPDATE") { is_update = 1 }
    }
    let mut ruri = ""
    if is_invite == 1 { ruri = sip_request_uri(data) }
    let cid = sip_header(data, "Call-ID")
    let from = sip_header(data, "From")
    let to = sip_header(data, "To")
    let mut ua = ""
    if is_invite == 1 { ua = sip_header(data, "User-Agent") }
    // Defer From user/domain parsing until needed — responses don't use them,
    // and most security checks short-circuit before they're needed.
    let mut from_user = ""
    let mut from_domain = ""
    let from_tag = sip_addr_tag(from)
    let _ = from_tag

    // ===== SECURITY LAYER =====

    // Master switch — check if security is enabled
    let mut sec_enabled = 1
    let sec_key = "sec_enabled"
    if cmap_has(cache, sec_key) == 1 {
        if str_eq(cmap_get(cache, sec_key), "0") { sec_enabled = 0 }
    } else {
        if db_ok == 1 {
            let se = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "security_enabled")
            if str_eq(se, "false") { sec_enabled = 0; cmap_set(cache, sec_key, "0") } else { cmap_set(cache, sec_key, "1") }
        }
    }

    if sec_enabled == 1 {

    // 0. Explicit whitelist check — only configured/trusted IPs skip the
    // security layer. Private address space is not trusted automatically;
    // an exposed proxy must not turn RFC1918 source spoofing into an auth
    // bypass.
    let mut whitelisted = 0
    let wl_key = "wl|" + ip
    if cmap_has(cache, wl_key) == 1 {
        let wl_value = cmap_get(cache, wl_key)
        // Avoid str_split allocation — just check first char
        if len(wl_value) > 0 && int(wl_value[0]) == 49 { whitelisted = 1 }
    } else {
        // Loopback is local-only, but other private ranges still require an
        // explicit access_control or security_whitelist_ips entry.
        if str_eq(ip, "127.0.0.1") { whitelisted = 1 }
        // IPs in access_control with allow are trusted
        if db_ok == 1 {
            let acl_ok = sql_query_str(db, "SELECT 1 FROM access_control WHERE source_ip = $1 AND action = 'allow' AND enabled = true LIMIT 1", ip)
            if len(acl_ok) > 0 { whitelisted = 1 }
        }
        if db_ok == 1 {
            let wl_list = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "security_whitelist_ips")
            if len(wl_list) > 0 {
                let wl_parts = str_split(wl_list, ",")
                let mut wi = 0
                while wi < len(wl_parts) {
                    let wl_ip = str_trim_space(wl_parts[wi])
                    if str_eq(wl_ip, ip) { whitelisted = 1 }
                    // CIDR /8 check
                    if str_has_suffix(wl_ip, ".0.0.0/8") {
                        let dot = str_index(wl_ip, ".")
                        if dot > 0 {
                            let pfx = wl_ip[0:dot]
                            if str_has_prefix(ip, pfx + ".") { whitelisted = 1 }
                        }
                    }
                    // CIDR /16 check
                    if str_has_suffix(wl_ip, ".0.0/16") {
                        let dot1 = str_index(wl_ip, ".")
                        if dot1 > 0 {
                            let rest = wl_ip[dot1 + 1:]
                            let dot2 = str_index(rest, ".")
                            if dot2 > 0 {
                                let pfx2 = wl_ip[0:dot1 + 1 + dot2]
                                if str_has_prefix(ip, pfx2 + ".") { whitelisted = 1 }
                            }
                        }
                    }
                    wi = wi + 1
                }
            }
        }
        if whitelisted == 1 {
            let _ = bounded_cache_set(cache, "wl_seq", "wl_ring|", wl_key, "1", 16384)
        } else {
            let _ = bounded_cache_set(cache, "wl_seq", "wl_ring|", wl_key, "0", 16384)
        }
    }

    // 1. Check if IP is auto-banned (skip if whitelisted)
    if whitelisted == 0 {
    if sec_is_banned(db, db_ok, ip, cache) == 1 {
        return sip_resp(403, "Forbidden", data, dl, "banned")
    }

    // 2. Rate limiting per IP (50 req/sec default)
    if sec_rate_check(ip, 50, cache) == 0 {
        return sip_resp(429, "Too Many Requests", data, dl, "rate")
    }
    // Per-method rate limits (INVITE/REGISTER are the expensive paths)
    if sec_method_rate_check(ip, method, cache) == 0 {
        return sip_resp(429, "Too Many Requests", data, dl, "method-rate")
    }

    // 3. Block SIP scanners (cache result per IP to avoid 11+ str_contains per msg)
    let scanner_key = "scanner_ok|" + ip
    if cmap_has(cache, scanner_key) == 0 && sec_is_scanner(data, dl) == 1 {
        let _ = sec_log(db, db_ok, "scanner_blocked", ip, from_user, "high", "")
        // Auto-ban scanner IPs permanently
        if db_ok == 1 {
            let _ = sql_exec_str4(db, "INSERT INTO security_bans (source_ip, reason, permanent) VALUES ($1, $2, true) ON CONFLICT (source_ip) DO UPDATE SET permanent = true", ip, "sip_scanner", "", "")
            let _ = bounded_cache_set(cache, "ban_seq", "ban_ring|", "ban|" + ip, "1|" + string(now_ms()), 16384)
        }
        return sip_resp(403, "Forbidden", data, dl, "scanner")
    }
    if cmap_has(cache, scanner_key) == 0 {
        let _ = bounded_cache_set(cache, "scanner_seq", "scanner_ring|", scanner_key, "1", 16384)
    }

    // 4. Toll fraud check on INVITE
    if is_invite == 1 {
        let dest = sip_user(ruri)
        if sec_is_fraud_dest(dest, cache) == 1 {
            let _ = sec_log(db, db_ok, "fraud_attempt", ip, from_user, "critical", dest)
            return sip_resp(403, "Call Blocked", data, dl, "fraud")
        }
    }

    } // end if whitelisted == 0
    } // end if sec_enabled == 1

    // ===== END SECURITY =====

    // --- Section 16.3 step 2: Check Proxy-Require ---
    let unsupported = sip_check_require(data, dl)
    if len(unsupported) > 0 {
        return sip_420_response(data, dl, unsupported)
    }

    // --- Section 16.3 step 3: Max-Forwards check ---
    let mf = sip_get_max_forwards(data, dl)
    if mf < 0 {
        return sip_resp(400, "Bad Request", data, dl, "mf")
    }
    if mf == 0 {
        return sip_resp(483, "Too Many Hops", data, dl, "loop")
    }

    // MAF-created outbound dialogs terminate locally. Handle their in-dialog
    // requests before proxy loop detection, since their Request-URI can point
    // back at this node by design.
    if is_ack == 1 || is_bye == 1 || is_cancel == 1 {
        if maf_worker_handle_outbound_request(db, db_ok, data, cache) == 1 {
            if is_ack == 1 { return "" }
            let _ = sip_call_state_cleanup(calls, cid, sip_addr_tag(from), sip_addr_tag(to))
            let _ = sip_dialog_cache_cleanup(cache, cid, data)
            return sip_reply(data, 200, "OK", "", "")
        }
    }

    // --- Section 16.3 step 4: Loop detection ---
    let loops = sip_detect_loop(data, dl, ip, port)
    if loops > 0 {
        return sip_resp(482, "Loop Detected", data, dl, "loop")
    }

    // --- Transaction deduplication (Section 17.2.3) ---
    let txn_key = sip_transaction_key(data, dl)
    if sip_is_retransmit(txn_key, cache) == 1 {
        // Retransmit: return cached response
        let cached_resp = sip_get_txn_response(txn_key, cache)
        if len(cached_resp) > 0 { return cached_resp }
    }

    // RFC 4028 request-side validation is opt-in. Retransmissions are checked
    // above first so a rejected request returns the same cached response.
    if (is_invite == 1 || is_update == 1) && ims_session_timer_enabled() == 1 {
        let timer_check = ims_session_timer_request_check(data)
        if timer_check == 0 {
            return sip_resp(400, "Bad Request", data, dl, "ims-session-timer")
        }
        if timer_check == 2 {
            return sip_reply(data, 422, "Session Interval Too Small", "Min-SE: " + string(ims_session_timer_effective_min(data)) + "\r\n", "")
        }
    }

    // --- Section 16.4: Route header processing ---
    let mut msg = data
    let mut next_hop = ""
    if sip_has_route(data, dl) == 1 {
        let route = sip_get_route(data, dl)
        if sip_route_is_ours(route, ip, port) == 1 {
            // Route points to us: pop it and continue (loose routing)
            msg = sip_pop_route(data, dl)
        } else {
            // A route set is authoritative. The top Route URI is the next
            // hop; do not replace it with location-service routing.
            next_hop = sip_route_target(route)
        }
    }
    let _ = ims_flow_refresh_request(cache, data, ip, source_port, tr)

    // P-Asserted-Identity and P-Preferred-Identity are trusted-network
    // headers. When enabled, strip them from untrusted ingress and validate
    // the single asserted identity received from an IP-authenticated peer.
    if ims_identity_policy_enabled() == 1 {
        let identity_trusted = db_ip_auth(db, db_ok, ip, cache)
        let identity_msg = ims_identity_ingress(msg, identity_trusted)
        if str_eq(identity_msg, "__IMS_IDENTITY_INVALID__") {
            return sip_resp(400, "Bad Request", data, dl, "ims-identity")
        }
        msg = identity_msg
    }
    // TS 24.229 §5.2.6.3: P-CSCF adds P-Access-Network-Info
    msg = ims_access_network_apply(msg, tr, ip)

    // Add received= and rport= to Via for NAT detection
    msg = via_add_received(msg, len(msg), ip, source_port)
    let msglen = len(msg)

    // --- Section 16.6 step 3: Decrement Max-Forwards ---
    msg = sip_decrement_max_forwards(msg, msglen)

    // Lazy-parse From user/domain — only after security short-circuits.
    // Saves sip_user + sip_domain calls on every rejected/rate-limited message.
    from_user = sip_user(from)
    from_domain = sip_domain(from)

    // ACL
    if db_check_acl(db, db_ok, ip, from_user, cache) == 0 {
        return sip_resp(403, "Forbidden", data, dl, "acl")
    }

    // Rate limit
    if db_rate_ok(from_user, cache) == 0 {
        return sip_resp(429, "Too Many Requests", data, dl, "rl")
    }

    // A B2BUA has two independent dialogs. Handle requests arriving on either
    // leg before ordinary proxy routing so Call-ID, tags, CSeq, and Via values
    // are not accidentally forwarded as if this were a proxy transaction.
    let b2_in_key = b2bua_lookup_in(data, cache)
    let b2_out_key = b2bua_lookup_out(data, cache)
    if len(b2_in_key) > 0 {
        if is_cancel == 1 {
            let cancel = b2bua_build_cancel(b2_in_key, cache)
            let mut sent = 0
            if len(cancel) > 0 { sent = sip_forward_target(b2bua_target(b2_in_key, cache), cancel, b2bua_transport(b2_in_key, cache), cache, forward_fd) }
            if sent == 1 { return sip_reply(data, 200, "OK", "", "") }
            return sip_resp(481, "Call/Transaction Does Not Exist", data, dl, "b2bua-cancel")
        }
        if is_ack == 1 {
            let ack = b2bua_prepare_in_dialog(data, b2_in_key, cache)
            if len(ack) > 0 { let _ = sip_forward_target(b2bua_target(b2_in_key, cache), ack, b2bua_transport(b2_in_key, cache), cache, forward_fd) }
            return ""
        }
        if is_bye == 1 || is_invite == 1 {
            let mut invite = data
            if is_invite == 1 { invite = rtp_process_offer(data, dl, cid, from_tag, db, db_ok, cache) }
            let forwarded = b2bua_prepare_in_dialog(invite, b2_in_key, cache)
            let mut sent = 0
            if len(forwarded) > 0 { sent = sip_forward_target(b2bua_target(b2_in_key, cache), forwarded, b2bua_transport(b2_in_key, cache), cache, forward_fd) }
            if is_bye == 1 {
                if sent == 1 {
                    let _ = rtp_process_delete(cid, db, db_ok, cache)
                    let _ = b2bua_cleanup(b2_in_key, cache)
                    return sip_reply(data, 200, "OK", "", "")
                }
                return sip_resp(481, "Call/Transaction Does Not Exist", data, dl, "b2bua-bye")
            }
            if sent == 1 { return sip_resp(100, "Trying", data, dl, "") }
            return sip_resp(503, "Service Unavailable", data, dl, "b2bua-invite")
        }
    }
    if len(b2_out_key) > 0 {
        if is_bye == 1 {
            let peer_request = b2bua_request_to_peer(data, b2_out_key, cache)
            let mut sent = 0
            if len(peer_request) > 0 { sent = sip_forward_target(b2bua_peer(b2_out_key, cache), peer_request, b2bua_peer_transport(b2_out_key, cache), cache, forward_fd) }
            if sent == 1 {
                let _ = rtp_process_delete(b2bua_in_cid(b2_out_key, cache), db, db_ok, cache)
                let _ = b2bua_cleanup(b2_out_key, cache)
                return sip_reply(data, 200, "OK", "", "")
            }
            return sip_resp(481, "Call/Transaction Does Not Exist", data, dl, "b2bua-peer-bye")
        }
        if is_ack == 1 { return sip_reply(data, 200, "OK", "", "") }
        return sip_resp(501, "Not Implemented", data, dl, "b2bua-method")
    }

    let maf_inbound_call = maf_worker_inbound_call_for_wire(cache, maf_worker_tenant(), cid)
    if len(maf_inbound_call) > 0 {
        if is_ack == 1 { return "" }
        if is_bye == 1 || is_cancel == 1 {
            if is_cancel == 1 { let _ = maf_worker_inbound_cancel_terminate(db, db_ok, data, cache, forward_fd) }
            if is_bye == 1 {
                let _ = maf_worker_sync_sip(db, db_ok, data, cache)
                let _ = maf_worker_call_state(db, db_ok, maf_worker_tenant(), maf_inbound_call, "ended", sha256("madis.maf.inbound.bye|" + maf_inbound_call)[0:32])
            }
            let _ = cmap_del(cache, "maf_inbound|" + maf_inbound_call)
            let _ = cmap_del(cache, "maf_created_ms|" + maf_inbound_call)
            let _ = sip_call_state_cleanup(calls, cid, sip_addr_tag(from), sip_addr_tag(to))
            let _ = sip_dialog_cache_cleanup(cache, cid, data)
            return sip_reply(data, 200, "OK", "", "")
        }
        if str_eq(method, "INFO") {
            let body = sip_body(data)
            let sig_pos = str_index(body, "Signal=")
            let mut digit = ""
            if sig_pos >= 0 && len(body) >= sig_pos + 8 {
                let ch = body[sig_pos + 7:sig_pos + 8]
                if not str_eq(ch, " ") && not str_eq(ch, "\t") && not str_eq(ch, "\r") && not str_eq(ch, "\n") {
                    digit = ch
                }
            }
            let trace = sha256("madis.maf.inbound.dtmf|" + maf_inbound_call + "|" + string(mono_ms()))[0:32]
            let payload = "{\"call_id\":\"" + maf_worker_json_escape(maf_inbound_call) + "\",\"digit\":\"" + maf_worker_json_escape(digit) + "\",\"body\":\"" + maf_worker_json_escape(body) + "\",\"direction\":\"inbound\"}"
            let _ = maf_worker_emit_event(db, db_ok, maf_worker_tenant(), "call.dtmf", maf_inbound_call, payload, trace)
            return sip_reply(data, 200, "OK", "", "")
        }
    }

    // === REGISTER ===
    if is_register == 1 {
        if ims_drain_reject_new() == 1 {
            return ims_drain_reply(data, dl)
        }
        let contact = sip_hdr(data, "Contact", dl)
        let aor = sip_user(to) + "@" + sip_domain(to)
        let ims_private_identity = from_user + "@" + from_domain
        let ims_public_identity = "sip:" + aor
        let ims_visited_network = cached_env(cache, "_ims_visited", "SIP_IMS_VISITED_NETWORK", realm)
        let ims_server_name = cached_env(cache, "_ims_server", "SIP_IMS_SERVER_NAME", "sip:" + node_id + "." + realm)

        // Keep the three CSCF responsibilities explicit even when they share
        // one worker binary. P-/I-CSCF roles forward REGISTER and never run
        // the local S-CSCF authentication or registrar write path.
        let ims_role = ims_role_configured()
        if len(ims_role) == 0 {
            return sip_resp(500, "IMS Role Misconfigured", data, dl, "ims-role")
        }
        if ims_role_local_register(ims_role) == 0 {
            let role_target = ims_role_register_target(ims_role, cache, diameter_lock, ims_public_identity, ims_visited_network)
            if len(role_target) == 0 {
                return sip_resp(503, "IMS Role Unavailable", data, dl, "ims-role")
            }
            // RFC 5626 outbound: reject Require: outbound when flow tokens off.
            let outbound_st = ims_flow_outbound_check(data)
            if outbound_st == 0 {
                return sip_resp(420, "Bad Extension", data, dl, "outbound")
            }
            let mut role_msg = msg
            if str_eq(ims_role, "pcscf") {
                // RFC 5626 §5.2: outbound flow token Path when enabled.
                let ob_token = outbound_process_register(cache, contact, ip, source_port, tr)
                if len(ob_token) > 0 {
                    let ob_proxy = env_get_or("SIP_PUBLIC_IP", node_id + "." + realm)
                    let ob_path = outbound_path_uri(ob_token, ob_proxy)
                    if len(ob_path) > 0 {
                        role_msg = ims_path_apply_value(msg, ob_path)
                    }
                }
                if str_eq(role_msg, msg) {
                // Dynamic Path with flow token when enabled; else static Path.
                let dyn_path = ims_flow_register_path(cache, data, ip, source_port, tr, 3600)
                if len(dyn_path) > 0 {
                    role_msg = ims_path_apply_value(msg, dyn_path)
                } else {
                    role_msg = ims_path_apply(msg)
                }
                }
                if str_eq(role_msg, "__IMS_PATH_INVALID__") {
                    return sip_resp(500, "IMS Path Misconfigured", data, dl, "ims-path")
                }
            }
            let role_forwarded = sip_forward_fork(role_target, role_msg, ip, port, tr, public_ip, cache, cid, forward_fd)
            if len(role_forwarded) == 0 {
                return sip_resp(503, "IMS Role Unavailable", data, dl, "ims-role")
            }
            return sip_resp(100, "Trying", data, dl, "ims-role")
        }

        // IMS AKA is an HSS-backed alternative to local SIP digest auth.
        // Evaluate it before IP trust so a trusted source cannot bypass it.
        // Source IP feeds optional external IPsec SA export after success.
        let aka_reply = ims_aka_register_gate_src(realm, data, dl, cache, diameter_lock, ims_public_identity, ims_private_identity, ims_server_name, ip)
        if len(aka_reply) > 0 {
            return aka_reply
        }

        if ims_aka_enabled() == 0 {
        // IP auth: skip digest if source IP is trusted
        let ip_trusted = db_ip_auth(db, db_ok, ip, cache)
        if ip_trusted == 0 {
            // Digest auth required
            if has_auth(data, dl) == 0 {
                return digest_challenge_cached(realm, data, dl, "auth", cache, 0)
            }
            let auth_user = auth_username(data, dl)
            if db_auth_user(db, db_ok, auth_user, from_domain, cache) == 0 {
                let _ = sec_auth_failure(db, db_ok, ip, auth_user, cache)
                if sec_is_enum_scanner(ip, auth_user, cache) == 1 {
                    if db_ok == 1 {
                        let _ = sql_exec_str4(db, "INSERT INTO security_bans (source_ip, reason, permanent) VALUES ($1, $2, true) ON CONFLICT (source_ip) DO UPDATE SET permanent = true", ip, "user_enumeration", "", "")
                        let _ = bounded_cache_set(cache, "ban_seq", "ban_ring|", "ban|" + ip, "1|" + string(now_ms()), 16384)
                    }
                    return sip_resp(403, "Forbidden", data, dl, "enum")
                }
                if not str_eq(tr, "UDP") {
                    let delay = sec_auth_delay_ms(ip, cache)
                    if delay > 0 { sleep_ms(delay) }
                }
                return sip_resp(403, "User Not Found", data, dl, "nf")
            }
            let auth_valid = db_digest_valid(db, db_ok, data, dl, "REGISTER", from_domain, cache)
            if auth_valid == 2 {
                return digest_challenge_cached_stale(realm, data, dl, "auth", cache, 0, 1)
            }
            if auth_valid == 0 {
                let _ = sec_auth_failure(db, db_ok, ip, auth_user, cache)
                // Delay only on stream transports — sleeping on UDP blocks all traffic.
                if not str_eq(tr, "UDP") {
                    let delay = sec_auth_delay_ms(ip, cache)
                    if delay > 0 { sleep_ms(delay) }
                }
                return sip_resp(403, "Bad Credentials", data, dl, "authbad")
            }
            // Successful auth — clear failure counter
            let _ = sec_auth_fail_clear(ip, cache)
        }

        }

        let ims_subscriber_response = ims_subscriber_register_response(ims_public_identity, ims_private_identity, ims_visited_network, ims_server_name)
        if len(ims_subscriber_response) == 0 && not str_eq(ims_subscriber_response, "__IMS_SUBSCRIBER_DISABLED__") {
            return sip_resp(403, "IMS Subscriber Not Authorized", data, dl, "ims-subscriber")
        }
        let subscriber_associated_list = ims_subscriber_profile_associated_list(ims_subscriber_response)
        if str_eq(subscriber_associated_list, "__IMS_PROFILE_INVALID__") {
            return sip_resp(503, "IMS Subscriber Profile Invalid", data, dl, "ims-subscriber-profile")
        }
        let subscriber_profile_associated = ims_subscriber_profile_associated_header(ims_subscriber_response)
        if str_eq(subscriber_profile_associated, "__IMS_PROFILE_INVALID__") {
            return sip_resp(503, "IMS Subscriber Profile Invalid", data, dl, "ims-subscriber-profile")
        }
        let subscriber_profile_ifc = ims_ifc_profile_targets(ims_subscriber_response)
        if str_eq(subscriber_profile_ifc, "__IMS_IFC_INVALID__") {
            return sip_resp(503, "IMS Subscriber iFC Invalid", data, dl, "ims-subscriber-ifc")
        }
        let configured_service_route = ims_service_route_value()
        if str_eq(configured_service_route, "__IMS_SERVICE_ROUTE_INVALID__") {
            return sip_resp(500, "IMS Service-Route Misconfigured", data, dl, "ims-service-route")
        }
        let configured_associated_uri = ims_associated_uri_value()
        if str_eq(configured_associated_uri, "__IMS_ASSOCIATED_URI_INVALID__") {
            return sip_resp(500, "IMS P-Associated-URI Misconfigured", data, dl, "ims-associated-uri")
        }
        let ims_assignment_type = registration_cx_assignment_type(reg, aor, contact, data, dl)
        // S-CSCF reassignment: if prior binding used a different server name, claim via SAR.
        if ims_lifecycle_server_mismatch(reg, aor, ims_server_name) == 1 {
            if ims_lifecycle_reassign(cache, diameter_lock, reg, aor, ims_private_identity, ims_public_identity, ims_server_name, db, db_ok) == 0 {
                return sip_resp(403, "IMS S-CSCF Reassignment Denied", data, dl, "ims-cx-reassign")
            }
        }
        let cx_result = ims_cx_register_result(cache, diameter_lock, ims_public_identity, ims_private_identity, ims_visited_network, ims_server_name, ims_assignment_type)
        let cx_reply = ims_diameter_sip_reply(data, dl, cx_result)
        if len(cx_reply) > 0 {
            return cx_reply
        }
        let mut reg_app_raw = app_gateway_call(msg, ip, port, tr, "request")
        let mut reg_app_id = app_gateway_request_id_for(msg, "request")
        let mut reg_app_action = app_gateway_action(reg_app_raw, reg_app_id, 0)
        let mut reg_command_token = cached_env(cache, "_app_token", "SIP_APP_TOKEN", "")
        if str_eq(reg_app_action, "module") && app_gateway_command_valid(reg_app_raw, reg_app_id, 0) == 1 {
            let module_name = json_get_string(reg_app_raw, "module")
            let module_operation = json_get_string(reg_app_raw, "operation")
            let module_payload = json_get_string(reg_app_raw, "payload")
            let module_raw = module_gateway_call(msg, ip, port, tr, "request", module_name, module_operation, module_payload)
            let module_id = module_gateway_request_id(msg, "request", module_name, module_operation, module_payload)
            let module_action = module_gateway_action(module_raw, msg, "request", module_name, module_operation, module_payload)
            if str_eq(module_action, "fail") { return sip_resp(503, "Service Unavailable", data, dl, "module") }
            if str_eq(module_action, "drop") { return "" }
            reg_app_raw = module_raw
            reg_app_id = module_id
            reg_app_action = module_action
            reg_command_token = cached_env(cache, "_mod_token", "SIP_MODULE_TOKEN", "")
        }
        if str_eq(reg_app_action, "fail") { return sip_resp(503, "Service Unavailable", data, dl, "app") }
        if str_eq(reg_app_action, "drop") { return "" }
        if str_eq(reg_app_action, "reply") || str_eq(reg_app_action, "redirect") {
            if app_gateway_command_valid_token(reg_app_raw, reg_app_id, 0, reg_command_token) == 1 { return app_command_reply(data, reg_app_raw) }
            if app_gateway_fail_closed() == 1 { return sip_resp(503, "Service Unavailable", data, dl, "app") }
        }
        if str_eq(reg_app_action, "proxy") || str_eq(reg_app_action, "route") || str_eq(reg_app_action, "dispatch") {
            let routed = app_command_apply(msg, reg_app_raw)
            if str_eq(routed, "__APP_INVALID_MESSAGE__") { return sip_resp(400, "Bad Request", data, dl, "app-message") }
            let primary = sip_forward_fork(json_get_string(reg_app_raw, "target"), routed, ip, port, tr, public_ip, cache, cid, forward_fd)
            if len(primary) == 0 { return sip_resp(503, "Service Unavailable", data, dl, "app-route") }
            return sip_resp(100, "Trying", data, dl, "")
        }
        if str_eq(reg_app_action, "b2bua") { return sip_resp(400, "Bad Request", data, dl, "app-action") }
        if len(reg_app_raw) > 0 && str_eq(reg_app_action, "continue") && app_gateway_command_valid_token(reg_app_raw, reg_app_id, 0, reg_command_token) == 1 {
            let changed = app_command_apply(msg, reg_app_raw)
            if str_eq(changed, "__APP_INVALID_MESSAGE__") {
                if app_gateway_fail_closed() == 1 { return sip_resp(400, "Bad Request", data, dl, "app-message") }
            } else { msg = changed }
        }
        // Path is edge-owned. Untrusted sources cannot inject a Path that
        // would divert terminating sessions; invalid Path fails closed.
        let register_path = ims_lifecycle_path_from_register_trusted(data, dl, db, db_ok, ip, cache)
        if str_eq(register_path, "__IMS_PATH_INVALID__") {
            return sip_resp(400, "Bad Request", data, dl, "ims-register-path")
        }
        let mut life_contact = ""
        let mut life_expires = 0
        let contact_items = sip_split_contact_values(contact)
        let mut ci = 0
        while ci < len(contact_items) {
            let item = str_trim_space(contact_items[ci])
            if len(item) > 0 {
                let item_exp = registration_expires(item, data, dl)
                if item_exp < 0 {
                    return sip_resp(400, "Bad Request", data, dl, "regexp")
                }
                if item_exp > 0 && item_exp < registration_min_expires() {
                    let tag_423 = "reg-" + sha256("madis.423|" + sip_header(data, "Call-ID"))[0:16]
                    return sip_reply_with_to_tag(data, 423, "Interval Too Brief", "Min-Expires: " + string(registration_min_expires()) + "\r\n", "", tag_423)
                }
                if str_eq(item, "*") {
                    if len(contact_items) != 1 || item_exp != 0 {
                        return sip_resp(400, "Bad Request", data, dl, "reg")
                    }
                    let _ = registration_remove(reg, aor, "*")
                    let _ = registration_db_remove(db, db_ok, aor, "*")
                    life_contact = ""
                    life_expires = 0
                } else {
                    let addr = sip_contact_addr(item)
                    let addr_low = str_to_lower(addr)
                    if len(addr) == 0 || (not str_has_prefix(addr_low, "sip:") && not str_has_prefix(addr_low, "sips:")) {
                        return sip_resp(400, "Bad Request", data, dl, "reguri")
                    }
                    // Validate contact ownership: the contact host must match the
                    // source IP or the AOR domain. Prevents registration hijacking
                    // where an attacker registers a victim's contact to intercept calls.
                    let contact_host = str_to_lower(sip_uri_host(addr))
                    let aor_domain = str_to_lower(sip_domain("sip:" + aor))
                    let contact_ok = if str_eq(contact_host, ip) { 1 }
                        else if str_eq(contact_host, str_to_lower(aor_domain)) { 1 }
                        else if is_private_ip(contact_host) == 1 { 1 }
                        else if str_eq(contact_host, "127.0.0.1") || str_eq(contact_host, "::1") { 1 }
                        else { 0 }
                    if contact_ok == 0 {
                        // Allow override for legitimate third-party registration
                        let allow_foreign = cached_env(cache, "_allow_foreign", "SIP_ALLOW_FOREIGN_CONTACT", "0")
                        if not str_eq(allow_foreign, "1") {
                            return sip_resp(403, "Forbidden", data, dl, "contact-mismatch")
                        }
                    }
                    if item_exp == 0 {
                        let _ = registration_remove(reg, aor, addr)
                        let _ = registration_db_remove(db, db_ok, aor, addr)
                    } else {
                        let stored = outbound_store_binding(reg, aor, addr, tr, item_exp, ip, port, item, cache)
                        if stored < 0 { return sip_resp(400, "Bad Request", data, dl, "registration-size") }
                        let _ = registration_db_upsert(db, db_ok, aor, addr, tr, node_id, item_exp, ip, port)
                        life_contact = addr
                        life_expires = item_exp
                    }
                }
            }
            ci = ci + 1
        }
        // Durable IMS lifecycle: bind IMPI/IMPU, Path, Service-Route, and
        // S-CSCF name to the contact so terminating sessions and restart
        // recovery have more than a generic AOR binding. Recompute from the
        // remaining live registration so a multi-Contact update that ends
        // with expires=0 does not wipe Path while other bindings remain.
        let mut life_tr = tr
        let mut life_ip = ip
        let mut life_port = port
        let remaining_binding = registration_find(reg, aor)
        if len(remaining_binding) > 0 {
            let rem_parts = str_split(remaining_binding, "|")
            if len(rem_parts) >= 1 && len(rem_parts[0]) > 0 { life_contact = rem_parts[0] }
            if len(rem_parts) >= 2 && len(rem_parts[1]) > 0 { life_tr = rem_parts[1] }
            if len(rem_parts) >= 3 {
                let mut exp_at = 0
                match parse_int(rem_parts[2]) {
                    Ok(v) => { exp_at = v }
                    Err(_) => { exp_at = 0 }
                }
                let mut rem_s = (exp_at - now_ms()) / 1000
                if rem_s < 1 { rem_s = 1 }
                life_expires = rem_s
            }
            if len(rem_parts) >= 5 {
                life_ip = rem_parts[3]
                match parse_int(rem_parts[4]) {
                    Ok(v) => { life_port = v }
                    Err(_) => {}
                }
            }
        } else {
            life_contact = ""
            life_expires = 0
        }
        if ims_lifecycle_reconcile(reg, aor, ims_private_identity, ims_public_identity, life_contact, life_tr, life_expires, life_ip, life_port, register_path, configured_service_route, ims_server_name, subscriber_associated_list, db, db_ok, node_id) == 0 {
            return sip_resp(500, "IMS Lifecycle Store Failed", data, dl, "ims-lifecycle")
        }
        let _ = ims_ifc_reconcile_registration(reg, aor, subscriber_profile_ifc)
        // Third-party REGISTER to AS targets (opt-in, best-effort, no secrets).
        // The worker originates one REGISTER per iFC AS target; responses are
        // consumed locally by the 3preg branch guard in the response path.
        if ims_ifc_3preg_enabled() == 1 && life_expires > 0 {
            let as_list = ims_ifc_3preg_targets(reg, aor)
            if len(as_list) > 0 {
                let as_items = str_split(as_list, ",")
                let mut ai = 0
                while ai < len(as_items) {
                    let as_uri = str_trim_space(as_items[ai])
                    let msg_3p = ims_ifc_3preg_build(ims_public_identity, as_uri, life_expires, cid)
                    if len(msg_3p) > 0 {
                        let sent_3p = sip_forward_target(as_uri, msg_3p, sip_transport_param(as_uri, "udp"), cache, forward_fd)
                        if sent_3p == 0 { slog("  3pREG:  delivery failed to " + as_uri) }
                    }
                    ai = ai + 1
                }
            }
        }
        let _ = db_sip_tx(db, db_ok, cid, "recv", "REGISTER", 0, ip, "proxy")
        let _ = db_sip_tx(db, db_ok, cid, "send", "OK", 200, "proxy", ip)
        let mut extra = ""
        let bindings = registration_response_contacts(reg, aor)
        if len(bindings) > 0 {
            extra = "Contact: " + bindings + "\r\n"
        }
        if len(configured_service_route) > 0 {
            extra = extra + "Service-Route: <" + configured_service_route + ">\r\n"
        }
        if len(subscriber_profile_associated) > 0 {
            extra = extra + subscriber_profile_associated
        } else if len(configured_associated_uri) > 0 {
            extra = extra + "P-Associated-URI: <" + configured_associated_uri + ">\r\n"
        }
        // RFC 5626 §5.1: advertise outbound support in 200 OK
        extra = outbound_add_supported(extra)
        return sip_reply_with_to_tag(data, 200, "OK", extra, "", "r" + string(now_ms()))

    } else {
    // === INVITE ===
    if is_invite == 1 {
        // Drain rejects new initial INVITEs; in-dialog continues below.
        if ims_initial_dialog_request(data, dl) == 1 && ims_drain_reject_new() == 1 {
            return ims_drain_reply(data, dl)
        }
        // Glare: concurrent re-INVITE/offer on same dialog → 491.
        if ims_initial_dialog_request(data, dl) == 0 {
            if ims_session_glare_begin(cache, cid) == 0 {
                return sip_resp(491, "Request Pending", data, dl, "glare")
            }
        }
        // Emergency calls bypass authentication (TS 23.167 §7.1)
        if sip_is_emergency(ruri) == 1 {
            let ecscf = sip_emergency_target(cache)
            if len(ecscf) > 0 {
                let fwd = nat_fix_sdp(proxy_hop(msg, ip, port, tr), len(msg), public_ip)
                let _ = sip_forward_target(ecscf, fwd, sip_transport_param(ecscf, "udp"), cache, forward_fd)
                let _ = db_cdr(db, db_ok, cid, from_user, sip_uri_user(ruri), "EMERGENCY:" + ecscf)
                let _ = log_info_if(cache, "sip", "emergency-call ruri=" + sip_uri_user(ruri) + " target=" + ecscf + " ip=" + ip)
                return sip_resp(100, "Trying", data, dl, "emergency")
            }
        }
        // IP auth: skip digest if source IP is trusted
        let ip_trusted = db_ip_auth(db, db_ok, ip, cache)
        if ip_trusted == 0 {
            if has_auth(data, dl) == 0 {
                return digest_challenge_cached(realm, data, dl, "pauth", cache, 1)
            }
            let auth_user = auth_username(data, dl)
            if db_auth_user(db, db_ok, auth_user, from_domain, cache) == 0 {
                let _ = sec_auth_failure(db, db_ok, ip, auth_user, cache)
                if sec_is_enum_scanner(ip, auth_user, cache) == 1 {
                    if db_ok == 1 {
                        let _ = sql_exec_str4(db, "INSERT INTO security_bans (source_ip, reason, permanent) VALUES ($1, $2, true) ON CONFLICT (source_ip) DO UPDATE SET permanent = true", ip, "user_enumeration", "", "")
                        let _ = bounded_cache_set(cache, "ban_seq", "ban_ring|", "ban|" + ip, "1|" + string(now_ms()), 16384)
                    }
                    return sip_resp(403, "Forbidden", data, dl, "enum")
                }
                if not str_eq(tr, "UDP") {
                    let delay = sec_auth_delay_ms(ip, cache)
                    if delay > 0 { sleep_ms(delay) }
                }
                return sip_resp(403, "Forbidden", data, dl, "noauth")
            }
            let auth_valid = db_digest_valid(db, db_ok, data, dl, "INVITE", from_domain, cache)
            if auth_valid == 2 {
                return digest_challenge_cached_stale(realm, data, dl, "pauth", cache, 1, 1)
            }
            if auth_valid == 0 {
                let _ = sec_auth_failure(db, db_ok, ip, auth_user, cache)
                // Delay only on stream transports — sleeping on UDP blocks all traffic.
                if not str_eq(tr, "UDP") {
                    let delay = sec_auth_delay_ms(ip, cache)
                    if delay > 0 { sleep_ms(delay) }
                }
                return sip_resp(403, "Bad Credentials", data, dl, "authbad")
            }
            let _ = sec_auth_fail_clear(ip, cache)
        }

        let maf_inbound_mode = cached_env(cache, "_maf_mode", "SIP_MAF_INBOUND_MODE", "disabled") |> str_trim_space() |> str_to_lower()
        if ims_initial_dialog_request(data, dl) == 1 && (str_eq(maf_inbound_mode, "control") || str_eq(maf_inbound_mode, "route") || str_eq(maf_inbound_mode, "1") || str_eq(maf_inbound_mode, "true") || str_eq(maf_inbound_mode, "yes") || str_eq(maf_inbound_mode, "enabled")) {
            let maf_call_id = maf_worker_ingress_invite(db, db_ok, maf_worker_tenant(), data, ip, source_port, tr, cache)
            if len(maf_call_id) == 0 { return sip_resp(503, "MAF Inbound Unavailable", data, dl, "maf-inbound") }
            return sip_resp(100, "Trying", data, dl, "maf-inbound")
        }

        let dest_user = sip_user(ruri)
        let dest_domain = sip_domain(ruri)

        // An established dialog is already bound to its terminating contact.
        // Forward a re-INVITE through that binding before any IMS role,
        // application, charging, dial-plan, or new-call state work. The
        // ingress transaction cache above still handles retransmissions, so a
        // repeated re-INVITE cannot create a second downstream transaction.
        let initial_dialog = ims_initial_dialog_request(data, dl)
        if initial_dialog == 0 {
            let dialog_msg = rtp_process_offer(msg, len(msg), cid, from_tag, db, db_ok, cache)
            let sent = sip_forward_dialog_request(dialog_msg, cid, "INVITE", next_hop, ip, port, tr, cache, forward_fd)
            let _ = ims_session_glare_end(cache, cid)
            if sent == 1 { return "" }
            if len(maf_inbound_call) > 0 && cmap_has(cache, "maf_inbound_answer|" + maf_inbound_call) == 1 {
                let prev_resp = cmap_get(cache, "maf_inbound_answer|" + maf_inbound_call)
                let prev_sdp = sip_body(prev_resp)
                let to_tag = sip_addr_tag(sip_header(prev_resp, "To"))
                let contact = sip_header(prev_resp, "Contact")
                let extra = if len(contact) > 0 { "Contact: " + contact + "\r\nContent-Type: application/sdp\r\n" } else { "Content-Type: application/sdp\r\n" }
                return sip_reply_with_to_tag(data, 200, "OK", extra, prev_sdp, to_tag)
            }
            return sip_resp(481, "Call/Transaction Does Not Exist", data, dl, "ims-dialog")
        }
        // P-Charging-Vector on originating initial INVITE + optional PAI.
        msg = ims_pcv_apply_originating(msg, cid)
        msg = ims_identity_assert_apply(msg, "sip:" + from_user + "@" + from_domain)
        let _ = ims_session_timer_bind_from_request(cache, cid, msg)
        // §7.1: ensure refresher= is present before forwarding
        msg = ims_session_timer_ensure_refresher(msg)

        // P-/I-CSCF roles route the initial terminating session toward the
        // next IMS role before dialplan, application, charging, or local
        // contact lookup. In-dialog requests follow the existing Route and
        // dialog state machinery instead of being re-selected here.
        let session_role = ims_role_configured()
        if len(session_role) == 0 {
            return sip_resp(500, "IMS Role Misconfigured", data, dl, "ims-role")
        }
        if ims_session_originator_registered(session_role, reg, from_user + "@" + from_domain) == 0 {
            return sip_resp(403, "IMS Registration Required", data, dl, "ims-session")
        }
        if initial_dialog == 1 && ims_session_requested() == 1 && ims_role_local_register(session_role) == 1 {
            let destination_aor = dest_user + "@" + dest_domain
            if len(ims_session_destination_contact(session_role, reg, destination_aor)) == 0 {
                return sip_resp(404, "IMS Destination Not Registered", data, dl, "ims-session-destination")
            }
        }
        if initial_dialog == 1 && len(next_hop) == 0 && ims_role_local_register(session_role) == 0 {
            let destination_identity = "sip:" + dest_user + "@" + dest_domain
            let session_target = ims_role_invite_target(session_role, cache, diameter_lock, destination_identity)
            if len(session_target) == 0 {
                return sip_resp(503, "IMS Role Unavailable", data, dl, "ims-role")
            }
            let session_primary = sip_forward_fork(session_target, msg, ip, port, tr, public_ip, cache, cid, forward_fd)
            if len(session_primary) == 0 {
                return sip_resp(503, "IMS Role Unavailable", data, dl, "ims-role")
            }
            let _ = db_cdr(db, db_ok, cid, from_user, dest_user, "IMS_ROLE:" + session_primary)
            return sip_resp(100, "Trying", data, dl, "ims-role")
        }

        // Number manipulation: transform both caller and callee
        let dp_result = db_dialplan(db, db_ok, from_user, dest_user, "outbound", cache)
        let translated = dp_result[0]   // transformed callee
        let caller_id = dp_result[1]    // transformed caller (for gateway)
        let aor = translated + "@" + dest_domain

        // Optional RFC 8506-style online authorization boundary. It is
        // disabled by default so the normal SIP path remains local and fast.
        // The adapter returns a typed allow/deny decision; failures fail
        // closed unless the deployment explicitly opts into fail-open.
        let charging_ok = charging_pre_authorize(cid, caller_id, translated, cache, diameter_lock)
        if charging_ok == 0 {
            let _ = db_cdr(db, db_ok, cid, caller_id, translated, "CHARGE_DENIED")
            return sip_resp(402, "Payment Required", data, dl, "charge")
        }
        // Optional Rx/PCRF AF session authorize (fail closed when SIP_IMS_RX=1).
        if ims_rx_authorize(cache, diameter_lock, cid, caller_id, "audio") == 0 {
            let _ = db_cdr(db, db_ok, cid, caller_id, translated, "RX_DENIED")
            return sip_resp(503, "Service Unavailable", data, dl, "ims-rx")
        }

        // Structured/target iFC trigger: originating initial INVITE at local
        // S-CSCF while source AOR is live. Sequential priority order via fork
        // list; default_handling 1 fails closed if no AS accepts.
        if initial_dialog == 1 && ims_role_local_register(session_role) == 1 {
            let origin_aor = from_user + "@" + from_domain
            let ifc_targets = ims_ifc_originating_targets(reg, origin_aor, initial_dialog, 1)
            if len(ifc_targets) > 0 {
                let ifc_msg = ims_ifc_prepare_outbound(msg)
                let ifc_primary = sip_forward_fork(ifc_targets, ifc_msg, ip, port, tr, public_ip, cache, cid, forward_fd)
                if len(ifc_primary) == 0 {
                    if ims_ifc_first_default_handling(reg, origin_aor, 0, "INVITE") == 1 {
                        return sip_resp(503, "IMS Application Unavailable", data, dl, "ims-ifc")
                    }
                    // default_handling=0: continue to contact routing.
                } else {
                    let _ = db_cdr(db, db_ok, cid, caller_id, translated, "IMS_IFC:" + ifc_primary)
                    return sip_resp(100, "Trying", data, dl, "ims-ifc")
                }
            }
        }

        // The application hook runs only after Madis security, SIP core
        // validation, digest authentication, and online charging. An
        // external application can make the call decision, but cannot bypass
        // those controls or mutate transaction identity headers.
        let mut inv_app_raw = app_gateway_call(msg, ip, port, tr, "request")
        let mut inv_app_id = app_gateway_request_id_for(msg, "request")
        let mut inv_app_action = app_gateway_action(inv_app_raw, inv_app_id, 0)
        let mut inv_command_token = cached_env(cache, "_app_token", "SIP_APP_TOKEN", "")
        if str_eq(inv_app_action, "module") && app_gateway_command_valid(inv_app_raw, inv_app_id, 0) == 1 {
            let module_name = json_get_string(inv_app_raw, "module")
            let module_operation = json_get_string(inv_app_raw, "operation")
            let module_payload = json_get_string(inv_app_raw, "payload")
            let module_raw = module_gateway_call(msg, ip, port, tr, "request", module_name, module_operation, module_payload)
            let module_id = module_gateway_request_id(msg, "request", module_name, module_operation, module_payload)
            let module_action = module_gateway_action(module_raw, msg, "request", module_name, module_operation, module_payload)
            if str_eq(module_action, "fail") { return sip_resp(503, "Service Unavailable", data, dl, "module") }
            if str_eq(module_action, "drop") { return "" }
            inv_app_raw = module_raw
            inv_app_id = module_id
            inv_app_action = module_action
            inv_command_token = cached_env(cache, "_mod_token", "SIP_MODULE_TOKEN", "")
        }
        if str_eq(inv_app_action, "fail") { return sip_resp(503, "Service Unavailable", data, dl, "app") }
        if str_eq(inv_app_action, "drop") { return "" }
        if str_eq(inv_app_action, "reply") || str_eq(inv_app_action, "redirect") {
            if app_gateway_command_valid_token(inv_app_raw, inv_app_id, 0, inv_command_token) == 1 { return app_command_reply(data, inv_app_raw) }
            if app_gateway_fail_closed() == 1 { return sip_resp(503, "Service Unavailable", data, dl, "app") }
        }
        if len(inv_app_raw) > 0 && (str_eq(inv_app_action, "continue") || str_eq(inv_app_action, "proxy") || str_eq(inv_app_action, "route") || str_eq(inv_app_action, "dispatch") || str_eq(inv_app_action, "b2bua")) && app_gateway_command_valid_token(inv_app_raw, inv_app_id, 0, inv_command_token) == 1 {
            let changed = app_command_apply(msg, inv_app_raw)
            if str_eq(changed, "__APP_INVALID_MESSAGE__") {
                if app_gateway_fail_closed() == 1 { return sip_resp(400, "Bad Request", data, dl, "app-message") }
            } else { msg = changed }
        }

        // CDR start
        let _ = db_cdr(db, db_ok, cid, caller_id, translated, "TRYING")
        let _ = db_cdr_detail(db, db_ok, cid, ip, "", tr)
        let _ = db_cdr_uris(db, db_ok, cid, from, to, ua)
        let _ = db_sip_tx(db, db_ok, cid, "recv", "INVITE", 0, ip, "proxy")
        if sip_call_state_set(calls, cache, cid, caller_id + "|" + translated + "|" + string(now_ms())) < 0 {
            return sip_resp(503, "Server Busy", data, dl, "call-capacity")
        }

        // Apply DB-driven header rules (add X-headers, strip Privacy, etc.)
        let mut inv_msg = db_apply_header_rules(db, db_ok, msg, "INVITE", "outbound", cache)

        // STIR/SHAKEN (RFC 8224/8225/8226)
        let shaken_cfg = db_shaken_config(db, db_ok, cache)
        if str_eq(shaken_cfg[0], "1") {
            // Verify inbound Identity (if present)
            inv_msg = shaken_verify_and_annotate_cfg(inv_msg, len(inv_msg), shaken_cfg, cache)
            // Sign outbound only if no valid Identity already present
            // RFC 8224 §4: a proxy that verifies should not re-sign unless
            // acting as an authentication service
            if len(sip_header(inv_msg, "P-Identity-Verified")) == 0 || str_eq(sip_header(inv_msg, "P-Identity-Verified"), "false") {
                inv_msg = shaken_add_identity_cfg(inv_msg, caller_id, translated, shaken_cfg[2], shaken_cfg)
            }
        }
        inv_msg = ims_identity_apply_privacy(inv_msg)
        // rtpengine: process offer SDP (INVITE with SDP)
        inv_msg = rtp_process_offer(inv_msg, len(inv_msg), cid, from_tag, db, db_ok, cache)
        let inv_dl = len(inv_msg)

        if (str_eq(inv_app_action, "proxy") || str_eq(inv_app_action, "route") || str_eq(inv_app_action, "dispatch")) && len(next_hop) == 0 {
            let targets = json_get_string(inv_app_raw, "target")
            let primary = sip_forward_fork(targets, inv_msg, ip, port, tr, public_ip, cache, cid, forward_fd)
            if len(primary) == 0 { return sip_resp(503, "Service Unavailable", data, dl, "app-route") }
            let _ = db_cdr(db, db_ok, cid, caller_id, translated, "APP_ROUTING:" + primary)
            return sip_resp(100, "Trying", data, dl, "")
        }
        if str_eq(inv_app_action, "b2bua") && len(next_hop) == 0 {
            if b2bua_enabled() == 0 { return sip_resp(503, "Service Unavailable", data, dl, "b2bua-disabled") }
            let target = json_get_string(inv_app_raw, "target")
            let b2_msg = b2bua_prepare_invite(inv_msg, target, sip_transport_param(target, tr), ip + ":" + string(port), tr, cache)
            let mut sent = 0
            if len(b2_msg) > 0 { sent = sip_forward_target(target, b2_msg, sip_transport_param(target, tr), cache, forward_fd) }
            if sent == 0 {
                let failed_key = b2bua_lookup_in(inv_msg, cache)
                if len(failed_key) > 0 { let _ = b2bua_cleanup(failed_key, cache) }
                return sip_resp(503, "Service Unavailable", data, dl, "app-b2bua")
            }
            let _ = db_cdr(db, db_ok, cid, caller_id, translated, "APP_B2BUA:" + target)
            return sip_resp(100, "Trying", data, dl, "")
        }
        if len(next_hop) > 0 {
            let fwd = nat_fix_sdp(proxy_hop(inv_msg, ip, port, tr), inv_dl, public_ip)
            let sent_to = sip_forward_target(next_hop, fwd, sip_transport_param(next_hop, "udp"), cache, forward_fd)
            if sent_to == 0 { return sip_resp(503, "Service Unavailable", data, dl, "route") }
            let _ = db_cdr(db, db_ok, cid, caller_id, translated, "ROUTE:" + next_hop)
            return sip_resp(100, "Trying", data, dl, "")
        }

        // 1. Check DID mapping (inbound calls)
        let did_target = db_lookup_did(db, db_ok, translated, cache)
        if len(did_target) > 0 {
            // DID maps to a local user
            let did_aor = did_target + "@" + dest_domain
            let did_contact = registration_find(reg, did_aor)
            if len(did_contact) > 0 {
                let did_ifc_targets = ims_ifc_terminating_targets(reg, did_aor, initial_dialog, ims_role_local_register(session_role))
                if len(did_ifc_targets) > 0 {
                    let ifc_primary = sip_forward_fork(did_ifc_targets, inv_msg, ip, port, tr, public_ip, cache, cid, forward_fd)
                    if len(ifc_primary) == 0 {
                        return sip_resp(503, "IMS Application Unavailable", data, dl, "ims-ifc")
                    }
                    let _ = db_cdr(db, db_ok, cid, caller_id, translated, "IMS_IFC_TERM:" + ifc_primary)
                    return sip_resp(100, "Trying", data, dl, "ims-ifc")
                }
                let contact_info = did_contact
                // Extract contact_uri and transport without str_split allocation
                let cp1 = str_index(contact_info, "|")
                let contact_uri = if cp1 >= 0 { contact_info[0:cp1] } else { contact_info }
                let mut contact_tr = "udp"
                if cp1 >= 0 {
                    let rest1 = contact_info[cp1 + 1:]
                    let cp2 = str_index(rest1, "|")
                    contact_tr = if cp2 >= 0 { rest1[0:cp2] } else { rest1 }
                }
                let mut term_msg = inv_msg
                let mut term_target = contact_uri
                let mut term_tr = contact_tr
                // NAT: if Contact has private IP but binding has public source, use source
                let did_nat = registration_nat_target(did_contact)
                if len(did_nat) > 0 { term_target = did_nat }
                // Prefer durable IMS Path so MT returns through the access edge.
                let life_target = ims_lifecycle_mt_target_resolved(reg, did_aor)
                if len(life_target) > 0 {
                    let life_parts = str_split(life_target, "|")
                    if len(life_parts) >= 1 && len(life_parts[0]) > 0 {
                        let life_path = ims_lifecycle_path(ims_lifecycle_find_resolved(reg, did_aor))
                        if len(life_path) > 0 {
                            let routed = ims_lifecycle_apply_path_route(term_msg, life_path)
                            if str_eq(routed, "__IMS_PATH_INVALID__") {
                                return sip_resp(500, "IMS Path Invalid", data, dl, "ims-lifecycle-path")
                            }
                            term_msg = routed
                        }
                        term_target = life_parts[0]
                        if len(life_parts) >= 2 && len(life_parts[1]) > 0 { term_tr = life_parts[1] }
                    }
                }
                term_msg = ims_pcv_apply_terminating(term_msg)
                let fwd = nat_fix_sdp(proxy_hop(term_msg, ip, port, tr), len(term_msg), public_ip)
                let _ = sip_forward_target(term_target, fwd, term_tr, cache, forward_fd)
                let _ = bounded_cache_set(cache, "dialog_seq", "dialog_ring|", "dialog_dst|" + cid, term_target, 131072)
                return sip_resp(100, "Trying", data, dl, "")
            }
        }

        // 2. Check local registration
        let local_contact = registration_find(reg, aor)
        if len(local_contact) > 0 {
            let terminating_ifc_targets = ims_ifc_terminating_targets(reg, aor, initial_dialog, ims_role_local_register(session_role))
            if len(terminating_ifc_targets) > 0 {
                let ifc_primary = sip_forward_fork(terminating_ifc_targets, inv_msg, ip, port, tr, public_ip, cache, cid, forward_fd)
                if len(ifc_primary) == 0 {
                    return sip_resp(503, "IMS Application Unavailable", data, dl, "ims-ifc")
                }
                let _ = db_cdr(db, db_ok, cid, caller_id, translated, "IMS_IFC_TERM:" + ifc_primary)
                return sip_resp(100, "Trying", data, dl, "ims-ifc")
            }
            let contact_info = local_contact
            let cp1 = str_index(contact_info, "|")
            let contact_uri = if cp1 >= 0 { contact_info[0:cp1] } else { contact_info }
            let mut contact_tr = "udp"
            if cp1 >= 0 {
                let rest1 = contact_info[cp1 + 1:]
                let cp2 = str_index(rest1, "|")
                contact_tr = if cp2 >= 0 { rest1[0:cp2] } else { rest1 }
            }
            let mut term_msg = inv_msg
            let mut term_target = contact_uri
            let mut term_tr = contact_tr
            // NAT: if Contact has private IP but binding has public source, use source
            let local_nat = registration_nat_target(local_contact)
            if len(local_nat) > 0 { term_target = local_nat }
            let life_target = ims_lifecycle_mt_target_resolved(reg, aor)
            if len(life_target) > 0 {
                let life_parts = str_split(life_target, "|")
                if len(life_parts) >= 1 && len(life_parts[0]) > 0 {
                    let life_path = ims_lifecycle_path(ims_lifecycle_find_resolved(reg, aor))
                    if len(life_path) > 0 {
                        let routed = ims_lifecycle_apply_path_route(term_msg, life_path)
                        if str_eq(routed, "__IMS_PATH_INVALID__") {
                            return sip_resp(500, "IMS Path Invalid", data, dl, "ims-lifecycle-path")
                        }
                        term_msg = routed
                    }
                    term_target = life_parts[0]
                    if len(life_parts) >= 2 && len(life_parts[1]) > 0 { term_tr = life_parts[1] }
                }
            }
            // RFC 5626 §5.3: if Path has a flow token, route through the
            // original transport connection instead of resolving Contact.
            let ob_path = ims_lifecycle_path(ims_lifecycle_find_resolved(reg, aor))
            let ob_conn = outbound_resolve_flow(cache, ob_path)
            if len(ob_conn) > 0 {
                let ob_parts = str_split(ob_conn, "|")
                if len(ob_parts) >= 3 {
                    term_target = ob_parts[0] + ":" + ob_parts[1]
                    term_tr = str_to_lower(ob_parts[2])
                }
            }
            term_msg = ims_pcv_apply_terminating(term_msg)
            let fwd = nat_fix_sdp(proxy_hop(term_msg, ip, port, tr), len(term_msg), public_ip)
            let _ = sip_forward_target(term_target, fwd, term_tr, cache, forward_fd)
            let _ = bounded_cache_set(cache, "dialog_seq", "dialog_ring|", "dialog_dst|" + cid, term_target, 131072)
            return sip_resp(100, "Trying", data, dl, "")
        }

        // 2b. Cluster: user not local — check which node has them
        if db_ok == 1 {
            let remote_node = sql_query_str(db, registration_cluster_owner_query(), aor)
            if len(remote_node) > 0 {
                // Forward INVITE to the remote node that owns this registration
                let fwd = nat_fix_sdp(proxy_hop(inv_msg, ip, port, tr), inv_dl, public_ip)
                let sent_to = sip_forward_first(remote_node, fwd, cache, cid, forward_fd)
                let _ = db_cdr(db, db_ok, cid, caller_id, translated, "CLUSTER:" + remote_node)
                if len(sent_to) == 0 { return sip_resp(503, "Service Unavailable", data, dl, "cluster") }
                return sip_resp(100, "Trying", data, dl, "")
            }
        }

        // 2c. Check if call is FROM a PBX server going outbound (egress)
        // If the source IP is a server in an ingress dispatch group, and it's
        // sending a new INVITE, look up the egress carrier group.
        let egress_key = "egress|" + cid
        if cmap_has(cache, egress_key) == 1 {
            let egress_targets = cmap_get(cache, egress_key)
            if len(egress_targets) > 0 {
                let primary = sip_forward_fork(egress_targets, inv_msg, ip, port, tr, public_ip, cache, cid, forward_fd)
                let _ = db_cdr(db, db_ok, cid, caller_id, translated, "EGRESS:" + primary)
                if len(primary) == 0 { return sip_resp(503, "Service Unavailable", data, dl, "egress") }
                return sip_resp(100, "Trying", data, dl, "")
            }
        }

        // 3. Advanced routing engine
        let route_result = db_route_call(db, db_ok, translated, caller_id, ip, inv_msg, inv_dl, from_user, cid, cache)
        if len(route_result) > 0 {
            // Parse action
            if str_has_prefix(route_result, "reject:") {
                // reject:code:reason
                let reject_parts = str_split(route_result[7:], ":")
                let mut rcode = 403
                let mut rreason = "Forbidden"
                if len(reject_parts) >= 1 {
                    match parse_int(reject_parts[0]) {
                        Ok(v) => { rcode = v }
                        Err(_) => {}
                    }
                }
                if len(reject_parts) >= 2 { rreason = reject_parts[1] }
                let _ = db_cdr(db, db_ok, cid, caller_id, translated, "REJECTED:" + string(rcode))
                return sip_resp(rcode, rreason, data, dl, "rj")
            } else {
            if str_has_prefix(route_result, "redirect:") {
                // 302 redirect
                let redir_uri = route_result[9:]
                let redir_tag = "redir-" + sha256("madis.302|" + cid)[0:16]
                return sip_reply_with_to_tag(data, 302, "Moved Temporarily", "Contact: <" + redir_uri + ">\r\n", "", redir_tag)
            } else {
            if str_has_prefix(route_result, "route|") {
                let targets = route_result[6:]
                let primary = sip_forward_fork(targets, inv_msg, ip, port, tr, public_ip, cache, cid, forward_fd)
                if len(primary) == 0 { return sip_resp(503, "Service Unavailable", data, dl, "route") }
                let _ = db_cdr(db, db_ok, cid, caller_id, translated, "ROUTING:" + primary)
                let _ = db_cdr_detail(db, db_ok, cid, ip, primary, tr)
                let _ = db_sip_tx(db, db_ok, cid, "send", "Trying", 100, "proxy", ip)
                let _ = db_sip_tx(db, db_ok, cid, "send", "INVITE", 0, "proxy", primary)
                return sip_resp(100, "Trying", data, dl, "")
            } else {
            if str_has_prefix(route_result, "b2bua|") {
                if b2bua_enabled() == 0 { return sip_resp(503, "Service Unavailable", data, dl, "b2bua-disabled") }
                let target = route_result[6:]
                let b2_msg = b2bua_prepare_invite(inv_msg, target, sip_transport_param(target, tr), ip + ":" + string(port), tr, cache)
                let mut sent = 0
                if len(b2_msg) > 0 { sent = sip_forward_target(target, b2_msg, sip_transport_param(target, tr), cache, forward_fd) }
                if sent == 0 {
                    let failed_key = b2bua_lookup_in(inv_msg, cache)
                    if len(failed_key) > 0 { let _ = b2bua_cleanup(failed_key, cache) }
                    return sip_resp(503, "Service Unavailable", data, dl, "b2bua-route")
                }
                let _ = db_cdr(db, db_ok, cid, caller_id, translated, "B2BUA:" + target)
                return sip_resp(100, "Trying", data, dl, "")
            } else {
            if str_has_prefix(route_result, "dispatch|") {
                let targets = route_result[9:]
                let primary = sip_forward_fork(targets, inv_msg, ip, port, tr, public_ip, cache, cid, forward_fd)
                if len(primary) == 0 { return sip_resp(503, "Service Unavailable", data, dl, "dispatch") }
                let _ = db_cdr(db, db_ok, cid, caller_id, translated, "DISPATCH:" + primary)
                return sip_resp(100, "Trying", data, dl, "")
            } else {
                // Unknown action
            }}}}}
        }

        let _ = db_cdr(db, db_ok, cid, from_user, translated, "NOT_FOUND")
        return sip_resp(404, "Not Found", data, dl, "nf")

    } else {
    // PRACK and UPDATE are dialog-scoped requests. Forward them through the
    // existing Route/To-tag binding before application or new-call routing.
    // Reliable provisional-response generation remains an endpoint
    // responsibility; the proxy validates PRACK RSeq/RAck against tracked
    // downstream provisional responses.
    if is_prack == 1 || is_update == 1 {
        if is_prack == 1 && sip_prack_matches_relprov(data, cache) == 0 {
            return sip_resp(481, "Call/Transaction Does Not Exist", data, dl, "prack-rack")
        }
        if ims_initial_dialog_request(data, dl) == 1 {
            return sip_resp(481, "Call/Transaction Does Not Exist", data, dl, "dialog-method")
        }
        let mut dialog_msg = msg
        if is_update == 1 {
            dialog_msg = rtp_process_offer(msg, len(msg), cid, from_tag, db, db_ok, cache)
        }
        let sent = sip_forward_dialog_request(dialog_msg, cid, method, next_hop, ip, port, tr, cache, forward_fd)
        if sent == 1 { return "" }
        return sip_resp(481, "Call/Transaction Does Not Exist", data, dl, "dialog-method")
    }
    let mut other_app_raw = app_gateway_call(msg, ip, port, tr, "request")
    let mut other_app_id = app_gateway_request_id_for(msg, "request")
    let mut other_app_action = app_gateway_action(other_app_raw, other_app_id, 0)
    let mut other_command_token = cached_env(cache, "_app_token", "SIP_APP_TOKEN", "")
    if str_eq(other_app_action, "module") && app_gateway_command_valid(other_app_raw, other_app_id, 0) == 1 {
        let module_name = json_get_string(other_app_raw, "module")
        let module_operation = json_get_string(other_app_raw, "operation")
        let module_payload = json_get_string(other_app_raw, "payload")
        let module_raw = module_gateway_call(msg, ip, port, tr, "request", module_name, module_operation, module_payload)
        let module_id = module_gateway_request_id(msg, "request", module_name, module_operation, module_payload)
        let module_action = module_gateway_action(module_raw, msg, "request", module_name, module_operation, module_payload)
        if str_eq(module_action, "fail") { return sip_resp(503, "Service Unavailable", data, dl, "module") }
        if str_eq(module_action, "drop") { return "" }
        other_app_raw = module_raw
        other_app_id = module_id
        other_app_action = module_action
        other_command_token = cached_env(cache, "_mod_token", "SIP_MODULE_TOKEN", "")
    }
    if str_eq(other_app_action, "fail") { return sip_resp(503, "Service Unavailable", data, dl, "app") }
    if str_eq(other_app_action, "drop") { return "" }
    if str_eq(other_app_action, "reply") || str_eq(other_app_action, "redirect") {
        if app_gateway_command_valid_token(other_app_raw, other_app_id, 0, other_command_token) == 1 { return app_command_reply(data, other_app_raw) }
        if app_gateway_fail_closed() == 1 { return sip_resp(503, "Service Unavailable", data, dl, "app") }
    }
    if str_eq(other_app_action, "b2bua") { return sip_resp(400, "Bad Request", data, dl, "app-action") }
    if len(other_app_raw) > 0 && (str_eq(other_app_action, "continue") || str_eq(other_app_action, "proxy") || str_eq(other_app_action, "route") || str_eq(other_app_action, "dispatch")) && app_gateway_command_valid_token(other_app_raw, other_app_id, 0, other_command_token) == 1 {
        let changed = app_command_apply(msg, other_app_raw)
        if str_eq(changed, "__APP_INVALID_MESSAGE__") {
            if app_gateway_fail_closed() == 1 { return sip_resp(400, "Bad Request", data, dl, "app-message") }
        } else { msg = changed }
    }
    if (str_eq(other_app_action, "proxy") || str_eq(other_app_action, "route") || str_eq(other_app_action, "dispatch")) && len(other_app_raw) > 0 {
        let target_items = str_split(json_get_string(other_app_raw, "target"), ",")
        let mut app_target = ""
        if len(target_items) > 0 { app_target = str_trim_space(target_items[0]) }
        if is_ack == 1 || is_bye == 1 || is_cancel == 1 {
            let sent = sip_forward_dialog_request(msg, cid, method, app_target, ip, port, tr, cache, forward_fd)
            if sent == 1 { return "" }
            return sip_resp(503, "Service Unavailable", data, dl, "app-route")
        }
        let primary = sip_forward_fork(json_get_string(other_app_raw, "target"), msg, ip, port, tr, public_ip, cache, cid, forward_fd)
        if len(primary) == 0 { return sip_resp(503, "Service Unavailable", data, dl, "app-route") }
        return sip_resp(100, "Trying", data, dl, "")
    }
    // === ACK ===
    if is_ack == 1 {
        let sent = sip_forward_dialog_request(msg, cid, "ACK", next_hop, ip, port, tr, cache, forward_fd)
        if sent == 1 { return "" }
        return ""
    } else {
    // === BYE ===
    if is_bye == 1 {
        if cmap_has(calls, cid) == 1 {
            let _ = db_cdr(db, db_ok, cid, from_user, "", "COMPLETED")
            let _ = charging_session_event(cid, from_user, "", "termination", 1, 0, cache, diameter_lock)
            let _ = db_cdr_code(db, db_ok, cid, "200")
            let _ = db_sip_tx(db, db_ok, cid, "recv", "BYE", 0, ip, "proxy")
            let _ = db_sip_tx(db, db_ok, cid, "send", "OK", 200, "proxy", ip)
            let _ = rtp_process_delete(cid, db, db_ok, cache)
            let _ = ims_rx_terminate(cache, diameter_lock, cid)
            let _ = sip_call_state_cleanup(calls, cid, sip_addr_tag(from), sip_addr_tag(to))
        }
        let sent = sip_forward_dialog_request(msg, cid, "BYE", next_hop, ip, port, tr, cache, forward_fd)
        let _ = log_debug_if(cache, "sip", "bye cid=" + cid + " ip=" + ip)
        let _ = sip_dialog_cache_cleanup(cache, cid, msg)
        if sent == 1 { return "" }
        // Cluster failover: if this node doesn't own the dialog, check PG
        // for a dialog binding from a failed node and forward BYE there.
        let cluster_dst = cluster_call_lookup(db, db_ok, cid)
        if len(cluster_dst) > 0 {
            let cluster_tr = sip_transport_param(cluster_dst, "udp")
            let _ = sip_forward_target(cluster_dst, msg, cluster_tr, cache, forward_fd)
            return ""
        }
        return sip_resp(481, "Call/Transaction Does Not Exist", data, dl, "bye")
    } else {
    // === CANCEL ===
    if is_cancel == 1 {
        let _ = log_debug_if(cache, "sip", "cancel cid=" + cid + " ip=" + ip)
        let _ = maf_worker_inbound_cancel_terminate(db, db_ok, data, cache, forward_fd)
        let _ = maf_worker_sync_sip(db, db_ok, data, cache)
        let _ = sip_send_fork_cancels(cid, "", cache, forward_fd)
        let _ = sip_forward_dialog_request(msg, cid, "CANCEL", next_hop, ip, port, tr, cache, forward_fd)
        // Mark the INVITE transaction as cancelled. If the downstream UAS
        // never responds with 487 and the client transaction times out,
        // the timeout path generates 487 instead of 408 per RFC 3261 §16.10.
        let _ = bounded_cache_set(cache, "cancel_seq", "cancel_ring|", "cancelled|" + cid, "1", 16384)
        if cmap_has(calls, cid) == 1 {
            let _ = db_cdr(db, db_ok, cid, from_user, "", "CANCELLED")
            let _ = charging_session_event(cid, from_user, "", "termination", 1, 0, cache, diameter_lock)
            let _ = rtp_process_delete(cid, db, db_ok, cache)
            let _ = ims_rx_terminate(cache, diameter_lock, cid)
            let _ = sip_call_state_cleanup(calls, cid, sip_addr_tag(from), sip_addr_tag(to))
        }
        return sip_resp(200, "OK", data, dl, "")
    } else {
    // === OPTIONS ===
    if is_options == 1 {
        return sip_options_response(data)
    } else {
    // === SUBSCRIBE (RFC 6665) ===
    // Event package handling — intercept SUBSCRIBE before the generic
    // in-dialog forwarder so the proxy can act as notifier.
    if str_eq(method, "SUBSCRIBE") && event_package_enabled() == 1 {
        let evt_resp = event_package_handle_subscribe(data, dl, cache, reg)
        if len(evt_resp) > 0 { return evt_resp }
        // Unsupported event package — fall through to forward or reject
    }
    // === REFER / INFO / MESSAGE / NOTIFY / SUBSCRIBE (passthrough) ===
    // RFC 3261 §16.2: a proxy MUST forward any request it understands if it
    // can determine the next hop. In-dialog requests (To-tag present) use the
    // existing dialog binding. Out-of-dialog requests are forwarded through
    // normal routing.
    let other_to_tag = sip_addr_tag(to)
    if len(other_to_tag) > 0 {
        let sent = sip_forward_dialog_request(msg, cid, method, next_hop, ip, port, tr, cache, forward_fd)
        if sent == 1 { return "" }
        return sip_resp(481, "Call/Transaction Does Not Exist", data, dl, "dialog-method")
    }
    if len(next_hop) > 0 {
        let forwarded = proxy_hop_via(msg, ip, port, tr)
        let sent = sip_forward_target(next_hop, forwarded, sip_transport_param(next_hop, "udp"), cache, forward_fd)
        if sent == 1 { return "" }
        return sip_resp(503, "Service Unavailable", data, dl, "route-failed")
    }
    if str_eq(method, "MESSAGE") || str_eq(method, "PUBLISH") || str_eq(method, "NOTIFY") || str_eq(method, "REFER") || str_eq(method, "SUBSCRIBE") {
        let ruri = sip_request_uri(data)
        let mut target_aor = sip_user(to) + "@" + sip_domain(to)
        if len(sip_user(ruri)) > 0 { target_aor = sip_user(ruri) + "@" + sip_domain(ruri) }
        let binding = registration_find(reg, target_aor)
        if len(binding) > 0 {
            let cp1 = str_index(binding, "|")
            let contact_uri = if cp1 >= 0 { binding[0:cp1] } else { binding }
            let mut contact_tr = "udp"
            if cp1 >= 0 {
                let rest1 = binding[cp1 + 1:]
                let cp2 = str_index(rest1, "|")
                contact_tr = if cp2 >= 0 { rest1[0:cp2] } else { rest1 }
            }
            let mut term_target = contact_uri
            let nat_target = registration_nat_target(binding)
            if len(nat_target) > 0 { term_target = nat_target }
            let fwd = proxy_hop_via(msg, ip, port, tr)
            let sent = sip_forward_target(term_target, fwd, contact_tr, cache, forward_fd)
            if sent == 1 { return "" }
            return sip_resp(503, "Service Unavailable", data, dl, "forward-failed")
        }
        return sip_resp(404, "Not Found", data, dl, "user-not-registered")
    }
    return sip_method_not_allowed(data)
    }}}}}}}

// Single ingress wrapper keeps tracing, metrics, transaction replay, and
// dialog bookkeeping consistent across UDP/TCP/TLS/WSS workers.
// Cache message size limit — env lookup + parse_int once, not per message.
fn sip_max_message_size_cached(cache: CMap) -> int {
    if cmap_has(cache, "_max_msg_size") == 1 {
        let mut v = 65536
        match parse_int(cmap_get(cache, "_max_msg_size")) { Ok(n) => { v = n } Err(_) => {} }
        return v
    }
    let mut limit = 65536
    match parse_int(env_get_or("SIP_MAX_MESSAGE_SIZE", "65536")) { Ok(v) => { limit = v } Err(_) => {} }
    if limit < 4096 { limit = 4096 }
    if limit > 1048576 { limit = 1048576 }
    cmap_set(cache, "_max_msg_size", string(limit))
    return limit
}

fn sip_stateless_options_enabled(cache: CMap) -> int {
    if cmap_has(cache, "_stateless_options") == 1 {
        return cmap_get_int(cache, "_stateless_options", 1)
    }
    let raw = env_get_or("SIP_STATELESS_OPTIONS", "1")
    let mut enabled = 1
    if str_eq(raw, "0") || str_eq(str_to_lower(raw), "false") { enabled = 0 }
    cmap_set_int(cache, "_stateless_options", enabled)
    return enabled
}

fn sip_record_basic_metrics(cache: CMap, calls: CMap, data: string, reply: string, tr: string, elapsed: int) -> int {
    let is_resp = sip_is_response(data)
    metric_add(0, 1)
    if is_resp == 1 { metric_add(2, 1) } else { metric_add(1, 1) }
    if len(reply) > 0 {
        let code = sip_status_code(reply)
        if code >= 200 && code < 300 { metric_add(3, 1) }
        if code >= 400 && code < 500 { metric_add(4, 1) }
        if code >= 500 { metric_add(5, 1) }
    }
    hist_observe(0, elapsed)
    gauge_set(0, cmap_len(calls))
    if cmap_has(cache, "_prom_active") == 1 {
        if is_resp == 0 {
            let m = madis_method(data)
            let _ = cmap_incr(cache, "prom|sip_requests|method=\"" + m + "\",transport=\"" + tr + "\"", 1)
        }
        if len(reply) > 0 {
            let c = sip_status_code(reply)
            if c > 0 { let _ = cmap_incr(cache, "prom|sip_responses|code=\"" + string(c) + "\",class=\"" + string(c / 100) + "xx\"", 1) }
        }
    }
    return 0
}

fn process_sip(data: string, dl: int, reg: CMap, calls: CMap, ip: string, port: int, source_port: int, tr: string, forward_fd: int, db: SqlDB, db_ok: int, cache: CMap, outbox: chan[string], realm: string, node_id: string, diameter_lock: Mutex) -> string {
    // Size check — cached, zero alloc
    if dl > sip_max_message_size_cached(cache) {
        return "SIP/2.0 413 Request Entity Too Large\r\nContent-Length: 0\r\n\r\n"
    }
    if sip_validate_message(data, dl) == 0 {
        return "SIP/2.0 400 Bad Request\r\nContent-Length: 0\r\n\r\n"
    }
    if dl > 0 && int(data[0]) == 79 && sip_stateless_options_enabled(cache) == 1 && str_eq(madis_method(data), "OPTIONS") {
        let started_fast = mono_ms()
        let reply_fast = sip_options_response(data)
        let _ = sip_record_basic_metrics(cache, calls, data, reply_fast, tr, mono_ms() - started_fast)
        return reply_fast
    }
    // HEP — fully skipped when off (single CMap check)
    if cmap_get_int(cache, "_hep_on", -1) != 0 {
        if cmap_get_int(cache, "_hep_on", -1) < 0 {
            let h = hep_enabled()
            cmap_set_int(cache, "_hep_on", h)
            if h == 0 { /* skip */ }
        }
        if cmap_get_int(cache, "_hep_on", 0) == 1 {
            let mut hep_ip = ""
            if cmap_has(cache, "_hep_local_ip") == 1 {
                hep_ip = cmap_get(cache, "_hep_local_ip")
            } else {
                hep_ip = env_get_or("SIP_HEP_LOCAL_IP", env_get_or("SIP_PUBLIC_IP", "127.0.0.1"))
                cmap_set(cache, "_hep_local_ip", hep_ip)
            }
            let _ = hep_capture(outbox, cache, data, ip, source_port, hep_ip, port, tr)
        }
    }
    let started = mono_ms()
    let _ = sip_server_txn_ack(data, cache)
    let reply = process_sip_core(data, dl, reg, calls, ip, port, source_port, tr, forward_fd, db, db_ok, cache, realm, node_id, diameter_lock)
    let elapsed = mono_ms() - started
    // Single is_response check — reused 3 times
    let is_resp = sip_is_response(data)
    if is_resp == 1 {
        let _ = sip_txn_cache_forwarded_response(reply, cache)
    }
    if len(reply) > 0 {
        let _ = sip_txn_cache_response(data, reply, cache)
        if is_resp == 0 && sip_status_code(reply) >= 200 {
            let mut pp = sip_msg_response_port(data)
            if pp <= 0 { pp = 5060 }
            let _ = sip_server_txn_record(data, reply, ip, pp, tr, forward_fd, cache)
        }
    }
    let _ = sip_dialog_observe(data, reply, calls, cache)
    let _ = maf_worker_sync_sip(db, db_ok, data, cache)
    let _ = sip_record_basic_metrics(cache, calls, data, reply, tr, elapsed)
    return reply
}

fn sip_config_port(name: string, default_port: int) -> int {
    let mut port = default_port
    match parse_int(env_get_or(name, string(default_port))) {
        Ok(v) => { if v > 0 && v <= 65535 { port = v } }
        Err(_) => {}
    }
    return port
}

// Strict dotted-quad check: four decimal octets 0-255, nothing else.
fn sip_bind_ip_valid(ip: string) -> int {
    if len(ip) < 7 || len(ip) > 15 { return 0 }
    let parts = str_split(ip, ".")
    if len(parts) != 4 { return 0 }
    let mut i = 0
    while i < 4 {
        let octet = parts[i]
        if len(octet) < 1 || len(octet) > 3 { return 0 }
        let mut j = 0
        while j < len(octet) {
            let c = int(octet[j])
            if c < 48 || c > 57 { return 0 }
            j = j + 1
        }
        match parse_int(octet) {
            Ok(v) => { if v > 255 { return 0 } }
            Err(_) => { return 0 }
        }
        i = i + 1
    }
    return 1
}

// SIP_BIND_IP selects the local IPv4 signaling bind address for the
// UDP/TCP/TLS/WSS listeners. Empty or "0.0.0.0" keeps the wildcard; IPv6
// listeners remain governed by SIP_IPV6. An invalid value falls back to the
// wildcard so a typo cannot silently move signaling to another interface.
fn sip_bind_ip() -> string {
    let raw = str_trim_space(env_get_or("SIP_BIND_IP", ""))
    if len(raw) == 0 { return "0.0.0.0" }
    if sip_bind_ip_valid(raw) == 1 { return raw }
    slog("  Bind:    SIP_BIND_IP invalid, using 0.0.0.0")
    return "0.0.0.0"
}

fn sip_worker_count(name: string, default_val: int, max_val: int) -> int {
    let mut n = default_val
    match parse_int(env_get_or(name, string(default_val))) {
        Ok(v) => { n = v }
        Err(_) => { n = default_val }
    }
    if n < 0 { n = 0 }
    if n > max_val { n = max_val }
    return n
}

fn sip_scheduler_workers(udp_workers: int, tcp_workers: int, tls_workers: int, wss_workers: int, ipv6_enabled: int) -> int {
    // Keep one scheduler slot for every long-lived listener task. A smaller
    // pool would let a kicked listener starve the rest of the process. Zero
    // preserves Mako's default: one pthread per kick.
    let mut minimum = udp_workers + tcp_workers + tls_workers + wss_workers + 2
    if ipv6_enabled == 1 { minimum = minimum + 1 }
    let mut workers = 0
    match parse_int(env_get_or("SIP_SCHED_WORKERS", "0")) {
        Ok(v) => { workers = v }
        Err(_) => { workers = 0 }
    }
    if workers <= 0 { return 0 }
    if minimum > 0 && workers < minimum { workers = minimum }
    if workers > 64 { workers = 64 }
    return workers
}

// ============ MAIN ============

fn main() {
    let _ = signal_on_term()
    // Validate config at startup — log warnings, abort on critical errors
    let config_errors = proxy_validate_config()
    if len(config_errors) > 0 {
        let lines = str_split(config_errors, "\n")
        let mut has_error = 0
        let mut i = 0
        while i < len(lines) {
            let line = str_trim_space(lines[i])
            if len(line) > 0 { slog("  Config:  " + line) }
            if str_has_prefix(line, "ERROR:") { has_error = 1 }
            i = i + 1
        }
        // Abort on errors, continue on warnings
        if has_error == 1 {
            slog("  Config:  fix errors above and restart")
            return
        }
    }
    let report_path = env_get_or("SIP_CRASH_REPORT", "")
    if len(report_path) > 0 { let _ = crash_report_install(report_path) }
    let udp_port = sip_config_port("SIP_UDP_PORT", 5060)
    // TCP shares the UDP port unless SIP_TCP_PORT overrides it.
    let tcp_port = sip_config_port("SIP_TCP_PORT", udp_port)
    let tls_port = sip_config_port("SIP_TLS_PORT", 5061)
    let wss_port = sip_config_port("SIP_WSS_PORT", 8443)
    let db_url = env_get_or("SIP_DB_URL", "")
    let realm = env_get_or("SIP_REALM", "mako.local")
    let node_id = env_get_or("SIP_NODE_ID", "node1")
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    let node_region = env_get_or("SIP_REGION", "default")
    let config_path = env_get_or("SIP_CONFIG_FILE", "")

    let reg = cmap_new()
    let calls = cmap_new()
    let cache = cmap_new()
    let hep_outbox = hep_queue_new()
    let diameter_lock = mutex_new()
    let mut config_watch = -1
    if len(config_path) > 0 && path_file_size(config_path) >= 0 {
        config_watch = hot_reload_watch(config_path)
    }

    // Database schema
    if len(db_url) > 0 {
        let db = sql_open_postgres(db_url)

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS users (id SERIAL PRIMARY KEY, username TEXT UNIQUE NOT NULL, password_ha1 TEXT NOT NULL, password_ha1_sha256 TEXT DEFAULT '', domain TEXT DEFAULT 'mako.local', display_name TEXT, email TEXT, max_contacts INT DEFAULT 5, enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "ALTER TABLE users ADD COLUMN IF NOT EXISTS password_ha1_sha256 TEXT DEFAULT ''")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS registrations (aor TEXT PRIMARY KEY, contact TEXT NOT NULL, transport TEXT DEFAULT 'UDP', node_id TEXT DEFAULT '', user_agent TEXT, updated_at TIMESTAMP DEFAULT NOW(), created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS registration_bindings (id SERIAL PRIMARY KEY, aor TEXT NOT NULL, contact TEXT NOT NULL, transport TEXT DEFAULT 'UDP', node_id TEXT DEFAULT '', source_ip TEXT DEFAULT '', source_port INT DEFAULT 0, expires_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW(), created_at TIMESTAMP DEFAULT NOW(), UNIQUE(aor, contact))")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_reg_bindings_aor_exp ON registration_bindings (aor, expires_at)")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS gateways (id SERIAL PRIMARY KEY, name TEXT UNIQUE NOT NULL, address TEXT NOT NULL, port INT DEFAULT 5060, transport TEXT DEFAULT 'UDP', auth_user TEXT, auth_pass TEXT, caller_id TEXT, max_channels INT DEFAULT 100, number_format TEXT DEFAULT 'e164', tech_prefix TEXT DEFAULT '', caller_id_override TEXT DEFAULT '', health_status TEXT DEFAULT 'unknown', last_health_code INT DEFAULT 0, last_health_check TIMESTAMP, enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")
        // Worker-created databases predate the policy/health columns; the admin
        // handlers and control API write them, so migrate in place.
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS number_format TEXT DEFAULT 'e164'")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS tech_prefix TEXT DEFAULT ''")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS caller_id_override TEXT DEFAULT ''")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS health_status TEXT DEFAULT 'unknown'")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS last_health_code INT DEFAULT 0")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS last_health_check TIMESTAMP")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS dispatch_sets (id SERIAL PRIMARY KEY, name TEXT UNIQUE NOT NULL, algorithm TEXT DEFAULT 'round-robin', description TEXT, enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS dispatch_members (id SERIAL PRIMARY KEY, set_id INT NOT NULL, gateway_id INT NOT NULL, priority INT DEFAULT 10, weight INT DEFAULT 100, enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS routes (id SERIAL PRIMARY KEY, prefix TEXT NOT NULL, gateway_id INT, dispatch_set_id INT, priority INT DEFAULT 10, weight INT DEFAULT 100, cost_per_min NUMERIC(8,4) DEFAULT 0, time_start TIME DEFAULT '00:00', time_end TIME DEFAULT '23:59', enabled BOOLEAN DEFAULT true, description TEXT, created_at TIMESTAMP DEFAULT NOW())")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS routing_rules (id SERIAL PRIMARY KEY, match_prefix TEXT DEFAULT '', match_caller TEXT DEFAULT '', match_src_ip TEXT DEFAULT '', match_time_start TEXT DEFAULT '', match_time_end TEXT DEFAULT '', match_day TEXT DEFAULT '', match_ani_group TEXT DEFAULT '', action TEXT NOT NULL, priority INT DEFAULT 10, enabled BOOLEAN DEFAULT true, description TEXT, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "ALTER TABLE routing_rules ADD COLUMN IF NOT EXISTS match_ani_group TEXT DEFAULT ''")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS dids (id SERIAL PRIMARY KEY, number TEXT UNIQUE NOT NULL, destination_user TEXT NOT NULL, description TEXT, enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS access_control (id SERIAL PRIMARY KEY, source_ip TEXT DEFAULT '*', sip_user TEXT DEFAULT '*', action TEXT DEFAULT 'allow', skip_auth BOOLEAN DEFAULT false, tenant TEXT DEFAULT 'default', max_channels INT DEFAULT 0, priority INT DEFAULT 10, enabled BOOLEAN DEFAULT true, description TEXT, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "ALTER TABLE access_control ADD COLUMN IF NOT EXISTS skip_auth BOOLEAN DEFAULT false")
        let _ = sql_exec_plain(db, "ALTER TABLE access_control ADD COLUMN IF NOT EXISTS tenant TEXT DEFAULT 'default'")
        let _ = sql_exec_plain(db, "ALTER TABLE access_control ADD COLUMN IF NOT EXISTS max_channels INT DEFAULT 0")
        let _ = sql_exec_plain(db, "ALTER TABLE access_control ADD COLUMN IF NOT EXISTS enabled BOOLEAN DEFAULT true")
        // Keep one-way compatibility with installations created before the
        // WebUI's access_control table replaced the old acl table.
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS acl (id SERIAL PRIMARY KEY, source_ip TEXT DEFAULT '*', sip_user TEXT DEFAULT '*', action TEXT DEFAULT 'allow', priority INT DEFAULT 10, description TEXT, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS madis_schema_migrations (key TEXT PRIMARY KEY, applied_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "INSERT INTO access_control (source_ip, sip_user, action, priority, description) SELECT source_ip, sip_user, action, priority, description FROM acl WHERE NOT EXISTS (SELECT 1 FROM madis_schema_migrations WHERE key = 'acl-to-access-control') AND NOT EXISTS (SELECT 1 FROM access_control)")
        let _ = sql_exec_plain(db, "INSERT INTO madis_schema_migrations (key) VALUES ('acl-to-access-control') ON CONFLICT DO NOTHING")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS dialplan (id SERIAL PRIMARY KEY, match_prefix TEXT NOT NULL, callee_action TEXT NOT NULL DEFAULT '', caller_action TEXT DEFAULT '', direction TEXT DEFAULT 'outbound', priority INT DEFAULT 10, enabled BOOLEAN DEFAULT true, description TEXT, created_at TIMESTAMP DEFAULT NOW())")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS cdr (call_id TEXT PRIMARY KEY, caller TEXT, callee TEXT, status TEXT, gateway TEXT, source_ip TEXT, destination TEXT, transport TEXT, from_uri TEXT, to_uri TEXT, user_agent TEXT, sip_code INT, started_at TIMESTAMP DEFAULT NOW(), ended_at TIMESTAMP, duration_sec INT)")
        let _ = sql_exec_plain(db, "ALTER TABLE cdr ADD COLUMN IF NOT EXISTS source_ip TEXT")
        let _ = sql_exec_plain(db, "ALTER TABLE cdr ADD COLUMN IF NOT EXISTS destination TEXT")
        let _ = sql_exec_plain(db, "ALTER TABLE cdr ADD COLUMN IF NOT EXISTS transport TEXT")
        let _ = sql_exec_plain(db, "ALTER TABLE cdr ADD COLUMN IF NOT EXISTS from_uri TEXT")
        let _ = sql_exec_plain(db, "ALTER TABLE cdr ADD COLUMN IF NOT EXISTS to_uri TEXT")
        let _ = sql_exec_plain(db, "ALTER TABLE cdr ADD COLUMN IF NOT EXISTS user_agent TEXT")
        let _ = sql_exec_plain(db, "ALTER TABLE cdr ADD COLUMN IF NOT EXISTS sip_code INT")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS billing_events (event_id TEXT PRIMARY KEY, call_id TEXT NOT NULL DEFAULT '', event_type TEXT NOT NULL, payload_json JSONB NOT NULL, occurred_at TIMESTAMP DEFAULT NOW(), available_at TIMESTAMP DEFAULT NOW(), delivered_at TIMESTAMP, attempts INT NOT NULL DEFAULT 0, last_error TEXT NOT NULL DEFAULT '', CONSTRAINT billing_event_id_size CHECK (char_length(event_id) BETWEEN 16 AND 128), CONSTRAINT billing_event_payload_size CHECK (octet_length(payload_json::text) <= 65536))")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_billing_events_pending ON billing_events (occurred_at, event_id) WHERE delivered_at IS NULL")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_billing_events_call ON billing_events (call_id, occurred_at)")
        let _ = maf_worker_bootstrap(db)
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS sip_transactions (id SERIAL PRIMARY KEY, call_id TEXT, direction TEXT, method TEXT, source TEXT, ts TIMESTAMP DEFAULT NOW())")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS ip_auth (id SERIAL PRIMARY KEY, ip_address TEXT UNIQUE NOT NULL, description TEXT, tenant TEXT DEFAULT 'default', account_id INT, max_channels INT DEFAULT 100, enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS cluster_nodes (id TEXT PRIMARY KEY, address TEXT NOT NULL, port INT DEFAULT 5060, region TEXT DEFAULT 'default', weight INT DEFAULT 100, status TEXT DEFAULT 'active', last_heartbeat TIMESTAMP DEFAULT NOW(), started_at TIMESTAMP DEFAULT NOW())")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS header_rules (id SERIAL PRIMARY KEY, match_method TEXT DEFAULT '*', match_direction TEXT DEFAULT 'outbound', action TEXT NOT NULL, header_name TEXT NOT NULL, header_value TEXT DEFAULT '', priority INT DEFAULT 10, enabled BOOLEAN DEFAULT true, description TEXT, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS number_format TEXT DEFAULT 'e164'")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS tech_prefix TEXT DEFAULT ''")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS caller_id_override TEXT DEFAULT ''")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS health_status TEXT DEFAULT 'unknown'")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS last_health_code INT DEFAULT 0")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS last_health_check TIMESTAMP")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS ani_groups (id SERIAL PRIMARY KEY, name TEXT UNIQUE NOT NULL, description TEXT DEFAULT '', enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS ani_ranges (id SERIAL PRIMARY KEY, group_id INT NOT NULL, range_start TEXT NOT NULL, range_end TEXT NOT NULL, enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_ani_ranges_group ON ani_ranges (group_id, range_start)")

        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS config (key TEXT PRIMARY KEY, value TEXT NOT NULL, description TEXT)")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS security_bans (source_ip TEXT PRIMARY KEY, reason TEXT DEFAULT '', ban_count INT DEFAULT 1, expires_at TIMESTAMP, permanent BOOLEAN DEFAULT false, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS security_events (id SERIAL PRIMARY KEY, event_type TEXT NOT NULL, source_ip TEXT DEFAULT '', sip_user TEXT DEFAULT '', severity TEXT DEFAULT 'low', details TEXT DEFAULT '', ts TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_security_events_ip_ts ON security_events (source_ip, ts)")

        // Indexes
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_routes_pfx ON routes (prefix, enabled)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_dids_num ON dids (number) WHERE enabled = true")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_acl_ip ON access_control (source_ip)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cdr_time ON cdr (started_at)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_users_name ON users (username) WHERE enabled = true")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_ipauth_ip ON ip_auth (ip_address) WHERE enabled = true")

        // Register this node in the cluster
        let _ = sql_exec_str4(db, "INSERT INTO cluster_nodes (id, address, port, region, status) VALUES ($1, $2, $3, $4, 'active') ON CONFLICT (id) DO UPDATE SET address = $2, port = $3, region = $4, status = 'active', last_heartbeat = NOW()", node_id, node_addr, string(udp_port), node_region)

        // Default STIR/SHAKEN config (sign=HS256 lab only; verify=HS256/RS256/JWKS)
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "stir_shaken_enabled", "false", "Enable STIR/SHAKEN", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "stir_shaken_attestation", "A", "Default attestation level A/B/C", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "stir_shaken_cert_url", "https://certs.example.com/sti.pem", "STI certificate URL (x5u)", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "stir_shaken_mode", "auto", "Verify mode: auto|hs256|rs256|jwks", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "stir_shaken_secret", "", "HS256 secret (lab sign/verify)", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "stir_shaken_private_key", "", "ES256 private key PEM/path for production signing", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "stir_shaken_public_key", "", "RS256 public key PEM path or inline", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "stir_shaken_jwks", "", "JWKS JSON path or inline", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "stir_shaken_jwks_url", "", "JWKS HTTPS URL", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "security_enabled", "true", "Enable SIP security controls", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "security_max_auth_failures", "5", "Auth failures before temporary ban", "")
        let _ = sql_exec_str4(db, "INSERT INTO config (key, value, description) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "security_ban_duration_min", "30", "Temporary ban duration", "")

        // Index for routing rules
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_routing_rules_pri ON routing_rules (priority) WHERE enabled = true")

        // Tenant scoping for MAF: add tenant_id to infrastructure tables
        let _ = sql_exec_plain(db, "ALTER TABLE routing_rules ADD COLUMN IF NOT EXISTS tenant_id TEXT NOT NULL DEFAULT 'default'")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS tenant_id TEXT NOT NULL DEFAULT 'default'")
        let _ = sql_exec_plain(db, "ALTER TABLE dids ADD COLUMN IF NOT EXISTS tenant_id TEXT NOT NULL DEFAULT 'default'")
        let _ = sql_exec_plain(db, "ALTER TABLE dispatch_sets ADD COLUMN IF NOT EXISTS tenant_id TEXT NOT NULL DEFAULT 'default'")
        let _ = sql_exec_plain(db, "ALTER TABLE registration_bindings ADD COLUMN IF NOT EXISTS tenant_id TEXT NOT NULL DEFAULT 'default'")
        let _ = sql_exec_plain(db, "ALTER TABLE config ADD COLUMN IF NOT EXISTS tenant_id TEXT NOT NULL DEFAULT 'default'")
        let _ = sql_exec_plain(db, "ALTER TABLE header_rules ADD COLUMN IF NOT EXISTS tenant_id TEXT NOT NULL DEFAULT 'default'")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_routing_rules_tenant ON routing_rules (tenant_id, priority) WHERE enabled = true")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_gateways_tenant ON gateways (tenant_id, name)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_dids_tenant ON dids (tenant_id, number)")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_dispatch_sets_tenant ON dispatch_sets (tenant_id, name)")

        let _ = ims_lifecycle_bootstrap(db)
        if cluster_call_state_enabled() == 1 { let _ = cluster_call_bootstrap(db) }
        let hydrated = registration_load_db(db, 1, reg)
        let ims_hydrated = ims_lifecycle_load_db(db, 1, reg)
        let ims_hss_dropped = ims_lifecycle_hss_reconcile(cache, diameter_lock, reg, db, 1)

        slog("  DB:      PostgreSQL (hydrated " + string(hydrated) + " registrations, " + string(ims_hydrated) + " IMS lifecycles, HSS reconcile dropped " + string(ims_hss_dropped) + ")")
        slog("  Cluster: node=" + node_id + " region=" + node_region)
    } else {
        slog("  DB:      in-memory (standalone)")
    }
    cmap_set(cache, "ready", "1")

    let requested_udp_workers = sip_worker_count("SIP_UDP_WORKERS", 1, 8)
    let tcp_workers = sip_worker_count("SIP_TCP_WORKERS", 1, 8)
    let tls_workers = sip_worker_count("SIP_TLS_WORKERS", 1, 4)
    let wss_workers = sip_worker_count("SIP_WSS_WORKERS", 1, 4)

    let ipv6_cfg = env_get_or("SIP_IPV6", "1")
    let mut ipv6_enabled = 0
    let ipv6_low = ipv6_cfg |> str_trim_space() |> str_to_lower()
    if str_eq(ipv6_low, "1") || str_eq(ipv6_low, "true") || str_eq(ipv6_low, "yes") {
        ipv6_enabled = 1
    }
    let scheduler_workers = sip_scheduler_workers(requested_udp_workers, tcp_workers, tls_workers, wss_workers, ipv6_enabled)
    sched_set_workers(scheduler_workers)
    let bind_ip = sip_bind_ip()
    let bind_wildcard = if str_eq(bind_ip, "0.0.0.0") { 1 } else { 0 }

    slog("")
    slog("Mako SIP Proxy")
    slog("  Node:    " + node_id + " (" + node_addr + ")")
    slog("  Realm:   " + realm)
    slog("  Bind:    " + bind_ip)
    slog("  UDP:     :" + string(udp_port) + " (" + string(requested_udp_workers) + " worker(s), SO_REUSEPORT)")
    slog("  TCP:     :" + string(tcp_port) + " (" + string(tcp_workers) + " worker(s), multiplexed)")
    slog("  TLS:     :" + string(tls_port) + " (" + string(tls_workers) + " worker(s), multiplexed, OpenSSL)")
    slog("  WSS:     :" + string(wss_port) + " (" + string(wss_workers) + " worker(s), multiplexed)")
    slog("  Crew:    " + string(scheduler_workers) + " scheduler workers (0=one pthread per kick)")
    slog("  Auth:    IP + Digest")
    slog("  Route:   longest-prefix → dispatcher → gateway")
    slog("  SHAKEN:  verify HS256/RS256/ES256/JWKS; sign HS256 lab or ES256")
    slog("  Admin:   /healthz /readyz /metrics /state (SIP_ADMIN_PORT)")
    slog("  Cluster: DB-shared registrations + heartbeat")
    if proxy_protocol_enabled() == 1 {
        slog("  PP:      PROXY protocol v1 enabled (SIP_PROXY_PROTOCOL=1)")
    }
    slog("")

    // HEP worker disabled in proxy-only deployment.
    crew t {
        let mut udp_i = 0
        let mut maf_poll_fd = -1
        while udp_i < requested_udp_workers {
            let mut udp_fd = -1
            if requested_udp_workers > 1 {
                if bind_wildcard == 1 {
                    udp_fd = nb_udp_bind_reuseport(udp_port)
                } else {
                    udp_fd = nb_udp_bind_reuseport_addr(bind_ip, udp_port)
                }
                if udp_fd >= 0 { let _ = io_set_nonblocking(udp_fd, 1) }
            } else {
                if bind_wildcard == 1 {
                    udp_fd = nb_udp_bind(udp_port)
                } else {
                    udp_fd = udp_bind_addr(bind_ip, udp_port)
                    if udp_fd >= 0 { let _ = io_set_nonblocking(udp_fd, 1) }
                }
            }
            if udp_fd < 0 {
                slog("  UDP:     listener " + string(udp_i + 1) + " bind failed on :" + string(udp_port))
                break
            } else {
                let _ = register_listener(udp_fd)
                let _ = t.kick(udp_worker(udp_i, udp_fd, udp_port, reg, calls, cache, hep_outbox, diameter_lock))
                if maf_poll_fd < 0 { maf_poll_fd = udp_fd }
            }
            udp_i = udp_i + 1
        }
        if ipv6_enabled == 1 {
            let ipv6_fd = udp_bind_addr("::", udp_port)
            if ipv6_fd >= 0 { let _ = io_set_nonblocking(ipv6_fd, 1) }
            if ipv6_fd < 0 {
                slog("  UDP6:   IPv6 listener unavailable on :" + string(udp_port))
            } else {
                let _ = register_listener(ipv6_fd)
                let _ = t.kick(udp_worker(requested_udp_workers, ipv6_fd, udp_port, reg, calls, cache, hep_outbox, diameter_lock))
                if maf_poll_fd < 0 { maf_poll_fd = ipv6_fd }
            }
        }
        if maf_poll_fd >= 0 {
            let _ = t.kick(maf_poll_worker(maf_poll_fd, cache, calls))
        }
        let mut tcp_i = 0
        while tcp_i < tcp_workers {
            let mut tcp_fd = -1
            if tcp_workers == 1 {
                if bind_wildcard == 1 {
                    tcp_fd = tcp_listen(tcp_port)
                } else {
                    tcp_fd = tcp_listen_addr(bind_ip, tcp_port)
                }
            } else {
                tcp_fd = tcp_listen_reuseport(bind_ip, tcp_port, 256)
            }
            if tcp_fd < 0 {
                slog("  TCP:     listener " + string(tcp_i + 1) + " failed")
                break
            }
            let _ = register_listener(tcp_fd)
            let _ = io_set_nonblocking(tcp_fd, 1)
            let _ = t.kick(tcp_worker_multiplexed(tcp_fd, reg, calls, tcp_port, cache, hep_outbox, diameter_lock))
            tcp_i = tcp_i + 1
        }
        // TLS: shared OpenSSL context, per-worker listener fds
        if tls_server_available() == 1 {
            let mut tls_cert_path = env_get_or("SIP_TLS_CERT", "")
            let mut tls_key_path = env_get_or("SIP_TLS_KEY", "")
            if len(tls_cert_path) == 0 {
                tls_cert_path = env_get_or("SIP_TLS_AUTO_CERT", "/tmp/mako-sipproxy.crt")
                tls_key_path = env_get_or("SIP_TLS_AUTO_KEY", "/tmp/mako-sipproxy.key")
                let cn = env_get_or("SIP_TLS_CN", "localhost")
                let existing = read_file(tls_cert_path)
                if len(existing) == 0 {
                    let rc = tls_make_self_signed(tls_cert_path, tls_key_path, cn, 365)
                    if rc != 0 {
                        slog("  TLS:     failed to create self-signed cert")
                        tls_cert_path = ""
                    } else {
                        slog("  TLS:     auto self-signed CN=" + cn)
                    }
                }
            }
            if len(tls_cert_path) == 0 || len(tls_key_path) == 0 {
                slog("  TLS:     skipped (no cert/key)")
            } else {
            let tls_srv = tls_server_new(tls_cert_path, tls_key_path)
            // Store cert paths for hot reload in heartbeat loop
            cmap_set(cache, "_tls_cert", tls_cert_path)
            cmap_set(cache, "_tls_key", tls_key_path)
            cmap_set(cache, "_tls_mtime", string(path_file_size(tls_cert_path)))
            let tls_sni = env_get_or("SIP_TLS_SNI", "")
            let _ = tls_apply_sni(tls_srv, tls_sni)
            let mut tls_i = 0
            while tls_i < tls_workers {
                let mut tls_fd = -1
                if tls_workers == 1 {
                    if bind_wildcard == 1 {
                        tls_fd = tcp_listen(tls_port)
                    } else {
                        tls_fd = tcp_listen_addr(bind_ip, tls_port)
                    }
                } else {
                    tls_fd = tcp_listen_reuseport(bind_ip, tls_port, 256)
                }
                if tls_fd < 0 {
                    slog("  TLS:     listener " + string(tls_i + 1) + " failed")
                    break
                }
                let _ = register_listener(tls_fd)
                let _ = io_set_nonblocking(tls_fd, 1)
                let _ = t.kick(tls_worker(tls_fd, tls_srv, tls_port, reg, calls, cache, hep_outbox, diameter_lock))
                tls_i = tls_i + 1
            }
            }
        } else {
            slog("  TLS:     skipped (OpenSSL not available)")
        }
        // WSS: per-worker listener fds
        let mut wss_i = 0
        while wss_i < wss_workers {
            let mut wss_fd = -1
            if wss_workers == 1 {
                if bind_wildcard == 1 {
                    wss_fd = tcp_listen(wss_port)
                } else {
                    wss_fd = tcp_listen_addr(bind_ip, wss_port)
                }
            } else {
                wss_fd = tcp_listen_reuseport(bind_ip, wss_port, 256)
            }
            if wss_fd < 0 {
                slog("  WSS:     listener " + string(wss_i + 1) + " failed")
                break
            }
            let _ = register_listener(wss_fd)
            let _ = io_set_nonblocking(wss_fd, 1)
            let _ = t.kick(wss_worker(wss_fd, wss_port, reg, calls, cache, hep_outbox, diameter_lock))
            wss_i = wss_i + 1
        }
    let _ = t.kick(ims_cx_push_server_worker(reg))

        // Heartbeat + stats loop
        let hb_db_url = env_get_or("SIP_DB_URL", "")
        let hb_node_id = env_get_or("SIP_NODE_ID", "node1")
        let mut hb_db_ok = 0
        let mut hb_db = sql_open_postgres(hb_db_url)
        if len(hb_db_url) > 0 { hb_db_ok = 1 }
        let _ = t.kick(proxy_admin_worker(reg, calls, cache))

        while shutdown_requested() == 0 {
            sleep_ms(1000)

            if shutdown_requested() == 1 {
                break
            }

            // Sync DB config into worker cache so MAF config changes take
            // effect without restart. Runs every 5s (gated internally).
            if hb_db_ok == 1 {
                let _ = proxy_config_sync_db(hb_db, hb_db_ok, cache)
            }
        }
        if shutdown_requested() == 1 {
            // Graceful drain: stop accepting new connections (listeners
            // closed by should_stop_accepting), wait for in-flight
            // transactions to complete, then shut down.
            let mut drain_ms = 5000
            match parse_int(env_get_or("SIP_SHUTDOWN_DRAIN_MS", "5000")) {
                Ok(v) => { drain_ms = v }
                Err(_) => {}
            }
            if drain_ms < 0 { drain_ms = 0 }
            if drain_ms > 30000 { drain_ms = 30000 }
            if drain_ms > 0 {
                slog("[shutdown] draining " + string(drain_ms) + "ms for in-flight transactions")
                let drain_start = mono_ms()
                while mono_ms() - drain_start < drain_ms {
                    // Keep flushing transactions during drain
                    if hb_db_ok == 1 {
                        let _ = registration_cleanup_db(hb_db, hb_db_ok)
                    }
                    sleep_ms(100)
                    // Exit early if all calls finished
                    if cmap_len(calls) == 0 { break }
                }
                slog("[shutdown] drain complete, calls=" + string(cmap_len(calls)))
            }
            let _ = server_shutdown_begin(0)
        }
    }
}
