        let body = parse_body(raw, n)
        let level = str_to_lower(str_trim_space(json_get_string(body, "level")))
        if not str_eq(level, "error") && not str_eq(level, "warn") && not str_eq(level, "info") && not str_eq(level, "debug") {
            return maf_api_error(400, "level must be error, warn, info, or debug")
        }
        let mut level_int = 2
        if str_eq(level, "error") { level_int = 0 }
        if str_eq(level, "warn") { level_int = 1 }
        if str_eq(level, "debug") { level_int = 3 }
        // This sets the level for the admin process. Worker log level is set via SIP_LOG_LEVEL env.
        return http_resp(200, "application/json", "{\"ok\":true,\"level\":\"" + maf_api_json_escape(level) + "\"}\n", "Cache-Control: no-store\r\n")
    }
