        let rc = sql_exec_str4(db, "INSERT INTO routing_rules (tenant_id, match_prefix, match_caller, match_src_ip, match_time_start, match_time_end, match_day, action, priority, description) SELECT ($1::jsonb->>'tenant_id'), ($1::jsonb->>'match_prefix'), ($1::jsonb->>'match_caller'), ($1::jsonb->>'match_src_ip'), ($1::jsonb->>'match_time_start'), ($1::jsonb->>'match_time_end'), ($1::jsonb->>'match_day'), ($1::jsonb->>'action'), ($1::jsonb->>'priority')::int, ($1::jsonb->>'description')", packed, "", "", "")
        if rc < 0 { return maf_api_error(500, "rule insert failed") }
