        if ok == 0 { return maf_api_error(503, "database unavailable") }
        let tenant = maf_api_tenant()
        let rows = tbl_query_param(db, ok, "SELECT json_build_object('schedule_id',schedule_id,'from_uri',from_uri,'to_uri',to_uri,'scheduled_at',scheduled_at,'status',status,'call_id',call_id,'application_data',application_data,'created_at',created_at)::text FROM maf_scheduled_calls WHERE tenant_id = $1 ORDER BY scheduled_at ASC", tenant, 200)
        let mut out = "{\"schema\":\"madis.maf.scheduled_calls.v1\",\"scheduled_calls\":["
        let mut i = 0
        while i < len(rows) {
            if i > 0 { out = out + "," }
            out = out + rows[i]
            i = i + 1
        }
        return http_resp(200, "application/json", out + "]}\n", "Cache-Control: no-store\r\n")
    }
    // DELETE /admin/api/v1/maf/scheduled-calls/{id} — cancel a scheduled call
    if kind == 82 {
        let scope = maf_api_scope(raw, n)
        if scope < 2 { return maf_api_error(if scope == 0 { 401 } else { 403 }, "write scope required") }
        if ok == 0 { return maf_api_error(503, "database unavailable") }
        let sched_del_id = path[len("/admin/api/v1/maf/scheduled-calls/"):]
        if len(sched_del_id) == 0 || len(sched_del_id) > 20 { return maf_api_error(400, "invalid schedule ID") }
        let tenant = maf_api_tenant()
        let rc = sql_exec_str4(db, "UPDATE maf_scheduled_calls SET status = 'canceled' WHERE schedule_id = $1::int AND tenant_id = $2 AND status = 'pending'", sched_del_id, tenant, "", "")
        if rc <= 0 { return maf_api_error(if rc == 0 { 404 } else { 500 }, if rc == 0 { "scheduled call not found or already processed" } else { "cancel failed" }) }
        return http_resp(200, "application/json", "{\"ok\":true}\n", "Cache-Control: no-store\r\n")
    }
    // POST /admin/api/v1/maf/queues — create a call queue
    if kind == 83 {
        let scope = maf_api_scope(raw, n)
        if scope < 2 { return maf_api_error(if scope == 0 { 401 } else { 403 }, "write scope required") }
        if ok == 0 { return maf_api_error(503, "database unavailable") }
        if maf_api_body_ok(raw, n, 1) == 0 { return maf_api_error(400, "application/json body required") }
        let body = parse_body(raw, n)
        let name = str_trim_space(json_get_string(body, "name"))
        let strategy = str_trim_space(json_get_string(body, "strategy"))
        let max_wait = str_trim_space(json_get_string(body, "max_wait_sec"))
        let moh = str_trim_space(json_get_string(body, "music_on_hold"))
        if len(name) == 0 || len(name) > 128 { return maf_api_error(400, "name required (max 128 chars)") }
        let mut strat = if len(strategy) > 0 { strategy } else { "round-robin" }
        if not str_eq(strat, "round-robin") && not str_eq(strat, "ring-all") && not str_eq(strat, "longest-idle") && not str_eq(strat, "random") { return maf_api_error(400, "strategy must be round-robin, ring-all, longest-idle, or random") }
        let mut mw = 300
        if len(max_wait) > 0 { match parse_int(max_wait) { Ok(v) => { mw = v } Err(_) => {} } }
        if mw < 0 || mw > 3600 { return maf_api_error(400, "max_wait_sec must be 0-3600") }
        let tenant = maf_api_tenant()
        let packed = "{\"tenant\":\"" + maf_api_json_escape(tenant) + "\",\"name\":\"" + maf_api_json_escape(name) + "\",\"strategy\":\"" + maf_api_json_escape(strat) + "\",\"max_wait\":" + string(mw) + ",\"moh\":\"" + maf_api_json_escape(moh) + "\"}"
        let q_id = sql_query_str2(db, "INSERT INTO maf_queues (tenant_id, name, strategy, max_wait_sec, music_on_hold) VALUES ($1::jsonb->>'tenant', $1::jsonb->>'name', $1::jsonb->>'strategy', ($1::jsonb->>'max_wait')::int, $1::jsonb->>'moh') RETURNING queue_id::text", packed, "")
        if len(q_id) == 0 { return maf_api_error(409, "queue create failed (duplicate name?)") }
        return http_resp(201, "application/json", "{\"ok\":true,\"queue_id\":" + q_id + "}\n", "Cache-Control: no-store\r\n")
    }
    // GET /admin/api/v1/maf/queues — list queues
    if kind == 84 {
        let scope = maf_api_scope(raw, n)
        if scope < 1 { return maf_api_error(401, "authentication required") }
        if ok == 0 { return maf_api_error(503, "database unavailable") }
        let tenant = maf_api_tenant()
        let rows = tbl_query_param(db, ok, "SELECT json_build_object('queue_id',q.queue_id,'name',q.name,'strategy',q.strategy,'max_wait_sec',q.max_wait_sec,'music_on_hold',q.music_on_hold,'enabled',q.enabled,'created_at',q.created_at,'member_count',(SELECT COUNT(*) FROM maf_queue_members m WHERE m.queue_id = q.queue_id AND m.enabled))::text FROM maf_queues q WHERE q.tenant_id = $1 ORDER BY q.name", tenant, 200)
        let mut out = "{\"schema\":\"madis.maf.queues.v1\",\"queues\":["
        let mut i = 0
        while i < len(rows) {
            if i > 0 { out = out + "," }
            out = out + rows[i]
            i = i + 1
        }
        return http_resp(200, "application/json", out + "]}\n", "Cache-Control: no-store\r\n")
    }
    // POST /admin/api/v1/maf/queues/{id}/members — add agent to queue
    if kind == 85 {
        let scope = maf_api_scope(raw, n)
        if scope < 2 { return maf_api_error(if scope == 0 { 401 } else { 403 }, "write scope required") }
        if ok == 0 { return maf_api_error(503, "database unavailable") }
        if maf_api_body_ok(raw, n, 1) == 0 { return maf_api_error(400, "application/json body required") }
        let body = parse_body(raw, n)
        let agent_uri = str_trim_space(json_get_string(body, "agent_uri"))
        let priority_str = str_trim_space(json_get_string(body, "priority"))
        if maf_api_sip_uri_ok(agent_uri) == 0 { return maf_api_error(400, "valid agent_uri SIP URI required") }
        let mut priority = 1
        if len(priority_str) > 0 { match parse_int(priority_str) { Ok(v) => { priority = v } Err(_) => {} } }
        if priority < 1 || priority > 100 { return maf_api_error(400, "priority must be 1-100") }
        // Extract queue_id from path: /admin/api/v1/maf/queues/{id}/members
        let qpath = path[len("/admin/api/v1/maf/queues/"):]
        let qslash = str_index(qpath, "/")
        let queue_id_str = if qslash > 0 { qpath[0:qslash] } else { "" }
        if len(queue_id_str) == 0 || len(queue_id_str) > 20 { return maf_api_error(400, "invalid queue ID") }
        let tenant = maf_api_tenant()
        let packed = "{\"qid\":\"" + maf_api_json_escape(queue_id_str) + "\",\"tenant\":\"" + maf_api_json_escape(tenant) + "\",\"agent\":\"" + maf_api_json_escape(agent_uri) + "\",\"priority\":" + string(priority) + "}"
        let m_id = sql_query_str2(db, "INSERT INTO maf_queue_members (queue_id, tenant_id, agent_uri, priority) SELECT ($1::jsonb->>'qid')::int, $1::jsonb->>'tenant', $1::jsonb->>'agent', ($1::jsonb->>'priority')::int WHERE EXISTS (SELECT 1 FROM maf_queues WHERE queue_id = ($1::jsonb->>'qid')::int AND tenant_id = $1::jsonb->>'tenant') RETURNING member_id::text", packed, "")
        if len(m_id) == 0 { return maf_api_error(404, "queue not found or member insert failed") }
        return http_resp(201, "application/json", "{\"ok\":true,\"member_id\":" + m_id + "}\n", "Cache-Control: no-store\r\n")
    }
    // DELETE /admin/api/v1/maf/queues/{id}/members/{agent_id} — remove agent from queue
    if kind == 86 {
        let scope = maf_api_scope(raw, n)
        if scope < 2 { return maf_api_error(if scope == 0 { 401 } else { 403 }, "write scope required") }
        if ok == 0 { return maf_api_error(503, "database unavailable") }
        // Parse: /admin/api/v1/maf/queues/{id}/members/{agent_id}
        let rpath = path[len("/admin/api/v1/maf/queues/"):]
        let rslash = str_index(rpath, "/")
        let r_queue_id = if rslash > 0 { rpath[0:rslash] } else { "" }
        let after_members = if rslash > 0 { rpath[rslash + 1:] } else { "" }
        let mem_prefix = "members/"
        let r_member_id = if str_has_prefix(after_members, mem_prefix) { after_members[len(mem_prefix):] } else { "" }
        if len(r_queue_id) == 0 || len(r_queue_id) > 20 || len(r_member_id) == 0 || len(r_member_id) > 20 { return maf_api_error(400, "invalid queue or member ID") }
        let tenant = maf_api_tenant()
        let rc = sql_exec_str4(db, "DELETE FROM maf_queue_members WHERE member_id = $1::int AND queue_id = $2::int AND tenant_id = $3", r_member_id, r_queue_id, tenant, "")
        if rc <= 0 { return maf_api_error(if rc == 0 { 404 } else { 500 }, if rc == 0 { "member not found" } else { "delete failed" }) }
        return http_resp(200, "application/json", "{\"ok\":true}\n", "Cache-Control: no-store\r\n")
    }
    // POST /admin/api/v1/maf/conferences — create conference room
    if kind == 87 {
        let scope = maf_api_scope(raw, n)
        if scope < 2 { return maf_api_error(if scope == 0 { 401 } else { 403 }, "write scope required") }
        if ok == 0 { return maf_api_error(503, "database unavailable") }
        if maf_api_body_ok(raw, n, 1) == 0 { return maf_api_error(400, "application/json body required") }
        let body = parse_body(raw, n)
        let cname = str_trim_space(json_get_string(body, "name"))
        let cpin = str_trim_space(json_get_string(body, "pin"))
        let cmax_str = str_trim_space(json_get_string(body, "max_participants"))
        let crecord = str_trim_space(json_get_string(body, "record"))
        let cmuted = str_trim_space(json_get_string(body, "muted_on_join"))
        if len(cname) == 0 || len(cname) > 128 { return maf_api_error(400, "name required (max 128 chars)") }
        if len(cpin) > 32 { return maf_api_error(400, "pin too long (max 32 chars)") }
        let mut cmax = 10
        if len(cmax_str) > 0 { match parse_int(cmax_str) { Ok(v) => { cmax = v } Err(_) => {} } }
        if cmax < 2 || cmax > 500 { return maf_api_error(400, "max_participants must be 2-500") }
        let rec_bool = if str_eq(crecord, "true") { "true" } else { "false" }
        let mute_bool = if str_eq(cmuted, "true") { "true" } else { "false" }
        let tenant = maf_api_tenant()
        let packed = "{\"tenant\":\"" + maf_api_json_escape(tenant) + "\",\"name\":\"" + maf_api_json_escape(cname) + "\",\"pin\":\"" + maf_api_json_escape(cpin) + "\",\"max\":" + string(cmax) + ",\"record\":" + rec_bool + ",\"muted\":" + mute_bool + "}"
        let c_id = sql_query_str2(db, "INSERT INTO maf_conferences (tenant_id, name, pin, max_participants, record, muted_on_join) VALUES ($1::jsonb->>'tenant', $1::jsonb->>'name', $1::jsonb->>'pin', ($1::jsonb->>'max')::int, ($1::jsonb->>'record')::boolean, ($1::jsonb->>'muted')::boolean) RETURNING conference_id::text", packed, "")
        if len(c_id) == 0 { return maf_api_error(409, "conference create failed (duplicate name?)") }
        return http_resp(201, "application/json", "{\"ok\":true,\"conference_id\":" + c_id + "}\n", "Cache-Control: no-store\r\n")
    }
    // GET /admin/api/v1/maf/conferences — list conferences
    if kind == 88 {
        let scope = maf_api_scope(raw, n)
        if scope < 1 { return maf_api_error(401, "authentication required") }
        if ok == 0 { return maf_api_error(503, "database unavailable") }
        let tenant = maf_api_tenant()
        let rows = tbl_query_param(db, ok, "SELECT json_build_object('conference_id',conference_id,'name',name,'pin',CASE WHEN length(pin)>0 THEN '***' ELSE '' END,'max_participants',max_participants,'record',record,'muted_on_join',muted_on_join,'enabled',enabled,'created_at',created_at)::text FROM maf_conferences WHERE tenant_id = $1 ORDER BY name", tenant, 200)
        let mut out = "{\"schema\":\"madis.maf.conferences.v1\",\"conferences\":["
        let mut i = 0
        while i < len(rows) {
            if i > 0 { out = out + "," }
            out = out + rows[i]
            i = i + 1
        }
        return http_resp(200, "application/json", out + "]}\n", "Cache-Control: no-store\r\n")
    }
    // GET /admin/api/v1/maf/routing/intelligence — view gateway scores
    if kind == 89 {
        let scope = maf_api_scope(raw, n)
        if scope < 1 { return maf_api_error(401, "authentication required") }
        // Read gateway stats registry and build JSON array
        let mut out = "{\"schema\":\"madis.maf.routing.intelligence.v1\",\"gateways\":["
        let mut entries = make([]string, 0, 64)
        if cmap_has(cache, "gw_stats_reg") == 1 {
            entries = str_split(cmap_get(cache, "gw_stats_reg"), ",")
        }
        let mut i = 0
        let mut first = 1
        while i < len(entries) {
            let entry = entries[i]
            // entry format: gateway|prefix
            let sep = str_index(entry, "|")
            let mut gw = entry
            let mut pfx = ""
            if sep > 0 { gw = entry[0:sep]; pfx = entry[sep + 1:] }
            let cache_key = "gw_stats|" + gw + "|" + pfx
            if cmap_has(cache, cache_key) == 0 { i = i + 1; continue }
            let raw_val = cmap_get(cache, cache_key)
            let mut attempts = 0
            let mut ans = 0
            let mut dur = 0
            let mut pdd_total = 0
            let p1 = str_index(raw_val, "|")
            if p1 > 0 {
                match parse_int(raw_val[0:p1]) { Ok(v) => { attempts = v } Err(_) => {} }
                let r1 = raw_val[p1 + 1:]
                let p2 = str_index(r1, "|")
                if p2 > 0 {
                    match parse_int(r1[0:p2]) { Ok(v) => { ans = v } Err(_) => {} }
                    let r2 = r1[p2 + 1:]
                    let p3 = str_index(r2, "|")
                    if p3 > 0 {
                        match parse_int(r2[0:p3]) { Ok(v) => { dur = v } Err(_) => {} }
                        match parse_int(r2[p3 + 1:]) { Ok(v) => { pdd_total = v } Err(_) => {} }
                    }
                }
            }
            let score = routing_gateway_score(cache, gw, pfx)
            let mut asr_pct = 0
            if attempts > 0 { asr_pct = (ans * 100) / attempts }
            let mut acd_avg = 0
            if ans > 0 { acd_avg = dur / ans }
            let mut pdd_avg = 0
            if attempts > 0 { pdd_avg = pdd_total / attempts }
            if first == 0 { out = out + "," }
            first = 0
            out = out + "{\"gateway\":\"" + maf_api_json_escape(gw) + "\",\"prefix\":\"" + maf_api_json_escape(pfx) + "\",\"score\":" + string(score) + ",\"attempts\":" + string(attempts) + ",\"asr_pct\":" + string(asr_pct) + ",\"acd_avg_sec\":" + string(acd_avg) + ",\"pdd_avg_ms\":" + string(pdd_avg) + "}"
            i = i + 1
        }
        return http_resp(200, "application/json", out + "]}\n", "Cache-Control: no-store\r\n")
    }
    // POST /admin/api/v1/maf/routing/intelligence/record — manually record outcome
    if kind == 90 {
        let scope = maf_api_scope(raw, n)
        if scope < 1 { return maf_api_error(401, "authentication required") }
        let body = http_body(raw, n)
        let gw = json_get_string(body, "gateway")
        let pfx = json_get_string(body, "prefix")
        if len(gw) == 0 { return maf_api_error(400, "gateway required") }
        let mut answered = 0
        let mut duration_sec = 0
        let mut pdd_ms = 0
        if str_eq(json_get_string(body, "answered"), "true") || str_contains(body, "\"answered\":true") { answered = 1 }
        match parse_int(json_get_string(body, "duration_sec")) { Ok(v) => { duration_sec = v } Err(_) => {} }
        match parse_int(json_get_string(body, "pdd_ms")) { Ok(v) => { pdd_ms = v } Err(_) => {} }
        let _ = routing_record_outcome(cache, gw, pfx, answered, duration_sec, pdd_ms)
        let score = routing_gateway_score(cache, gw, pfx)
        return http_resp(200, "application/json", "{\"ok\":true,\"score\":" + string(score) + "}\n", "Cache-Control: no-store\r\n")
    }
    return maf_api_error(404, "not found")
}
