    }
    // POST /admin/api/v1/maf/number — upsert number intelligence
    if kind == 78 {
        let scope = maf_api_scope(raw, n)
        if scope < 2 { return maf_api_error(if scope == 0 { 401 } else { 403 }, "write scope required") }
        if ok == 0 { return maf_api_error(503, "database unavailable") }
        if maf_api_body_ok(raw, n, 1) == 0 { return maf_api_error(400, "application/json body required") }
        let body = parse_body(raw, n)
        let number = str_trim_space(json_get_string(body, "number"))
        let carrier = str_trim_space(json_get_string(body, "carrier"))
        let ntype = str_trim_space(json_get_string(body, "type"))
        let country = str_trim_space(json_get_string(body, "country"))
        let spam_str = str_trim_space(json_get_string(body, "spam_score"))
        if len(number) == 0 || len(number) > 32 { return maf_api_error(400, "number required (max 32 chars)") }
        if len(carrier) > 128 || len(ntype) > 32 || len(country) > 8 { return maf_api_error(400, "field too long") }
        let mut spam_score = 0
        if len(spam_str) > 0 { match parse_int(spam_str) { Ok(v) => { spam_score = v } Err(_) => {} } }
        if spam_score < 0 || spam_score > 100 { return maf_api_error(400, "spam_score must be 0-100") }
        let packed = "{\"number\":\"" + maf_api_json_escape(number) + "\",\"carrier\":\"" + maf_api_json_escape(carrier) + "\",\"type\":\"" + maf_api_json_escape(ntype) + "\",\"country\":\"" + maf_api_json_escape(country) + "\",\"spam_score\":" + string(spam_score) + "}"
        let rc = sql_exec_str4(db, "INSERT INTO number_intelligence (number, carrier, type, country, spam_score, updated_at) VALUES ($1::jsonb->>'number', $1::jsonb->>'carrier', $1::jsonb->>'type', $1::jsonb->>'country', ($1::jsonb->>'spam_score')::int, NOW()) ON CONFLICT (number) DO UPDATE SET carrier = EXCLUDED.carrier, type = EXCLUDED.type, country = EXCLUDED.country, spam_score = EXCLUDED.spam_score, updated_at = NOW()", packed, "", "", "")
        if rc < 0 { return maf_api_error(500, "upsert failed") }
        return http_resp(201, "application/json", "{\"ok\":true,\"number\":\"" + maf_api_json_escape(number) + "\"}\n", "Cache-Control: no-store\r\n")
    }
