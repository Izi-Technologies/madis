        if maf_api_body_ok(raw, n, 1) == 0 { return maf_api_error(400, "application/json body required") }
        let body = parse_body(raw, n)
        let from_uri = str_trim_space(json_get_string(body, "from"))
        let to_uri = str_trim_space(json_get_string(body, "to"))
        let scheduled_at = str_trim_space(json_get_string(body, "scheduled_at"))
        let app_data = json_get_string(body, "application_data")
        if maf_api_sip_uri_ok(from_uri) == 0 { return maf_api_error(400, "valid from SIP URI required") }
        if maf_api_sip_uri_ok(to_uri) == 0 { return maf_api_error(400, "valid to SIP URI required") }
        if len(scheduled_at) == 0 || len(scheduled_at) > 64 { return maf_api_error(400, "scheduled_at required (ISO 8601)") }
        let mut ad = if len(app_data) > 0 && int(app_data[0]) == 123 { app_data } else { "{}" }
        if len(ad) > 8192 { return maf_api_error(400, "application_data exceeds 8KB limit") }
        let tenant = maf_api_tenant()
        let packed = "{\"tenant\":\"" + maf_api_json_escape(tenant) + "\",\"from\":\"" + maf_api_json_escape(from_uri) + "\",\"to\":\"" + maf_api_json_escape(to_uri) + "\",\"at\":\"" + maf_api_json_escape(scheduled_at) + "\",\"ad\":" + ad + "}"
        let sched_id = sql_query_str2(db, "INSERT INTO maf_scheduled_calls (tenant_id, from_uri, to_uri, scheduled_at, application_data) SELECT $1::jsonb->>'tenant', $1::jsonb->>'from', $1::jsonb->>'to', ($1::jsonb->>'at')::timestamp, ($1::jsonb->'ad')::jsonb WHERE ($1::jsonb->>'at')::timestamp > NOW() RETURNING schedule_id::text", packed, "")
        if len(sched_id) == 0 { return maf_api_error(400, "scheduled_at must be in the future or invalid timestamp") }
        return http_resp(201, "application/json", "{\"ok\":true,\"schedule_id\":" + sched_id + "}\n", "Cache-Control: no-store\r\n")
    }
