        let body = parse_body(raw, n)
        let steps = json_get_string(body, "steps")
        if len(steps) < 2 || int(steps[0]) != 91 { return maf_api_error(400, "steps must be a JSON array") }
        if len(steps) > 16384 { return maf_api_error(400, "flow definition exceeds 16KB limit") }
        let call_id = maf_api_call_id(path, "flow")
        let tenant = maf_api_tenant()
        let flow_json = "{\"call_flow\":{\"steps\":" + steps + "},\"flow_step\":0}"
        let rc = sql_exec_str4(db, "UPDATE maf_calls SET application_data = application_data || $2::jsonb, updated_at = NOW() WHERE tenant_id = $1 AND call_id = $3", tenant, flow_json, call_id, "")
        if rc <= 0 { return maf_api_error(if rc == 0 { 404 } else { 500 }, if rc == 0 { "call not found" } else { "flow update failed" }) }
        return http_resp(200, "application/json", "{\"ok\":true,\"call_id\":\"" + maf_api_json_escape(call_id) + "\",\"flow_steps\":" + steps + "}\n", "Cache-Control: no-store\r\n")
    }
