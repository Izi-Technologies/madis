        let selector_type = if str_eq(selector_type_raw, "source_ip") || str_eq(selector_type_raw, "target") || str_eq(selector_type_raw, "tenant") { selector_type_raw } else { "global" }
        let selector_value = json_get_string(body, "selector_value")
        if len(selector_value) > 256 || maf_api_text_safe(selector_value, 256) == 0 { return maf_api_error(400, "selector_value is invalid") }
        let mut max_active = json_get_int(body, "max_active_calls")
        let mut max_cps = json_get_int(body, "max_cps")
        let mut reject_code = json_get_int(body, "reject_sip_code")
        if max_active < 0 { max_active = 0 }
        if max_active > 1000000 { max_active = 1000000 }
        if max_cps < 0 { max_cps = 0 }
        if max_cps > 100000 { max_cps = 100000 }
        if reject_code < 300 || reject_code > 699 { reject_code = 503 }
        let enabled_raw = str_to_lower(str_trim_space(json_get_string(body, "enabled")))
