        let wh_id = sql_query_str2(db, "INSERT INTO maf_webhooks (tenant_id, url, events_json, secret) VALUES ($1::jsonb->>'tenant', $1::jsonb->>'url', ($1::jsonb->'events')::jsonb, $1::jsonb->>'secret') RETURNING webhook_id::text", packed, "")
        if len(wh_id) == 0 { return maf_api_error(500, "webhook create failed") }
        return http_resp(201, "application/json", "{\"ok\":true,\"webhook_id\":" + wh_id + "}\n", "Cache-Control: no-store\r\n")
