        let rc = sql_exec_str4(db, "INSERT INTO gateways (tenant_id, name, address, port, transport) VALUES (($1::jsonb->>'tenant_id'), ($1::jsonb->>'name'), ($1::jsonb->>'address'), ($1::jsonb->>'port')::int, ($1::jsonb->>'transport')) ON CONFLICT (name) DO UPDATE SET address = ($1::jsonb->>'address'), port = ($1::jsonb->>'port')::int, transport = ($1::jsonb->>'transport')", packed, "", "", "")
