        let rc = sql_exec_str4(db, "UPDATE maf_calls SET application_data = application_data || $2::jsonb, updated_at = NOW() WHERE tenant_id = $1 AND call_id = $3", tenant, tags, call_id, "")
        if rc <= 0 { return maf_api_error(if rc == 0 { 404 } else { 500 }, if rc == 0 { "call not found" } else { "tag update failed" }) }
        return http_resp(200, "application/json", "{\"ok\":true,\"call_id\":\"" + maf_api_json_escape(call_id) + "\"}\n", "Cache-Control: no-store\r\n")
    }
