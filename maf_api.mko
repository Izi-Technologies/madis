        let body = parse_body(raw, n)
        let tags = json_get_string(body, "tags")
        if len(tags) == 0 || int(tags[0]) != 123 { return maf_api_error(400, "tags must be a JSON object") }
        if len(tags) > 4096 { return maf_api_error(400, "tags exceed 4KB limit") }
        let call_id = maf_api_call_id(path, "tags")
