    // POST /admin/api/v1/maf/config — set config key
    if kind == 36 {
        let scope = maf_api_scope(raw, n)
        if scope < 2 { return maf_api_error(if scope == 0 { 401 } else { 403 }, "write scope required") }
        if ok == 0 { return maf_api_error(503, "database unavailable") }
        if maf_api_body_ok(raw, n, 1) == 0 { return maf_api_error(400, "application/json body required") }
        let body = parse_body(raw, n)
        let cfg_key = json_get_string(body, "key")
        let cfg_value = json_get_string(body, "value")
        if len(cfg_key) == 0 || len(cfg_key) > 128 || len(cfg_value) > 4096 { return maf_api_error(400, "key and value required") }
        if str_index(cfg_value, "\x01") >= 0 { return maf_api_error(400, "config value contains invalid bytes") }
        if maf_api_identifier_ok(cfg_key, 1, 128) == 0 { return maf_api_error(400, "invalid config key") }
        // Allowlist: only permit config keys that are safe for MAF to modify.
        // All other keys (TLS paths, credentials, DB URLs, etc.) are blocked.
        // Allowlist: operator-configurable runtime settings. Process-level
        // settings (bind IP, ports, worker counts, DB URLs, TLS paths, private
        // keys) are excluded — they require a restart or are security-sensitive.
        let maf_cfg_ok = str_has_prefix(cfg_key, "rtpengine_") || str_has_prefix(cfg_key, "security_") || str_has_prefix(cfg_key, "stir_shaken_enabled") || str_has_prefix(cfg_key, "stir_shaken_attestation") || str_has_prefix(cfg_key, "stir_shaken_cert_url") || str_has_prefix(cfg_key, "stir_shaken_mode") || str_has_prefix(cfg_key, "sip_realm") || str_has_prefix(cfg_key, "sip_rate_limit") || str_has_prefix(cfg_key, "sip_invite_rate_limit") || str_has_prefix(cfg_key, "sip_register_rate_limit") || str_has_prefix(cfg_key, "sip_max_message_size") || str_has_prefix(cfg_key, "sip_fraud_prefixes") || str_has_prefix(cfg_key, "sip_scanner_ua_list") || str_has_prefix(cfg_key, "sip_emergency") || str_has_prefix(cfg_key, "sip_digest_algorithm") || str_has_prefix(cfg_key, "sip_session_timer") || str_has_prefix(cfg_key, "sip_max_reg_expires") || str_has_prefix(cfg_key, "sip_min_expires") || str_has_prefix(cfg_key, "sip_user_rate_limit") || str_has_prefix(cfg_key, "sip_conn_idle_timeout") || str_has_prefix(cfg_key, "sip_per_ip_conn_limit") || str_has_prefix(cfg_key, "sip_call_state_capacity") || str_has_prefix(cfg_key, "sip_outbound") || str_has_prefix(cfg_key, "sip_event_package") || str_has_prefix(cfg_key, "sip_tls_reuse") || str_has_prefix(cfg_key, "sip_b2bua") || str_has_prefix(cfg_key, "sip_cluster") || str_has_prefix(cfg_key, "sip_hep_") || str_has_prefix(cfg_key, "sip_ims_")
        if not maf_cfg_ok { return maf_api_error(403, "config key not in MAF allowlist") }
        let desc = json_get_string(body, "description")
        let tenant = maf_api_tenant()
        let packed = "{\"tenant_id\":\"" + maf_api_json_escape(tenant) + "\",\"key\":\"" + maf_api_json_escape(cfg_key) + "\",\"value\":\"" + maf_api_json_escape(cfg_value) + "\",\"description\":\"" + maf_api_json_escape(desc) + "\"}"
        let rc = sql_exec_str4(db, "INSERT INTO config (tenant_id, key, value, description) VALUES (($1::jsonb->>'tenant_id'), ($1::jsonb->>'key'), ($1::jsonb->>'value'), ($1::jsonb->>'description')) ON CONFLICT (key) DO UPDATE SET value = ($1::jsonb->>'value'), description = COALESCE(NULLIF(($1::jsonb->>'description'),''), config.description)", packed, "", "", "")
        if rc < 0 { return maf_api_error(500, "config update failed") }
        return http_resp(200, "application/json", "{\"ok\":true,\"key\":\"" + maf_api_json_escape(cfg_key) + "\"}\n", "Cache-Control: no-store\r\n")
    }
