        if ok == 0 { return maf_api_error(503, "database unavailable") }
        let number = path[len("/admin/api/v1/maf/number/"):]
        if len(number) == 0 || len(number) > 32 { return maf_api_error(400, "invalid number") }
        let result = sql_query_str2(db, "SELECT json_build_object('number',number,'carrier',carrier,'type',type,'country',country,'spam_score',spam_score,'updated_at',updated_at)::text FROM number_intelligence WHERE number = $1", number, "")
        if len(result) == 0 { return maf_api_error(404, "number not found") }
