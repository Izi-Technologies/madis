        let rc = sql_exec_str4(db, "INSERT INTO maf_capacity_policies (tenant_id,name,selector_type,selector_value,max_active_calls,max_cps,reject_sip_code,enabled) SELECT $1::jsonb->>'tenant_id',$1::jsonb->>'name',$1::jsonb->>'selector_type',$1::jsonb->>'selector_value',($1::jsonb->>'max_active_calls')::int,($1::jsonb->>'max_cps')::int,($1::jsonb->>'reject_sip_code')::int,($1::jsonb->>'enabled')::boolean ON CONFLICT (tenant_id,name) DO UPDATE SET selector_type=EXCLUDED.selector_type,selector_value=EXCLUDED.selector_value,max_active_calls=EXCLUDED.max_active_calls,max_cps=EXCLUDED.max_cps,reject_sip_code=EXCLUDED.reject_sip_code,enabled=EXCLUDED.enabled,updated_at=NOW()", packed, "", "", "")
