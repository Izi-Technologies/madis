// ============ CLUSTER CALL STATE ============
// Replicate confirmed dialog bindings to PostgreSQL so a surviving node can
// send BYE for calls owned by a failed node. This is not real-time
// replication — it syncs confirmed dialogs every heartbeat tick.
//
// The table holds the minimum state needed for call teardown:
// call_id, dialog_dst (where to send BYE), transport, node_id, and
// confirmed_at timestamp. A surviving node queries this table when it
// receives a BYE/CANCEL for an unknown Call-ID.

fn cluster_call_state_enabled() -> int {
    let v = env_get_or("SIP_CLUSTER_CALLS", "0") |> str_trim_space() |> str_to_lower()
    if str_eq(v, "1") || str_eq(v, "true") { return 1 }
    return 0
}

fn cluster_call_bootstrap(db: SqlDB) -> int {
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS cluster_calls (call_id TEXT NOT NULL, node_id TEXT NOT NULL, dialog_dst TEXT NOT NULL DEFAULT '', transport TEXT NOT NULL DEFAULT 'udp', from_tag TEXT NOT NULL DEFAULT '', to_tag TEXT NOT NULL DEFAULT '', confirmed_at TIMESTAMP DEFAULT NOW(), PRIMARY KEY (call_id, node_id))")
    let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_cluster_calls_node ON cluster_calls (node_id, confirmed_at)")
    return 1
}

// Sync confirmed dialogs from CMap to PG. Runs in the heartbeat loop.
// Scans the calls CMap for confirmed dialogs and upserts them.
fn cluster_call_sync(calls: CMap, cache: CMap, db: SqlDB, db_ok: int, node_id: string) -> int {
    if db_ok == 0 || cluster_call_state_enabled() == 0 { return 0 }
    let now = mono_ms()
    let mut last = 0
    if cmap_has(cache, "cluster_sync_at") == 1 {
        match parse_int(cmap_get(cache, "cluster_sync_at")) { Ok(v) => { last = v } Err(_) => {} }
    }
    // Sync every 5s
    if last > 0 && now - last < 5000 { return 0 }
    cmap_set(cache, "cluster_sync_at", string(now))

    // Scan call_state_ring for confirmed dialogs
    let mut synced = 0
    let mut i = 0
    while i < 262144 && synced < 256 {
        let ring_key = "call_state_ring|" + string(i)
        if cmap_has(cache, ring_key) == 1 {
            let key = cmap_get(cache, ring_key)
            if len(key) > 7 && str_has_prefix(key, "dialog|") {
                if cmap_has(calls, key) == 1 {
                    let value = cmap_get(calls, key)
                    if str_has_prefix(value, "confirmed|") {
                        // Extract call_id from dialog key
                        let dialog_id = key[7:]
                        let pipe = str_index(dialog_id, "|")
                        let call_id = if pipe > 0 { dialog_id[0:pipe] } else { dialog_id }
                        // Get dialog destination
                        let dst_key = "dialog_dst|" + call_id
                        let mut dialog_dst = ""
                        if cmap_has(cache, dst_key) == 1 { dialog_dst = cmap_get(cache, dst_key) }
                        if len(call_id) > 0 && len(dialog_dst) > 0 {
                            let _ = sql_exec_str4(db, "INSERT INTO cluster_calls (call_id, node_id, dialog_dst, confirmed_at) VALUES ($1, $2, $3, NOW()) ON CONFLICT (call_id, node_id) DO UPDATE SET dialog_dst = $3, confirmed_at = NOW()", call_id, node_id, dialog_dst, "")
                            synced = synced + 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }

    // Clean up calls that are no longer active on this node
    let _ = sql_exec_str4(db, "DELETE FROM cluster_calls WHERE node_id = $1 AND confirmed_at < NOW() - INTERVAL '30 seconds'", node_id, "", "", "")

    return synced
}

// Look up a dialog destination for a call owned by a failed node.
// Called when we receive BYE/CANCEL for an unknown Call-ID.
fn cluster_call_lookup(db: SqlDB, db_ok: int, call_id: string) -> string {
    if db_ok == 0 || cluster_call_state_enabled() == 0 { return "" }
    return sql_query_str(db, "SELECT dialog_dst FROM cluster_calls WHERE call_id = $1 AND confirmed_at > NOW() - INTERVAL '1 hour' ORDER BY confirmed_at DESC LIMIT 1", call_id)
}

// Clean up all calls for a failed node (called from heartbeat when a node
// goes stale).
fn cluster_call_cleanup_node(db: SqlDB, db_ok: int, node_id: string) -> int {
    if db_ok == 0 || cluster_call_state_enabled() == 0 { return 0 }
    let _ = sql_exec_str4(db, "DELETE FROM cluster_calls WHERE node_id = $1", node_id, "", "", "")
    return 1
}
