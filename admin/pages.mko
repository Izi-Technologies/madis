// Probe local sipproxy with SIP OPTIONS. Returns "up", "down", or "error".
// Via must include the ephemeral source port so the 200 OK is routed back to us.
fn js_esc(s: string) -> string {
    let mut out = s
    out = str_replace(out, "\\", "\\\\")
    out = str_replace(out, "'", "\\'")
    out = str_replace(out, "\r", "\\r")
    out = str_replace(out, "\n", "\\n")
    return out
}

fn sip_options_probe() -> string {
    let fd = udp_bind_addr("127.0.0.1", 0)
    if fd < 0 { return "down" }
    let _ = io_set_nonblocking(fd, 1)
    let lport = udp_local_port(fd)
    if lport <= 0 {
        let _ = udp_close(fd)
        return "down"
    }
    let msg = "OPTIONS sip:127.0.0.1 SIP/2.0\r\nVia: SIP/2.0/UDP 127.0.0.1:" + string(lport) + ";branch=z9hG4bK-admin-health;rport\r\nFrom: <sip:admin@health>;tag=h1\r\nTo: <sip:127.0.0.1>\r\nCall-ID: admin-health-probe\r\nCSeq: 1 OPTIONS\r\nMax-Forwards: 70\r\nContent-Length: 0\r\n\r\n"
    let _ = udp_send_to(fd, "127.0.0.1", 5060, msg)
    let ready = io_read_ready(fd, 800)
    let mut status = "down"
    if ready > 0 {
        let resp = udp_recv(fd, 2048)
        if str_has_prefix(resp, "SIP/2.0 200") {
            status = "up"
        } else {
            if len(resp) > 0 { status = "error" }
        }
    }
    let _ = udp_close(fd)
    return status
}

// Fetch from sipproxy metrics HTTP (loopback). path e.g. /stats.json /dialogs /metrics
fn fetch_metrics_path(path: string) -> string {
    let host = env_get_or("SIP_METRICS_HOST", "127.0.0.1")
    let mut port = 9090
    match parse_int(env_get_or("SIP_METRICS_PORT", "9090")) {
        Ok(v) => { port = v }
        Err(_) => { port = 9090 }
    }
    if port < 1 || port > 65535 { return "" }
    let c = tcp_connect(host, port)
    if c < 0 { return "" }
    let _ = tcp_set_timeout(c, 800)
    let _ = tcp_write(c, "GET " + path + " HTTP/1.0\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    let raw = tcp_read(c)
    let _ = tcp_close(c)
    let sep = str_index(raw, "\r\n\r\n")
    if sep < 0 { return "" }
    return raw[sep + 4:]
}

fn fetch_metrics_json() -> string {
    return fetch_metrics_path("/stats.json")
}

fn fetch_dialogs_json() -> string {
    return fetch_metrics_path("/dialogs")
}

fn json_num(js: string, key: string) -> string {
    // naive "key":123 extractor
    let needle = "\"" + key + "\":"
    let i = str_index(js, needle)
    if i < 0 { return "0" }
    let s = i + len(needle)
    let mut e = s
    while e < len(js) {
        let ch = int(js[e])
        if ch >= 48 {
            if ch <= 57 { e = e + 1; continue }
        }
        if ch == 45 {
            if e == s { e = e + 1; continue }
        }
        break
    }
    if e <= s { return "0" }
    return js[s:e]
}

// Escape a string for JSON string values (quotes + backslash + control chars → space).
fn json_esc(s: string) -> string {
    let mut b = str_builder()
    let n = len(s)
    let mut i = 0
    while i < n {
        let c = int(s[i])
        if c == 34 {
            builder_write(b, "\\\"")
        } else {
            if c == 92 {
                builder_write(b, "\\\\")
            } else {
                if c < 32 {
                    builder_write(b, " ")
                } else {
                    builder_write_byte(b, byte(c))
                }
            }
        }
        i = i + 1
    }
    return builder_string(b)
}

// Keep dashboard counts to one database round trip. The dashboard is a read
// path, so returning a stable pipe-delimited row is considerably cheaper than
// opening eight query plans for every live refresh.
fn dashboard_counts(db: SqlDB, ok: int) -> string {
    if ok == 0 { return "0|0|0|0|0|0|0|0" }
    return sql_query_str(db, "SELECT (SELECT COUNT(*)::text FROM registrations WHERE expires_at IS NULL OR expires_at > NOW()) || '|' || (SELECT COUNT(*)::text FROM users WHERE enabled = true) || '|' || (SELECT COUNT(*)::text FROM gateways WHERE enabled = true) || '|' || (SELECT COUNT(*)::text FROM routes WHERE enabled = true) || '|' || (SELECT COUNT(*)::text FROM dids WHERE enabled = true) || '|' || (SELECT COUNT(*)::text FROM cluster_nodes WHERE status = 'active') || '|' || (SELECT COUNT(*)::text FROM cdr WHERE started_at > NOW() - INTERVAL '24 hours') || '|' || (SELECT COUNT(*)::text FROM access_control WHERE enabled = true)", "")
}

// Compact live snapshot for WebSocket dashboard push (JSON object).
// sip is edge health: "up" | "down" | "error" (caller caches OPTIONS probe).
fn live_snapshot_json(db: SqlDB, ok: int, sip: string) -> string {
    let mut r = "0"
    let mut u = "0"
    let mut g = "0"
    let mut rt = "0"
    let mut d = "0"
    let mut n = "0"
    let mut c = "0"
    let mut ac = "0"
    let count_parts = str_split(dashboard_counts(db, ok), "|")
    if len(count_parts) >= 8 {
        r = count_parts[0]
        u = count_parts[1]
        g = count_parts[2]
        rt = count_parts[3]
        d = count_parts[4]
        n = count_parts[5]
        c = count_parts[6]
        ac = count_parts[7]
    }
    let mut sip_s = sip
    if len(sip_s) == 0 { sip_s = "down" }
    let live = fetch_metrics_json()
    let mut pkts = "0"
    let mut inv = "0"
    let mut active = "0"
    let mut done = "0"
    let mut regok = "0"
    let mut offline = "0"
    let mut authf = "0"
    let mut davg = "0"
    let mut metrics_ok = 0
    if len(live) > 2 {
        metrics_ok = 1
        inv = json_num(live, "invite")
        regok = json_num(live, "register_ok")
        done = json_num(live, "completed")
        active = json_num(live, "active_calls")
        offline = json_num(live, "offline")
        authf = json_num(live, "auth_fail")
        pkts = json_num(live, "packets")
        davg = json_num(live, "duration_avg_sec")
    }
    return "{\"type\":\"snapshot\""
        + ",\"ts\":" + string(now_ms())
        + ",\"sip\":\"" + json_esc(sip_s) + "\""
        + ",\"online\":" + r
        + ",\"users\":" + u
        + ",\"gateways\":" + g
        + ",\"routes\":" + rt
        + ",\"dids\":" + d
        + ",\"access\":" + ac
        + ",\"calls24h\":" + c
        + ",\"nodes\":" + n
        + ",\"metrics_ok\":" + string(metrics_ok)
        + ",\"packets\":" + pkts
        + ",\"register_ok\":" + regok
        + ",\"invite\":" + inv
        + ",\"completed\":" + done
        + ",\"active\":" + active
        + ",\"duration_avg\":" + davg
        + ",\"offline\":" + offline
        + ",\"auth_fail\":" + authf
        + "}"
}

// A short process-wide cache prevents every connected browser from rerunning
// the same Postgres and metrics work. The dashboard still emits once per
// second, but the expensive snapshot is refreshed at most every 3 seconds.
fn live_snapshot_cached(db: SqlDB, ok: int, sip: string, cache: CMap) -> string {
    let now = now_ms()
    if cmap_has(cache, "snapshot") == 1 && cmap_has(cache, "snapshot_at") == 1 {
        let mut at = 0
        match parse_int(cmap_get(cache, "snapshot_at")) { Ok(v) => { at = v } Err(_) => {} }
        if at > 0 && now >= at && now - at < 3000 {
            return cmap_get(cache, "snapshot")
        }
    }
    let body = live_snapshot_json(db, ok, sip)
    cmap_set(cache, "snapshot", body)
    cmap_set(cache, "snapshot_at", string(now))
    return body
}

// Authenticated WebSocket live feed: push snapshot ~1s until client disconnects.
// Opens its own Postgres connection (SqlDB is not kick-sendable).
// Push-only: client close is detected when ws_send_text fails (avoids blocking on ws_recv).
fn ws_live_session(fd: int, db_url: string, live_cache: CMap) -> int {
    let _ = io_set_nonblocking(fd, 0)
    let _ = tcp_nodelay(fd)
    // Bound send so a half-open peer cannot hang the worker forever
    let _ = tcp_set_timeout(fd, 5000)
    let mut db_ok = 0
    let mut db = sql_open_postgres("")
    if len(db_url) > 0 {
        db = sql_open_postgres(db_url)
        db_ok = 1
    }
    let mut alive = 1
    let mut tick = 0
    let mut sip = "down"
    while alive == 1 {
        // OPTIONS probe is relatively heavy — refresh every ~5s
        if tick % 5 == 0 {
            sip = sip_options_probe()
        }
        let snap = live_snapshot_cached(db, db_ok, sip, live_cache)
        let rc = ws_send_text(fd, snap)
        if rc < 0 {
            alive = 0
        } else {
            sleep_ms(1000)
            tick = tick + 1
            // Cap session length: browser reconnects cleanly (prevents runaway workers)
            if tick > 3600 {
                alive = 0
            }
        }
    }
    let _ = ws_send_close(fd, 1000, "")
    let _ = ws_close(fd)
    if db_ok == 1 {
        let _ = sql_close(db)
    }
    return 0
}

fn f_dashboard(db: SqlDB, ok: int) -> string {
    let mut r = "0"
    let mut u = "0"
    let mut g = "0"
    let mut rt = "0"
    let mut d = "0"
    let mut n = "0"
    let mut c = "0"
    let mut ac = "0"
    let mut realm = env_get_or("SIP_REALM", "mako.local")
    let mut pubip = env_get_or("SIP_PUBLIC_IP", "")
    // Prefer FQDN when available (matches sipproxy resolve_sip_realm)
    let mut fqdn = env_get_or("SIP_PUBLIC_HOST", "")
    if len(fqdn) == 0 { fqdn = env_get_or("SIP_DOMAIN", "") }
    if len(fqdn) == 0 { fqdn = env_get_or("SIP_FQDN", "") }
    if len(fqdn) > 0 {
        if len(realm) == 0 { realm = fqdn }
        if str_eq(realm, "mako.local") { realm = fqdn }
    }
    if ok == 1 {
        // Online = not expired (honor expires_at). Do not use register_ok metric (cumulative 200s).
        let count_parts = str_split(dashboard_counts(db, ok), "|")
        if len(count_parts) >= 8 {
            r = count_parts[0]
            u = count_parts[1]
            g = count_parts[2]
            rt = count_parts[3]
            d = count_parts[4]
            n = count_parts[5]
            c = count_parts[6]
            ac = count_parts[7]
        }
        let cr = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "sip_realm")
        // Prefer env/FQDN; only use DB if still placeholder
        if len(cr) > 0 {
            if str_eq(realm, "mako.local") { realm = cr }
            if len(realm) == 0 { realm = cr }
        }
        let ci = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "sip_public_ip")
        if len(ci) > 0 { pubip = ci }
    }
    // The live WebSocket/HTTP snapshot updates this badge immediately after
    // first paint. Do not block the initial HTML response on an 800ms probe.
    let sip = "down"
    let mut sip_badge = "<span id=\"dash-sip-badge\" class=\"badge r\"><span class=\"status-dot down\"></span>DOWN</span>"
    let mut sip_note = "Checking live SIP edge health…"
    let mut sip_glow = "rgba(248,113,113,.15)"
    if str_eq(sip, "up") {
        sip_badge = "<span id=\"dash-sip-badge\" class=\"badge g\"><span class=\"status-dot up\"></span>OPERATIONAL</span>"
        sip_note = "OPTIONS 200 OK · edge is healthy"
        sip_glow = "rgba(34,211,238,.18)"
    }
    if str_eq(sip, "error") {
        sip_badge = "<span id=\"dash-sip-badge\" class=\"badge y\">DEGRADED</span>"
        sip_note = "Got a SIP reply that was not 200 OK"
        sip_glow = "rgba(251,191,36,.15)"
    }
    if len(pubip) == 0 { pubip = "(set sip_public_ip in Config)" }

    // Metrics are also delivered by the live snapshot. Avoid a second blocking
    // loopback connection during the initial page render.
    let live = ""
    let mut pkts = "0"
    let mut inv = "0"
    let mut active = "0"
    let mut done = "0"
    let mut regok = "0"
    let mut offline = "0"
    let mut authf = "0"
    let mut davg = "0"
    let mut metrics_ok = 0
    if len(live) > 2 {
        metrics_ok = 1
        inv = json_num(live, "invite")
        regok = json_num(live, "register_ok")
        done = json_num(live, "completed")
        active = json_num(live, "active_calls")
        offline = json_num(live, "offline")
        authf = json_num(live, "auth_fail")
        pkts = json_num(live, "packets")
        davg = json_num(live, "duration_avg_sec")
    }
    let live_stats = "<div class=\"stats\" style=\"margin:0\" id=\"dash-metrics-stats\">"
        + "<div class=\"stat-card blue\"><div class=\"label\">Packets</div><div class=\"value\" data-live=\"packets\">" + pkts + "</div></div>"
        + "<div class=\"stat-card green\"><div class=\"label\">REGISTER OK</div><div class=\"value\" data-live=\"register_ok\">" + regok + "</div></div>"
        + "<div class=\"stat-card purple\"><div class=\"label\">INVITE</div><div class=\"value\" data-live=\"invite\">" + inv + "</div></div>"
        + "<div class=\"stat-card orange\"><div class=\"label\">Completed</div><div class=\"value\" data-live=\"completed\">" + done + "</div></div>"
        + "<div class=\"stat-card pink\"><div class=\"label\">Active now</div><div class=\"value\" data-live=\"active\">" + active + "</div></div>"
        + "<div class=\"stat-card blue\"><div class=\"label\">Avg call</div><div class=\"value\"><span data-live=\"duration_avg\">" + davg + "</span>s</div></div>"
        + "<div class=\"stat-card orange\"><div class=\"label\">Offline</div><div class=\"value\" data-live=\"offline\">" + offline + "</div></div>"
        + "<div class=\"stat-card pink\"><div class=\"label\">Auth fail</div><div class=\"value\" data-live=\"auth_fail\">" + authf + "</div></div>"
        + "</div>"
    let mut live_card = ""
    if metrics_ok == 0 {
        live_card = "<div class=\"card\" id=\"dash-live-telemetry\"><div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px\"><h2 style=\"margin:0\">Live edge telemetry <span id=\"dash-metrics-badge\" class=\"badge y\">WAITING</span></h2><a class=\"btn sm ghost\" hx-get=\"/admin/metrics\" hx-target=\"#c\">Open metrics →</a></div><p id=\"dash-metrics-note\" style=\"color:var(--muted);font-size:13px\">Live telemetry is loading; counters will appear as soon as the WebSocket connects.</p>"
            + str_replace(live_stats, "style=\"margin:0\"", "style=\"margin:0;display:none\"") + "</div>"
    } else {
        live_card = "<div class=\"card\" id=\"dash-live-telemetry\"><div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px\"><h2 style=\"margin:0\">Live edge telemetry <span id=\"dash-metrics-badge\" class=\"badge g\">LIVE</span></h2><a class=\"btn sm ghost\" hx-get=\"/admin/metrics\" hx-target=\"#c\">Open metrics →</a></div>"
            + live_stats + "</div>"
    }

    let mut tips = ""
    if str_eq(u, "0") {
        tips = tips + "<li>Add a <a hx-get=\"/admin/users\" hx-target=\"#c\">SIP user</a> for softphone registration.</li>"
    }
    if str_eq(g, "0") {
        tips = tips + "<li>Add a <a hx-get=\"/admin/gateways\" hx-target=\"#c\">gateway</a> for outbound termination.</li>"
    }
    if str_eq(rt, "0") {
        tips = tips + "<li>Add a <a hx-get=\"/admin/routing\" hx-target=\"#c\">route</a> (e.g. prefix <code>*</code>) to a gateway.</li>"
    }
    if str_eq(ac, "0") {
        tips = tips + "<li>Add an <a hx-get=\"/admin/access\" hx-target=\"#c\">access control</a> rule (allow <code>*</code>) so policy is explicit.</li>"
    }
    let mut tips_card = ""
    if len(tips) > 0 {
        tips_card = "<div class=\"card\"><h2>Quick start</h2><ul style=\"margin-left:18px;color:var(--muted);font-size:13px;line-height:1.85\">" + tips + "</ul></div>"
    }

    let hero = "<div class=\"card\" id=\"dash-hero\" style=\"padding:26px;background:linear-gradient(135deg,rgba(15,23,42,.9),rgba(8,47,73,.55));border-color:rgba(34,211,238,.2);box-shadow:0 0 0 1px rgba(34,211,238,.08),0 20px 60px " + sip_glow + "\"><div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap\"><div><div style=\"font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--faint);margin-bottom:8px\">Edge status</div><div style=\"display:flex;align-items:center;gap:10px;margin-bottom:8px\">" + sip_badge + "<span style=\"font-size:20px;font-weight:700;letter-spacing:-.02em\">Mako SIP Proxy</span></div><p id=\"dash-sip-note\" style=\"color:var(--muted);font-size:13.5px;max-width:520px\">" + sip_note + "</p></div><div style=\"display:flex;gap:8px;flex-wrap:wrap\"><a class=\"btn sm\" hx-get=\"/admin/dialogs\" hx-target=\"#c\">Active dialogs</a><a class=\"btn sm ghost\" hx-get=\"/admin/transactions\" hx-target=\"#c\">SIP trace</a></div></div>"
        + "<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-top:20px\">"
        + "<div style=\"padding:12px 14px;border-radius:12px;background:rgba(2,6,23,.4);border:1px solid var(--border)\"><div style=\"font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.08em\">Realm</div><div style=\"margin-top:4px\"><code>" + html_esc(realm) + "</code></div></div>"
        + "<div style=\"padding:12px 14px;border-radius:12px;background:rgba(2,6,23,.4);border:1px solid var(--border)\"><div style=\"font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.08em\">Public IP</div><div style=\"margin-top:4px\"><code>" + html_esc(pubip) + "</code></div></div>"
        + "<div style=\"padding:12px 14px;border-radius:12px;background:rgba(2,6,23,.4);border:1px solid var(--border)\"><div style=\"font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.08em\">UDP / TCP</div><div style=\"margin-top:4px\"><code>:5060</code></div></div>"
        + "<div style=\"padding:12px 14px;border-radius:12px;background:rgba(2,6,23,.4);border:1px solid var(--border)\"><div style=\"font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.08em\">TLS / WSS</div><div style=\"margin-top:4px\"><code>:5061 · :8443</code></div></div>"
        + "</div></div>"

    let client_card = "<div class=\"card\"><h2>Client / softphone settings</h2>"
        + "<p style=\"color:var(--muted);font-size:13px;margin-bottom:12px\">Point any SIP UA (Linphone, MicroSIP, Zoiper, etc.) at this edge. No built-in softphone — external clients only.</p>"
        + "<table><tr><th>Setting</th><th>Value</th></tr>"
        + "<tr><td>Domain / realm</td><td><code>" + html_esc(realm) + "</code></td></tr>"
        + "<tr><td>Proxy host</td><td><code>proxy.mako-lang.com</code> or <code>" + html_esc(pubip) + "</code></td></tr>"
        + "<tr><td>UDP / TCP</td><td><code>5060</code></td></tr>"
        + "<tr><td>TLS (SIPS)</td><td><code>5061</code></td></tr>"
        + "<tr><td>WSS (behind leba TLS)</td><td><code>8443</code> internal · public WSS via HTTPS reverse proxy</td></tr>"
        + "<tr><td>Auth</td><td>Digest · users from <a hx-get=\"/admin/users\" hx-target=\"#c\">SIP Users</a></td></tr>"
        + "<tr><td>Media</td><td>rtpengine ports <code>30000–40000/udp</code> (SDP rewritten to public IP)</td></tr>"
        + "<tr><td>DTMF</td><td>RFC 4733 <code>telephone-event</code> in RTP (via rtpengine) · SIP INFO <code>application/dtmf-relay</code> mid-dialog (proxy transparent)</td></tr>"
        + "</table>"
        + "<p style=\"color:var(--faint);font-size:12px;margin-top:12px\">Prometheus: session cookie <code>GET /admin/api/prom</code> or bearer <code>ADMIN_METRICS_TOKEN</code> → <code>/admin/api/prom?token=…</code></p>"
        + "</div>"

    // Ops panels: failed CDRs, auth fails, gateway health
    let mut fail_rows = ""
    let fails = tbl_query(db, ok, "SELECT call_id || '|' || COALESCE(caller,'') || '|' || COALESCE(callee,'') || '|' || COALESCE(status,'') || '|' || to_char(started_at,'HH24:MI:SS') FROM cdr WHERE status LIKE '%NOT_FOUND%' OR status LIKE '%REJECT%' OR status = 'OFFLINE' OR status LIKE '%CANCEL%' ORDER BY started_at DESC", 8)
    let mut fi = 0
    while fi < len(fails) {
        let fp = str_split(fails[fi], "|")
        if len(fp) >= 5 {
            fail_rows = fail_rows + "<tr><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(fp[4]) + "</td><td><strong>" + html_esc(fp[1]) + "</strong> → " + html_esc(fp[2]) + "</td><td><span class=\"badge r\">" + html_esc(fp[3]) + "</span></td>"
                + "<td><a class=\"btn sm\" hx-get=\"/admin/transactions?cid=" + html_esc(fp[0]) + "\" hx-target=\"#c\" hx-push-url=\"true\">Trace</a></td></tr>"
        }
        fi = fi + 1
    }
    if len(fail_rows) == 0 { fail_rows = "<tr><td colspan=\"4\" style=\"color:var(--muted);text-align:center;padding:16px\">No recent failures</td></tr>" }

    let mut auth_rows = ""
    let auths = tbl_query(db, ok, "SELECT to_char(ts,'HH24:MI:SS') || '|' || COALESCE(source_ip,'') || '|' || COALESCE(sip_user,'') || '|' || COALESCE(severity,'') FROM security_events WHERE event_type LIKE '%auth%' OR event_type = 'auth_failure' ORDER BY ts DESC", 8)
    let mut ai = 0
    while ai < len(auths) {
        let ap = str_split(auths[ai], "|")
        if len(ap) >= 3 {
            auth_rows = auth_rows + "<tr><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(ap[0]) + "</td><td><code>" + html_esc(ap[1]) + "</code></td><td>" + html_esc(ap[2]) + "</td><td><span class=\"badge y\">" + html_esc(ap[3]) + "</span></td></tr>"
        }
        ai = ai + 1
    }
    if len(auth_rows) == 0 { auth_rows = "<tr><td colspan=\"4\" style=\"color:var(--muted);text-align:center;padding:16px\">No recent auth failures</td></tr>" }

    let mut gw_rows = ""
    let gws = tbl_query(db, ok, "SELECT name || '|' || address || ':' || port || '|' || COALESCE(health_status,'unknown') || '|' || COALESCE(last_health_code::text,'') || '|' || COALESCE(to_char(last_health_check,'HH24:MI:SS'),'') FROM gateways WHERE enabled = true ORDER BY name", 20)
    let mut gi = 0
    while gi < len(gws) {
        let gp = str_split(gws[gi], "|")
        if len(gp) >= 3 {
            let mut hb = "y"
            if str_eq(gp[2], "up") { hb = "g" }
            if str_eq(gp[2], "down") { hb = "r" }
            gw_rows = gw_rows + "<tr><td><strong>" + html_esc(gp[0]) + "</strong></td><td style=\"font-size:12px\"><code>" + html_esc(gp[1]) + "</code></td><td><span class=\"badge " + hb + "\">" + html_esc(gp[2]) + "</span></td><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(gp[3]) + " @ " + html_esc(gp[4]) + "</td></tr>"
        }
        gi = gi + 1
    }
    if len(gw_rows) == 0 { gw_rows = "<tr><td colspan=\"4\" style=\"color:var(--muted);text-align:center;padding:16px\">No enabled gateways</td></tr>" }

    let ops = "<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;margin-bottom:16px\">"
        + "<div class=\"card\" style=\"margin:0\"><h2>Recent failures</h2><table><tr><th>Time</th><th>Parties</th><th>Status</th><th></th></tr>" + fail_rows + "</table></div>"
        + "<div class=\"card\" style=\"margin:0\"><h2>Auth failures</h2><table><tr><th>Time</th><th>IP</th><th>User</th><th>Sev</th></tr>" + auth_rows + "</table>"
        + "<div style=\"margin-top:10px\"><a class=\"btn sm ghost\" hx-get=\"/admin/security\" hx-target=\"#c\">Security →</a></div></div>"
        + "<div class=\"card\" style=\"margin:0\"><h2>Gateway health</h2><table><tr><th>Name</th><th>Addr</th><th>Status</th><th>Probe</th></tr>" + gw_rows + "</table>"
        + "<div style=\"margin-top:10px\"><a class=\"btn sm ghost\" hx-get=\"/admin/gateways\" hx-target=\"#c\">Gateways →</a> "
        + "<a class=\"btn sm ghost\" hx-get=\"/admin/simulate\" hx-target=\"#c\">Simulate route →</a></div></div>"
        + "</div>"

    return "<div data-ws-live=\"/admin/ws/live\">"
        + "<div class=\"topbar\"><div><h1>Command center</h1><div style=\"color:var(--faint);font-size:12px;margin-top:4px\">Real-time control plane · WebSocket</div></div>"
        + "<div class=\"user\"><span id=\"dash-ws-badge\" class=\"badge y\">CONNECTING</span> <span class=\"badge b\">prod</span> softphone domain <code>" + html_esc(realm) + "</code></div></div>"
        + hero + live_card + ops + client_card + tips_card
        + "<div class=\"stats\">"
        + "<div class=\"stat-card blue\"><div class=\"label\">Online now</div><div class=\"value\" data-live=\"online\">" + r + "</div></div>"
        + "<div class=\"stat-card green\"><div class=\"label\">SIP Users</div><div class=\"value\" data-live=\"users\">" + u + "</div></div>"
        + "<div class=\"stat-card orange\"><div class=\"label\">Gateways</div><div class=\"value\" data-live=\"gateways\">" + g + "</div></div>"
        + "<div class=\"stat-card purple\"><div class=\"label\">Routes</div><div class=\"value\" data-live=\"routes\">" + rt + "</div></div>"
        + "<div class=\"stat-card pink\"><div class=\"label\">DIDs</div><div class=\"value\" data-live=\"dids\">" + d + "</div></div>"
        + "<div class=\"stat-card blue\"><div class=\"label\">Access rules</div><div class=\"value\" data-live=\"access\">" + ac + "</div></div>"
        + "<div class=\"stat-card green\"><div class=\"label\">Calls (24h)</div><div class=\"value\" data-live=\"calls24h\">" + c + "</div></div>"
        + "<div class=\"stat-card purple\"><div class=\"label\">Cluster nodes</div><div class=\"value\" data-live=\"nodes\">" + n + "</div></div>"
        + "</div></div>"
}

// Dashboard HTML is identical for all authenticated roles. Keep a short
// process-wide copy so opening or refreshing the command center does not
// rerun its table queries for every browser request.
fn f_dashboard_cached(db: SqlDB, ok: int, cache: CMap) -> string {
    let now = now_ms()
    if cmap_has(cache, "html") == 1 && cmap_has(cache, "html_at") == 1 {
        let mut at = 0
        match parse_int(cmap_get(cache, "html_at")) { Ok(v) => { at = v } Err(_) => {} }
        if at > 0 && now >= at && now - at < 3000 {
            return cmap_get(cache, "html")
        }
    }
    let body = f_dashboard(db, ok)
    cmap_set(cache, "html", body)
    cmap_set(cache, "html_at", string(now))
    return body
}

fn f_metrics(db: SqlDB, ok: int) -> string {
    let mut live = fetch_metrics_json()
    let mut host = env_get_or("SIP_METRICS_HOST", "127.0.0.1")
    let mut port = env_get_or("SIP_METRICS_PORT", "9090")
    host = html_esc(host)
    port = html_esc(port)
    if len(live) < 2 {
        return "<div class=\"topbar\"><h1>Live Metrics</h1></div><div class=\"card\"><p style=\"color:var(--muted)\">Could not reach sipproxy metrics at <code>" + host + ":" + port + "</code>. Ensure mako-sip is running and <code>SIP_METRICS_PORT</code> matches.</p></div>"
    }
    let inv = json_num(live, "invite")
    let regok = json_num(live, "register_ok")
    let done = json_num(live, "completed")
    let active = json_num(live, "active_calls")
    let offline = json_num(live, "offline")
    let authf = json_num(live, "auth_fail")
    let pkts = json_num(live, "packets")
    let bye = json_num(live, "bye")
    let opts = json_num(live, "options")
    let resp = json_num(live, "responses")
    let cancel = json_num(live, "cancelled")
    let nf = json_num(live, "not_found")
    let local = json_num(live, "local_call")
    let davg = json_num(live, "duration_avg_sec")
    let dmax = json_num(live, "duration_max_sec")
    let rtpok = json_num(live, "rtp_ok")
    let rtpf = json_num(live, "rtp_fail")
    let msgc = json_num(live, "message")
    let refc = json_num(live, "refer")
    let infoc = json_num(live, "info")
    let upd = json_num(live, "update")
    let prk = json_num(live, "prack")
    let mut rtp_en = "false"
    let mut rtp_host = "127.0.0.1"
    let mut rtp_port = "2223"
    if ok == 1 {
        let e = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "rtpengine_enabled")
        let h = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "rtpengine_host")
        let p = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "rtpengine_port")
        if len(e) > 0 { rtp_en = e }
        if len(h) > 0 { rtp_host = h }
        if len(p) > 0 { rtp_port = p }
    }
    let mut rtp_badge = "y"
    let mut rtp_label = "off (SDP NAT only)"
    if str_eq(rtp_en, "true") {
        rtp_badge = "g"
        rtp_label = "on → " + rtp_host + ":" + rtp_port
    }
    if str_eq(rtp_en, "1") {
        rtp_badge = "g"
        rtp_label = "on → " + rtp_host + ":" + rtp_port
    }
    live = html_esc(live)
    let rtp_card = "<div class=\"card\" style=\"margin-bottom:14px\"><div style=\"display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px\"><div><strong>Media path</strong><div style=\"color:var(--muted);font-size:13px;margin-top:4px\">rtpengine <span class=\"badge " + rtp_badge + "\">" + html_esc(rtp_label) + "</span> · offer/answer ok <strong>" + rtpok + "</strong> · fail <strong>" + rtpf + "</strong></div></div><div style=\"font-size:12px;color:var(--muted)\">RTP UDP ports 30000–40000 · toggle via Config <code>rtpengine_enabled</code></div></div></div>"
    return "<div hx-get=\"/admin/metrics\" hx-trigger=\"every 5s\" hx-swap=\"outerHTML\"><div class=\"topbar\"><h1>Live Metrics</h1><div class=\"user\">Auto-refresh 5s · " + host + ":" + port + " · counters since process start (not concurrent users)</div></div>" + rtp_card + "<div class=\"stats\"><div class=\"stat-card blue\"><div class=\"label\">Packets</div><div class=\"value\">" + pkts + "</div></div><div class=\"stat-card green\"><div class=\"label\">REGISTER 200s</div><div class=\"value\">" + regok + "</div></div><div class=\"stat-card purple\"><div class=\"label\">INVITE</div><div class=\"value\">" + inv + "</div></div><div class=\"stat-card green\"><div class=\"label\">Local calls</div><div class=\"value\">" + local + "</div></div><div class=\"stat-card orange\"><div class=\"label\">Completed</div><div class=\"value\">" + done + "</div></div><div class=\"stat-card pink\"><div class=\"label\">Active</div><div class=\"value\">" + active + "</div></div><div class=\"stat-card blue\"><div class=\"label\">Avg duration</div><div class=\"value\">" + davg + "s</div></div><div class=\"stat-card orange\"><div class=\"label\">Max duration</div><div class=\"value\">" + dmax + "s</div></div><div class=\"stat-card green\"><div class=\"label\">RTP ok</div><div class=\"value\">" + rtpok + "</div></div><div class=\"stat-card orange\"><div class=\"label\">RTP fail</div><div class=\"value\">" + rtpf + "</div></div><div class=\"stat-card blue\"><div class=\"label\">INFO (DTMF)</div><div class=\"value\">" + infoc + "</div></div><div class=\"stat-card purple\"><div class=\"label\">UPDATE</div><div class=\"value\">" + upd + "</div></div><div class=\"stat-card green\"><div class=\"label\">PRACK</div><div class=\"value\">" + prk + "</div></div><div class=\"stat-card blue\"><div class=\"label\">MESSAGE</div><div class=\"value\">" + msgc + "</div></div><div class=\"stat-card purple\"><div class=\"label\">REFER</div><div class=\"value\">" + refc + "</div></div><div class=\"stat-card orange\"><div class=\"label\">Offline</div><div class=\"value\">" + offline + "</div></div><div class=\"stat-card pink\"><div class=\"label\">Auth fail</div><div class=\"value\">" + authf + "</div></div><div class=\"stat-card blue\"><div class=\"label\">BYE</div><div class=\"value\">" + bye + "</div></div><div class=\"stat-card purple\"><div class=\"label\">OPTIONS</div><div class=\"value\">" + opts + "</div></div><div class=\"stat-card blue\"><div class=\"label\">Responses</div><div class=\"value\">" + resp + "</div></div><div class=\"stat-card orange\"><div class=\"label\">Cancelled</div><div class=\"value\">" + cancel + "</div></div><div class=\"stat-card pink\"><div class=\"label\">Not found</div><div class=\"value\">" + nf + "</div></div></div><div class=\"card\"><h2>Prometheus scrape</h2><p style=\"color:var(--muted);font-size:13px;margin-bottom:8px\">Loopback on the proxy host, or use the auth-proxied admin path below from outside.</p><pre style=\"background:rgba(2,6,23,.45);padding:12px;border-radius:8px;font-size:12px;overflow:auto\"># on the SIP host
curl http://" + host + ":" + port + "/metrics

# via admin (session cookie required) — also good for leba
# GET /admin/api/prom  → Prometheus text
# GET /admin/api/dialogs → active dialogs JSON</pre></div><div class=\"card\"><h2>Raw JSON</h2><pre style=\"background:rgba(2,6,23,.8);color:#cbd5e1;padding:12px;border-radius:8px;font-size:12px;overflow:auto\">" + live + "</pre></div></div>"
}

fn f_dialogs(db: SqlDB, ok: int) -> string {
    let raw = fetch_dialogs_json()
    let host = env_get_or("SIP_METRICS_HOST", "127.0.0.1")
    let port = env_get_or("SIP_METRICS_PORT", "9090")
    if len(raw) < 2 {
        return "<div class=\"topbar\"><h1>Active Dialogs</h1></div><div class=\"card\"><p style=\"color:var(--muted)\">No dialog data — is mako-sip up on " + html_esc(host) + ":" + html_esc(port) + "?</p></div>"
    }
    let mut rows = ""
    let mut n = 0
    let parts = str_split(raw, "{")
    let mut i = 1
    while i < len(parts) {
        let obj = parts[i]
        let cid = json_str_field(obj, "call_id")
        let caller = json_str_field(obj, "caller")
        let callee = json_str_field(obj, "callee")
        let status = json_str_field(obj, "status")
        let age = json_num("{" + obj, "age_sec")
        let src = json_str_field(obj, "src")
        let dst = json_str_field(obj, "dst")
        if len(cid) > 0 {
            let mut b = "b"
            if str_eq(status, "ANSWERED") { b = "g" }
            if str_eq(status, "RINGING") { b = "y" }
            if str_eq(status, "PROGRESS") { b = "y" }
            rows = rows + "<tr><td><code style=\"font-size:11px\">" + html_esc(cid) + "</code></td><td><strong>" + html_esc(caller) + "</strong></td><td>" + html_esc(callee) + "</td><td><span class=\"badge " + b + "\">" + html_esc(status) + "</span></td><td>" + html_esc(age) + "s</td><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(src) + "</td><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(dst) + "</td><td><button class=\"btn sm r\" hx-post=\"/admin/api/dialog_clear\" hx-vals='{\"id\":\"" + html_esc(cid) + "\"}' hx-target=\"#c\" hx-confirm=\"Clear this dialog from the live table?\">Clear</button></td></tr>"
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 {
        rows = "<tr><td colspan=\"8\" style=\"color:var(--muted);text-align:center;padding:24px\">No active dialogs right now</td></tr>"
    }
    let mut clear_all = ""
    if n > 0 {
        clear_all = "<button class=\"btn sm r\" style=\"margin-left:8px\" hx-post=\"/admin/api/dialog_clear\" hx-vals='{\"all\":\"1\"}' hx-target=\"#c\" hx-confirm=\"Clear ALL live dialogs?\">Clear all</button>"
    }
    return "<div hx-get=\"/admin/dialogs\" hx-trigger=\"every 3s\" hx-swap=\"outerHTML\"><div class=\"topbar\"><h1>Active Dialogs</h1><div class=\"user\">" + string(n) + " live · refresh 3s" + clear_all + "</div></div><div class=\"card\"><p style=\"color:var(--muted);font-size:13px;margin-bottom:12px\">In-memory dialogs on the SIP proxy (ring of last 64). Status advances LOCAL → RINGING → ANSWERED. Clear removes stuck entries from the live table (does not send SIP BYE).</p><table><tr><th>Call-ID</th><th>Caller</th><th>Callee</th><th>Status</th><th>Age</th><th>Src</th><th>Dst</th><th></th></tr>" + rows + "</table></div></div>"
}

// Badge color for SIP method / response code label.
fn tx_method_badge(method: string) -> string {
    if str_has_prefix(method, "INVITE") { return "b" }
    if str_has_prefix(method, "ACK") { return "g" }
    if str_has_prefix(method, "BYE") { return "y" }
    if str_has_prefix(method, "CANCEL") { return "y" }
    if str_has_prefix(method, "REGISTER") { return "g" }
    if str_has_prefix(method, "100") { return "b" }
    if str_has_prefix(method, "180") { return "y" }
    if str_has_prefix(method, "183") { return "y" }
    if str_has_prefix(method, "200") { return "g" }
    if str_has_prefix(method, "202") { return "g" }
    if str_has_prefix(method, "401") { return "y" }
    if str_has_prefix(method, "407") { return "y" }
    if str_has_prefix(method, "4") { return "r" }
    if str_has_prefix(method, "5") { return "r" }
    if str_has_prefix(method, "6") { return "r" }
    return "b"
}

// Split "a -> b" hop into sides for the ladder table.
fn tx_flow_left(flow: string) -> string {
    let i = str_index(flow, " -> ")
    if i < 0 { return flow }
    return flow[0:i]
}
fn tx_flow_right(flow: string) -> string {
    let i = str_index(flow, " -> ")
    if i < 0 { return "" }
    return flow[i + 4:]
}

// Outcome label for a finished dialog.
fn tx_outcome(kind: string, last_m: string, saw_bye: int, saw_cancel: int, saw_ok: int, saw_fail: int) -> []string {
    // returns [label, badge]
    let mut out = make([]string, 2)
    out[0] = "In progress"
    out[1] = "b"
    if str_eq(kind, "Register") {
        if saw_ok == 1 { out[0] = "Registered"; out[1] = "g"; return out }
        if saw_fail == 1 { out[0] = "Auth failed"; out[1] = "r"; return out }
        out[0] = "Registering"; out[1] = "y"
        return out
    }
    if saw_cancel == 1 { out[0] = "Cancelled"; out[1] = "y"; return out }
    if saw_bye == 1 {
        if saw_ok == 1 { out[0] = "Completed"; out[1] = "g"; return out }
        out[0] = "Ended"; out[1] = "g"
        return out
    }
    if saw_fail == 1 { out[0] = "Failed"; out[1] = "r"; return out }
    if str_has_prefix(last_m, "180") { out[0] = "Ringing"; out[1] = "y"; return out }
    if str_has_prefix(last_m, "183") { out[0] = "Progress"; out[1] = "y"; return out }
    if str_has_prefix(last_m, "200") {
        if str_eq(kind, "Call") { out[0] = "Answered"; out[1] = "g"; return out }
    }
    if str_has_prefix(last_m, "407") { out[0] = "Auth challenge"; out[1] = "y"; return out }
    if str_has_prefix(last_m, "100") { out[0] = "Trying"; out[1] = "b"; return out }
    return out
}

// SIP Trace: group by Call-ID, organized call cards with expandable timed ladder.
// Query: cid= filter Call-ID, kind=Call|Register|Other, q= free text in call_id/method/source
fn f_transactions(db: SqlDB, ok: int, qstr: string) -> string {
    let filter_cid = query_val(qstr, "cid")
    let filter_kind = query_val(qstr, "kind")
    let filter_q = query_val(qstr, "q")
    let data = tbl_query(db, ok, "SELECT to_char(ts,'HH24:MI:SS') || '|' || COALESCE(call_id,'') || '|' || COALESCE(direction,'') || '|' || COALESCE(method,'') || '|' || COALESCE(replace(source,'|','/'),'') || '|' || to_char(ts,'HH24:MI:SS') || '|' || id::text FROM sip_transactions WHERE COALESCE(call_id,'') <> '' ORDER BY ts DESC, id DESC", 400)

    // Optional CDR context: call_id|caller|callee|status|dur
    let cdrs = tbl_query(db, ok, "SELECT call_id || '|' || COALESCE(caller,'') || '|' || COALESCE(callee,'') || '|' || COALESCE(status,'') || '|' || COALESCE(duration_sec::text,'') FROM cdr ORDER BY started_at DESC", 80)

    let mut cids = make([]string, 0, 64)
    let mut seen = "|"
    let mut di = 0
    while di < len(data) {
        let p = str_split(data[di], "|")
        if len(p) >= 2 {
            let cid = p[1]
            if len(cid) > 0 {
                // Optional Call-ID filter (substring match)
                let mut cid_ok = 1
                if len(filter_cid) > 0 {
                    if str_contains(cid, filter_cid) { cid_ok = 1 } else { cid_ok = 0 }
                }
                if cid_ok == 1 {
                    let key = "|" + cid + "|"
                    if str_contains(seen, key) {
                    } else {
                        seen = seen + cid + "|"
                        cids = append(cids, cid)
                    }
                }
            }
        }
        di = di + 1
        if len(cids) >= 50 { break }
    }

    let mut n_calls = 0
    let mut n_regs = 0
    let mut n_other = 0
    let mut cards = ""
    let mut gi = 0
    while gi < len(cids) {
        let cid = cids[gi]

        // CDR parties
        let mut caller = ""
        let mut callee = ""
        let mut cdr_st = ""
        let mut dur = ""
        let mut ci = 0
        while ci < len(cdrs) {
            let cp = str_split(cdrs[ci], "|")
            if len(cp) >= 1 {
                if str_eq(cp[0], cid) {
                    if len(cp) >= 2 { caller = cp[1] }
                    if len(cp) >= 3 { callee = cp[2] }
                    if len(cp) >= 4 { cdr_st = cp[3] }
                    if len(cp) >= 5 { dur = cp[4] }
                    break
                }
            }
            ci = ci + 1
        }

        let mut legs_rows = ""
        let mut first_m = ""
        let mut last_m = ""
        let mut t0 = ""
        let mut t1 = ""
        let mut nlegs = 0
        let mut saw_invite = 0
        let mut saw_reg = 0
        let mut saw_bye = 0
        let mut saw_cancel = 0
        let mut saw_ok = 0
        let mut saw_fail = 0
        let mut chips = ""
        let mut step = 0

        let mut j = len(data) - 1
        while j >= 0 {
            let p = str_split(data[j], "|")
            if len(p) >= 4 {
                if str_eq(p[1], cid) {
                    let ts = p[0]
                    let dir = p[2]
                    let method = p[3]
                    let mut flow = ""
                    if len(p) >= 5 { flow = p[4] }
                    let safe_ts = html_esc(ts)
                    let safe_method = html_esc(method)
                    if nlegs == 0 {
                        first_m = method
                        t0 = ts
                    }
                    last_m = method
                    t1 = ts
                    nlegs = nlegs + 1
                    step = step + 1

                    if str_has_prefix(method, "INVITE") { saw_invite = 1 }
                    if str_has_prefix(method, "REGISTER") { saw_reg = 1 }
                    if str_eq(method, "BYE") { saw_bye = 1 }
                    if str_eq(method, "CANCEL") { saw_cancel = 1 }
                    if str_has_prefix(method, "200") { saw_ok = 1 }
                    if str_has_prefix(method, "4") {
                        if str_has_prefix(method, "401") {
                        } else {
                            if str_has_prefix(method, "407") {
                            } else { saw_fail = 1 }
                        }
                    }
                    if str_has_prefix(method, "5") { saw_fail = 1 }
                    if str_has_prefix(method, "6") { saw_fail = 1 }

                    // chips (collapsed preview) — key milestones only
                    let mut show_chip = 0
                    if str_has_prefix(method, "INVITE") { show_chip = 1 }
                    if str_has_prefix(method, "REGISTER") { show_chip = 1 }
                    if str_has_prefix(method, "100") { show_chip = 1 }
                    if str_has_prefix(method, "180") { show_chip = 1 }
                    if str_has_prefix(method, "200") { show_chip = 1 }
                    if str_has_prefix(method, "407") { show_chip = 1 }
                    if str_has_prefix(method, "401") { show_chip = 1 }
                    if str_eq(method, "ACK") { show_chip = 1 }
                    if str_eq(method, "BYE") { show_chip = 1 }
                    if str_eq(method, "CANCEL") { show_chip = 1 }
                    if str_has_prefix(method, "4") {
                        if str_has_prefix(method, "40") {
                        } else { show_chip = 1 }
                    }
                    if show_chip == 1 {
                        if len(chips) < 420 {
                            chips = chips + "<span class=\"tx-chip badge " + tx_method_badge(method) + "\">" + safe_method + "</span>"
                        }
                    }

                    let b = tx_method_badge(method)
                    let left = tx_flow_left(flow)
                    let right = tx_flow_right(flow)
                    let safe_left = html_esc(left)
                    let safe_right = html_esc(right)
                    let mut arrow = "→"
                    let mut dir_lbl = "out"
                    let mut dir_cls = "out"
                    if str_eq(dir, "recv") {
                        arrow = "←"
                        dir_lbl = "in"
                        dir_cls = "in"
                    }
                    legs_rows = legs_rows
                        + "<tr class=\"tx-row " + dir_cls + "\">"
                        + "<td class=\"tx-n\">" + string(step) + "</td>"
                        + "<td class=\"tx-t\">" + safe_ts + "</td>"
                        + "<td class=\"tx-dir\"><span class=\"tx-dir-pill " + dir_cls + "\">" + dir_lbl + " " + arrow + "</span></td>"
                        + "<td class=\"tx-m\"><span class=\"badge " + b + "\">" + safe_method + "</span></td>"
                        + "<td class=\"tx-from\"><code>" + safe_left + "</code></td>"
                        + "<td class=\"tx-arr\">→</td>"
                        + "<td class=\"tx-to\"><code>" + safe_right + "</code></td>"
                        + "</tr>"
                }
            }
            j = j - 1
        }

        let mut kind = "Other"
        if saw_invite == 1 { kind = "Call"; n_calls = n_calls + 1 }
        if saw_reg == 1 {
            if saw_invite == 0 { kind = "Register"; n_regs = n_regs + 1 }
        }
        if str_eq(kind, "Other") { n_other = n_other + 1 }

        // Kind filter
        if len(filter_kind) > 0 {
            if str_eq(filter_kind, kind) {
            } else {
                gi = gi + 1
                continue
            }
        }
        // Free-text filter against method chips / cid / parties
        if len(filter_q) > 0 {
            let mut hit = 0
            if str_contains(cid, filter_q) { hit = 1 }
            if str_contains(first_m, filter_q) { hit = 1 }
            if str_contains(last_m, filter_q) { hit = 1 }
            if str_contains(caller, filter_q) { hit = 1 }
            if str_contains(callee, filter_q) { hit = 1 }
            if hit == 0 {
                gi = gi + 1
                continue
            }
        }

        let oc = tx_outcome(kind, last_m, saw_bye, saw_cancel, saw_ok, saw_fail)
        let mut oc_lbl = oc[0]
        let mut oc_b = oc[1]

        // Prefer CDR status when present for calls
        if str_eq(kind, "Call") {
            if str_contains(cdr_st, "COMPLETE") { oc_lbl = "Completed"; oc_b = "g" }
            if str_contains(cdr_st, "CANCEL") { oc_lbl = "Cancelled"; oc_b = "y" }
            if str_contains(cdr_st, "OFFLINE") { oc_lbl = "Offline"; oc_b = "y" }
            if str_contains(cdr_st, "NOT_FOUND") { oc_lbl = "Not found"; oc_b = "r" }
            if str_contains(cdr_st, "REJECT") { oc_lbl = "Rejected"; oc_b = "r" }
            if str_contains(cdr_st, "ANSWER") { oc_lbl = "Answered"; oc_b = "g" }
        }

        let mut parties = ""
        if len(caller) > 0 {
            parties = "<strong>" + html_esc(caller) + "</strong>"
            if len(callee) > 0 { parties = parties + " <span class=\"tx-to-arrow\">→</span> <strong>" + html_esc(callee) + "</strong>" }
        } else {
            if str_eq(kind, "Register") {
                parties = "<span class=\"tx-muted\">Registration</span>"
            } else {
                parties = "<span class=\"tx-muted\">—</span>"
            }
        }

        let mut short_cid = cid
        if len(cid) > 22 {
            short_cid = cid[0:10] + "…" + cid[len(cid) - 6:]
        }

        let mut time_lbl = t0
        if str_eq(t0, t1) {
        } else {
            if len(t1) > 0 { time_lbl = t0 + " – " + t1 }
        }
        let mut dur_lbl = ""
        if len(dur) > 0 { dur_lbl = dur + "s" }

        let mut kind_b = "b"
        if str_eq(kind, "Call") { kind_b = "b" }
        if str_eq(kind, "Register") { kind_b = "g" }
        let mut kind_cls = "other"
        if str_eq(kind, "Call") { kind_cls = "call" }
        if str_eq(kind, "Register") { kind_cls = "register" }

        let mut open_tag = ""
        if len(filter_cid) > 0 {
            if str_contains(cid, filter_cid) { open_tag = " open" }
        }
        cards = cards
            + "<details class=\"tx-call kind-" + kind_cls + "\"" + open_tag + ">"
            + "<summary class=\"tx-sum\">"
            + "<div class=\"tx-sum-main\">"
            + "<span class=\"tx-chev\">▸</span>"
            + "<span class=\"tx-kind badge " + kind_b + "\">" + kind + "</span>"
            + "<span class=\"tx-parties\">" + parties + "</span>"
            + "<span class=\"badge " + oc_b + "\">" + oc_lbl + "</span>"
            + "</div>"
            + "<div class=\"tx-sum-meta\">"
            + "<span class=\"tx-meta\" title=\"" + html_esc(cid) + "\"><code>" + html_esc(short_cid) + "</code></span>"
            + "<span class=\"tx-meta\">" + string(nlegs) + " msgs</span>"
            + "<span class=\"tx-meta\">" + html_esc(time_lbl) + "</span>"
        if len(dur_lbl) > 0 {
            cards = cards + "<span class=\"tx-meta\">" + html_esc(dur_lbl) + "</span>"
        }
        cards = cards
            + "</div>"
            + "<div class=\"tx-chips\">" + chips + "</div>"
            + "</summary>"
            + "<div class=\"tx-ladder\">"
            + "<div class=\"tx-ladder-bar\">"
            + "<div><span class=\"tx-muted\">Call-ID</span> <code class=\"tx-full-cid\">" + html_esc(cid) + "</code> "
            + "<button type=\"button\" class=\"btn sm ghost\" onclick=\"event.preventDefault();event.stopPropagation();copyCid('" + js_esc(cid) + "',this)\">Copy</button></div>"
            + "<div class=\"tx-ladder-legend\"><span class=\"tx-dir-pill in\">in ←</span> from network &nbsp; <span class=\"tx-dir-pill out\">out →</span> toward peer</div>"
            + "</div>"
            + "<div class=\"tx-table-wrap\"><table class=\"tx-table\">"
            + "<thead><tr><th>#</th><th>Time</th><th>Dir</th><th>Message</th><th>From</th><th></th><th>To</th></tr></thead>"
            + "<tbody>" + legs_rows + "</tbody></table></div>"
            + "</div></details>"
        gi = gi + 1
    }

    if len(cards) == 0 {
        cards = "<div class=\"tx-empty\">No matching SIP activity. Clear filters or place a call / register a softphone.</div>"
    }

    let stats = "<div class=\"stats\" style=\"margin-bottom:14px\">"
        + "<div class=\"stat-card purple\"><div class=\"label\">Calls</div><div class=\"value\">" + string(n_calls) + "</div></div>"
        + "<div class=\"stat-card green\"><div class=\"label\">Registers</div><div class=\"value\">" + string(n_regs) + "</div></div>"
        + "<div class=\"stat-card blue\"><div class=\"label\">Other</div><div class=\"value\">" + string(n_other) + "</div></div>"
        + "<div class=\"stat-card orange\"><div class=\"label\">Groups shown</div><div class=\"value\">" + string(len(cids)) + "</div></div>"
        + "</div>"

    // Build refresh URL preserving filters
    let mut refresh = "/admin/transactions"
    let mut qs = ""
    if len(filter_cid) > 0 { qs = qs + "cid=" + filter_cid + "&" }
    if len(filter_kind) > 0 { qs = qs + "kind=" + filter_kind + "&" }
    if len(filter_q) > 0 { qs = qs + "q=" + filter_q + "&" }
    if len(qs) > 0 { refresh = refresh + "?" + qs }

    let mut kind_opts = "<option value=\"\">All</option><option value=\"Call\""
    if str_eq(filter_kind, "Call") { kind_opts = kind_opts + " selected" }
    kind_opts = kind_opts + ">Calls</option><option value=\"Register\""
    if str_eq(filter_kind, "Register") { kind_opts = kind_opts + " selected" }
    kind_opts = kind_opts + ">Registers</option><option value=\"Other\""
    if str_eq(filter_kind, "Other") { kind_opts = kind_opts + " selected" }
    kind_opts = kind_opts + ">Other</option>"

    let filters = "<div class=\"card\" style=\"margin-bottom:12px\"><form class=\"form-row\" style=\"margin:0\" "
        + "hx-get=\"/admin/transactions\" hx-target=\"#c\" hx-push-url=\"true\">"
        + "<div><label>Call-ID</label><input name=\"cid\" value=\"" + html_esc(filter_cid) + "\" placeholder=\"paste Call-ID\"></div>"
        + "<div><label>Kind</label><select name=\"kind\">" + kind_opts + "</select></div>"
        + "<div><label>Search</label><input name=\"q\" value=\"" + html_esc(filter_q) + "\" placeholder=\"user, method…\"></div>"
        + "<div style=\"flex:none\"><label style=\"color:transparent\">.</label><button type=\"submit\">Filter</button></div>"
        + "<div style=\"flex:none\"><label style=\"color:transparent\">.</label>"
        + "<a class=\"btn ghost\" hx-get=\"/admin/transactions\" hx-target=\"#c\" hx-push-url=\"true\">Clear</a></div>"
        + "</form></div>"

    return "<div hx-get=\"" + html_esc(refresh) + "\" hx-trigger=\"every 15s\" hx-swap=\"outerHTML\">"
        + "<div class=\"topbar\"><div><h1>SIP Trace</h1>"
        + "<div style=\"color:var(--faint);font-size:12px;margin-top:4px\">Organized by Call-ID · expand for timed ladder · auto-refresh pauses while a call is open</div></div>"
        + "<div class=\"user\"><span class=\"badge b\">live</span></div></div>"
        + stats + filters
        + "<div class=\"card tx-card\">"
        + "<div class=\"tx-help\">Click a row to expand the full invite ladder. Use <strong>Copy</strong> for Call-ID. Open a CDR and use <strong>Trace</strong> to jump here filtered.</div>"
        + "<div class=\"tx-list\">" + cards + "</div></div></div>"
}

fn json_str_field(obj: string, key: string) -> string {
    let needle = "\"" + key + "\":\""
    let i = str_index(obj, needle)
    if i < 0 { return "" }
    let s = i + len(needle)
    let mut e = s
    while e < len(obj) {
        if int(obj[e]) == 34 { break }
        e = e + 1
    }
    if e <= s { return "" }
    return obj[s:e]
}

fn tbl_query(db: SqlDB, ok: int, sql: string, max: int) -> []string {
    let mut rows = make([]string, 0, max)
    if ok == 0 { return rows }
    // Prefer multi-row cursor (one round-trip). Fall back to OFFSET loop.
    let mut lim = max
    if lim < 1 { lim = 1 }
    if lim > 500 { lim = 500 }
    let q = sql + " LIMIT " + string(lim)
    let rh = sql_query_rows_str(db, q, "")
    if sql_rows_ok(rh) == 1 {
        let mut n = 0
        while sql_rows_next(rh) == 1 {
            let v = sql_rows_str(rh, 0)
            if len(v) == 0 { break }
            rows = append(rows, v)
            n = n + 1
            if n >= lim { break }
        }
        let _ = sql_rows_close(rh)
        return rows
    }
    let _ = sql_rows_close(rh)
    // Fallback for older runtimes / failed cursor
    let mut i = 0
    while i < max {
        let v = sql_query_str(db, sql + " LIMIT 1 OFFSET " + string(i), "")
        if len(v) == 0 { break }
        rows = append(rows, v)
        i = i + 1
    }
    return rows
}

// Parameterized sibling for pages whose filters come from the request or
// from database values. Identifiers stay in static SQL while the value is
// bound through Mako's SQL facade.
fn tbl_query_param(db: SqlDB, ok: int, sql: string, param: string, max: int) -> []string {
    let mut rows = make([]string, 0, max)
    if ok == 0 { return rows }
    let mut lim = max
    if lim < 1 { lim = 1 }
    if lim > 500 { lim = 500 }
    let q = sql + " LIMIT " + string(lim)
    let rh = sql_query_rows_str(db, q, param)
    if sql_rows_ok(rh) == 1 {
        let mut n = 0
        while sql_rows_next(rh) == 1 {
            let v = sql_rows_str(rh, 0)
            if len(v) == 0 { break }
            rows = append(rows, v)
            n = n + 1
            if n >= lim { break }
        }
        let _ = sql_rows_close(rh)
        return rows
    }
    let _ = sql_rows_close(rh)
    let mut i = 0
    while i < max {
        let v = sql_query_str(db, sql + " LIMIT 1 OFFSET " + string(i), param)
        if len(v) == 0 { break }
        rows = append(rows, v)
        i = i + 1
    }
    return rows
}

fn f_users(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT username || '|' || COALESCE(domain,'') || '|' || enabled FROM users ORDER BY id", 50)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 3 {
            let mut b = "g"
            let mut st = "Active"
            if str_eq(p[2], "f") { b = "r"; st = "Disabled" }
            rows = rows + "<tr><td>" + html_esc(p[0]) + "</td><td>" + html_esc(p[1]) + "</td><td><span class=\"badge " + b + "\">" + st + "</span></td><td><button class=\"btn sm\" hx-post=\"/admin/api/toggle\" hx-vals='{\"table\":\"users\",\"key\":\"username\",\"val\":\"" + html_esc(p[0]) + "\"}' hx-target=\"#c\">Toggle</button> <button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"users\",\"key\":\"username\",\"val\":\"" + html_esc(p[0]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete?\">Del</button></td></tr>"
        }
        i = i + 1
    }
    let mut realm = env_get_or("SIP_REALM", "mako.local")
    let mut fqdn = env_get_or("SIP_PUBLIC_HOST", "")
    if len(fqdn) == 0 { fqdn = env_get_or("SIP_DOMAIN", "") }
    if len(fqdn) == 0 { fqdn = env_get_or("SIP_FQDN", "") }
    if len(fqdn) > 0 {
        if len(realm) == 0 { realm = fqdn }
        if str_eq(realm, "mako.local") { realm = fqdn }
    }
    let mut pubip = env_get_or("SIP_PUBLIC_IP", "")
    let mut pubhost = fqdn
    if ok == 1 {
        let cr = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "sip_realm")
        if len(cr) > 0 {
            if str_eq(realm, "mako.local") { realm = cr }
            if len(realm) == 0 { realm = cr }
        }
        let ci = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "sip_public_ip")
        if len(ci) > 0 { pubip = ci }
    }
    if len(pubhost) == 0 { pubhost = pubip }
    if len(pubhost) == 0 { pubhost = "YOUR_SERVER_HOST" }
    if len(pubip) == 0 { pubip = "YOUR_SERVER_IP" }
    let help = "<div class=\"card\"><h2>Softphone setup</h2><p style=\"color:var(--muted);font-size:13px;margin-bottom:10px\">Passwords are stored as SIP digest HA1 (<code>MD5(user:realm:password)</code>), never in plain text. Realm defaults to the public FQDN when set. Re-save a user after realm changes so HA1 is recomputed.</p><table><tr><th>Username</th><td>SIP user from the table below</td></tr><tr><th>Password</th><td>the password you entered when adding the user</td></tr><tr><th>Domain / Realm</th><td><code>" + html_esc(realm) + "</code></td></tr><tr><th>Registrar / Proxy</th><td><code>" + html_esc(pubhost) + "</code> (or <code>" + html_esc(pubip) + "</code>)</td></tr><tr><th>Port</th><td><code>5060</code> (UDP/TCP), <code>5061</code> (TLS), <code>8443</code> (WSS)</td></tr><tr><th>Auth username</th><td>same as Username</td></tr></table></div>"
    return help + "<div class=\"card\"><h2>SIP Users</h2><form hx-post=\"/admin/api/users\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"username\" placeholder=\"Username\" required><input name=\"password\" type=\"password\" placeholder=\"Password (min 6)\" required minlength=\"6\"><input name=\"domain\" placeholder=\"Domain\" value=\"" + html_esc(realm) + "\"><button type=\"submit\">Add / Update User</button></div></form></div><div class=\"card\"><table><tr><th>Username</th><th>Domain</th><th>Enabled</th><th></th></tr>" + rows + "</table></div>"
}

fn f_access(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT source_ip || '|' || COALESCE(sip_user,'*') || '|' || action || '|' || skip_auth || '|' || COALESCE(tenant,'') || '|' || max_channels || '|' || priority || '|' || enabled || '|' || COALESCE(description,'') || '|' || id FROM access_control ORDER BY priority, id", 100)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 10 {
            let mut ab = "g"
            if str_eq(p[2], "deny") { ab = "r" }
            let mut sb = ""
            if str_eq(p[3], "t") { sb = "<span class=\"badge y\">skip auth</span>" }
            let mut eb = "g"
            let mut est = "Active"
            if str_eq(p[7], "f") { eb = "r"; est = "Off" }
            rows = rows + "<tr><td>" + html_esc(p[0]) + "</td><td>" + html_esc(p[1]) + "</td><td><span class=\"badge " + ab + "\">" + html_esc(p[2]) + "</span> " + sb + "</td><td>" + html_esc(p[4]) + "</td><td>" + html_esc(p[5]) + "</td><td>" + html_esc(p[6]) + "</td><td><span class=\"badge " + eb + "\">" + est + "</span></td><td>" + html_esc(p[8]) + "</td><td><button class=\"btn sm\" hx-post=\"/admin/api/toggle\" hx-vals='{\"table\":\"access_control\",\"key\":\"id\",\"val\":\"" + html_esc(p[9]) + "\"}' hx-target=\"#c\">Toggle</button> <button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"access_control\",\"key\":\"id\",\"val\":\"" + html_esc(p[9]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete?\">Del</button></td></tr>"
        }
        i = i + 1
    }
    return "<div class=\"card\"><h2>Access Control</h2><p style=\"color:var(--muted);font-size:12px;margin-bottom:10px\">Manage IP allow/deny, trusted IPs (skip digest auth), per-tenant limits. Evaluated by priority (lowest first).</p><form hx-post=\"/admin/api/access\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"ip\" placeholder=\"Source IP / CIDR\" required value=\"*\"><input name=\"sip_user\" placeholder=\"SIP User (*=any)\" value=\"*\"><select name=\"action\"><option>allow</option><option>deny</option></select><select name=\"skip_auth\"><option value=\"false\">Require Auth</option><option value=\"true\">Skip Auth (IP trusted)</option></select></div><div class=\"form-row\"><input name=\"tenant\" placeholder=\"Tenant\" value=\"default\"><input name=\"max_channels\" placeholder=\"Max Channels\" value=\"0\"><input name=\"priority\" placeholder=\"Priority\" value=\"10\"><input name=\"description\" placeholder=\"Description\"><button type=\"submit\">Add Rule</button></div></form></div><div class=\"card\"><table><tr><th>Source IP</th><th>User</th><th>Action</th><th>Tenant</th><th>Max Ch</th><th>Priority</th><th>Status</th><th>Description</th><th></th></tr>" + rows + "</table></div>"
}

fn f_gateways(db: SqlDB, ok: int) -> string {
    let mut cards = ""
    let data = tbl_query(db, ok, "SELECT name || '|' || address || '|' || port || '|' || COALESCE(transport,'UDP') || '|' || COALESCE(number_format,'e164') || '|' || COALESCE(tech_prefix,'') || '|' || COALESCE(caller_id_override,'') || '|' || COALESCE(enabled::text,'t') || '|' || id || '|' || COALESCE(health_status,'unknown') || '|' || COALESCE(last_health_code::text,'') || '|' || COALESCE(to_char(last_health_check,'HH24:MI:SS'),'') FROM gateways ORDER BY id", 50)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 9 {
            let mut eb = "g"
            let mut est = "Active"
            if str_eq(p[7], "f") { eb = "r"; est = "Disabled" }
            if str_eq(p[7], "false") { eb = "r"; est = "Disabled" }
            let mut hb = "y"
            let mut hs = "unknown"
            if len(p) >= 10 { hs = p[9] }
            if str_eq(hs, "up") { hb = "g" }
            if str_eq(hs, "down") { hb = "r" }
            let mut hcode = ""
            if len(p) >= 11 { hcode = p[10] }
            let mut hwhen = ""
            if len(p) >= 12 { hwhen = p[11] }
            let mut tech_badge = ""
            if len(p[5]) > 0 { tech_badge = " <span class=\"badge y\">prefix: " + html_esc(p[5]) + "</span>" }
            let mut caller_badge = ""
            if len(p[6]) > 0 { caller_badge = " <span class=\"badge b\">CID: " + html_esc(p[6]) + "</span>" }
            cards = cards + "<div style=\"border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:10px;background:rgba(15,23,42,.6)\"><div style=\"display:flex;justify-content:space-between;align-items:start;margin-bottom:8px\"><div><strong style=\"font-size:15px\">" + html_esc(p[0]) + "</strong><div style=\"font-size:12px;color:var(--muted);margin-top:2px\">" + html_esc(p[1]) + ":" + html_esc(p[2]) + " / " + html_esc(p[3]) + "</div></div><div style=\"display:flex;gap:4px;align-items:center;flex-wrap:wrap\"><span class=\"badge " + hb + "\">health: " + html_esc(hs) + "</span><span class=\"badge " + eb + "\">" + est + "</span><button class=\"btn sm\" hx-post=\"/admin/api/gateway_test\" hx-vals='{\"name\":\"" + html_esc(p[0]) + "\"}' hx-target=\"#c\">Test OPTIONS</button><button class=\"btn sm\" hx-post=\"/admin/api/toggle\" hx-vals='{\"table\":\"gateways\",\"key\":\"id\",\"val\":\"" + html_esc(p[8]) + "\"}' hx-target=\"#c\">Toggle</button><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"gateways\",\"key\":\"id\",\"val\":\"" + html_esc(p[8]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete?\">Del</button></div></div><div style=\"font-size:12px;color:var(--muted)\">Last probe: code=" + html_esc(hcode) + " at " + html_esc(hwhen) + "</div><div style=\"font-size:12px;color:var(--muted);margin-top:4px\">Format: <span class=\"badge g\">" + html_esc(p[4]) + "</span>" + tech_badge + caller_badge + "</div><form hx-post=\"/admin/api/gateway_format\" hx-target=\"#c\" style=\"margin-top:10px;padding-top:10px;border-top:1px solid var(--border)\"><input type=\"hidden\" name=\"name\" value=\"" + html_esc(p[0]) + "\"><div class=\"form-row\"><div><label style=\"font-size:11px;color:var(--muted)\">Number Format</label><select name=\"number_format\"><option>e164</option><option>e164_no_plus</option><option>national</option><option>tech_prefix</option></select></div><div><label style=\"font-size:11px;color:var(--muted)\">Tech Prefix</label><input name=\"tech_prefix\" value=\"" + html_esc(p[5]) + "\" placeholder=\"e.g. 0049#\"></div><div><label style=\"font-size:11px;color:var(--muted)\">Caller ID Override</label><input name=\"caller_id\" value=\"" + html_esc(p[6]) + "\" placeholder=\"+15551234567\"></div><div style=\"flex:none\"><label style=\"font-size:11px;color:transparent\">.</label><button type=\"submit\" class=\"btn sm\">Save Format</button></div></div></form></div>"
        }
        i = i + 1
    }
    return "<div class=\"card\"><h2>Gateways / Trunks</h2><p style=\"color:var(--muted);font-size:12px;margin-bottom:10px\">Trunks for outbound routing. Health is probed via OPTIONS (heartbeat + Test button). Number format applies per carrier.</p><form hx-post=\"/admin/api/gateways\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"name\" placeholder=\"Gateway Name\" required><input name=\"address\" placeholder=\"IP / Hostname\" required><input name=\"port\" placeholder=\"Port\" value=\"5060\"><select name=\"transport\"><option>UDP</option><option>TCP</option><option>TLS</option></select><button type=\"submit\">Add Gateway</button></div></form></div><div class=\"card\"><div style=\"display:grid;gap:0\">" + cards + "</div></div>"
}

// Describe a routing action in plain English
fn describe_action(action: string) -> string {
    // Handle ingress+egress combo: "ingress:group1|egress:group2"
    if str_contains(action, "|egress:") {
        let parts = str_split(action, "|")
        let mut ingress_desc = ""
        let mut egress_desc = ""
        let mut pi = 0
        while pi < len(parts) {
            if str_has_prefix(parts[pi], "dispatch:") {
                ingress_desc = parts[pi][9:]
            }
            if str_has_prefix(parts[pi], "ingress:") {
                ingress_desc = parts[pi][8:]
            }
            if str_has_prefix(parts[pi], "egress:") {
                egress_desc = parts[pi][7:]
            }
            pi = pi + 1
        }
        return "<span class=\"badge b\">IN</span> <strong>" + html_esc(ingress_desc) + "</strong> &rarr; <span class=\"badge y\">OUT</span> <strong>" + html_esc(egress_desc) + "</strong>"
    }
    if str_has_prefix(action, "route:") {
        return "<span class=\"badge y\">OUT</span> Send to <strong>" + html_esc(action[6:]) + "</strong>"
    }
    if str_has_prefix(action, "dispatch:") {
        return "Dispatch to <strong>" + html_esc(action[9:]) + "</strong>"
    }
    if str_has_prefix(action, "failover:") {
        return "<span class=\"badge y\">OUT</span> Failover: <strong>" + html_esc(str_replace(action[9:], ",", " → ")) + "</strong>"
    }
    if str_has_prefix(action, "reject:") {
        let parts = str_split(action[7:], ":")
        if len(parts) >= 2 {
            return "<span style=\"color:#ef4444\">Block: " + html_esc(parts[0]) + " " + html_esc(parts[1]) + "</span>"
        }
        return "<span style=\"color:#ef4444\">Block " + html_esc(action[7:]) + "</span>"
    }
    if str_has_prefix(action, "redirect:") {
        return "Redirect to <strong>" + html_esc(action[9:]) + "</strong>"
    }
    if str_has_prefix(action, "forward:") {
        return "Forward to <strong>" + html_esc(action[8:]) + "</strong>"
    }
    if str_eq(action, "lcr") {
        return "<span class=\"badge y\">OUT</span> Least-cost routing"
    }
    if str_eq(action, "continue") {
        return "<span style=\"color:var(--faint)\">Skip (try next rule)</span>"
    }
    return action
}

fn describe_days(days: string) -> string {
    if len(days) == 0 { return "Every day" }
    let mut result = ""
    if str_contains(days, "0") { result = result + "Sun " }
    if str_contains(days, "1") { result = result + "Mon " }
    if str_contains(days, "2") { result = result + "Tue " }
    if str_contains(days, "3") { result = result + "Wed " }
    if str_contains(days, "4") { result = result + "Thu " }
    if str_contains(days, "5") { result = result + "Fri " }
    if str_contains(days, "6") { result = result + "Sat " }
    if str_eq(days, "1,2,3,4,5") { return "Weekdays" }
    if str_eq(days, "0,6") { return "Weekends" }
    return str_trim_space(result)
}

fn f_routing(db: SqlDB, ok: int) -> string {
    // Build existing rules as visual cards
    let mut rule_cards = ""
    let adata = tbl_query(db, ok, "SELECT COALESCE(match_prefix,'') || '|' || COALESCE(match_caller,'') || '|' || COALESCE(match_src_ip,'') || '|' || COALESCE(match_time_start,'') || '|' || COALESCE(match_time_end,'') || '|' || COALESCE(match_day,'') || '|' || action || '|' || priority || '|' || enabled || '|' || COALESCE(description,'') || '|' || id || '|' || COALESCE(match_ani_group,'') FROM routing_rules ORDER BY priority, id", 50)
    let mut ai = 0
    while ai < len(adata) {
        let p = str_split(adata[ai], "|")
        if len(p) >= 12 {
            let mut eb = "g"
            let mut est = "Active"
            if str_eq(p[8], "f") { eb = "r"; est = "Disabled" }

            // Build condition text
            let mut conds = ""
            if len(p[0]) > 0 { conds = conds + "<span class=\"badge b\">Callee: " + html_esc(p[0]) + "*</span> " }
            if len(p[1]) > 0 { conds = conds + "<span class=\"badge b\">Caller: " + html_esc(p[1]) + "*</span> " }
            if len(p[2]) > 0 { conds = conds + "<span class=\"badge y\">IP: " + html_esc(p[2]) + "</span> " }
            if len(p[3]) > 0 { conds = conds + "<span class=\"badge b\">Time: " + html_esc(p[3]) + "-" + html_esc(p[4]) + "</span> " }
            if len(p[5]) > 0 { conds = conds + "<span class=\"badge b\">" + describe_days(p[5]) + "</span> " }
            if len(p[11]) > 0 { conds = conds + "<span class=\"badge y\">ANI: " + html_esc(p[11]) + "</span> " }
            if len(conds) == 0 { conds = "<span class=\"badge b\">All calls</span>" }

            let action_desc = describe_action(p[6])
            let desc = p[9]

            rule_cards = rule_cards + "<div style=\"display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px;background:rgba(2,6,23,.4)\"><div style=\"min-width:36px;text-align:center;font-weight:700;color:var(--faint);font-size:13px\">#" + html_esc(p[7]) + "</div><div style=\"flex:1\"><div style=\"margin-bottom:4px\">" + conds + "</div><div style=\"font-size:14px\">&rarr; " + action_desc + "</div>"

            if len(desc) > 0 {
                rule_cards = rule_cards + "<div style=\"font-size:11px;color:var(--faint);margin-top:2px\">" + desc + "</div>"
            }

            rule_cards = rule_cards + "</div><div style=\"display:flex;gap:4px;align-items:center\"><span class=\"badge " + eb + "\">" + est + "</span><button class=\"btn sm\" hx-post=\"/admin/api/toggle\" hx-vals='{\"table\":\"routing_rules\",\"key\":\"id\",\"val\":\"" + html_esc(p[10]) + "\"}' hx-target=\"#c\">Toggle</button><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"routing_rules\",\"key\":\"id\",\"val\":\"" + html_esc(p[10]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete this rule?\">Del</button></div></div>"
        }
        ai = ai + 1
    }

    // Prefix routes as simple table
    let mut srows = ""
    let sdata = tbl_query(db, ok, "SELECT r.prefix || '|' || COALESCE(g.name,'set:' || COALESCE(r.dispatch_set_id::text,'?')) || '|' || r.priority || '|' || r.cost_per_min || '|' || r.id FROM routes r LEFT JOIN gateways g ON r.gateway_id = g.id ORDER BY r.priority, r.id", 50)
    let mut si = 0
    while si < len(sdata) {
        let p = str_split(sdata[si], "|")
        if len(p) >= 5 {
            srows = srows + "<tr><td><strong>" + html_esc(p[0]) + "</strong></td><td>&rarr; " + html_esc(p[1]) + "</td><td>" + html_esc(p[2]) + "</td><td>$" + html_esc(p[3]) + "</td><td><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"routes\",\"key\":\"id\",\"val\":\"" + html_esc(p[4]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete?\">Del</button></td></tr>"
        }
        si = si + 1
    }

    return "<div class=\"card\"><h2>Call Routing Rules</h2><p style=\"color:var(--muted);font-size:13px;margin-bottom:16px\">Rules are evaluated top-to-bottom by priority. The first matching rule wins. Add conditions to control when a rule applies.</p><form hx-post=\"/admin/api/routing\" hx-target=\"#c\"><div style=\"background:rgba(2,6,23,.45);border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:12px\"><div style=\"font-weight:600;font-size:13px;margin-bottom:10px;color:var(--muted)\">When a call matches...</div><div class=\"form-row\"><div><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">Called number starts with</label><input name=\"prefix\" placeholder=\"e.g. +1, +44, +1800\"></div><div><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">Caller number starts with</label><input name=\"caller\" placeholder=\"e.g. +1212\"></div><div><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">From IP address</label><input name=\"src_ip\" placeholder=\"e.g. 10.0.0.5\"></div><div><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">ANI Group (caller range)</label><input name=\"ani_group\" placeholder=\"e.g. customer_a\"></div></div><div class=\"form-row\"><div><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">Time window</label><div style=\"display:flex;gap:4px;align-items:center\"><input name=\"time_start\" placeholder=\"09:00\" style=\"max-width:80px\"><span style=\"color:var(--faint)\">to</span><input name=\"time_end\" placeholder=\"17:00\" style=\"max-width:80px\"></div></div><div><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">Days of week</label><select name=\"day\"><option value=\"\">Every day</option><option value=\"1,2,3,4,5\">Weekdays</option><option value=\"0,6\">Weekends</option><option value=\"0\">Sunday</option><option value=\"1\">Monday</option><option value=\"2\">Tuesday</option><option value=\"3\">Wednesday</option><option value=\"4\">Thursday</option><option value=\"5\">Friday</option><option value=\"6\">Saturday</option></select></div><div><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">Priority (lower = first)</label><input name=\"priority\" value=\"10\" style=\"max-width:60px\"></div></div><div style=\"font-weight:600;font-size:13px;margin:12px 0 10px;color:var(--muted)\">...then do this:</div><div class=\"form-row\"><div style=\"flex:2\"><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">Action</label><select name=\"action_type\" onchange=\"var v=this.value;var eg=document.getElementById('egress_row');var t=this.form.action_target;if(v=='lcr'||v=='continue'||v=='reject'){t.style.display='none';t.value='';eg.style.display='none';}else{t.style.display='';eg.style.display=(v=='dispatch')?'flex':'none';t.placeholder=v=='route'?'Gateway name':v=='dispatch'?'Ingress dispatch group (e.g. datacenter4)':v=='failover'?'gw1, gw2, gw3':v=='redirect'?'sip:user@host':v=='forward'?'10.0.0.5:5060':'';}\"><option value=\"dispatch\">Dispatch to Server Group</option><option value=\"route\">Send to Carrier/Gateway</option><option value=\"failover\">Failover Chain</option><option value=\"lcr\">Least Cost Routing</option><option value=\"reject\">Reject Call</option><option value=\"redirect\">Redirect (302)</option><option value=\"forward\">Forward to IP</option><option value=\"continue\">Skip (try next rule)</option></select></div><div style=\"flex:2\"><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">Target</label><input name=\"action_target\" placeholder=\"Ingress dispatch group (e.g. datacenter4)\"></div></div><div class=\"form-row\" id=\"egress_row\"><div style=\"flex:2;padding:8px;background:rgba(15,23,42,.6)8e1;border-radius:6px;border:1px solid #ffd54f\"><label style=\"font-size:11px;color:#f57f17;display:block;margin-bottom:3px\">Egress carrier group (optional — for outbound leg)</label><input name=\"egress_target\" placeholder=\"e.g. us_carriers (leave empty if not needed)\" style=\"border-color:#ffd54f\"></div></div><div class=\"form-row\"><div style=\"flex:3\"><label style=\"font-size:11px;color:var(--muted);display:block;margin-bottom:3px\">Description (optional)</label><input name=\"description\" placeholder=\"e.g. US business hours via Twilio\"></div><div style=\"flex:none\"><label style=\"font-size:11px;color:transparent;display:block;margin-bottom:3px\">.</label><button type=\"submit\">Add Rule</button></div></div></div><input type=\"hidden\" name=\"action\" value=\"\"><script>document.querySelector('form[hx-post*=routing]').addEventListener('htmx:configRequest',function(e){var f=e.target;var t=f.querySelector('[name=action_type]').value;var v=f.querySelector('[name=action_target]').value;var eg=f.querySelector('[name=egress_target]');var a=t;if(v)a=t+':'+v;if(eg&&eg.value&&t=='dispatch')a=a+'|egress:'+eg.value;if(t=='reject')a='reject:403:Forbidden';f.querySelector('[name=action]').value=a;})</script></form>" + rule_cards + "</div><div class=\"card\"><h2>Prefix Routes (fallback)</h2><p style=\"color:var(--muted);font-size:12px;margin-bottom:8px\">Simple prefix-to-gateway mapping. Used when no routing rule above matches.</p><form hx-post=\"/admin/api/routes\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"prefix\" placeholder=\"Prefix (*, +1, +44)\" required><input name=\"gateway\" placeholder=\"Gateway Name\"><input name=\"priority\" placeholder=\"Priority\" value=\"10\"><input name=\"cost\" placeholder=\"$/min\" value=\"0\"><button type=\"submit\">Add</button></div></form><table><tr><th>Prefix</th><th>Destination</th><th>Priority</th><th>Cost/min</th><th></th></tr>" + srows + "</table></div>"
}

fn f_dispatch(db: SqlDB, ok: int) -> string {
    // Build a card per dispatch set with its members inline
    let mut set_cards = ""
    let sets = tbl_query(db, ok, "SELECT ds.name || '|' || ds.algorithm || '|' || COALESCE(ds.direction,'egress') || '|' || ds.enabled || '|' || ds.id || '|' || (SELECT COUNT(*) FROM dispatch_members dm WHERE dm.set_id = ds.id AND dm.enabled = true) FROM dispatch_sets ds ORDER BY ds.name", 30)
    let mut si = 0
    while si < len(sets) {
        let p = str_split(sets[si], "|")
        if len(p) >= 6 {
            let mut eb = "g"
            let mut est = "Active"
            if str_eq(p[3], "f") { eb = "r"; est = "Disabled" }
            let mut dir_badge = "b"
            let mut dir_label = "Ingress"
            if str_eq(p[2], "egress") { dir_badge = "y"; dir_label = "Egress" }

            // Get members for this set
            let mut members = ""
            let mdata = tbl_query_param(db, ok, "SELECT g.name || '|' || g.address || ':' || g.port || '|' || dm.priority || '|' || dm.weight || '|' || dm.enabled || '|' || dm.id FROM dispatch_members dm JOIN gateways g ON dm.gateway_id = g.id JOIN dispatch_sets ds ON dm.set_id = ds.id WHERE ds.name = $1 ORDER BY dm.priority, dm.weight DESC", p[0], 30)
            let mut mi = 0
            while mi < len(mdata) {
                let mp = str_split(mdata[mi], "|")
                if len(mp) >= 6 {
                    let mut mb = "g"
                    let mut mst = "Up"
                    if str_eq(mp[4], "f") { mb = "r"; mst = "Down" }
                    members = members + "<div style=\"display:flex;align-items:center;gap:8px;padding:6px 8px;border-bottom:1px solid var(--border)\"><div style=\"width:20px;text-align:center;color:var(--faint);font-size:11px\">" + string(mi + 1) + "</div><div style=\"flex:1\"><strong style=\"font-size:13px\">" + mp[0] + "</strong><div style=\"font-size:11px;color:var(--faint)\">" + mp[1] + "</div></div><div style=\"font-size:11px;color:var(--muted)\">pri: " + mp[2] + " / wt: " + mp[3] + "</div><span class=\"badge " + mb + "\">" + mst + "</span><button class=\"btn sm\" hx-post=\"/admin/api/toggle\" hx-vals='{\"table\":\"dispatch_members\",\"key\":\"id\",\"val\":\"" + mp[5] + "\"}' hx-target=\"#c\">Toggle</button><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"dispatch_members\",\"key\":\"id\",\"val\":\"" + mp[5] + "\"}' hx-target=\"#c\" hx-confirm=\"Remove server?\">Del</button></div>"
                }
                mi = mi + 1
            }
            if len(members) == 0 { members = "<div style=\"padding:12px;color:var(--faint);text-align:center;font-size:13px\">No servers in this group. Add gateways below.</div>" }

            set_cards = set_cards + "<div class=\"card\" style=\"margin-bottom:12px\"><div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:12px\"><div style=\"display:flex;align-items:center;gap:8px\"><strong style=\"font-size:16px\">" + html_esc(p[0]) + "</strong><span class=\"badge " + dir_badge + "\">" + dir_label + "</span><span class=\"badge b\">" + html_esc(p[1]) + "</span><span class=\"badge " + eb + "\">" + est + "</span><span style=\"color:var(--muted);font-size:12px\">" + html_esc(p[5]) + " servers</span></div><div style=\"display:flex;gap:4px\"><button class=\"btn sm\" hx-post=\"/admin/api/toggle\" hx-vals='{\"table\":\"dispatch_sets\",\"key\":\"id\",\"val\":\"" + html_esc(p[4]) + "\"}' hx-target=\"#c\">Toggle</button><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"dispatch_sets\",\"key\":\"id\",\"val\":\"" + html_esc(p[4]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete this group and all its members?\">Del</button></div></div><div style=\"background:rgba(2,6,23,.4);border-radius:8px;margin-bottom:10px\">" + members + "</div><form hx-post=\"/admin/api/dispatch_member\" hx-target=\"#c\"><input type=\"hidden\" name=\"set_name\" value=\"" + html_esc(p[0]) + "\"><div class=\"form-row\"><div style=\"flex:2\"><label style=\"font-size:11px;color:var(--muted)\">Add Server (gateway name)</label><input name=\"gateway\" placeholder=\"e.g. asterisk1, freeswitch2\" required></div><div><label style=\"font-size:11px;color:var(--muted)\">Priority</label><input name=\"priority\" value=\"10\"></div><div><label style=\"font-size:11px;color:var(--muted)\">Weight</label><input name=\"weight\" value=\"100\"></div><div style=\"flex:none\"><label style=\"font-size:11px;color:transparent\">.</label><button type=\"submit\" class=\"btn sm\">Add Server</button></div></div></form></div>"
        }
        si = si + 1
    }

    return "<div class=\"card\"><h2>Dispatch Groups</h2><p style=\"color:var(--muted);font-size:13px;margin-bottom:12px\">Create server groups for load balancing. <strong>Ingress</strong> groups contain PBX/media servers (Asterisk, FreeSWITCH) that receive calls. <strong>Egress</strong> groups contain carriers/trunks for outbound calls.</p><form hx-post=\"/admin/api/dispatch\" hx-target=\"#c\"><div class=\"form-row\"><div><label style=\"font-size:11px;color:var(--muted)\">Group Name</label><input name=\"name\" placeholder=\"e.g. datacenter4, us_carriers\" required></div><div><label style=\"font-size:11px;color:var(--muted)\">Algorithm</label><select name=\"algorithm\"><option>round-robin</option><option>weight</option><option>priority</option><option>hash</option><option>hash-user</option><option>broadcast</option></select></div><div><label style=\"font-size:11px;color:var(--muted)\">Direction</label><select name=\"direction\"><option value=\"ingress\">Ingress (PBX/Media Servers)</option><option value=\"egress\">Egress (Carriers/Trunks)</option></select></div><div style=\"flex:none\"><label style=\"font-size:11px;color:transparent\">.</label><button type=\"submit\">Create Group</button></div></div></form></div>" + set_cards
}

fn f_dids(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT number || '|' || destination_user || '|' || enabled FROM dids ORDER BY id", 50)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 3 {
            let mut b = "g"
            if str_eq(p[2], "f") { b = "r" }
            rows = rows + "<tr><td>" + html_esc(p[0]) + "</td><td>" + html_esc(p[1]) + "</td><td><span class=\"badge " + b + "\">" + html_esc(p[2]) + "</span></td><td><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"dids\",\"key\":\"number\",\"val\":\"" + html_esc(p[0]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete?\">Del</button></td></tr>"
        }
        i = i + 1
    }
    return "<div class=\"card\"><h2>DID Numbers</h2><form hx-post=\"/admin/api/dids\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"number\" placeholder=\"DID (+15551234567)\" required><input name=\"destination\" placeholder=\"Destination User\" required><button type=\"submit\">Add DID</button></div></form></div><div class=\"card\"><table><tr><th>Number</th><th>Destination</th><th>Enabled</th><th></th></tr>" + rows + "</table></div>"
}

fn f_dialplan(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT match_prefix || '|' || callee_action || '|' || COALESCE(caller_action,'') || '|' || direction || '|' || priority || '|' || id FROM dialplan WHERE enabled = true ORDER BY priority, id", 50)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 6 {
            rows = rows + "<tr><td>" + html_esc(p[0]) + "</td><td><code>" + html_esc(p[1]) + "</code></td><td><code>" + html_esc(p[2]) + "</code></td><td>" + html_esc(p[3]) + "</td><td>" + html_esc(p[4]) + "</td><td><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"dialplan\",\"key\":\"id\",\"val\":\"" + html_esc(p[5]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete?\">Del</button></td></tr>"
        }
        i = i + 1
    }
    return "<div class=\"card\"><h2>Dialplan (Number Translation)</h2><p style=\"color:var(--faint);font-size:12px;margin-bottom:8px\">Actions: strip:N, prepend:PFX, replace:OLD:NEW, set:NUM, e164:CC, strip_plus, add_plus. Chain with ;</p><form hx-post=\"/admin/api/dialplan\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"prefix\" placeholder=\"Match Prefix\" required><input name=\"callee_action\" placeholder=\"Callee Action\" required><input name=\"caller_action\" placeholder=\"Caller Action\"><select name=\"direction\"><option>outbound</option><option>inbound</option></select><input name=\"priority\" value=\"10\" style=\"max-width:60px\"><button type=\"submit\">Add</button></div></form></div><div class=\"card\"><table><tr><th>Prefix</th><th>Callee</th><th>Caller</th><th>Dir</th><th>Pri</th><th></th></tr>" + rows + "</table></div>"
}

fn f_headers(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT match_method || '|' || match_direction || '|' || action || '|' || header_name || '|' || COALESCE(header_value,'') || '|' || priority || '|' || id FROM header_rules WHERE enabled = true ORDER BY priority, id", 50)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 7 {
            rows = rows + "<tr><td>" + html_esc(p[0]) + "</td><td>" + html_esc(p[1]) + "</td><td>" + html_esc(p[2]) + "</td><td>" + html_esc(p[3]) + "</td><td><code>" + html_esc(p[4]) + "</code></td><td>" + html_esc(p[5]) + "</td><td><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"header_rules\",\"key\":\"id\",\"val\":\"" + html_esc(p[6]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete?\">Del</button></td></tr>"
        }
        i = i + 1
    }
    return "<div class=\"card\"><h2>Header Manipulation Rules</h2><form hx-post=\"/admin/api/headers\" hx-target=\"#c\"><div class=\"form-row\"><select name=\"method\"><option value=\"*\">All Methods</option><option>INVITE</option><option>REGISTER</option><option>OPTIONS</option></select><select name=\"direction\"><option>outbound</option><option>inbound</option></select><select name=\"action\"><option>add</option><option>remove</option><option>set</option></select><input name=\"header_name\" placeholder=\"Header Name (e.g. X-Account-ID)\" required><input name=\"header_value\" placeholder=\"Value\"><button type=\"submit\">Add</button></div></form></div><div class=\"card\"><table><tr><th>Method</th><th>Dir</th><th>Action</th><th>Header</th><th>Value</th><th>Pri</th><th></th></tr>" + rows + "</table></div>"
}

fn f_ani(db: SqlDB, ok: int) -> string {
    // Build dropdown options for ingress and egress dispatch sets
    let mut ingress_opts = "<option value=\"\">-- None --</option>"
    let mut egress_opts = "<option value=\"\">-- None --</option>"
    let mut carrier_opts = "<option value=\"\">-- None --</option>"
    if ok == 1 {
        let idata = tbl_query(db, ok, "SELECT name FROM dispatch_sets WHERE COALESCE(direction,'ingress') = 'ingress' AND enabled = true ORDER BY name", 20)
        let mut ii = 0
        while ii < len(idata) {
            ingress_opts = ingress_opts + "<option>" + idata[ii] + "</option>"
            ii = ii + 1
        }
        let edata = tbl_query(db, ok, "SELECT name FROM dispatch_sets WHERE direction = 'egress' AND enabled = true ORDER BY name", 20)
        let mut ei = 0
        while ei < len(edata) {
            egress_opts = egress_opts + "<option>" + edata[ei] + "</option>"
            ei = ei + 1
        }
        // Also list individual gateways as carrier options
        let gw_data = tbl_query(db, ok, "SELECT name FROM gateways WHERE COALESCE(gateway_type,'carrier') = 'carrier' AND enabled = true ORDER BY name", 20)
        let mut gi = 0
        while gi < len(gw_data) {
            carrier_opts = carrier_opts + "<option>" + gw_data[gi] + "</option>"
            gi = gi + 1
        }
    }

    // ANI Groups
    let mut gcards = ""
    let gdata = tbl_query(db, ok, "SELECT ag.name || '|' || COALESCE(ag.description,'') || '|' || (SELECT COUNT(*) FROM ani_ranges ar WHERE ar.group_id = ag.id AND ar.enabled = true) || '|' || ag.enabled || '|' || ag.id FROM ani_groups ag ORDER BY ag.name", 50)
    let mut gi = 0
    while gi < len(gdata) {
        let p = str_split(gdata[gi], "|")
        if len(p) >= 5 {
            let mut eb = "g"
            let mut est = "Active"
            if str_eq(p[3], "f") { eb = "r"; est = "Disabled" }

            // Get ranges for this group
            let mut ranges = ""
            let rdata = tbl_query_param(db, ok, "SELECT ar.range_start || '|' || ar.range_end || '|' || ar.id FROM ani_ranges ar JOIN ani_groups ag ON ar.group_id = ag.id WHERE ag.name = $1 AND ar.enabled = true ORDER BY ar.range_start", p[0], 20)
            let mut ri = 0
            while ri < len(rdata) {
                let rp = str_split(rdata[ri], "|")
                if len(rp) >= 3 {
                    ranges = ranges + "<div style=\"display:flex;align-items:center;gap:8px;padding:4px 0\"><span class=\"badge b\">" + html_esc(rp[0]) + "</span><span style=\"color:var(--faint)\">&rarr;</span><span class=\"badge b\">" + html_esc(rp[1]) + "</span><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"ani_ranges\",\"key\":\"id\",\"val\":\"" + html_esc(rp[2]) + "\"}' hx-target=\"#c\" hx-confirm=\"Remove range?\">Del</button></div>"
                }
                ri = ri + 1
            }
            if len(ranges) == 0 { ranges = "<span style=\"color:var(--faint);font-size:12px\">No ranges defined</span>" }

            // Get current routing for this ANI group
            let mut current_route = ""
            if ok == 1 {
                current_route = sql_query_str(db, "SELECT action FROM routing_rules WHERE match_ani_group = $1 AND enabled = true ORDER BY priority ASC LIMIT 1", p[0])
            }
            let mut route_desc = "<span style=\"color:var(--faint)\">No routing configured</span>"
            if len(current_route) > 0 {
                route_desc = describe_action(current_route)
            }

            gcards = gcards + "<div class=\"card\" style=\"margin-bottom:12px\"><div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:12px\"><div style=\"display:flex;align-items:center;gap:8px\"><strong style=\"font-size:16px\">" + html_esc(p[0]) + "</strong><span class=\"badge " + eb + "\">" + est + "</span><span style=\"color:var(--muted);font-size:12px\">" + html_esc(p[2]) + " ranges</span></div><div style=\"display:flex;gap:4px\"><button class=\"btn sm\" hx-post=\"/admin/api/toggle\" hx-vals='{\"table\":\"ani_groups\",\"key\":\"id\",\"val\":\"" + html_esc(p[4]) + "\"}' hx-target=\"#c\">Toggle</button><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"ani_groups\",\"key\":\"id\",\"val\":\"" + html_esc(p[4]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete group and all its ranges?\">Del</button></div></div><form hx-post=\"/admin/api/ani_group_update\" hx-target=\"#c\" style=\"margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--border)\"><input type=\"hidden\" name=\"id\" value=\"" + html_esc(p[4]) + "\"><div class=\"form-row\"><div><label style=\"font-size:11px;color:var(--muted)\">Group Name</label><input name=\"name\" value=\"" + html_esc(p[0]) + "\" required></div><div style=\"flex:2\"><label style=\"font-size:11px;color:var(--muted)\">Description</label><input name=\"description\" value=\"" + html_esc(p[1]) + "\"></div><div style=\"flex:none\"><label style=\"font-size:11px;color:transparent\">.</label><button type=\"submit\" class=\"btn sm\">Save</button></div></div></form><div style=\"margin-bottom:12px\"><div style=\"font-size:12px;font-weight:600;color:var(--muted);margin-bottom:6px\">Number Ranges</div>" + ranges + "<form hx-post=\"/admin/api/ani_range\" hx-target=\"#c\" style=\"margin-top:6px\"><input type=\"hidden\" name=\"group\" value=\"" + html_esc(p[0]) + "\"><div class=\"form-row\"><input name=\"range_start\" placeholder=\"Start (e.g. 8464440001)\" required><input name=\"range_end\" placeholder=\"End (e.g. 8464443000)\" required><button type=\"submit\" class=\"btn sm\">Add Range</button></div></form></div><div style=\"padding:12px;background:#f0f7ff;border-radius:8px;border:1px solid #bfdbfe\"><div style=\"font-size:12px;font-weight:600;color:#1e40af;margin-bottom:6px\">Call Routing</div><div style=\"font-size:13px;margin-bottom:8px\">Current: " + route_desc + "</div><form hx-post=\"/admin/api/ani_quick_route\" hx-target=\"#c\"><input type=\"hidden\" name=\"ani_group\" value=\"" + html_esc(p[0]) + "\"><div class=\"form-row\"><div><label style=\"font-size:11px;color:#1e40af\">Send to (Ingress PBX servers)</label><select name=\"ingress\">" + ingress_opts + "</select></div><div><label style=\"font-size:11px;color:#1e40af\">Then out via (Egress Carrier)</label><select name=\"egress\">" + egress_opts + "</select></div><div><label style=\"font-size:11px;color:#1e40af\">Or direct to carrier</label><select name=\"direct_carrier\">" + carrier_opts + "</select></div><div style=\"flex:none\"><label style=\"font-size:11px;color:transparent\">.</label><button type=\"submit\">Set Route</button></div></div></form></div></div>"
        }
        gi = gi + 1
    }

    return "<div class=\"card\"><h2>ANI Groups</h2><p style=\"color:var(--muted);font-size:13px;margin-bottom:12px\">Group caller numbers (ANI) by range, then route them to dispatch sets (ingress PBX servers) or carriers (egress trunks). Each group can contain multiple number ranges.</p><form hx-post=\"/admin/api/ani_group\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"name\" placeholder=\"Group Name (e.g. customer_acme)\" required><input name=\"description\" placeholder=\"Description (e.g. Acme Corp caller IDs)\"><button type=\"submit\">Create Group</button></div></form></div>" + gcards + "<div class=\"card\"><h2>Quick Route an ANI Group</h2><p style=\"color:var(--muted);font-size:12px;margin-bottom:10px\">Create a routing rule for an ANI group in one step. Calls from numbers in the group will be sent to the selected destination.</p><form hx-post=\"/admin/api/ani_quick_route\" hx-target=\"#c\"><div class=\"form-row\"><div><label style=\"font-size:11px;color:var(--muted)\">ANI Group</label><input name=\"ani_group\" placeholder=\"Group name\" required></div><div><label style=\"font-size:11px;color:var(--muted)\">Send to</label><select name=\"action_type\"><option value=\"dispatch\">Dispatch Set (ingress)</option><option value=\"route\">Gateway (egress)</option><option value=\"failover\">Failover Chain</option></select></div><div><label style=\"font-size:11px;color:var(--muted)\">Target</label><input name=\"target\" placeholder=\"Set or gateway name\" required></div><div><label style=\"font-size:11px;color:var(--muted)\">Priority</label><input name=\"priority\" value=\"10\" style=\"max-width:60px\"></div><div style=\"flex:none\"><label style=\"font-size:11px;color:transparent\">.</label><button type=\"submit\">Create Route</button></div></div></form></div>"
}

fn f_security(db: SqlDB, ok: int) -> string {
    // Active bans
    let mut ban_rows = ""
    let bdata = tbl_query(db, ok, "SELECT source_ip || '|' || COALESCE(reason,'') || '|' || ban_count || '|' || COALESCE(to_char(created_at,'YYYY-MM-DD HH24:MI:SS'),'') || '|' || COALESCE(to_char(expires_at,'YYYY-MM-DD HH24:MI:SS'),'') || '|' || permanent || '|' || source_ip FROM security_bans ORDER BY created_at DESC", 50)
    let mut bi = 0
    while bi < len(bdata) {
        let p = str_split(bdata[bi], "|")
        if len(p) >= 7 {
            let mut perm = ""
            if str_eq(p[5], "t") { perm = "<span class=\"badge r\">PERMANENT</span>" } else { perm = "<span class=\"badge y\">temp</span>" }
            ban_rows = ban_rows + "<tr><td><strong>" + html_esc(p[0]) + "</strong></td><td>" + html_esc(p[1]) + "</td><td>" + html_esc(p[2]) + "</td><td>" + perm + "</td><td style=\"font-size:11px\">" + html_esc(p[4]) + "</td><td><button class=\"btn sm\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"security_bans\",\"key\":\"source_ip\",\"val\":\"" + html_esc(p[6]) + "\"}' hx-target=\"#c\" hx-confirm=\"Unban this IP?\">Unban</button></td></tr>"
        }
        bi = bi + 1
    }

    // Recent security events
    let mut event_rows = ""
    let edata = tbl_query(db, ok, "SELECT ts || '|' || event_type || '|' || source_ip || '|' || COALESCE(sip_user,'') || '|' || severity FROM security_events ORDER BY ts DESC", 50)
    let mut ei = 0
    while ei < len(edata) {
        let p = str_split(edata[ei], "|")
        if len(p) >= 5 {
            let mut sb = "b"
            if str_eq(p[4], "high") { sb = "y" }
            if str_eq(p[4], "critical") { sb = "r" }
            event_rows = event_rows + "<tr><td style=\"font-size:11px\">" + html_esc(p[0]) + "</td><td>" + html_esc(p[1]) + "</td><td>" + html_esc(p[2]) + "</td><td>" + html_esc(p[3]) + "</td><td><span class=\"badge " + sb + "\">" + html_esc(p[4]) + "</span></td></tr>"
        }
        ei = ei + 1
    }

    // Stats
    let mut total_bans = "0"
    let mut events_24h = "0"
    let mut scanners = "0"
    let mut auth_fails = "0"
    if ok == 1 {
        total_bans = sql_query_str(db, "SELECT COUNT(*) FROM security_bans WHERE permanent = true OR expires_at > NOW()", "")
        events_24h = sql_query_str(db, "SELECT COUNT(*) FROM security_events WHERE ts > NOW() - INTERVAL '24 hours'", "")
        scanners = sql_query_str(db, "SELECT COUNT(*) FROM security_events WHERE event_type = 'scanner_blocked' AND ts > NOW() - INTERVAL '24 hours'", "")
        auth_fails = sql_query_str(db, "SELECT COUNT(*) FROM security_events WHERE event_type = 'auth_failure' AND ts > NOW() - INTERVAL '24 hours'", "")
    }

    return "<div class=\"stats\"><div class=\"stat-card orange\"><div class=\"label\">Active Bans</div><div class=\"value\">" + total_bans + "</div></div><div class=\"stat-card purple\"><div class=\"label\">Events (24h)</div><div class=\"value\">" + events_24h + "</div></div><div class=\"stat-card pink\"><div class=\"label\">Scanners Blocked</div><div class=\"value\">" + scanners + "</div></div><div class=\"stat-card blue\"><div class=\"label\">Auth Failures (24h)</div><div class=\"value\">" + auth_fails + "</div></div></div><div class=\"card\"><h2>Active Bans</h2><p style=\"color:var(--muted);font-size:12px;margin-bottom:8px\">IPs auto-banned for brute force, scanning, or fraud. Click Unban to remove.</p><form hx-post=\"/admin/api/ban\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"ip\" placeholder=\"IP to ban\" required><select name=\"permanent\"><option value=\"false\">Temporary (1 hour)</option><option value=\"true\">Permanent</option></select><input name=\"reason\" placeholder=\"Reason\" value=\"manual_ban\"><button type=\"submit\">Ban IP</button></div></form><table><tr><th>IP</th><th>Reason</th><th>Count</th><th>Type</th><th>Expires</th><th></th></tr>" + ban_rows + "</table></div><div class=\"card\" hx-get=\"/admin/security\" hx-trigger=\"every 10s\" hx-swap=\"outerHTML\"><h2>Security Events (last 50)</h2><table><tr><th>Time</th><th>Event</th><th>Source IP</th><th>User</th><th>Severity</th></tr>" + event_rows + "</table></div>"
}

fn f_logs(db: SqlDB, ok: int) -> string {
    // Read last 200 lines from log files
    let proxy_log = read_file("/var/log/mako-sip/sipproxy.log")
    let admin_log = read_file("/var/log/mako-sip/admin.log")

    // Show last lines of each
    let mut proxy_lines = str_split(proxy_log, "\n")
    let mut admin_lines = str_split(admin_log, "\n")

    let mut proxy_rows = ""
    let plen = len(proxy_lines)
    let mut pi = plen - 50
    if pi < 0 { pi = 0 }
    while pi < plen {
        let line = proxy_lines[pi]
        if len(line) > 0 {
            let mut cls = ""
            if str_contains(line, "error") { cls = " style=\"color:#ef4444\"" }
            if str_contains(line, "FAIL") { cls = " style=\"color:#ef4444\"" }
            if str_contains(line, "warning") { cls = " style=\"color:#f59e0b\"" }
            proxy_rows = proxy_rows + "<div" + cls + " style=\"font-family:monospace;font-size:12px;padding:2px 0;border-bottom:1px solid var(--border)\">" + html_esc(line) + "</div>"
        }
        pi = pi + 1
    }

    let mut admin_rows = ""
    let alen = len(admin_lines)
    let mut ai = alen - 30
    if ai < 0 { ai = 0 }
    while ai < alen {
        let line = admin_lines[ai]
        if len(line) > 0 {
            admin_rows = admin_rows + "<div style=\"font-family:monospace;font-size:12px;padding:2px 0;border-bottom:1px solid var(--border)\">" + html_esc(line) + "</div>"
        }
        ai = ai + 1
    }

    // DB logs
    let mut db_rows = ""
    if ok == 1 {
        let data = tbl_query(db, ok, "SELECT ts || '|' || level || '|' || component || '|' || message FROM logs ORDER BY ts DESC", 50)
        let mut di = 0
        while di < len(data) {
            let p = str_split(data[di], "|")
            if len(p) >= 4 {
                let mut b = "b"
                if str_eq(p[1], "error") { b = "r" }
                if str_eq(p[1], "warn") { b = "y" }
                db_rows = db_rows + "<tr><td>" + html_esc(p[0]) + "</td><td><span class=\"badge " + b + "\">" + html_esc(p[1]) + "</span></td><td>" + html_esc(p[2]) + "</td><td style=\"font-family:monospace;font-size:12px\">" + html_esc(p[3]) + "</td></tr>"
            }
            di = di + 1
        }
    }

    return "<div class=\"card\" hx-get=\"/admin/logs\" hx-trigger=\"every 5s\" hx-swap=\"outerHTML\"><h2>SIP Proxy Logs (last 50 lines)</h2><div style=\"max-height:400px;overflow-y:auto;background:rgba(2,6,23,.4);border-radius:8px;padding:8px\">" + proxy_rows + "</div></div><div class=\"card\"><h2>Admin Panel Logs (last 30 lines)</h2><div style=\"max-height:250px;overflow-y:auto;background:rgba(2,6,23,.4);border-radius:8px;padding:8px\">" + admin_rows + "</div></div><div class=\"card\"><h2>Database Logs</h2><table><tr><th>Time</th><th>Level</th><th>Component</th><th>Message</th></tr>" + db_rows + "</table></div>"
}

fn f_regs(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let mut online = 0
    // Prefer live (non-expired) first
    let data = tbl_query(db, ok, "SELECT aor || '|' || contact || '|' || COALESCE(transport,'UDP') || '|' || COALESCE(node_id,'') || '|' || COALESCE(user_agent,'') || '|' || COALESCE(to_char(expires_at,'YYYY-MM-DD HH24:MI:SS'),'') || '|' || COALESCE(to_char(updated_at,'HH24:MI:SS'),'') || '|' || CASE WHEN expires_at IS NULL THEN 'unknown' WHEN expires_at > NOW() THEN 'online' ELSE 'expired' END || '|' || COALESCE(EXTRACT(EPOCH FROM (expires_at - NOW()))::int::text,'') FROM registrations ORDER BY CASE WHEN expires_at IS NULL OR expires_at > NOW() THEN 0 ELSE 1 END, updated_at DESC", 100)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 8 {
            let st = p[7]
            let mut b = "y"
            if str_eq(st, "online") { b = "g"; online = online + 1 }
            if str_eq(st, "expired") { b = "r" }
            let mut ttl = "—"
            if len(p) >= 9 {
                if len(p[8]) > 0 {
                    if str_eq(st, "online") { ttl = p[8] + "s" }
                }
            }
            let mut ua = ""
            if len(p) >= 5 { ua = p[4] }
            let mut exp = ""
            if len(p) >= 6 { exp = p[5] }
            let mut upd = ""
            if len(p) >= 7 { upd = p[6] }
            rows = rows + "<tr><td><span class=\"badge " + b + "\">" + html_esc(st) + "</span></td><td><strong>" + html_esc(p[0]) + "</strong></td><td style=\"font-size:12px\"><code>" + html_esc(p[1]) + "</code></td><td>" + html_esc(p[2]) + "</td><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(p[3]) + "</td><td style=\"font-size:11px;color:var(--muted)\">" + html_esc(ua) + "</td><td style=\"font-variant-numeric:tabular-nums\">" + html_esc(ttl) + "</td><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(exp) + "</td><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(upd) + "</td></tr>"
        }
        i = i + 1
    }
    if len(rows) == 0 {
        rows = "<tr><td colspan=\"9\" style=\"color:var(--muted);text-align:center;padding:24px\">No registrations</td></tr>"
    }
    return "<div class=\"card\" hx-get=\"/admin/regs\" hx-trigger=\"every 5s\" hx-swap=\"outerHTML\"><div class=\"topbar\" style=\"margin-bottom:12px\"><h2 style=\"margin:0\">Active Registrations</h2><div class=\"user\">" + string(online) + " online · refresh 5s</div></div><p style=\"color:var(--muted);font-size:13px;margin-bottom:12px\">Presence from <code>registrations</code>. TTL is seconds until <code>expires_at</code>. Expired rows are cleaned by the proxy heartbeat.</p><table><tr><th>Status</th><th>AOR</th><th>Contact</th><th>Transport</th><th>Node</th><th>User-Agent</th><th>TTL</th><th>Expires</th><th>Updated</th></tr>" + rows + "</table></div>"
}

fn f_cluster(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT id || '|' || address || ':' || port || '|' || region || '|' || COALESCE(weight::text,'100') || '|' || status || '|' || COALESCE(to_char(last_heartbeat,'YYYY-MM-DD HH24:MI:SS'),'') || '|' || COALESCE(EXTRACT(EPOCH FROM (NOW() - last_heartbeat))::int::text,'') FROM cluster_nodes ORDER BY id", 20)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 6 {
            let mut b = "g"
            if str_eq(p[4], "stale") { b = "y" }
            if str_eq(p[4], "down") { b = "r" }
            let mut lag = "—"
            if len(p) >= 7 {
                if len(p[6]) > 0 { lag = p[6] + "s" }
            }
            rows = rows + "<tr><td><strong>" + html_esc(p[0]) + "</strong></td><td>" + html_esc(p[1]) + "</td><td>" + html_esc(p[2]) + "</td><td>" + html_esc(p[3]) + "</td><td><span class=\"badge " + b + "\">" + html_esc(p[4]) + "</span></td><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(p[5]) + "</td><td style=\"font-variant-numeric:tabular-nums\">" + html_esc(lag) + "</td></tr>"
        }
        i = i + 1
    }
    return "<div class=\"card\" hx-get=\"/admin/cluster\" hx-trigger=\"every 5s\" hx-swap=\"outerHTML\"><h2>Cluster Nodes</h2><p style=\"color:var(--muted);font-size:13px;margin-bottom:12px\">Shared Postgres is the source of truth for multi-node HA. Heartbeats mark stale after 30s. Multi-worker on one host is not multi-node. Registrations carry <code>node_id</code> for cross-node INVITE forwarding.</p><table><tr><th>Node ID</th><th>Address</th><th>Region</th><th>Weight</th><th>Status</th><th>Heartbeat</th><th>Lag</th></tr>" + rows + "</table></div>"
}

fn f_cdr(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT call_id || '|' || COALESCE(caller,'') || '|' || COALESCE(callee,'') || '|' || COALESCE(status,'') || '|' || to_char(started_at,'YYYY-MM-DD HH24:MI:SS') || '|' || COALESCE(destination,'') || '|' || COALESCE(source_ip,'') || '|' || COALESCE(to_char(ended_at,'HH24:MI:SS'),'') || '|' || COALESCE(duration_sec::text,'') || '|' || COALESCE(transport,'') FROM cdr ORDER BY started_at DESC", 100)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 5 {
            let mut b = "g"
            let mut icon = "&#9989;"
            if str_contains(p[3], "CANCEL") { b = "y"; icon = "&#10060;" }
            if str_contains(p[3], "NOT_FOUND") { b = "r"; icon = "&#10060;" }
            if str_contains(p[3], "OFFLINE") { b = "y"; icon = "&#128164;" }
            if str_contains(p[3], "REJECT") { b = "r"; icon = "&#128683;" }
            if str_contains(p[3], "TRYING") { b = "b"; icon = "&#128222;" }
            if str_contains(p[3], "ROUTING") { b = "b"; icon = "&#10132;" }
            if str_contains(p[3], "LOCAL") { b = "g"; icon = "&#128241;" }
            if str_contains(p[3], "ANSWERED") { b = "g"; icon = "&#128222;" }
            if str_contains(p[3], "COMPLETED") { b = "g"; icon = "&#9989;" }

            let mut dest = ""
            let mut src = ""
            let mut ended = ""
            let mut dur = ""
            let mut tr = ""
            if len(p) >= 6 { dest = p[5] }
            if len(p) >= 7 { src = p[6] }
            if len(p) >= 8 { ended = p[7] }
            if len(p) >= 9 { dur = p[8] }
            if len(p) >= 10 { tr = p[9] }
            let mut dur_label = "—"
            if len(dur) > 0 { dur_label = dur + "s" }

            let did = "cdr" + string(i)
            let detail = "<div id=\"" + did + "\" style=\"display:none;margin:8px 12px 12px;padding:16px;background:rgba(2,6,23,.45);border:1px solid var(--border);border-radius:10px\"><div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;font-size:13px\"><div><div style=\"color:var(--muted);font-size:11px\">Call-ID</div><code style=\"font-size:11px;word-break:break-all\">" + html_esc(p[0]) + "</code></div><div><div style=\"color:var(--muted);font-size:11px\">Status</div><span class=\"badge " + b + "\">" + html_esc(p[3]) + "</span></div><div><div style=\"color:var(--muted);font-size:11px\">Started</div>" + html_esc(p[4]) + "</div><div><div style=\"color:var(--muted);font-size:11px\">Caller</div><strong>" + html_esc(p[1]) + "</strong></div><div><div style=\"color:var(--muted);font-size:11px\">Callee</div><strong>" + html_esc(p[2]) + "</strong></div><div><div style=\"color:var(--muted);font-size:11px\">Destination</div>" + html_esc(dest) + "</div><div><div style=\"color:var(--muted);font-size:11px\">Source IP</div>" + html_esc(src) + "</div><div><div style=\"color:var(--muted);font-size:11px\">Transport</div>" + html_esc(tr) + "</div><div><div style=\"color:var(--muted);font-size:11px\">Duration</div>" + html_esc(dur_label) + "</div></div>"
                + "<div style=\"margin-top:12px;display:flex;gap:8px;flex-wrap:wrap\">"
                + "<a class=\"btn sm\" hx-get=\"/admin/transactions?cid=" + html_esc(p[0]) + "\" hx-target=\"#c\" hx-push-url=\"true\">Open SIP Trace</a>"
                + "<button type=\"button\" class=\"btn sm ghost\" onclick=\"event.stopPropagation();copyCid('" + js_esc(p[0]) + "',this)\">Copy Call-ID</button>"
                + "</div></div>"

            rows = rows + "<tr style=\"cursor:pointer\" onclick=\"var d=document.getElementById('" + did + "');d.style.display=d.style.display=='none'?'block':'none'\"><td>" + icon + "</td><td><strong>" + html_esc(p[1]) + "</strong></td><td>" + html_esc(p[2]) + "</td><td><span class=\"badge " + b + "\">" + html_esc(p[3]) + "</span></td><td style=\"font-size:12px;font-variant-numeric:tabular-nums\">" + html_esc(dur_label) + "</td><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(p[4]) + "</td><td style=\"font-size:12px\">" + html_esc(dest) + "</td></tr><tr><td colspan=\"7\" style=\"padding:0;border:none\">" + detail + "</td></tr>"
        }
        i = i + 1
    }

    let mut total = "0"
    let mut connected = "0"
    let mut failed = "0"
    let mut today_count = "0"
    if ok == 1 {
        total = sql_query_str(db, "SELECT COUNT(*) FROM cdr", "")
        connected = sql_query_str(db, "SELECT COUNT(*) FROM cdr WHERE status IN ('COMPLETED','ANSWERED') OR status LIKE 'LOCAL%'", "")
        failed = sql_query_str(db, "SELECT COUNT(*) FROM cdr WHERE status LIKE '%NOT_FOUND%' OR status LIKE '%REJECT%' OR status = 'OFFLINE'", "")
        today_count = sql_query_str(db, "SELECT COUNT(*) FROM cdr WHERE started_at > NOW() - INTERVAL '24 hours'", "")
    }

    return "<div class=\"stats\" style=\"margin-bottom:16px\"><div class=\"stat-card blue\"><div class=\"label\">Total CDRs</div><div class=\"value\">" + total + "</div></div><div class=\"stat-card green\"><div class=\"label\">Connected</div><div class=\"value\">" + connected + "</div></div><div class=\"stat-card orange\"><div class=\"label\">Failed</div><div class=\"value\">" + failed + "</div></div><div class=\"stat-card purple\"><div class=\"label\">Today</div><div class=\"value\">" + today_count + "</div></div></div><div class=\"card\"><div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:12px\"><h2 style=\"margin:0\">Call Detail Records</h2><a class=\"btn sm\" href=\"/admin/api/cdr.csv\">Download CSV</a></div><p style=\"color:var(--muted);font-size:12px;margin-bottom:12px\">Click any row for Call-ID, duration, source IP, destination, and transport.</p><table><tr><th></th><th>Caller</th><th>Callee</th><th>Status</th><th>Duration</th><th>Time</th><th>Destination</th></tr>" + rows + "</table></div>"
}

fn f_config(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT key || '|' || value || '|' || COALESCE(description,'') FROM config ORDER BY key", 100)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 3 {
            rows = rows + "<tr><td style=\"font-weight:500\">" + html_esc(p[0]) + "</td><td><form hx-post=\"/admin/api/config\" hx-target=\"#c\" style=\"display:flex;gap:4px\"><input type=\"hidden\" name=\"key\" value=\"" + html_esc(p[0]) + "\"><input type=\"hidden\" name=\"description\" value=\"" + html_esc(p[2]) + "\"><input name=\"value\" value=\"" + html_esc(p[1]) + "\" style=\"min-width:200px\"><button class=\"btn sm\" type=\"submit\">Save</button></form></td><td style=\"color:var(--muted);font-size:12px\">" + html_esc(p[2]) + "</td><td><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"config\",\"key\":\"key\",\"val\":\"" + html_esc(p[0]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete?\">Del</button></td></tr>"
        }
        i = i + 1
    }
    let tls_cert = env_get_or("SIP_TLS_CERT", "(unset — SIPS disabled)")
    let tls_key = env_get_or("SIP_TLS_KEY", "(unset)")
    let pubip = env_get_or("SIP_PUBLIC_IP", "")
    let note = "<div class=\"card\" style=\"margin-bottom:14px\"><h2>Runtime / transports</h2><p style=\"color:var(--muted);font-size:13px;line-height:1.6\"><strong>SIPS TLS (5061):</strong> <code>" + html_esc(tls_cert) + "</code> / <code>" + html_esc(tls_key) + "</code><br><strong>WSS (8443):</strong> plain WebSocket — terminate TLS at leba/proxy<br><strong>Public IP (SDP NAT):</strong> <code>" + html_esc(pubip) + "</code><br><strong>STIR/SHAKEN:</strong> Identity uses HMAC JWT placeholder when enabled — <em>not</em> production ES256 STI-PA. Keep <code>stir_shaken_enabled=false</code> unless testing.<br><strong>rtpengine:</strong> set <code>rtpengine_enabled=true</code> + host/port when media relay is installed. Default is SDP NAT rewrite only.</p></div>"
    return note + "<div class=\"card\"><h2>Configuration</h2><p style=\"color:var(--muted);font-size:12px;margin-bottom:12px\">Edit values inline and click Save. Rate limits and rtpengine apply after SIGHUP / ~10s heartbeat. Keys: <code>rate_limit_per_user</code>, <code>rtpengine_*</code>, <code>security_*</code>.</p><form hx-post=\"/admin/api/config\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"key\" placeholder=\"New Key\" required><input name=\"value\" placeholder=\"Value\" required><input name=\"description\" placeholder=\"Description\"><button type=\"submit\">Add Setting</button></div></form></div><div class=\"card\"><table><tr><th>Key</th><th>Value</th><th>Description</th><th></th></tr>" + rows + "</table></div>"
}

fn f_admins(db: SqlDB, ok: int) -> string {
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT username || '|' || role || '|' || enabled FROM admin_users ORDER BY id", 50)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 3 {
            let mut b = "b"
            if str_eq(p[1], "super_admin") { b = "y" }
            if str_eq(p[1], "admin") { b = "g" }
            rows = rows + "<tr><td>" + html_esc(p[0]) + "</td><td><span class=\"badge " + b + "\">" + html_esc(p[1]) + "</span></td><td>" + html_esc(p[2]) + "</td><td><button class=\"btn sm r\" hx-post=\"/admin/api/delete\" hx-vals='{\"table\":\"admin_users\",\"key\":\"username\",\"val\":\"" + html_esc(p[0]) + "\"}' hx-target=\"#c\" hx-confirm=\"Delete?\">Del</button></td></tr>"
        }
        i = i + 1
    }
    return "<div class=\"card\"><h2>Admin Users</h2><form hx-post=\"/admin/api/admins\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"username\" placeholder=\"Username\" required><input name=\"password\" type=\"password\" placeholder=\"Password\" required><select name=\"role\"><option>viewer</option><option>operator</option><option>admin</option><option>super_admin</option></select><button type=\"submit\">Add Admin</button></div></form></div><div class=\"card\"><table><tr><th>Username</th><th>Role</th><th>Enabled</th><th></th></tr>" + rows + "</table></div>"
}

fn f_account() -> string {
    return "<div class=\"topbar\"><h1>Account</h1></div><div class=\"card\"><h2>Change password</h2><p style=\"color:var(--muted);font-size:13px;margin-bottom:12px\">Minimum 12 characters. Other sessions will be signed out after a successful change.</p><form hx-post=\"/admin/api/password\" hx-target=\"#c\"><div class=\"form-row\"><input name=\"old_password\" type=\"password\" placeholder=\"Current password\" required autocomplete=\"current-password\"></div><div class=\"form-row\"><input name=\"new_password\" type=\"password\" placeholder=\"New password\" required minlength=\"12\" autocomplete=\"new-password\"><input name=\"confirm_password\" type=\"password\" placeholder=\"Confirm new password\" required minlength=\"12\" autocomplete=\"new-password\"><button type=\"submit\">Update password</button></div></form></div>"
}

// Global search across users, CDRs, regs, bans
fn f_search(db: SqlDB, ok: int, qstr: string) -> string {
    let q = query_val(qstr, "q")
    let form = "<div class=\"card\"><form class=\"form-row\" hx-get=\"/admin/search\" hx-target=\"#c\" hx-push-url=\"true\">"
        + "<div style=\"flex:2\"><label>Search</label><input name=\"q\" value=\"" + html_esc(q) + "\" placeholder=\"username, call-id, IP, number…\" autofocus></div>"
        + "<div style=\"flex:none\"><label style=\"color:transparent\">.</label><button type=\"submit\">Search</button></div></form></div>"
    if len(q) == 0 {
        return "<div class=\"topbar\"><h1>Search</h1></div>" + form
            + "<div class=\"card\"><p style=\"color:var(--muted)\">Search SIP users, registrations, CDRs, bans, and Call-IDs.</p></div>"
    }
    let like = "%" + q + "%"

    let mut out = ""
    let users = tbl_query_param(db, ok, "SELECT username || '|' || COALESCE(domain,'') || '|' || enabled FROM users WHERE username ILIKE $1 OR domain ILIKE $1 ORDER BY username", like, 30)
    let mut ur = ""
    let mut ui = 0
    while ui < len(users) {
        let p = str_split(users[ui], "|")
        if len(p) >= 2 { ur = ur + "<tr><td>" + html_esc(p[0]) + "</td><td>" + html_esc(p[1]) + "</td><td>" + html_esc(p[2]) + "</td></tr>" }
        ui = ui + 1
    }
    if len(ur) == 0 { ur = "<tr><td colspan=\"3\" style=\"color:var(--muted)\">No users</td></tr>" }
    out = out + "<div class=\"card\"><h2>SIP Users</h2><table><tr><th>User</th><th>Domain</th><th>Enabled</th></tr>" + ur + "</table></div>"

    let regs = tbl_query_param(db, ok, "SELECT aor || '|' || contact || '|' || COALESCE(transport,'') FROM registrations WHERE aor ILIKE $1 OR contact ILIKE $1 ORDER BY updated_at DESC", like, 30)
    let mut rr = ""
    let mut ri = 0
    while ri < len(regs) {
        let p = str_split(regs[ri], "|")
        if len(p) >= 2 { rr = rr + "<tr><td>" + html_esc(p[0]) + "</td><td><code style=\"font-size:11px\">" + html_esc(p[1]) + "</code></td><td>" + html_esc(p[2]) + "</td></tr>" }
        ri = ri + 1
    }
    if len(rr) == 0 { rr = "<tr><td colspan=\"3\" style=\"color:var(--muted)\">No registrations</td></tr>" }
    out = out + "<div class=\"card\"><h2>Registrations</h2><table><tr><th>AOR</th><th>Contact</th><th>Transport</th></tr>" + rr + "</table></div>"

    let cdrs = tbl_query_param(db, ok, "SELECT call_id || '|' || COALESCE(caller,'') || '|' || COALESCE(callee,'') || '|' || COALESCE(status,'') || '|' || to_char(started_at,'YYYY-MM-DD HH24:MI') FROM cdr WHERE call_id ILIKE $1 OR caller ILIKE $1 OR callee ILIKE $1 OR status ILIKE $1 ORDER BY started_at DESC", like, 30)
    let mut cr = ""
    let mut cii = 0
    while cii < len(cdrs) {
        let p = str_split(cdrs[cii], "|")
        if len(p) >= 5 {
            cr = cr + "<tr><td style=\"font-size:12px\">" + html_esc(p[4]) + "</td><td>" + html_esc(p[1]) + " → " + html_esc(p[2]) + "</td><td><span class=\"badge b\">" + html_esc(p[3]) + "</span></td>"
                + "<td><a class=\"btn sm\" hx-get=\"/admin/transactions?cid=" + html_esc(p[0]) + "\" hx-target=\"#c\" hx-push-url=\"true\">Trace</a></td></tr>"
        }
        cii = cii + 1
    }
    if len(cr) == 0 { cr = "<tr><td colspan=\"4\" style=\"color:var(--muted)\">No CDRs</td></tr>" }
    out = out + "<div class=\"card\"><h2>CDRs</h2><table><tr><th>Time</th><th>Parties</th><th>Status</th><th></th></tr>" + cr + "</table></div>"

    let bans = tbl_query_param(db, ok, "SELECT source_ip || '|' || COALESCE(reason,'') || '|' || ban_count FROM security_bans WHERE source_ip ILIKE $1 OR reason ILIKE $1 ORDER BY created_at DESC", like, 20)
    let mut br = ""
    let mut bi = 0
    while bi < len(bans) {
        let p = str_split(bans[bi], "|")
        if len(p) >= 2 { br = br + "<tr><td><code>" + html_esc(p[0]) + "</code></td><td>" + html_esc(p[1]) + "</td><td>" + html_esc(p[2]) + "</td></tr>" }
        bi = bi + 1
    }
    if len(br) == 0 { br = "<tr><td colspan=\"3\" style=\"color:var(--muted)\">No bans</td></tr>" }
    out = out + "<div class=\"card\"><h2>Bans</h2><table><tr><th>IP</th><th>Reason</th><th>Count</th></tr>" + br + "</table></div>"

    return "<div class=\"topbar\"><h1>Search</h1><div class=\"user\">Results for <code>" + html_esc(q) + "</code></div></div>" + form + out
}

// Route / dialplan simulator (prefix + DID + local user checks — mirrors proxy decision outline)
fn f_simulate(db: SqlDB, ok: int, qstr: string) -> string {
    let num = query_val(qstr, "number")
    let caller = query_val(qstr, "caller")
    let form = "<div class=\"card\"><h2>Route simulator</h2>"
        + "<p style=\"color:var(--muted);font-size:13px;margin-bottom:12px\">Enter a callee number (and optional caller) to see which DID, local user, routing rule, or gateway prefix would apply. This is a read-only decision preview — it does not place a call.</p>"
        + "<form class=\"form-row\" hx-get=\"/admin/simulate\" hx-target=\"#c\" hx-push-url=\"true\">"
        + "<div><label>Callee / number</label><input name=\"number\" value=\"" + html_esc(num) + "\" placeholder=\"e.g. bob or 15551234567\" required></div>"
        + "<div><label>Caller (optional)</label><input name=\"caller\" value=\"" + html_esc(caller) + "\" placeholder=\"alice\"></div>"
        + "<div style=\"flex:none\"><label style=\"color:transparent\">.</label><button type=\"submit\">Simulate</button></div></form></div>"

    if len(num) == 0 {
        return "<div class=\"topbar\"><h1>Route Simulator</h1></div>" + form
    }

    let mut steps = ""
    let mut decision = "No match → 404 Not Found"
    let mut dec_b = "r"

    // DID
    let mut did_u = ""
    if ok == 1 {
        did_u = sql_query_str(db, "SELECT destination_user FROM dids WHERE number = $1 AND enabled = true LIMIT 1", num)
    }
    if len(did_u) > 0 {
        steps = steps + "<li><span class=\"badge g\">DID</span> Number <code>" + html_esc(num) + "</code> maps to user <strong>" + html_esc(did_u) + "</strong></li>"
        // check reg
        let mut reg = ""
        if ok == 1 {
            reg = sql_query_str(db, "SELECT contact FROM registrations WHERE aor LIKE $1 || '@%' AND (expires_at IS NULL OR expires_at > NOW()) LIMIT 1", did_u)
        }
        if len(reg) > 0 {
            decision = "LOCAL-DID → " + reg
            dec_b = "g"
            steps = steps + "<li><span class=\"badge g\">REG</span> User online at <code>" + html_esc(reg) + "</code></li>"
        } else {
            decision = "DID target offline → 480"
            dec_b = "y"
            steps = steps + "<li><span class=\"badge y\">REG</span> Destination user not registered</li>"
        }
    } else {
        steps = steps + "<li><span class=\"badge b\">DID</span> No DID mapping for <code>" + html_esc(num) + "</code></li>"
        // Local SIP user
        let mut lu = ""
        if ok == 1 {
            lu = sql_query_str(db, "SELECT username FROM users WHERE username = $1 AND enabled = true LIMIT 1", num)
        }
        if len(lu) > 0 {
            steps = steps + "<li><span class=\"badge g\">USER</span> Local SIP user <strong>" + html_esc(lu) + "</strong> exists</li>"
            let mut reg2 = ""
            if ok == 1 {
                reg2 = sql_query_str(db, "SELECT contact FROM registrations WHERE aor LIKE $1 || '@%' AND (expires_at IS NULL OR expires_at > NOW()) LIMIT 1", lu)
            }
            if len(reg2) > 0 {
                decision = "LOCAL → " + reg2
                dec_b = "g"
                steps = steps + "<li><span class=\"badge g\">REG</span> Registered at <code>" + html_esc(reg2) + "</code></li>"
            } else {
                decision = "Local user offline → 480 Temporarily Unavailable"
                dec_b = "y"
                steps = steps + "<li><span class=\"badge y\">REG</span> Not registered (would not go to PSTN gateway)</li>"
            }
        } else {
            steps = steps + "<li><span class=\"badge b\">USER</span> Not a local SIP username</li>"
            // Routing rules
            let mut rule = ""
            if ok == 1 {
                rule = sql_query_str(db, "SELECT action || '|' || COALESCE(description,'') || '|' || priority FROM routing_rules WHERE enabled = true AND (match_prefix = '' OR $1 LIKE match_prefix || '%') ORDER BY priority ASC LIMIT 1", num)
            }
            if len(rule) > 0 {
                let rp = str_split(rule, "|")
                let act = rp[0]
                steps = steps + "<li><span class=\"badge g\">RULE</span> Matched routing rule action <code>" + html_esc(act) + "</code> (priority " + html_esc(rp[2]) + ")</li>"
                decision = "ROUTING → " + act
                dec_b = "b"
            } else {
                // Longest prefix routes table
                let mut rt = ""
                if ok == 1 {
                    rt = sql_query_str(db, "SELECT g.name || ' @ ' || g.address || ':' || g.port || ' (prefix ' || r.prefix || ')' FROM routes r JOIN gateways g ON r.gateway_id = g.id WHERE r.enabled = true AND g.enabled = true AND ($1 LIKE r.prefix || '%' OR r.prefix = '*') ORDER BY length(r.prefix) DESC, r.priority ASC LIMIT 1", num)
                }
                if len(rt) > 0 {
                    steps = steps + "<li><span class=\"badge g\">ROUTE</span> Gateway <code>" + html_esc(rt) + "</code></li>"
                    decision = "GATEWAY → " + rt
                    dec_b = "b"
                } else {
                    steps = steps + "<li><span class=\"badge r\">ROUTE</span> No routing rule or gateway prefix matched</li>"
                }
            }
        }
    }

    // Dialplan preview
    let mut dp = ""
    if ok == 1 {
        dp = sql_query_str(db, "SELECT match_prefix || ' → callee:' || callee_action || ' caller:' || COALESCE(caller_action,'') FROM dialplan WHERE enabled = true AND $1 LIKE match_prefix || '%' ORDER BY priority ASC LIMIT 1", num)
    }
    if len(dp) > 0 {
        steps = steps + "<li><span class=\"badge y\">DIALPLAN</span> Number translation: <code>" + html_esc(dp) + "</code></li>"
    }

    let mut result = "<div class=\"card\"><h2>Result</h2>"
        + "<p style=\"margin-bottom:12px\">Input <code>" + html_esc(num) + "</code>"
    if len(caller) > 0 { result = result + " from <code>" + html_esc(caller) + "</code>" }
    result = result + "</p>"
        + "<div style=\"font-size:18px;margin-bottom:14px\"><span class=\"badge " + dec_b + "\">" + html_esc(decision) + "</span></div>"
        + "<ol style=\"margin-left:18px;color:var(--muted);font-size:13.5px;line-height:1.9\">" + steps + "</ol></div>"

    return "<div class=\"topbar\"><h1>Route Simulator</h1></div>" + form + result
}

fn f_audit(db: SqlDB, ok: int) -> string {
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS admin_audit (id SERIAL PRIMARY KEY, ts TIMESTAMP DEFAULT NOW(), username TEXT, action TEXT, detail TEXT)")
    let mut rows = ""
    let data = tbl_query(db, ok, "SELECT to_char(ts,'YYYY-MM-DD HH24:MI:SS') || '|' || COALESCE(username,'') || '|' || COALESCE(action,'') || '|' || COALESCE(detail,'') FROM admin_audit ORDER BY ts DESC", 100)
    let mut i = 0
    while i < len(data) {
        let p = str_split(data[i], "|")
        if len(p) >= 4 {
            rows = rows + "<tr><td style=\"font-size:12px;color:var(--muted)\">" + html_esc(p[0]) + "</td><td><strong>" + html_esc(p[1]) + "</strong></td><td><span class=\"badge b\">" + html_esc(p[2]) + "</span></td><td style=\"font-size:12px\">" + html_esc(p[3]) + "</td></tr>"
        }
        i = i + 1
    }
    if len(rows) == 0 {
        rows = "<tr><td colspan=\"4\" style=\"color:var(--muted);text-align:center;padding:20px\">No audit events yet</td></tr>"
    }
    return "<div class=\"topbar\"><h1>Audit Log</h1><div class=\"user\">Admin mutations</div></div>"
        + "<div class=\"card\"><p style=\"color:var(--muted);font-size:13px;margin-bottom:12px\">Who changed users, toggles, deletes, and config. Lightweight trail for operators.</p>"
        + "<table><tr><th>Time</th><th>Admin</th><th>Action</th><th>Detail</th></tr>" + rows + "</table></div>"
}

// ============ HTTP HELPERS ============
