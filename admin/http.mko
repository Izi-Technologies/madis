fn parse_path(raw: string, n: int) -> string {
    let mut i = 0
    while i < n { if int(raw[i]) == 32 { i = i + 1; break }
        i = i + 1 }
    let s = i
    while i < n {
        let c = int(raw[i])
        if c == 32 { return raw[s:i] }
        if c == 63 { return raw[s:i] }
        i = i + 1
    }
    return ""
}

// Query string after ? in request line (without leading ?)
fn parse_query(raw: string, n: int) -> string {
    let mut i = 0
    while i < n { if int(raw[i]) == 32 { i = i + 1; break }
        i = i + 1 }
    while i < n {
        let c = int(raw[i])
        if c == 63 {
            let s = i + 1
            let mut e = s
            while e < n {
                let d = int(raw[e])
                if d == 32 { break }
                e = e + 1
            }
            return raw[s:e]
        }
        if c == 32 { break }
        i = i + 1
    }
    return ""
}

fn query_val(q: string, name: string) -> string {
    let needle = name + "="
    let idx = str_index(q, needle)
    if idx < 0 { return "" }
    // Ensure start or &
    if idx > 0 {
        if int(q[idx - 1]) != 38 { return "" }
    }
    let s = idx + len(needle)
    let mut e = s
    while e < len(q) {
        if int(q[e]) == 38 { break }
        e = e + 1
    }
    return url_decode(q[s:e])
}

// Case-insensitive HTTP header value (first match). Returns trimmed value or "".
fn parse_header(raw: string, n: int, name: string) -> string {
    let wanted = str_to_lower(name)
    let mut line = 0
    while line < n {
        let mut end = line
        while end < n {
            let c = int(raw[end])
            if c == 13 || c == 10 { break }
            end = end + 1
        }
        if end - line > len(wanted) {
            let colon = line + len(wanted)
            if int(raw[colon]) == 58 && str_eq(str_to_lower(raw[line:colon]), wanted) {
                let mut vs = colon + 1
                while vs < end {
                    let c = int(raw[vs])
                    if c != 32 && c != 9 { break }
                    vs = vs + 1
                }
                return str_trim_space(raw[vs:end])
            }
        }
        while end < n {
            let c = int(raw[end])
            if c == 10 { end = end + 1; break }
            end = end + 1
        }
        line = end
    }
    return ""
}

// Authorization: Bearer <token>
// Header name "authorization:" is 14 chars (not 15).
fn parse_bearer(raw: string, n: int) -> string {
    let val = parse_header(raw, n, "authorization")
    if len(val) == 0 { return "" }
    let vlow = str_to_lower(val)
    if str_has_prefix(vlow, "bearer ") {
        return str_trim_space(val[7:])
    }
    return val
}

// Complete RFC 6455 server upgrade for an already-read request.
// Returns the HTTP 101 response body, or "" if the request is not a valid upgrade.
fn ws_upgrade_response(raw: string) -> string {
    if ws_upgrade_request_ok(raw) == 0 { return "" }
    let key = parse_header(raw, len(raw), "Sec-WebSocket-Key")
    if len(key) == 0 { return "" }
    let acc = ws_accept_key(key)
    if len(acc) == 0 { return "" }
    return "HTTP/1.1 101 Switching Protocols\r\n"
        + "Upgrade: websocket\r\n"
        + "Connection: Upgrade\r\n"
        + "Sec-WebSocket-Accept: " + acc + "\r\n"
        + "\r\n"
}

fn parse_method(raw: string, n: int) -> string {
    let mut i = 0
    while i < n { if int(raw[i]) == 32 { return raw[0:i] }
        i = i + 1 }
    return ""
}

fn parse_cookie(raw: string, n: int, name: string) -> string {
    let mut i = 0
    while i < n { if int(raw[i]) == 10 { i = i + 1; break }
        i = i + 1 }
    while i + 7 < n {
        if int(raw[i]) == 13 { break }
        if i + 8 < n {
            if str_eq(str_to_lower(raw[i:i + 7]), "cookie:") {
                let mut vs = i + 7
                if vs < n { if int(raw[vs]) == 32 { vs = vs + 1 } }
                let mut ve = vs
                while ve < n { if int(raw[ve]) == 13 { break }
                    ve = ve + 1 }
                let cookies = raw[vs:ve]
                let clen = len(cookies)
                let mut ci = 0
                while ci < clen {
                    while ci < clen {
                        let ws = int(cookies[ci])
                        if ws != 32 && ws != 9 && ws != 59 { break }
                        ci = ci + 1
                    }
                    let cs = ci
                    while ci < clen {
                        let cc = int(cookies[ci])
                        if cc == 61 || cc == 59 { break }
                        ci = ci + 1
                    }
                    let ce = ci
                    if ci < clen && int(cookies[ci]) == 61 {
                        let start = ci + 1
                        let mut end = start
                        while end < clen { if int(cookies[end]) == 59 { break }
                            end = end + 1 }
                        if str_eq(cookies[cs:ce], name) { return cookies[start:end] }
                        ci = end
                    }
                    while ci < clen && int(cookies[ci]) != 59 { ci = ci + 1 }
                    if ci < clen { ci = ci + 1 }
                }
            }
        }
        while i < n { if int(raw[i]) == 10 { i = i + 1; break }
            i = i + 1 }
    }
    return ""
}

fn parse_body(raw: string, n: int) -> string {
    let mut i = 0
    while i + 3 < n {
        if int(raw[i]) == 13 { if int(raw[i+1]) == 10 { if int(raw[i+2]) == 13 { if int(raw[i+3]) == 10 { return raw[i+4:] } } } }
        i = i + 1
    }
    return ""
}

// The admin listener handles one complete HTTP request per read. Reject
// ambiguous framing and malformed header lines before any route/auth logic.
// Transfer-Encoding is intentionally unsupported; accepting it here would
// make a proxy in front of the admin service disagree about message length.
fn http_headers_safe(raw: string, n: int) -> int {
    if n < 4 { return 0 }
    let mut boundary = -1
    let mut i = 0
    while i + 3 < n {
        if int(raw[i]) == 13 && int(raw[i + 1]) == 10 && int(raw[i + 2]) == 13 && int(raw[i + 3]) == 10 {
            boundary = i
            break
        }
        i = i + 1
    }
    if boundary < 0 || boundary + 4 > 65536 { return 0 }

    // Reject C0 controls except HTAB/CR/LF and reject bare line endings.
    i = 0
    while i < boundary + 4 {
        let c = int(raw[i])
        if c == 0 || c == 127 { return 0 }
        if c < 32 && c != 9 && c != 10 && c != 13 { return 0 }
        if c == 10 {
            if i == 0 || int(raw[i - 1]) != 13 { return 0 }
        }
        if c == 13 {
            if i + 1 >= boundary + 4 || int(raw[i + 1]) != 10 { return 0 }
        }
        i = i + 1
    }

    // The request line is the first line; every later line must have a
    // token-like field name and exactly one Content-Length at most.
    let mut line = 0
    let mut line_number = 0
    let mut content_lengths = 0
    while line < boundary + 2 {
        let mut end = line
        while end + 1 < boundary + 4 {
            if int(raw[end]) == 13 && int(raw[end + 1]) == 10 { break }
            end = end + 1
        }
        if end >= boundary + 2 { return 0 }
        if line_number > 0 {
            if end == line { return 0 }
            let colon = str_index(raw[line:end], ":")
            if colon <= 0 { return 0 }
            let name = raw[line:line + colon]
            let mut ni = 0
            while ni < len(name) {
                let nc = int(name[ni])
                if (nc >= 65 && nc <= 90) || (nc >= 97 && nc <= 122) || (nc >= 48 && nc <= 57) || nc == 45 {
                    ni = ni + 1
                } else {
                    return 0
                }
            }
            let lname = str_to_lower(name)
            if str_eq(lname, "content-length") {
                content_lengths = content_lengths + 1
                if content_lengths > 1 { return 0 }
            }
            if str_eq(lname, "transfer-encoding") { return 0 }
        }
        line = end + 2
        line_number = line_number + 1
    }
    return 1
}

// Admin requests are single-read, single-request messages. Reject oversized
// or truncated bodies instead of parsing a partial form or retaining an
// attacker-controlled amount of data in the connection worker.
fn http_request_size_ok(raw: string, n: int) -> int {
    if n < 0 || n > 131072 { return 0 }
    if http_headers_safe(raw, n) == 0 { return 0 }
    let body = parse_body(raw, n)
    let cl = parse_header(raw, n, "Content-Length")
    if len(cl) == 0 {
        if len(body) > 0 { return 0 }
        return 1
    }
    let mut size = 0
    let mut i = 0
    while i < len(cl) {
        let c = int(cl[i])
        if c < 48 || c > 57 { return 0 }
        if size > 6553 { return 0 }
        size = size * 10 + (c - 48)
        if size > 65536 { return 0 }
        i = i + 1
    }
    if len(body) != size { return 0 }
    return 1
}

// Browser state-changing requests must carry an Origin matching Host. Clients
// without Origin (curl/health tooling) remain supported; SameSite=Lax still
// protects the session cookie for those browser cases.
fn http_post_origin_ok(raw: string, n: int) -> int {
    let origin = parse_header(raw, n, "Origin")
    if len(origin) == 0 { return 1 }
    if str_eq(str_to_lower(origin), "null") { return 0 }
    let host = parse_header(raw, n, "Host")
    if len(host) == 0 { return 0 }
    let marker = str_index(origin, "://")
    if marker < 0 { return 0 }
    let start = marker + 3
    let mut end = len(origin)
    let slash = str_index(origin[start:], "/")
    if slash >= 0 { end = start + slash }
    return if str_eq(str_to_lower(origin[start:end]), str_to_lower(host)) { 1 } else { 0 }
}

fn hex_nibble(c: int) -> int {
    if c >= 48 { if c <= 57 { return c - 48 } }
    if c >= 65 { if c <= 70 { return c - 55 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    return 0 - 1
}

// Decode application/x-www-form-urlencoded values (+ and %XX).
fn url_decode(s: string) -> string {
    let mut b = str_builder()
    let n = len(s)
    let mut i = 0
    while i < n {
        let c = int(s[i])
        if c == 43 {
            builder_write(b, " ")
            i = i + 1
        } else {
            if c == 37 {
                if i + 2 < n {
                    let hi = hex_nibble(int(s[i + 1]))
                    let lo = hex_nibble(int(s[i + 2]))
                    if hi >= 0 {
                        if lo >= 0 {
                            builder_write_byte(b, byte(hi * 16 + lo))
                            i = i + 3
                        } else {
                            builder_write_byte(b, byte(c))
                            i = i + 1
                        }
                    } else {
                        builder_write_byte(b, byte(c))
                        i = i + 1
                    }
                } else {
                    builder_write_byte(b, byte(c))
                    i = i + 1
                }
            } else {
                builder_write_byte(b, byte(c))
                i = i + 1
            }
        }
    }
    return builder_string(b)
}

// Parse an application/x-www-form-urlencoded body once per request. Keeping
// the first value matches form_val's behavior for duplicate fields while
// avoiding a full split/decode for every field read in an API handler.
fn form_map(body: string) -> CMap {
    let out = cmap_new()
    let parts = str_split(body, "&")
    let mut i = 0
    while i < len(parts) {
        let part = parts[i]
        let eq = str_index(part, "=")
        let mut raw_key = part
        let mut raw_value = ""
        if eq >= 0 {
            raw_key = part[0:eq]
            raw_value = part[eq + 1:]
        }
        let key = url_decode(raw_key)
        if len(key) > 0 {
            if cmap_has(out, key) == 0 {
                cmap_set(out, key, url_decode(raw_value))
            }
        }
        i = i + 1
    }
    return out
}

fn form_get(fields: CMap, field: string) -> string {
    if cmap_has(fields, field) == 1 { return cmap_get(fields, field) }
    return ""
}

// Hex session id only (no + / =) — base64 tokens break browser cookies when they start with /
fn session_token_new() -> string {
    return sha256(random_bytes(32))
}

// Accept only 64-char lowercase hex session tokens.
fn session_token_ok(tk: string) -> int {
    if len(tk) != 64 { return 0 }
    let mut i = 0
    while i < 64 {
        let c = int(tk[i])
        let mut ok = 0
        if c >= 48 { if c <= 57 { ok = 1 } }
        if c >= 97 { if c <= 102 { ok = 1 } }
        if ok == 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn http_resp(st: int, ctype: string, body: string, extra: string) -> string {
    let mut sn = "OK"
    if st == 200 { sn = "OK" }
    if st == 201 { sn = "Created" }
    if st == 202 { sn = "Accepted" }
    if st == 302 { sn = "Found" }
    if st == 400 { sn = "Bad Request" }
    if st == 401 { sn = "Unauthorized" }
    if st == 403 { sn = "Forbidden" }
    if st == 404 { sn = "Not Found" }
    if st == 405 { sn = "Method Not Allowed" }
    if st == 429 { sn = "Too Many Requests" }
    if st == 500 { sn = "Internal Server Error" }
    if st == 502 { sn = "Bad Gateway" }
    if st == 503 { sn = "Service Unavailable" }
    return "HTTP/1.1 " + string(st) + " " + sn + "\r\nContent-Type: " + ctype + "\r\nContent-Length: " + string(len(body)) + "\r\nConnection: keep-alive\r\n" + extra + "\r\n" + body
}

// Session cookie attributes. Secure is on by default (HTTPS via leba).
// Set ADMIN_SECURE_COOKIE=0 for plain-HTTP local dev.
fn cookie_secure_suffix() -> string {
    let sec = env_get_or("ADMIN_SECURE_COOKIE", "1")
    if str_eq(sec, "0") { return "" }
    if str_eq(sec, "false") { return "" }
    if str_eq(sec, "no") { return "" }
    return "; Secure"
}

// Positive int from env (digits only); def if missing/invalid.
fn env_pos_int(name: string, def: int) -> int {
    let s = env_get_or(name, "")
    if len(s) == 0 { return def }
    let mut n = 0
    let mut i = 0
    while i < len(s) {
        let c = int(s[i])
        if c < 48 { return def }
        if c > 57 { return def }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    if n <= 0 { return def }
    if n > 2147483647 { return def }
    return n
}

// Default session lifetime: 24h. Override with ADMIN_SESSION_TTL_SECS.
fn session_ttl_secs() -> int {
    let ttl = env_pos_int("ADMIN_SESSION_TTL_SECS", 86400)
    if ttl > 604800 { return 604800 }
    return ttl
}

// Keep process-local sessions bounded even if an authenticated client creates
// tokens repeatedly. Ring entries are metadata in the same CMap and are never
// treated as session payloads.
fn session_cache_set(sessions: CMap, token: string, payload: string) -> int {
    let seq_key = "__session_seq"
    let ring_prefix = "__session_ring|"
    if cmap_has(sessions, token) == 1 {
        cmap_set(sessions, token, payload)
        return 0
    }
    let seq = cmap_incr(sessions, seq_key, 1)
    let capacity = 65536
    let slot = seq - (seq / capacity) * capacity
    let ring_key = ring_prefix + string(slot)
    if cmap_has(sessions, ring_key) == 1 {
        let old = cmap_get(sessions, ring_key)
        if len(old) > 0 && not str_eq(old, token) { let _ = cmap_del(sessions, old) }
    }
    cmap_set(sessions, ring_key, token)
    cmap_set(sessions, token, payload)
    return 0
}

fn login_fail_key(user: string) -> string {
    if len(user) == 0 { return "__login_fail|_" }
    if len(user) > 256 { return "__login_fail|oversize|" + sha256(user) }
    return "__login_fail|" + user
}

fn login_fail_cache_set(fails: CMap, key: string, value: string) -> int {
    let seq_key = "__login_seq"
    let ring_prefix = "__login_ring|"
    if cmap_has(fails, key) == 1 {
        cmap_set(fails, key, value)
        return 0
    }
    let seq = cmap_incr(fails, seq_key, 1)
    let capacity = 16384
    let slot = seq - (seq / capacity) * capacity
    let ring_key = ring_prefix + string(slot)
    if cmap_has(fails, ring_key) == 1 {
        let old = cmap_get(fails, ring_key)
        if len(old) > 0 && not str_eq(old, key) { let _ = cmap_del(fails, old) }
    }
    cmap_set(fails, ring_key, key)
    cmap_set(fails, key, value)
    return 0
}

fn session_cookie_set(token: string) -> string {
    let ttl = session_ttl_secs()
    // SameSite=Lax so top-level navigations after login keep the cookie reliably
    return "session=" + token + "; Path=/; HttpOnly; SameSite=Lax; Max-Age=" + string(ttl) + cookie_secure_suffix()
}

fn session_cookie_clear() -> string {
    return "session=; Path=/; Max-Age=0; SameSite=Lax" + cookie_secure_suffix()
}

// Login lockout: ADMIN_LOGIN_MAX_FAILS (default 5) per ADMIN_LOGIN_LOCK_SECS (default 900).
// Value in cmap: "fail_count|window_start_ms"
fn login_is_locked(fails: CMap, user: string) -> int {
    let key = login_fail_key(user)
    if cmap_has(fails, key) == 0 { return 0 }
    let sp = str_split(cmap_get(fails, key), "|")
    if len(sp) < 2 { return 0 }
    let mut count = 0
    let mut si = 0
    while si < len(sp[0]) {
        let c = int(sp[0][si])
        if c < 48 { break }
        if c > 57 { break }
        count = count * 10 + (c - 48)
        si = si + 1
    }
    let mut start = 0
    let mut sj = 0
    while sj < len(sp[1]) {
        let c2 = int(sp[1][sj])
        if c2 < 48 { break }
        if c2 > 57 { break }
        start = start * 10 + (c2 - 48)
        sj = sj + 1
    }
    let lock_ms = env_pos_int("ADMIN_LOGIN_LOCK_SECS", 900) * 1000
    let maxf = env_pos_int("ADMIN_LOGIN_MAX_FAILS", 5)
    let now = now_ms()
    if now - start > lock_ms {
        let _ = cmap_del(fails, key)
        return 0
    }
    if count >= maxf { return 1 }
    return 0
}

fn login_record_fail(fails: CMap, user: string) {
    let key = login_fail_key(user)
    let lock_ms = env_pos_int("ADMIN_LOGIN_LOCK_SECS", 900) * 1000
    let now = now_ms()
    if cmap_has(fails, key) == 0 {
        let _ = login_fail_cache_set(fails, key, "1|" + string(now))
        return
    }
    let sp = str_split(cmap_get(fails, key), "|")
    if len(sp) < 2 {
        let _ = login_fail_cache_set(fails, key, "1|" + string(now))
        return
    }
    let mut start = 0
    let mut sj = 0
    while sj < len(sp[1]) {
        let c2 = int(sp[1][sj])
        if c2 < 48 { break }
        if c2 > 57 { break }
        start = start * 10 + (c2 - 48)
        sj = sj + 1
    }
    if now - start > lock_ms {
        let _ = login_fail_cache_set(fails, key, "1|" + string(now))
        return
    }
    let mut count = 0
    let mut si = 0
    while si < len(sp[0]) {
        let c = int(sp[0][si])
        if c < 48 { break }
        if c > 57 { break }
        count = count * 10 + (c - 48)
        si = si + 1
    }
    let _ = login_fail_cache_set(fails, key, string(count + 1) + "|" + string(start))
}

fn login_clear_fails(fails: CMap, user: string) {
    let key = login_fail_key(user)
    if cmap_has(fails, key) == 1 { let _ = cmap_del(fails, key) }
}

// Session payload: "user|role|created_ms". Returns "" if expired/invalid.
fn session_payload_valid(payload: string) -> string {
    let sp = str_split(payload, "|")
    if len(sp) < 2 { return "" }
    let mut created = 0
    if len(sp) >= 3 {
        let mut k = 0
        while k < len(sp[2]) {
            let c = int(sp[2][k])
            if c < 48 { break }
            if c > 57 { break }
            created = created * 10 + (c - 48)
            k = k + 1
        }
    }
    if created > 0 {
        let ttl_ms = session_ttl_secs() * 1000
        if now_ms() - created > ttl_ms { return "" }
    }
    return sp[0] + "|" + sp[1]
}

fn session_payload_new(user: string, role: string) -> string {
    return user + "|" + role + "|" + string(now_ms())
}

fn redirect(path: string, cookie: string) -> string {
    let mut extra = "Location: " + path + "\r\n"
    if len(cookie) > 0 { extra = extra + "Set-Cookie: " + cookie + "\r\n" }
    return "HTTP/1.1 302 Found\r\n" + extra + "Content-Length: 0\r\n\r\n"
}

fn role_level(role: string) -> int {
    if str_eq(role, "viewer") { return 0 }
    if str_eq(role, "operator") { return 1 }
    if str_eq(role, "admin") { return 2 }
    if str_eq(role, "super_admin") { return 3 }
    return -1
}

fn check_role(required: string, actual: string) -> int {
    let mut needed = -1
    if str_eq(required, "viewer") { needed = 0 }
    if str_eq(required, "operator") { needed = 1 }
    if str_eq(required, "admin") { needed = 2 }
    if str_eq(required, "super_admin") { needed = 3 }
    let have = role_level(actual)
    if needed < 0 || have < 0 { return 0 }
    if have >= needed { return 1 }
    return 0
}

// ============ REQUEST HANDLER ============
