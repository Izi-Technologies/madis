// Mako SIP Admin Panel — main entry point
import "./log.mko"
import "./ui.mko"
import "./pages.mko"
import "./http.mko"
import "./handlers.mko"
pull . "../carrier_api.mko"
pull . "../maf_api.mko"
pull . "../ims_subscriber_service.mko"
pull . "../control_resources.mko"

fn main() {
    let db_url = env_get_or("SIP_DB_URL", "")
    let mut db_ok = 0
    let mut db = sql_open_postgres("")
    if len(db_url) > 0 {
        db = sql_open_postgres(db_url)
        db_ok = 1
        let _ = ims_subscriber_service_bootstrap(db)
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS admin_users (id SERIAL PRIMARY KEY, username TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL, role TEXT DEFAULT 'viewer', enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS admin_sessions (token TEXT PRIMARY KEY, username TEXT NOT NULL, role TEXT NOT NULL, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS billing_events (event_id TEXT PRIMARY KEY, call_id TEXT NOT NULL DEFAULT '', event_type TEXT NOT NULL, payload_json JSONB NOT NULL, occurred_at TIMESTAMP DEFAULT NOW(), available_at TIMESTAMP DEFAULT NOW(), delivered_at TIMESTAMP, attempts INT NOT NULL DEFAULT 0, last_error TEXT NOT NULL DEFAULT '', CONSTRAINT billing_event_id_size CHECK (char_length(event_id) BETWEEN 16 AND 128), CONSTRAINT billing_event_payload_size CHECK (octet_length(payload_json::text) <= 65536))")
        let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_billing_events_pending ON billing_events (occurred_at, event_id) WHERE delivered_at IS NULL")
        let _ = maf_api_bootstrap(db)
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS access_control (id SERIAL PRIMARY KEY, source_ip TEXT DEFAULT '*', sip_user TEXT DEFAULT '*', action TEXT DEFAULT 'allow', skip_auth BOOLEAN DEFAULT false, tenant TEXT DEFAULT 'default', max_channels INT DEFAULT 0, priority INT DEFAULT 10, enabled BOOLEAN DEFAULT true, description TEXT, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS ani_groups (id SERIAL PRIMARY KEY, name TEXT UNIQUE NOT NULL, description TEXT DEFAULT '', enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS ani_ranges (id SERIAL PRIMARY KEY, group_id INT NOT NULL, range_start TEXT NOT NULL, range_end TEXT NOT NULL, enabled BOOLEAN DEFAULT true, created_at TIMESTAMP DEFAULT NOW())")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS number_format TEXT DEFAULT 'e164'")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS tech_prefix TEXT DEFAULT ''")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS caller_id_override TEXT DEFAULT ''")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS health_status TEXT DEFAULT 'unknown'")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS last_health_code INT DEFAULT 0")
        let _ = sql_exec_plain(db, "ALTER TABLE gateways ADD COLUMN IF NOT EXISTS last_health_check TIMESTAMP")
        let ac = sql_query_str(db, "SELECT COUNT(*) FROM admin_users", "")
        if str_eq(ac, "0") {
            // Bootstrap only when SIP_ADMIN_PASSWORD is set — never hardcode admin/admin.
            let init = env_get_or("SIP_ADMIN_PASSWORD", "")
            if len(init) > 0 {
            let password_hash = admin_password_hash(init)
            if len(password_hash) > 0 {
                let _ = sql_exec_str4(db, "INSERT INTO admin_users (username, password_hash, role) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", "admin", password_hash, "super_admin", "")
            }
                slog("  Bootstrap admin created from SIP_ADMIN_PASSWORD")
            } else {
                slog("  WARNING: no admin users — set SIP_ADMIN_PASSWORD and restart to bootstrap")
            }
        }
        // Default access policy if none configured (auth still required unless skip_auth)
        let ac_n = sql_query_str(db, "SELECT COUNT(*) FROM access_control", "")
        if str_eq(ac_n, "0") {
            let _ = sql_exec_plain(db, "INSERT INTO access_control (source_ip, sip_user, action, skip_auth, description, priority, enabled) VALUES ('*', '*', 'allow', false, 'Default allow (digest auth required)', 100, true)")
            slog("  Seeded default access_control allow *")
        }
    }
    let sessions = cmap_new()
    let login_fails = cmap_new()
    let live_cache = cmap_new()
    let dashboard_cache = cmap_new()
    let ttl = session_ttl_secs()
    // Default loopback-only — leba (or nginx) terminates TLS and proxies in.
    // Set ADMIN_BIND=0.0.0.0 only if you intentionally expose admin publicly.
    let bind_host = env_get_or("ADMIN_BIND", "127.0.0.1")
    let bind_port = env_pos_int("ADMIN_PORT", 8080)
    slog("Mako SIP Admin on " + bind_host + ":" + string(bind_port) + " (session_ttl=" + string(ttl) + "s)")

    let lfd = tcp_listen_addr(bind_host, bind_port)
    if lfd < 0 { slog("ERROR: cannot bind " + bind_host + ":" + string(bind_port)); return }
    let _ = io_set_nonblocking(lfd, 1)
    let el = evloop_new()
    let _ = evloop_add(el, lfd, 1)

    // Crew owns long-lived WebSocket live sessions kicked from the accept loop.
    crew ws_crew {
    while shutdown_requested() == 0 {
        // Keep the wait finite so SIGTERM can drain the worker without
        // relying on systemd's SIGKILL fallback.
        let n = evloop_wait(el, 100)
        if n <= 0 { continue }
        let mut i = 0
        while i < n {
            let fd = evloop_event_fd(el, i)
            if fd == lfd {
                let mut a = 1
                while a == 1 {
                    let cfd = nb_accept(lfd)
                    if cfd < 0 { a = 0 } else { let _ = evloop_add(el, cfd, 1) }
                }
            } else {
                let flags = evloop_event_flags(el, i)
                if flags / 4 > 0 {
                    let _ = evloop_del(el, fd)
                    let _ = nb_close(fd)
                } else {
                    let raw = nb_read(fd)
                    let rl = len(raw)
                    if rl == 0 {
                        let _ = evloop_del(el, fd)
                        let _ = nb_close(fd)
                    } else {
                        let method = parse_method(raw, rl)
                        let mut path = parse_path(raw, rl)
                        let mut resp = ""
                        let mut ws_handed_off = 0

                        if http_request_size_ok(raw, rl) == 0 {
                            resp = http_resp(400, "text/plain", "invalid request size or body\n", "Connection: close\r\n")
                            path = "__invalid_request__"
                        }
                        if len(resp) == 0 && str_eq(method, "POST") && http_post_origin_ok(raw, rl) == 0 {
                            resp = http_resp(403, "text/plain", "cross-origin request rejected\n", "Connection: close\r\n")
                            path = "__invalid_request__"
                        }

                        // Favicon (no auth) — browsers always request /favicon.ico
                        if str_eq(path, "/favicon.ico") {
                            resp = http_resp(200, "image/svg+xml", favicon_svg(), "Cache-Control: public, max-age=86400\r\n")
                        }
                        if str_eq(path, "/favicon.svg") {
                            resp = http_resp(200, "image/svg+xml", favicon_svg(), "Cache-Control: public, max-age=86400\r\n")
                        }

                        // Login (no auth)
                        if str_eq(path, "/admin/login") {
                            if str_eq(method, "POST") {
                                let body = parse_body(raw, rl)
                                let fields = form_map(body)
                                let u = form_get(fields, "username")
                                if login_is_locked(login_fails, u) == 1 {
                                    resp = http_resp(200, "text/html", html_login_msg("Too many failed attempts. Wait a few minutes and try again."), "")
                                } else {
                            let password = form_get(fields, "password")
                            if db_ok == 1 {
                                let stored = sql_query_str(db, "SELECT password_hash FROM admin_users WHERE username = $1 AND enabled = true", u)
                                if admin_password_valid(stored, password) == 1 {
                                    if admin_password_is_modern(stored) == 0 {
                                        let migrated = admin_password_hash(password)
                                        if len(migrated) > 0 { let _ = sql_exec_str4(db, "UPDATE admin_users SET password_hash = $2 WHERE username = $1", u, migrated, "", "") }
                                    }
                                            login_clear_fails(login_fails, u)
                                            let role = sql_query_str(db, "SELECT role FROM admin_users WHERE username = $1", u)
                                            let token = session_token_new()
                                            let _ = sql_exec_str4(db, "INSERT INTO admin_sessions (token, username, role) VALUES ($1, $2, $3) ON CONFLICT DO NOTHING", token, u, role, "")
                                            let _ = sql_exec_str4(db, "DELETE FROM admin_sessions WHERE created_at < NOW() - ($1 || ' seconds')::interval", string(session_ttl_secs()), "", "", "")
                                            let _ = session_cache_set(sessions, token, session_payload_new(u, role))
                                            slog("  login ok user=" + u)
                                            resp = redirect("/admin", session_cookie_set(token))
                                        } else {
                                            login_record_fail(login_fails, u)
                                            slog("  login fail user=" + u)
                                            resp = http_resp(200, "text/html", html_login_msg("Invalid username or password."), "")
                                        }
                                    } else {
                                        resp = http_resp(200, "text/html", html_login_msg("Database unavailable."), "")
                                    }
                                }
                            } else {
                                resp = http_resp(200, "text/html", html_login(), "")
                            }
                        }

                        // Logout
                        if str_eq(path, "/admin/logout") {
                            let tk = parse_cookie(raw, rl, "session")
                            if len(tk) > 0 {
                                let _ = cmap_del(sessions, tk)
                                if db_ok == 1 {
                                    let _ = sql_exec_str4(db, "DELETE FROM admin_sessions WHERE token = $1", tk, "", "", "")
                                }
                            }
                            resp = redirect("/admin/login", session_cookie_clear())
                        }

                        // Prometheus scrape without browser session:
                        //   Authorization: Bearer $ADMIN_METRICS_TOKEN
                        //   (query-string tokens are deliberately rejected)
                        if len(resp) == 0 {
                            if str_eq(method, "GET") {
                                let mtok = env_get_or("ADMIN_METRICS_TOKEN", "")
                                if len(mtok) >= 16 && len(mtok) <= 512 {
                                    let btok = parse_bearer(raw, rl)
                                    if admin_metrics_token_valid(btok, mtok) == 1 {
                                        if str_eq(path, "/admin/api/prom") {
                                            let body = fetch_metrics_path("/metrics")
                                            if len(body) == 0 {
                                                resp = http_resp(502, "text/plain", "metrics unreachable\n", "")
                                            } else {
                                                resp = http_resp(200, "text/plain; version=0.0.4; charset=utf-8", body, "")
                                            }
                                        }
                                        if str_eq(path, "/admin/api/stats") {
                                            let body = fetch_metrics_json()
                                            if len(body) == 0 {
                                                resp = http_resp(502, "application/json", "{}", "")
                                            } else {
                                                resp = http_resp(200, "application/json", body, "")
                                            }
                                        }
                                        if str_eq(path, "/admin/api/dialogs") {
                                            let body = fetch_dialogs_json()
                                            if len(body) == 0 {
                                                resp = http_resp(502, "application/json", "[]", "")
                                            } else {
                                                resp = http_resp(200, "application/json", body, "")
        }
    }
    let _ = evloop_del(el, lfd)
    let _ = nb_close(lfd)
}
                                }
                            }
                        }

                        // Machine API: bearer token only, never a browser
                        // session. This keeps carrier integrations independent
                        // of HTML cookies and CSRF semantics.
    let maf_kind = maf_api_route(method, path)
    if len(resp) == 0 && maf_kind > 0 {
        let maf_scope = maf_api_scope(raw, rl)
        if maf_scope == 0 || (maf_api_write_required(maf_kind) == 1 && maf_scope < 2) {
            resp = http_resp(401, "application/json", "{\"ok\":false,\"error\":\"MAF bearer token required\"}\n", "WWW-Authenticate: Bearer\r\nCache-Control: no-store\r\n")
        } else {
            resp = maf_api_handle(db, db_ok, method, path, raw, rl)
        }
    }
    let maf_ws_kind = maf_api_ws_route(method, path)
    if len(resp) == 0 && maf_ws_kind > 0 {
        let maf_scope = maf_api_scope(raw, rl)
        if maf_scope == 0 {
            resp = "HTTP/1.1 401 Unauthorized\r\nContent-Type: text/plain\r\nContent-Length: 12\r\nConnection: close\r\n\r\nunauthorized"
        } else {
            let up = ws_upgrade_response(raw)
            if len(up) == 0 {
                resp = http_resp(400, "text/plain", "bad websocket upgrade\n", "Connection: close\r\n")
            } else {
                let query = parse_query(raw, rl)
                let event_type = query_val(query, "event_type")
                if maf_api_parse_cursor(query) < 0 || (len(event_type) > 0 && maf_api_identifier_ok(event_type, 1, 128) == 0) {
                    resp = http_resp(400, "application/json", "{\"ok\":false,\"error\":\"invalid event subscription\"}\n", "Cache-Control: no-store\r\n")
                } else {
                    let _ = evloop_del(el, fd)
                    let _ = io_set_nonblocking(fd, 0)
                    let wr = tcp_write_all(fd, up)
                    if wr < 0 {
                        let _ = nb_close(fd)
                    } else {
                        let _ = ws_crew.kick(maf_api_ws_session(fd, db_url, maf_api_tenant(), query))
                        ws_handed_off = 1
                        slog("  ws MAF event session tenant=" + maf_api_tenant())
                    }
                }
            }
        }
    }
    let subscriber_service_resp = ims_subscriber_service_handle(db, db_ok, method, path, raw, rl)
    if len(resp) == 0 && len(subscriber_service_resp) > 0 { resp = subscriber_service_resp }
    let machine_kind = carrier_api_route(method, path)
                        if len(resp) == 0 && machine_kind > 0 {
                            let mut machine_auth = carrier_api_token_ok(raw, rl)
                            let mut control_scope = 0
                            if carrier_api_requires_control(machine_kind) == 1 {
                                control_scope = carrier_api_control_scope(raw, rl)
                                machine_auth = if control_scope > 0 { 1 } else { 0 }
                                if carrier_api_control_write_required(machine_kind) == 1 && control_scope < 2 { machine_auth = 0 }
                            }
                            if machine_auth == 1 {
                                resp = carrier_api_handle(db, db_ok, method, path, raw, rl)
                            } else {
                                let mut message = "carrier bearer token required"
                                if carrier_api_requires_control(machine_kind) == 1 {
                                    message = "control bearer token required"
                                    if control_scope == 1 && carrier_api_control_write_required(machine_kind) == 1 { message = "control write scope required" }
                                }
                                resp = http_resp(401, "application/json", "{\"ok\":false,\"error\":\"" + message + "\"}\n", "WWW-Authenticate: Bearer\r\n")
                            }
                        }

                        // All other routes need auth
                        if len(resp) == 0 {
                            let tk = parse_cookie(raw, rl, "session")
                            let mut au = ""
                            let mut ar = ""
                            // Reject empty / malformed tokens immediately (never treat as logged-in)
                            if session_token_ok(tk) == 1 {
                                if cmap_has(sessions, tk) == 1 {
                                    let valid = session_payload_valid(cmap_get(sessions, tk))
                                    if len(valid) > 0 {
                                        let sp = str_split(valid, "|")
                                        if len(sp) >= 2 {
                                            if len(sp[0]) > 0 {
                                                au = sp[0]
                                                ar = sp[1]
                                            }
                                        }
                                    } else {
                                        let _ = cmap_del(sessions, tk)
                                    }
                                } else {
                                    // Restore from DB only for well-formed tokens + enabled users
                                    if db_ok == 1 {
                                        let db_user = sql_query_str2(db, "SELECT s.username || '|' || s.role FROM admin_sessions s JOIN admin_users u ON u.username = s.username WHERE s.token = $1 AND u.enabled = true AND s.created_at > NOW() - ($2 || ' seconds')::interval LIMIT 1", tk, string(session_ttl_secs()))
                                        if len(db_user) > 0 {
                                            let sp = str_split(db_user, "|")
                                            if len(sp) >= 2 {
                                                if len(sp[0]) > 0 {
                                                    au = sp[0]
                                                    ar = sp[1]
                                                    let _ = session_cache_set(sessions, tk, session_payload_new(au, ar))
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Require non-empty authenticated identity
                        if len(au) == 0 && ws_handed_off == 0 {
                                // WebSocket upgrade without session → close (no HTML redirect body)
                                if str_eq(path, "/admin/ws/live") {
                                    if ws_upgrade_request_ok(raw) == 1 {
                                        resp = "HTTP/1.1 401 Unauthorized\r\nContent-Type: text/plain\r\nContent-Length: 12\r\nConnection: close\r\n\r\nunauthorized"
                                    } else {
                                        resp = redirect("/admin/login", session_cookie_clear())
                                    }
                                } else {
                                    resp = redirect("/admin/login", session_cookie_clear())
                                }
                            } else {
                                // Realtime dashboard WebSocket (auth required)
                                if str_eq(path, "/admin/ws/live") {
                                    if str_eq(method, "GET") {
                                        let up = ws_upgrade_response(raw)
                                        if len(up) > 0 {
                                            let _ = evloop_del(el, fd)
                                            // Blocking write for full 101 handshake before kick
                                            let _ = io_set_nonblocking(fd, 0)
                                            let wr = tcp_write_all(fd, up)
                                            if wr < 0 {
                                                let _ = nb_close(fd)
                                            } else {
                                                let _ = ws_crew.kick(ws_live_session(fd, db_url, live_cache))
                                                ws_handed_off = 1
                                                slog("  ws live session user=" + au)
                                            }
                                        } else {
                                            resp = http_resp(400, "text/plain", "bad websocket upgrade\n", "")
                                        }
                                    }
                                }

                                // Full page — / and /admin both open the command center
                                if len(resp) == 0 {
                                    if ws_handed_off == 0 {
                                        if str_eq(path, "/admin") {
                                            resp = http_resp(200, "text/html", html_page("Dashboard", au, ar, f_dashboard_cached(db, db_ok, dashboard_cache)), "")
                                        }
                                        if str_eq(path, "/") {
                                            resp = http_resp(200, "text/html", html_page("Dashboard", au, ar, f_dashboard_cached(db, db_ok, dashboard_cache)), "")
                                        }
                                    }
                                }

                                // HTMX fragments (pass query string for filters / deep links)
                                if len(resp) == 0 {
                                    if ws_handed_off == 0 {
                                        let q = parse_query(raw, rl)
                                        let page = handle_page(path, q, db, db_ok, dashboard_cache)
                                        if len(page) > 0 {
                                            resp = http_resp(200, "text/html", page, "")
                                        }
                                    }
                                }

                                // Auth-proxied metrics (session required) — safe to expose via leba
                                if len(resp) == 0 {
                                    if str_eq(method, "GET") {
                                        if str_eq(path, "/admin/api/prom") {
                                            let body = fetch_metrics_path("/metrics")
                                            if len(body) == 0 {
                                                resp = http_resp(502, "text/plain", "metrics unreachable\n", "")
                                            } else {
                                                resp = http_resp(200, "text/plain; version=0.0.4; charset=utf-8", body, "")
                                            }
                                        }
                                        if str_eq(path, "/admin/api/dialogs") {
                                            let body = fetch_dialogs_json()
                                            if len(body) == 0 {
                                                resp = http_resp(502, "application/json", "[]", "")
                                            } else {
                                                resp = http_resp(200, "application/json", body, "")
                                            }
                                        }
                                        if str_eq(path, "/admin/api/stats") {
                                            let body = fetch_metrics_json()
                                            if len(body) == 0 {
                                                resp = http_resp(502, "application/json", "{}", "")
                                            } else {
                                                resp = http_resp(200, "application/json", body, "")
                                            }
                                        }
                                        // Live dashboard snapshot (auth) — HTTP fallback when WS is not available at the edge
                                        if str_eq(path, "/admin/api/live") {
                                            let sip = sip_options_probe()
                                            let body = live_snapshot_cached(db, db_ok, sip, live_cache)
                                            resp = http_resp(200, "application/json", body, "Cache-Control: no-store\r\n")
                                        }
                                        // CDR CSV export (auth required)
                                        if str_eq(path, "/admin/api/cdr.csv") {
                                            let mut csv = "call_id,caller,callee,status,started_at,duration_sec,destination,source_ip\n"
                                            if db_ok == 1 {
                                                let data = tbl_query(db, db_ok, "SELECT COALESCE(call_id,'') || ',' || COALESCE(caller,'') || ',' || COALESCE(callee,'') || ',' || COALESCE(replace(status,',',';'),'') || ',' || COALESCE(to_char(started_at,'YYYY-MM-DD HH24:MI:SS'),'') || ',' || COALESCE(duration_sec::text,'') || ',' || COALESCE(destination,'') || ',' || COALESCE(source_ip,'') FROM cdr ORDER BY started_at DESC", 500)
                                                let mut ci = 0
                                                while ci < len(data) {
                                                    csv = csv + data[ci] + "\n"
                                                    ci = ci + 1
                                                }
                                            }
                                            resp = http_resp(200, "text/csv; charset=utf-8", csv, "Content-Disposition: attachment; filename=\"cdr.csv\"\r\n")
                                        }
                                    }
                                }

                                // API endpoints
                                if len(resp) == 0 {
                                    if str_eq(method, "POST") {
                                        let body = parse_body(raw, rl)
                                        let fields = form_map(body)
                                        let result = handle_api(path, fields, ar, au, db, db_ok)
                                        if str_eq(result, "FORBIDDEN") {
                                            resp = http_resp(403, "text/html", "<div class=\"alert err\">Forbidden</div>", "")
                                        } else {
                                            if str_eq(result, "OK") {
                                                resp = http_resp(200, "text/html", "<div class=\"alert ok\">Done</div>", "")
                                            } else {
                                                if len(result) > 0 {
                                                    resp = http_resp(200, "text/html", result, "")
                                                }
                                            }
                                        }
                                    }
                                }

                                // 404
                                if len(resp) == 0 {
                                    if ws_handed_off == 0 {
                                        resp = http_resp(404, "text/html", "<div class=\"alert err\">Not found</div>", "")
                                    }
                                }
                            }
                        }

                        if ws_handed_off == 0 {
                            if len(resp) > 0 {
                                let _ = nb_write(fd, resp)
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    } // crew ws_crew
}
