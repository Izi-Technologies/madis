// ============ UPSTREAM TRANSPORTS ============
// Preserve the transport advertised by a registered contact or Via. UDP is
// still the fast path; stream transports use bounded one-shot connections so
// a dead gateway cannot block a SIP worker indefinitely.

fn sip_transport_param(target: string, fallback: string) -> string {
    // Scan for "transport=" case-insensitively without lowering the whole URI.
    // Most targets are <100 bytes; scan bytes for 't'/'T' then verify.
    let tlen = len(target)
    let mut p = -1
    let mut si = 0
    while si + 10 <= tlen {
        let c = int(target[si])
        if (c == 116 || c == 84) && str_eq(str_to_lower(target[si:si + 10]), "transport=") {
            p = si
            break
        }
        si = si + 1
    }
    if p >= 0 {
        let start = p + 10
        let mut end = start
        while end < tlen {
            let c = int(target[end])
            if c == 59 || c == 62 || c == 32 || c == 9 { break }
            end = end + 1
        }
        if end > start { return str_to_lower(target[start:end]) }
    }
    // Check scheme — only lowercase the first 5 bytes
    if str_has_prefix(target, "sips:") || str_has_prefix(target, "tls:") { return "tls" }
    if str_has_prefix(target, "ws:") { return "ws" }
    if str_has_prefix(target, "wss:") { return "wss" }
    if len(target) >= 5 {
        let scheme = str_to_lower(target[0:5])
        if str_has_prefix(scheme, "sips:") || str_has_prefix(scheme, "tls:") { return "tls" }
        if str_has_prefix(scheme, "wss:") { return "wss" }
        if str_has_prefix(scheme, "ws:") { return "ws" }
    }
    return str_to_lower(fallback)
}

fn sip_target_path(target: string) -> string {
    let low = str_to_lower(target)
    let mut scheme = str_index(low, "ws://")
    if scheme < 0 { scheme = str_index(low, "wss://") }
    if scheme < 0 { return "/" }
    let start = str_index(target[scheme:], "/")
    if start < 0 { return "/" }
    let mut path = target[scheme + start:]
    let semi = str_index(path, ";")
    if semi >= 0 { path = path[0:semi] }
    if len(path) == 0 { return "/" }
    return path
}

fn sip_target_explicit_port(target: string) -> int {
    if sip_target_port_state(target) == 1 { return 1 }
    return 0
}

fn sip_srv_service(target: string, transport: string) -> string {
    if sip_target_explicit_port(target) == 1 { return "" }
    let host = sip_target_host(target)
    if len(host) == 0 || parse_ip_ok(host) == 1 { return "" }
    let tr = str_to_lower(transport)
    if str_eq(tr, "tls") || str_eq(tr, "sips") { return "_sips._tcp." + host }
    if str_has_prefix(target, "sips:") || str_has_prefix(target, "tls://") { return "_sips._tcp." + host }
    if len(target) >= 5 {
        let scheme = str_to_lower(target[0:5])
        if str_has_prefix(scheme, "sips:") { return "_sips._tcp." + host }
    }
    if str_eq(tr, "tcp") { return "_sip._tcp." + host }
    return "_sip._udp." + host
}

fn sip_srv_record_priority(record: string) -> int {
    let parts = str_split(record, ":")
    if len(parts) < 4 { return -1 }
    let mut value = -1
    match parse_int(str_trim_space(parts[0])) { Ok(v) => { value = v } Err(_) => { value = -1 } }
    return value
}

fn sip_srv_record_weight(record: string) -> int {
    let parts = str_split(record, ":")
    if len(parts) < 4 { return 0 }
    let mut value = 0
    match parse_int(str_trim_space(parts[1])) { Ok(v) => { value = v } Err(_) => { value = 0 } }
    return value
}

fn sip_srv_record_target(record: string) -> string {
    let parts = str_split(record, ":")
    if len(parts) < 4 { return "" }
    let port = parse_int(str_trim_space(parts[2]))
    let mut host = str_trim_space(parts[3])
    if len(host) > 0 && int(host[len(host) - 1]) == 46 { host = host[0:len(host) - 1] }
    match port { Ok(v) => { if v > 0 && v <= 65535 && len(host) > 0 { return host + ":" + string(v) } } Err(_) => {} }
    return ""
}

fn sip_naptr_record_order(record: string) -> int {
    let parts = str_split(record, ":")
    if len(parts) < 2 { return -1 }
    let mut value = -1
    match parse_int(str_trim_space(parts[0])) { Ok(v) => { value = v } Err(_) => {} }
    return value
}

fn sip_naptr_record_preference(record: string) -> int {
    let parts = str_split(record, ":")
    if len(parts) < 2 { return -1 }
    let mut value = -1
    match parse_int(str_trim_space(parts[1])) { Ok(v) => { value = v } Err(_) => {} }
    return value
}

fn sip_naptr_record_service(record: string) -> string {
    let parts = str_split(record, "|")
    if len(parts) < 4 { return "" }
    return str_to_lower(str_trim_space(parts[1]))
}

fn sip_naptr_service_target(service: string, host: string) -> string {
    let s = str_to_lower(service)
    if str_eq(s, "sip+d2u") { return "_sip._udp." + host }
    if str_eq(s, "sip+d2t") { return "_sip._tcp." + host }
    if str_eq(s, "sips+d2t") { return "_sips._tcp." + host }
    return ""
}

fn sip_naptr_service_transport(service: string) -> string {
    let s = str_to_lower(service)
    if str_has_suffix(s, "._udp") || str_contains(s, "_sip._udp.") { return "udp" }
    if str_has_suffix(s, "._tcp") || str_contains(s, "_sip._tcp.") { return "tcp" }
    if str_contains(s, "_sips._tcp.") { return "tls" }
    return ""
}

fn sip_naptr_resolve_service(target: string, transport: string, cache: CMap) -> string {
    if sip_target_explicit_port(target) == 1 { return "" }
    if str_index(str_to_lower(target), "transport=") >= 0 { return "" }
    let host = sip_target_host(target)
    if len(host) == 0 || parse_ip_ok(host) == 1 { return "" }
    let key = "dns_naptr|" + host
    let now = mono_ms()
    let mut records = ""
    let mut fresh = 0
    if cmap_has(cache, key) == 1 && cmap_has(cache, key + "|at") == 1 {
        let mut at = 0
        match parse_int(cmap_get(cache, key + "|at")) { Ok(v) => { at = v } Err(_) => {} }
        if at > 0 && now - at < 60000 { fresh = 1; records = cmap_get(cache, key) }
    }
    if fresh == 0 {
        records = dns_naptr_lookup(host)
        let _ = bounded_cache_pair_set(cache, "dns_seq", "dns_ring|", key, records, now, 16384)
    }
    if len(records) == 0 { return "" }
    // A URI transport parameter (or sips scheme) is an explicit choice. A
    // plain SIP URI leaves transport selection to NAPTR order/preference.
    let mut wanted = ""
    let target_low = str_to_lower(target)
    if str_index(target_low, "transport=") >= 0 { wanted = str_to_lower(transport) }
    if str_has_prefix(target_low, "sips:") || str_has_prefix(target_low, "sips://") { wanted = "tls" }
    let mut best_order = 65536
    let mut best_pref = 65536
    let mut selected = ""
    let raw = str_split(records, ",")
    let mut i = 0
    while i < len(raw) {
        let record = str_trim_space(raw[i])
        let service = sip_naptr_record_service(record)
        let mut service_transport = ""
        if str_eq(service, "sip+d2u") { service_transport = "udp" }
        if str_eq(service, "sip+d2t") { service_transport = "tcp" }
        if str_eq(service, "sips+d2t") { service_transport = "tls" }
        let order = sip_naptr_record_order(record)
        let pref = sip_naptr_record_preference(record)
        if len(service_transport) > 0 && (len(wanted) == 0 || str_eq(wanted, service_transport)) {
            if order >= 0 && (order < best_order || (order == best_order && pref < best_pref)) {
                best_order = order
                best_pref = pref
                selected = sip_naptr_service_target(service, host)
            }
        }
        i = i + 1
    }
    return selected
}

fn sip_srv_resolve_targets(target: string, transport: string, cache: CMap) -> string {
    let mut service = sip_naptr_resolve_service(target, transport, cache)
    if len(service) == 0 { service = sip_srv_service(target, transport) }
    if len(service) == 0 { return "" }
    let key = "dns_srv|" + service
    let now = mono_ms()
    let mut records = ""
    let mut fresh = 0
    if cmap_has(cache, key) == 1 && cmap_has(cache, key + "|at") == 1 {
        let mut at = 0
        match parse_int(cmap_get(cache, key + "|at")) { Ok(v) => { at = v } Err(_) => {} }
        if at > 0 && now - at < 60000 { fresh = 1; records = cmap_get(cache, key) }
    }
    if fresh == 0 {
        records = dns_srv_lookup(service)
        let _ = bounded_cache_pair_set(cache, "dns_seq", "dns_ring|", key, records, now, 16384)
    }
    if len(records) == 0 { return "" }

    // RFC 2782: use the lowest priority set first and apply weight within
    // that set. Keep the remaining records so connection failure can advance
    // to the next weighted target without another DNS query.
    let raw = str_split(records, ",")
    let mut remaining = make([]string, 0, 8)
    let mut i = 0
    while i < len(raw) {
        if sip_srv_record_target(str_trim_space(raw[i])) != "" { remaining = append(remaining, str_trim_space(raw[i])) }
        i = i + 1
    }
    let mut result = ""
    while len(remaining) > 0 {
        let mut priority = 65536
        i = 0
        while i < len(remaining) {
            let p = sip_srv_record_priority(remaining[i])
            if p >= 0 && p < priority { priority = p }
            i = i + 1
        }
        let mut total = 0
        i = 0
        while i < len(remaining) {
            if sip_srv_record_priority(remaining[i]) == priority { total = total + sip_srv_record_weight(remaining[i]) }
            i = i + 1
        }
        let pick = if total > 0 { mono_ms() % total } else { 0 }
        let mut chosen = -1
        i = 0
        while i < len(remaining) {
            if sip_srv_record_priority(remaining[i]) == priority {
                if total == 0 && chosen < 0 { chosen = i }
                if total > 0 {
                    // cursor is intentionally recomputed below to keep this
                    // helper compatible with the value semantics of arrays.
                    let mut running = 0
                    let mut j = 0
                    while j <= i {
                        if sip_srv_record_priority(remaining[j]) == priority { running = running + sip_srv_record_weight(remaining[j]) }
                        j = j + 1
                    }
                    if pick < running { chosen = i; break }
                }
            }
            i = i + 1
        }
        if chosen < 0 { break }
        let picked = sip_srv_record_target(remaining[chosen])
        if len(picked) > 0 {
            if len(result) > 0 { result = result + "," }
            result = result + picked
        }
        let mut next = make([]string, 0, 8)
        i = 0
        while i < len(remaining) {
            if i != chosen { next = append(next, remaining[i]) }
            i = i + 1
        }
        remaining = next
    }
    return result
}

fn sip_srv_resolve_target(target: string, transport: string, cache: CMap) -> string {
    let targets = sip_srv_resolve_targets(target, transport, cache)
    if len(targets) == 0 { return "" }
    return str_trim_space(str_split(targets, ",")[0])
}

// Persistent outbound associations are keyed by attacker- or database-derived
// targets. Keep the per-worker list bounded and return the oldest item so the
// caller can close its transport-specific handle before replacing it.
fn sip_assoc_list_add(cache: CMap, list_key: string, item: string) -> string {
    if len(item) == 0 { return "" }
    let mut list = ""
    if cmap_has(cache, list_key) == 1 { list = cmap_get(cache, list_key) }
    if str_contains("," + list + ",", "," + item + ",") { return "" }
    let values = str_split(list, ",")
    let mut start = 0
    let mut evicted = ""
    if len(values) >= 1024 {
        evicted = str_trim_space(values[0])
        start = 1
    }
    let mut next = ""
    let mut i = start
    while i < len(values) {
        let value = str_trim_space(values[i])
        if len(value) > 0 {
            if len(next) > 0 { next = next + "," }
            next = next + value
        }
        i = i + 1
    }
    if len(next) > 0 { next = next + "," }
    next = next + item
    cmap_set(cache, list_key, next)
    return evicted
}

fn sip_assoc_list_remove(cache: CMap, list_key: string, item: string) -> int {
    if cmap_has(cache, list_key) == 0 { return 0 }
    let values = str_split(cmap_get(cache, list_key), ",")
    let mut kept = ""
    let mut i = 0
    while i < len(values) {
        let value = str_trim_space(values[i])
        if len(value) > 0 && not str_eq(value, item) {
            if len(kept) > 0 { kept = kept + "," }
            kept = kept + value
        }
        i = i + 1
    }
    if len(kept) == 0 { let _ = cmap_del(cache, list_key) } else { cmap_set(cache, list_key, kept) }
    return 0
}

// DNS rebinding guard: reject outbound connections to private/loopback IPs
// unless explicitly allowed. Prevents an attacker-controlled DNS record from
// redirecting SIP traffic to internal services.
fn sip_outbound_target_safe(host: string) -> int {
    if len(host) == 0 { return 0 }
    let allow_private = env_get_or("SIP_ALLOW_PRIVATE_TARGETS", "0")
    if str_eq(allow_private, "1") { return 1 }
    // Only check when the host looks like an IP (not a hostname that needs DNS)
    if parse_ip_ok(host) == 1 {
        if is_private_ip(host) == 1 { return 0 }
        if str_eq(host, "0.0.0.0") || str_eq(host, "::") { return 0 }
    }
    return 1
}

fn sip_forward_tcp(target: string, msg: string, cache: CMap, owner: int) -> int {
    let host = sip_target_host(target)
    let port = sip_target_port(target, 5060)
    if len(host) == 0 || port <= 0 { return 0 }
    if sip_outbound_target_safe(host) == 0 { return 0 }
    let assoc_key = "tcp_assoc|" + string(owner) + "|" + host + ":" + string(port)
    let mut fd = -1
    if cmap_has(cache, assoc_key) == 1 {
        match parse_int(cmap_get(cache, assoc_key)) { Ok(v) => { fd = v } Err(_) => { fd = -1 } }
    }
    if fd >= 0 {
        let sent_existing = sip_tcp_send(fd, msg)
        if sent_existing >= 0 {
            cmap_set(cache, "last_forward_target", host + ":" + string(port) + ";tcp;reused")
            return 1
        }
        let _ = tcp_close(fd)
        let _ = cmap_del(cache, assoc_key)
        fd = -1
    }
    fd = tcp_connect_timeout(host, port, 1200)
    if fd < 0 { return 0 }
    let sent = sip_tcp_send(fd, msg)
    if sent >= 0 {
        cmap_set(cache, assoc_key, string(fd))
        let list_key = "tcp_assoc_list|" + string(owner)
        let item = host + ":" + string(port)
        let evicted = sip_assoc_list_add(cache, list_key, item)
        if len(evicted) > 0 {
            let old_key = "tcp_assoc|" + string(owner) + "|" + evicted
            if cmap_has(cache, old_key) == 1 {
                match parse_int(cmap_get(cache, old_key)) { Ok(old_fd) => { let _ = tcp_close(old_fd) } Err(_) => {} }
                let _ = cmap_del(cache, old_key)
                let _ = cmap_del(cache, "tcp_buf|" + string(owner) + "|" + evicted)
            }
        }
        cmap_set(cache, "last_forward_target", host + ":" + string(port) + ";tcp")
        return 1
    }
    let _ = tcp_close(fd)
    return 0
}

fn sip_forward_tls(target: string, msg: string, cache: CMap, owner: int) -> int {
    if tls_client_available() == 0 { return 0 }
    let host = sip_target_host(target)
    let port = sip_target_port(target, 5061)
    if len(host) == 0 || port <= 0 { return 0 }
    if sip_outbound_target_safe(host) == 0 { return 0 }
    // RFC 5923: try reusing an inbound TLS connection (alias) before opening outbound
    let alias_handle = tls_reuse_lookup(cache, host, port)
    if alias_handle >= 0 {
        let sent_alias = tls_server_pool_write(alias_handle, msg)
        if sent_alias >= 0 {
            cmap_set(cache, "last_forward_target", host + ":" + string(port) + ";tls;alias-reuse")
            return 1
        }
        // Alias connection dead — clear it and fall through to normal path
        let _ = tls_reuse_clear(cache, alias_handle)
    }
    let ca = env_get_or("SIP_UPSTREAM_CA", "")
    let item = host + ":" + string(port)
    let assoc_key = "tls_assoc|" + string(owner) + "|" + item
    let mut handle = -1
    if cmap_has(cache, assoc_key) == 1 {
        match parse_int(cmap_get(cache, assoc_key)) { Ok(v) => { handle = v } Err(_) => { handle = -1 } }
    }
    if handle > 0 {
        let sent_existing = tls_pool_send(handle, msg)
        if sent_existing >= 0 {
            cmap_set(cache, "last_forward_target", item + ";tls;reused")
            return 1
        }
        let _ = tls_pool_close(handle)
        let _ = cmap_del(cache, assoc_key)
        handle = -1
    }
    handle = tls_pool_open_timeout(host, port, ca, 1200)
    if handle > 0 && tls_pool_set_timeout(handle, 1200) < 0 {
        let _ = tls_pool_close(handle)
        handle = -1
    }
    if handle < 0 { return 0 }
    // RFC 5923 §5: add ;alias to our Via so the remote side can reuse this connection
    let out_msg = tls_reuse_add_via_alias(msg)
    let sent = tls_pool_send(handle, out_msg)
    if sent >= 0 {
        cmap_set(cache, assoc_key, string(handle))
        let list_key = "tls_assoc_list|" + string(owner)
        let evicted = sip_assoc_list_add(cache, list_key, item)
        if len(evicted) > 0 {
            let old_key = "tls_assoc|" + string(owner) + "|" + evicted
            if cmap_has(cache, old_key) == 1 {
                match parse_int(cmap_get(cache, old_key)) { Ok(old_handle) => { let _ = tls_pool_close(old_handle) } Err(_) => {} }
                let _ = cmap_del(cache, old_key)
                let _ = cmap_del(cache, "tls_buf|" + string(owner) + "|" + evicted)
            }
        }
        cmap_set(cache, "last_forward_target", item + ";tls")
        return 1
    }
    let _ = tls_pool_close(handle)
    return 0
}

fn sip_forward_ws(target: string, msg: string, cache: CMap) -> int {
    let host = sip_target_host(target)
    let port = sip_target_port(target, 80)
    if len(host) == 0 || port <= 0 { return 0 }
    let path = sip_target_path(target)
    let key = base64_encode(random_bytes(16))
    let conn = ws_client_connect(host, port, path, key)
    if conn < 0 { return 0 }
    let sent = ws_client_send_text(conn, msg)
    let _ = ws_client_send_close(conn, 1000, "done")
    let _ = ws_close(conn)
    if sent == 0 {
        cmap_set(cache, "last_forward_target", host + ":" + string(port) + ";ws")
        return 1
    }
    return 0
}

// WSS outbound uses a bounded, persistent Mako association.  A CA bundle is
// required in production; the insecure switch exists only for controlled
// interoperability labs where the peer certificate is not publicly trusted.
fn sip_forward_wss(target: string, msg: string, cache: CMap, owner: int) -> int {
    if wss_available() == 0 { return 0 }
    let host = sip_target_host(target)
    let port = sip_target_port(target, 443)
    if len(host) == 0 || port <= 0 { return 0 }
    if sip_outbound_target_safe(host) == 0 { return 0 }
    let path = sip_target_path(target)
    let item = host + ":" + string(port) + path
    let assoc_key = "wss_assoc|" + string(owner) + "|" + item
    let mut handle = -1
    if cmap_has(cache, assoc_key) == 1 {
        match parse_int(cmap_get(cache, assoc_key)) { Ok(v) => { handle = v } Err(_) => { handle = -1 } }
    }
    if handle > 0 {
        let sent_existing = wss_pool_send(handle, msg)
        if sent_existing >= 0 {
            cmap_set(cache, "last_forward_target", item + ";wss;reused")
            cmap_set(cache, "wss_at|" + assoc_key, string(mono_ms()))
            return 1
        }
        let _ = sip_wss_drop_assoc(owner, item, handle, cache)
        handle = -1
    }

    let key = base64_encode(random_bytes(16))
    let ca = env_get_or("SIP_UPSTREAM_CA", "")
    if len(ca) > 0 {
        handle = wss_pool_open_ca(host, port, path, key, ca)
    } else {
        let insecure = str_to_lower(str_trim_space(env_get_or("SIP_UPSTREAM_TLS_INSECURE", "0")))
        if not str_eq(insecure, "1") && not str_eq(insecure, "true") && not str_eq(insecure, "yes") {
            return 0
        }
        handle = wss_pool_open_insecure(host, port, path, key)
    }
    if handle <= 0 { return 0 }
    let sent = wss_pool_send(handle, msg)
    if sent < 0 {
        let _ = wss_pool_close(handle)
        return 0
    }
    cmap_set(cache, assoc_key, string(handle))
    let list_key = "wss_assoc_list|" + string(owner)
    let evicted = sip_assoc_list_add(cache, list_key, item)
    if len(evicted) > 0 {
        let old_key = "wss_assoc|" + string(owner) + "|" + evicted
        if cmap_has(cache, old_key) == 1 {
            match parse_int(cmap_get(cache, old_key)) { Ok(old_handle) => { let _ = wss_pool_close(old_handle) } Err(_) => {} }
            let _ = cmap_del(cache, old_key)
            let _ = cmap_del(cache, "wss_at|" + old_key)
            let _ = cmap_del(cache, "wss_buf|" + string(owner) + "|" + evicted)
        }
    }
    cmap_set(cache, "wss_at|" + assoc_key, string(mono_ms()))
    cmap_set(cache, "last_forward_target", item + ";wss")
    return 1
}

fn sip_forward_target(target: string, msg: string, transport: string, cache: CMap, out_fd: int) -> int {
    let mut tr = sip_transport_param(target, transport)
    let target_low = str_to_lower(target)
    let mut explicit = 0
    if str_index(target_low, "transport=") >= 0 || sip_target_explicit_port(target) == 1 || str_has_prefix(target_low, "sips:") { explicit = 1 }
    if sip_target_port_state(target) < 0 { return 0 }
    if explicit == 0 {
        let naptr_service = sip_naptr_resolve_service(target, tr, cache)
        let naptr_transport = sip_naptr_service_transport(naptr_service)
        if len(naptr_transport) > 0 { tr = naptr_transport }
    }
    let mut resolved_targets = sip_srv_resolve_targets(target, tr, cache)
    if len(resolved_targets) == 0 { resolved_targets = target }
    let mut default_port = 5060
    if str_eq(tr, "tls") || str_eq(tr, "sips") { default_port = 5061 }
    if str_eq(tr, "ws") { default_port = 80 }
    if str_eq(tr, "wss") { default_port = 443 }
    let mut sent = 0
    let mut chosen_target = ""
    let candidates = str_split(resolved_targets, ",")
    let mut i = 0
    while i < len(candidates) && sent == 0 {
        let send_target = str_trim_space(candidates[i])
        if len(send_target) == 0 { i = i + 1; continue }
        if sip_target_port_state(send_target) < 0 { i = i + 1; continue }
        let health_addr = sip_target_host(send_target) + ":" + string(sip_target_port(send_target, default_port))
        if dispatch_is_healthy(health_addr, cache) == 1 {
            if str_eq(tr, "udp") { sent = sip_forward_udp(send_target, msg, cache, out_fd) }
            if str_eq(tr, "tcp") { sent = sip_forward_tcp(send_target, msg, cache, out_fd) }
            if str_eq(tr, "tls") || str_eq(tr, "sips") { sent = sip_forward_tls(send_target, msg, cache, out_fd) }
            if str_eq(tr, "ws") { sent = sip_forward_ws(send_target, msg, cache) }
            if str_eq(tr, "wss") { sent = sip_forward_wss(send_target, msg, cache, out_fd) }
            if len(tr) == 0 { sent = sip_forward_udp(send_target, msg, cache, out_fd) }
            let _ = dispatch_health_note(health_addr, sent, cache)
            if sent == 1 { chosen_target = send_target }
        }
        i = i + 1
    }
    if sent == 1 && str_eq(madis_method(msg), "INVITE") {
        let cid = sip_header(msg, "Call-ID")
        let branch = sip_via_branch(sip_header(msg, "Via"))
        if len(cid) > 0 && len(branch) > 0 {
            let _ = bounded_cache_set(cache, "dialog_seq", "dialog_ring|", "dialog_dst|" + cid, target, 131072)
            let _ = bounded_cache_set(cache, "dialog_seq", "dialog_ring|", "dialog_branch|" + cid, branch, 131072)
        }
    }
    if sent == 1 {
        let method = madis_method(msg)
        if not str_eq(method, "ACK") && not str_eq(method, "") {
            let _ = sip_client_txn_record(msg, chosen_target, tr, out_fd, cache)
        }
    }
    return sent
}

// Retransmission path: send an already-built request without creating a new
// client transaction or changing its branch.
fn sip_resend_target(target: string, msg: string, transport: string, cache: CMap, out_fd: int) -> int {
    let tr = sip_transport_param(target, transport)
    if str_eq(tr, "udp") { return sip_forward_udp(target, msg, cache, out_fd) }
    if str_eq(tr, "tcp") { return sip_forward_tcp(target, msg, cache, out_fd) }
    if str_eq(tr, "tls") || str_eq(tr, "sips") { return sip_forward_tls(target, msg, cache, out_fd) }
    if str_eq(tr, "ws") { return sip_forward_ws(target, msg, cache) }
    if str_eq(tr, "wss") { return sip_forward_wss(target, msg, cache, out_fd) }
    return 0
}

fn sip_reply_transport(msg: string, fallback: string) -> string {
    let via = sip_header(msg, "Via")
    let tr = sip_via_transport(via)
    if len(tr) > 0 { return str_to_lower(tr) }
    return str_to_lower(fallback)
}

fn sip_forward_reply(reply: string, cache: CMap, out_fd: int) -> int {
    let txn_key = sip_transaction_key(reply, len(reply))
    let conn_key = "server_conn|" + txn_key
    if len(txn_key) > 2 && cmap_has(cache, conn_key) == 1 {
        let mut conn_fd = -1
        match parse_int(cmap_get(cache, conn_key)) {
            Ok(v) => { conn_fd = v }
            Err(_) => {}
        }
        if conn_fd >= 0 {
            // RFC 7118 §5: WebSocket connections must use frame-based send,
            // not raw TCP write. Check the tracked transport type.
            let conn_tr = cmap_get(cache, "server_conn_tr|" + txn_key)
            if str_eq(conn_tr, "WSS") || str_eq(conn_tr, "WS") {
                let ws_sent = ws_send_text(conn_fd, reply)
                if ws_sent >= 0 { return 1 }
            } else {
                let sent_existing = tcp_write_all(conn_fd, reply)
                if sent_existing >= 0 { return 1 }
            }
        }
    }
    let host = proxy_reply_host(reply)
    let port = proxy_reply_port(reply)
    if len(host) == 0 { return 0 }
    let target = host + ":" + string(port)
    return sip_forward_target(target, reply, sip_reply_transport(reply, "udp"), cache, out_fd)
}
