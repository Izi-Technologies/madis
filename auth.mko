// ============ DIGEST AUTH (RFC 7616 / RFC 3261) ============
// Keep MD5 for legacy SIP devices, while accepting SHA-256 and both standard
// qop values. The database stores the algorithm-specific HA1 in
// users.password_ha1 (32 hex chars for MD5, 64 for SHA-256).

fn digest_algorithm_config() -> string {
    let configured = str_to_lower(str_trim_space(env_get_or("SIP_DIGEST_ALGORITHM", "md5")))
    if str_eq(configured, "sha256") { return "SHA-256" }
    if str_eq(configured, "sha-256") { return "SHA-256" }
    if str_eq(configured, "sha-256-sess") { return "SHA-256-sess" }
    if str_eq(configured, "md5-sess") { return "MD5-sess" }
    return "MD5"
}

fn digest_hash(value: string, algorithm: string) -> string {
    let a = str_to_lower(algorithm)
    if str_has_prefix(a, "sha-256") { return sha256(value) }
    return sip_md5_hex(value)
}

fn digest_challenge_value(realm: string, nonce: string, stale: int) -> string {
    let algorithm = digest_algorithm_config()
    let mut value = "Digest realm=\"" + realm + "\", nonce=\"" + nonce + "\", algorithm=" + algorithm + ", qop=\"auth,auth-int\""
    if stale == 1 { value = value + ", stale=true" }
    return value
}

// CMap has no TTL primitive. Keep attacker-derived cache keys bounded with a
// fixed ring; the ring stores the real key so eviction removes both entries.
// This is deliberately shared by auth, ACL, and security caches.
// Bounded ring storage. Each seq_key/ring_prefix pair is an independent
// eviction domain — ban entries never evict rate-limit entries and vice versa.
// This prevents an attacker from filling one domain to flush another.
fn bounded_state_set(store: CMap, index: CMap, seq_key: string, ring_prefix: string, key: string, value: string, capacity: int) -> int {
    if cmap_has(store, key) == 1 {
        cmap_set(store, key, value)
        return 0
    }
    let seq = cmap_incr(index, seq_key, 1)
    let slot = seq - (seq / capacity) * capacity
    let ring_key = ring_prefix + string(slot)
    if cmap_has(index, ring_key) == 1 {
        let old_key = cmap_get(index, ring_key)
        if len(old_key) > 0 && not str_eq(old_key, key) { let _ = cmap_del(store, old_key) }
    }
    cmap_set(index, ring_key, key)
    cmap_set(store, key, value)
    return 0
}

fn bounded_cache_set(cache: CMap, seq_key: string, ring_prefix: string, key: string, value: string, capacity: int) -> int {
    let _ = bounded_state_set(cache, cache, seq_key, ring_prefix, key, value, capacity)
    return 0
}

fn bounded_cache_pair_set(cache: CMap, seq_key: string, ring_prefix: string, key: string, value: string, at: int, capacity: int) -> int {
    if cmap_has(cache, key) == 1 {
        cmap_set(cache, key, value)
        cmap_set(cache, key + "|at", string(at))
        return 0
    }
    let seq = cmap_incr(cache, seq_key, 1)
    let slot = seq - (seq / capacity) * capacity
    let ring_key = ring_prefix + string(slot)
    if cmap_has(cache, ring_key) == 1 {
        let old_key = cmap_get(cache, ring_key)
        if len(old_key) > 0 && not str_eq(old_key, key) {
            let _ = cmap_del(cache, old_key)
            let _ = cmap_del(cache, old_key + "|at")
        }
    }
    cmap_set(cache, ring_key, key)
    cmap_set(cache, key, value)
    cmap_set(cache, key + "|at", string(at))
    return 0
}

fn auth_nonce_cache_set(cache: CMap, nonce: string, created_at: int) -> int {
    return bounded_cache_set(cache, "auth_nonce_seq", "auth_nonce_ring|", "nonce|" + nonce, string(created_at), 65536)
}

fn auth_nonce_used_set(cache: CMap, key: string, used_at: int) -> int {
    return bounded_cache_set(cache, "auth_used_seq", "auth_used_ring|", key, string(used_at), 65536)
}

fn digest_challenge_cached_stale(realm: string, msg: string, n: int, tag: string, cache: CMap, proxy: int, stale: int) -> string {
    let _ = n
    let nonce = base64_encode(random_bytes(24))
    let _ = auth_nonce_cache_set(cache, nonce, mono_ms())
    let mut extra = ""
    if proxy == 1 {
        extra = sip_header_line("Proxy-Authenticate", digest_challenge_value(realm, nonce, stale))
        if len(tag) > 0 { return sip_reply_with_to_tag(msg, 407, "Proxy Authentication Required", extra, "", tag) }
        return sip_reply(msg, 407, "Proxy Authentication Required", extra, "")
    }
    extra = sip_header_line("WWW-Authenticate", digest_challenge_value(realm, nonce, stale))
    if len(tag) > 0 { return sip_reply_with_to_tag(msg, 401, "Unauthorized", extra, "", tag) }
    return sip_reply(msg, 401, "Unauthorized", extra, "")
}

fn digest_challenge_cached(realm: string, msg: string, n: int, tag: string, cache: CMap, proxy: int) -> string {
    return digest_challenge_cached_stale(realm, msg, n, tag, cache, proxy, 0)
}

fn has_auth(msg: string, n: int) -> int {
    let auth = sip_hdr(msg, "Authorization", n)
    if len(auth) > 5 { return 1 }
    let pauth = sip_hdr(msg, "Proxy-Authorization", n)
    if len(pauth) > 5 { return 1 }
    return 0
}

fn auth_username(msg: string, n: int) -> string {
    let auth = sip_hdr(msg, "Authorization", n)
    if len(auth) > 0 { return sip_auth_param(auth, "username") }
    let pauth = sip_hdr(msg, "Proxy-Authorization", n)
    return sip_auth_param(pauth, "username")
}

fn auth_header(msg: string, n: int) -> string {
    let auth = sip_hdr(msg, "Authorization", n)
    if len(auth) > 0 { return auth }
    return sip_hdr(msg, "Proxy-Authorization", n)
}

fn digest_response_ha1_qop(ha1: string, method: string, uri: string, nonce: string, nc: string, cnonce: string, qop: string) -> string {
    return digest_response_ha1_qop_alg(ha1, method, uri, nonce, nc, cnonce, qop, "MD5", "")
}

fn digest_response_ha1_qop_alg(ha1: string, method: string, uri: string, nonce: string, nc: string, cnonce: string, qop: string, algorithm: string, body: string) -> string {
    let mut ha1_value = ha1
    let a = str_to_lower(algorithm)
    if str_has_suffix(a, "-sess") { ha1_value = digest_hash(ha1 + ":" + nonce + ":" + cnonce, algorithm) }
    let mut ha2_input = method + ":" + uri
    if str_eq(str_to_lower(qop), "auth-int") { ha2_input = ha2_input + ":" + digest_hash(body, algorithm) }
    let ha2 = digest_hash(ha2_input, algorithm)
    return digest_hash(ha1_value + ":" + nonce + ":" + nc + ":" + cnonce + ":" + qop + ":" + ha2, algorithm)
}

fn digest_response_ha1_alg(ha1: string, method: string, uri: string, nonce: string, algorithm: string, body: string) -> string {
    let ha1_value = ha1
    let mut ha2_input = method + ":" + uri
    if len(body) > 0 { ha2_input = ha2_input + ":" + digest_hash(body, algorithm) }
    let ha2 = digest_hash(ha2_input, algorithm)
    return digest_hash(ha1_value + ":" + nonce + ":" + ha2, algorithm)
}

fn digest_response_ha1_sess(ha1: string, method: string, uri: string, nonce: string, cnonce: string, algorithm: string) -> string {
    let ha1_value = digest_hash(ha1 + ":" + nonce + ":" + cnonce, algorithm)
    let ha2 = digest_hash(method + ":" + uri, algorithm)
    return digest_hash(ha1_value + ":" + nonce + ":" + ha2, algorithm)
}

fn db_digest_valid(db: SqlDB, db_ok: int, msg: string, n: int, method: string, fallback_domain: string, cache: CMap) -> int {
    if db_ok == 0 { return 1 }
    let auth = auth_header(msg, n)
    if len(auth) == 0 { return 0 }
    let username = sip_auth_param(auth, "username")
    let realm = sip_auth_param(auth, "realm")
    let nonce = sip_auth_param(auth, "nonce")
    let uri = sip_auth_param(auth, "uri")
    let response = sip_auth_param(auth, "response")
    let mut algorithm = str_to_lower(sip_auth_param(auth, "algorithm"))
    let qop = str_to_lower(sip_auth_param(auth, "qop"))
    let nc = sip_auth_param(auth, "nc")
    let cnonce = sip_auth_param(auth, "cnonce")
    if len(username) == 0 { return 0 }
    if len(nonce) == 0 { return 0 }
    if len(uri) == 0 { return 0 }
    if len(response) == 0 { return 0 }
    if len(algorithm) == 0 { algorithm = "md5" }
    if not str_eq(algorithm, "md5") && not str_eq(algorithm, "md5-sess") && not str_eq(algorithm, "sha-256") && not str_eq(algorithm, "sha-256-sess") { return 0 }
    if len(qop) > 0 {
        if not str_eq(qop, "auth") && not str_eq(qop, "auth-int") { return 0 }
        if len(cnonce) == 0 || len(nc) != 8 { return 0 }
        let mut ni = 0
        while ni < len(nc) {
            let ch = int(str_to_lower(nc)[ni])
            if not ((ch >= 48 && ch <= 57) || (ch >= 97 && ch <= 102)) { return 0 }
            ni = ni + 1
        }
    }
    if str_has_suffix(algorithm, "-sess") && len(cnonce) == 0 { return 0 }
    if cmap_has(cache, "nonce|" + nonce) == 0 { return 0 }
    let mut nonce_at = 0
    match parse_int(cmap_get(cache, "nonce|" + nonce)) {
        Ok(v) => { nonce_at = v }
        Err(_) => { return 0 }
    }
    // Default 120s nonce lifetime; configurable via SIP_NONCE_TTL_SEC.
    let mut nonce_ttl = 120000
    match parse_int(env_get_or("SIP_NONCE_TTL_SEC", "120")) { Ok(v) => { nonce_ttl = v * 1000 } Err(_) => {} }
    if nonce_ttl < 30000 { nonce_ttl = 30000 }
    if nonce_ttl > 600000 { nonce_ttl = 600000 }
    if mono_ms() - nonce_at > nonce_ttl { return 2 }
    // nc monotonicity: reject replayed or out-of-order nonce counts.
    if len(nc) == 8 {
        let nc_key = "nonce_nc|" + nonce
        let mut last_nc = 0
        if cmap_has(cache, nc_key) == 1 {
            match parse_int(cmap_get(cache, nc_key)) { Ok(v) => { last_nc = v } Err(_) => {} }
        }
        let mut this_nc = 0
        let nc_low = str_to_lower(nc)
        let mut hi = 0
        while hi < len(nc_low) {
            let hc = int(nc_low[hi])
            this_nc = this_nc * 16
            if hc >= 48 && hc <= 57 { this_nc = this_nc + (hc - 48) }
            else if hc >= 97 && hc <= 102 { this_nc = this_nc + (hc - 87) }
            hi = hi + 1
        }
        if this_nc > 0 && this_nc <= last_nc { return 0 }
        let _ = bounded_cache_set(cache, "nonce_nc_seq", "nonce_nc_ring|", nc_key, string(this_nc), 65536)
    }
    let mut domain = realm
    if len(domain) == 0 { domain = fallback_domain }
    let _ = domain
    let credentials = sql_query_str(db, "SELECT COALESCE(password_ha1,'') || '|' || COALESCE(password_ha1_sha256,'') FROM users WHERE username = $1 AND enabled = true LIMIT 1", username)
    let credential_parts = str_split(credentials, "|")
    let mut ha1 = ""
    let mut sha_ha1 = ""
    if len(credential_parts) >= 1 { ha1 = credential_parts[0] }
    if len(credential_parts) >= 2 { sha_ha1 = credential_parts[1] }
    if str_has_prefix(algorithm, "sha-256") {
        if len(sha_ha1) == 64 { ha1 = sha_ha1 }
    }
    if str_has_prefix(algorithm, "sha-256") && len(ha1) != 64 { return 0 }
    if str_has_prefix(algorithm, "md5") && len(ha1) != 32 { return 0 }
    let expected = if len(qop) > 0 {
        digest_response_ha1_qop_alg(ha1, method, uri, nonce, nc, cnonce, qop, algorithm, sip_body(msg))
    } else if str_has_suffix(algorithm, "-sess") {
        digest_response_ha1_sess(ha1, method, uri, nonce, cnonce, algorithm)
    } else {
        digest_response_ha1_alg(ha1, method, uri, nonce, algorithm, "")
    }
    // Constant-time comparison to prevent timing-based credential recovery.
    let exp_low = str_to_lower(expected)
    let resp_low = str_to_lower(response)
    let mut digest_match = 0
    if len(exp_low) > 0 && len(exp_low) == len(resp_low) {
        let mut diff = 0
        let mut di = 0
        while di < len(exp_low) {
            diff = diff | (int(exp_low[di]) ^ int(resp_low[di]))
            di = di + 1
        }
        if diff == 0 { digest_match = 1 }
    }
    if digest_match == 1 {
        // RFC 7616 §3.4.6: verify the digest uri matches the Request-URI.
        // An attacker who authenticates for sip:legit@host then rewrites the
        // R-URI to sip:premium@toll can bypass toll-fraud checks.
        let request_uri = sip_request_uri(msg)
        if len(request_uri) > 0 && len(uri) > 0 && not str_eq(uri, request_uri) {
            // Allow minor normalization differences (port, scheme) by
            // comparing host+user only when the full URI doesn't match.
            let uri_user = sip_uri_user(uri)
            let uri_host = sip_uri_host(uri)
            let ruri_user = sip_uri_user(request_uri)
            let ruri_host = sip_uri_host(request_uri)
            if not str_eq(uri_user, ruri_user) || not str_eq(str_to_lower(uri_host), str_to_lower(ruri_host)) {
                return 0
            }
        }
        let mut used_key = "nonce_used|" + nonce + "|" + username + "|" + method + "|" + uri
        if len(qop) > 0 { used_key = used_key + "|" + nc + "|" + cnonce }
        if cmap_has(cache, used_key) == 1 { return 0 }
        let _ = auth_nonce_used_set(cache, used_key, mono_ms())
        return 1
    }
    return 0
}

// IP-based auth: check if source IP is trusted (carriers, trunks, PBXes)
// Returns: 1=trusted (skip digest), 0=not trusted (require digest)
fn db_ip_auth(db: SqlDB, db_ok: int, src_ip: string, cache: CMap) -> int prove len(src_ip) > 0 {
    let key = "ipauth|" + src_ip
    if cmap_has(cache, key) == 1 {
        let cached = cmap_get(cache, key)
        // Fast path: check first byte for 1/0 before parsing timestamp.
        // Format: "1|<ms>" or "0|<ms>". First byte is the decision.
        if len(cached) > 2 && int(cached[1]) == 124 {
            let mut at = 0
            match parse_int(cached[2:]) { Ok(v) => { at = v } Err(_) => {} }
            if at > 0 && mono_ms() - at < 30000 {
                return if int(cached[0]) == 49 { 1 } else { 0 }
            }
        }
    }
    // The local health/interop path is intentionally usable without a
    // database. Do not extend this exception to RFC1918/private networks.
    if str_eq(src_ip, "127.0.0.1") || str_eq(src_ip, "::1") {
        let _ = bounded_cache_set(cache, "auth_ip_seq", "auth_ip_ring|", key, "1|" + string(mono_ms()), 16384)
        return 1
    }
    if db_ok == 0 {
        // A database outage must fail closed. Private address space is not
        // proof of trust because a SIP listener may be reachable on a
        // routed or spoofable interface.
        let _ = bounded_cache_set(cache, "auth_ip_seq", "auth_ip_ring|", key, "0|" + string(mono_ms()), 16384)
        return 0
    }

    // Check ip_auth table
    let r = sql_query_str(db, "SELECT id FROM ip_auth WHERE ip_address = $1 AND enabled = true LIMIT 1", src_ip)
    if len(r) > 0 {
        let _ = log_info_if(cache, "auth", "ip-auth-trusted ip=" + src_ip)
        let _ = bounded_cache_set(cache, "auth_ip_seq", "auth_ip_ring|", key, "1|" + string(mono_ms()), 16384)
        return 1
    }
    // Check CIDR/subnet — /24 by finding the last dot (no str_split)
    let mut last_dot = -1
    let mut di = len(src_ip) - 1
    while di >= 0 {
        if int(src_ip[di]) == 46 { last_dot = di; break }
        di = di - 1
    }
    if last_dot > 0 {
        let subnet = src_ip[0:last_dot] + ".0/24"
        let r2 = sql_query_str(db, "SELECT id FROM ip_auth WHERE ip_address = $1 AND enabled = true LIMIT 1", subnet)
        if len(r2) > 0 {
            let _ = log_info_if(cache, "auth", "ip-auth-trusted ip=" + src_ip + " subnet=" + subnet)
            let _ = bounded_cache_set(cache, "auth_ip_seq", "auth_ip_ring|", key, "1|" + string(mono_ms()), 16384)
            return 1
        }
    }
    let _ = bounded_cache_set(cache, "auth_ip_seq", "auth_ip_ring|", key, "0|" + string(mono_ms()), 16384)
    return 0
}

// Check if user exists and auth is present
fn db_auth_user(db: SqlDB, db_ok: int, username: string, domain: string, cache: CMap) -> int {
    if db_ok == 0 { return 1 }

    let key = "user|" + username + "@" + domain
    if cmap_has(cache, key) == 1 {
        let v = cmap_get(cache, key)
        if str_eq(v, "1") { return 1 }
        return 0
    }

    let result = sql_query_str(db, "SELECT id FROM users WHERE username = $1 AND enabled = true LIMIT 1", username)
    if len(result) > 0 {
        let _ = bounded_cache_set(cache, "auth_user_seq", "auth_user_ring|", key, "1", 16384)
        return 1
    }
    let _ = bounded_cache_set(cache, "auth_user_seq", "auth_user_ring|", key, "0", 16384)
    return 0
}
