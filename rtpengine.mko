// ============ RTPENGINE INTEGRATION ============
// Optional media proxy via rtpengine ng protocol.
// Sends UDP bencode commands to rtpengine to set up RTP relay.
// Rewrites SDP with rtpengine-provided media addresses.
//
// Config (DB config table):
//   rtpengine_enabled = true/false
//   rtpengine_host = 127.0.0.1  (or /var/run/rtpengine/rtpengine.sock for unix socket)
//   rtpengine_port = 2223       (ignored when host is a unix socket path)
//
// Protocol: bencode over UDP or unix socket (ng control protocol)
// Commands: offer, answer, delete

// Build a bencode dictionary string
// rtpengine ng protocol uses bencode: d...e wrapping
fn bencode_str(s: string) -> string {
    return string(len(s)) + ":" + s
}

fn bencode_dict_2(k1: string, v1: string, k2: string, v2: string) -> string {
    return "d" + bencode_str(k1) + bencode_str(v1) + bencode_str(k2) + bencode_str(v2) + "e"
}

fn bencode_dict_3(k1: string, v1: string, k2: string, v2: string, k3: string, v3: string) -> string {
    return "d" + bencode_str(k1) + bencode_str(v1) + bencode_str(k2) + bencode_str(v2) + bencode_str(k3) + bencode_str(v3) + "e"
}

fn bencode_dict_4(k1: string, v1: string, k2: string, v2: string, k3: string, v3: string, k4: string, v4: string) -> string {
    return "d" + bencode_str(k1) + bencode_str(v1) + bencode_str(k2) + bencode_str(v2) + bencode_str(k3) + bencode_str(v3) + bencode_str(k4) + bencode_str(v4) + "e"
}

fn bencode_dict_5(k1: string, v1: string, k2: string, v2: string, k3: string, v3: string, k4: string, v4: string, k5: string, v5: string) -> string {
    return "d" + bencode_str(k1) + bencode_str(v1) + bencode_str(k2) + bencode_str(v2) + bencode_str(k3) + bencode_str(v3) + bencode_str(k4) + bencode_str(v4) + bencode_str(k5) + bencode_str(v5) + "e"
}

// Parse a bencode response to extract a value by key
// Simple parser: finds "N:key" then reads the next "N:value"
fn bencode_get(resp: string, key: string) -> string {
    let needle = string(len(key)) + ":" + key
    let idx = str_index(resp, needle)
    if idx < 0 { return "" }
    // Move past the key
    let mut i = idx + len(needle)
    let n = len(resp)
    // Read the value length
    let mut vlen = 0
    while i < n {
        let c = int(resp[i])
        if c == 58 { i = i + 1; break }  // ':'
        if c >= 48 {
            if c <= 57 { vlen = vlen * 10 + (c - 48) }
        }
        i = i + 1
    }
    if vlen == 0 { return "" }
    if i + vlen > n { return "" }
    return resp[i:i + vlen]
}

// Generate a unique cookie for the ng request
fn rtp_cookie() -> string {
    return base64_encode(random_bytes(6))
}

fn rtp_port_value(raw: string) -> int {
    match parse_int(raw) {
        Ok(v) => { if v > 0 && v <= 65535 { return v } }
        Err(_) => {}
    }
    return 2223
}

fn rtp_dialog_tag_safe(value: string) -> int {
    if len(value) < 1 || len(value) > 256 { return 0 }
    let mut i = 0
    while i < len(value) {
        let c = int(value[i])
        if sip_token_char(c) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

fn rtp_sdp_content_type_safe(msg: string) -> int {
    let raw = str_to_lower(str_trim_space(sip_header(msg, "Content-Type")))
    if len(raw) == 0 { return 1 }
    let semi = str_index(raw, ";")
    let mut media = raw
    if semi >= 0 { media = raw[0:semi] }
    return if str_eq(str_trim_space(media), "application/sdp") { 1 } else { 0 }
}

fn rtp_sdp_body_safe(sdp: string) -> int {
    if len(sdp) < 1 || len(sdp) > 65535 { return 0 }
    let mut i = 0
    while i < len(sdp) {
        if int(sdp[i]) == 0 { return 0 }
        i = i + 1
    }
    if len(sdp) < 5 || int(sdp[0]) != 118 || int(sdp[1]) != 61 || int(sdp[2]) != 48 || int(sdp[3]) != 13 || int(sdp[4]) != 10 { return 0 }
    let mut j = 0
    while j + 3 < len(sdp) {
        if int(sdp[j]) == 13 && int(sdp[j + 1]) == 10 && int(sdp[j + 2]) == 109 && int(sdp[j + 3]) == 61 { return 1 }
        j = j + 1
    }
    return 0
}

// Optional multi-node list: "host:port,host2:port2". Empty → single-host config.
fn rtp_nodes_csv() -> string {
    let nodes = str_trim_space(env_get_or("SIP_RTPENGINE_NODES", ""))
    if len(nodes) > 0 && len(nodes) <= 4096 { return nodes }
    return ""
}

fn rtp_node_count() -> int {
    let csv = rtp_nodes_csv()
    if len(csv) == 0 { return 0 }
    let items = str_split(csv, ",")
    let mut n = 0
    let mut i = 0
    while i < len(items) {
        if len(str_trim_space(items[i])) > 0 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn rtp_node_at(index: int) -> string {
    if index < 0 { return "" }
    let csv = rtp_nodes_csv()
    if len(csv) == 0 { return "" }
    let items = str_split(csv, ",")
    let mut n = 0
    let mut i = 0
    while i < len(items) {
        let item = str_trim_space(items[i])
        if len(item) > 0 {
            if n == index { return item }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

fn rtp_node_host(entry: string) -> string {
    let e = str_trim_space(entry)
    if len(e) == 0 || len(e) > 512 { return "" }
    let colon = str_index(e, ":")
    if colon <= 0 { return e }
    if str_index(e[colon + 1:], ":") >= 0 { return e }
    return e[0:colon]
}

fn rtp_node_port(entry: string) -> int {
    let e = str_trim_space(entry)
    let colon = str_index(e, ":")
    if colon <= 0 { return 2223 }
    if str_index(e[colon + 1:], ":") >= 0 { return 2223 }
    return rtp_port_value(e[colon + 1:])
}

// Hash call-id onto node index for sticky selection.
fn rtp_node_index_for(call_id: string) -> int {
    let n = rtp_node_count()
    if n < 1 { return 0 }
    if len(call_id) == 0 { return 0 }
    let h = sha256("madis.rtp|" + call_id)
    let mut acc = 0
    let mut i = 0
    while i < 8 && i < len(h) {
        let c = int(h[i])
        acc = acc * 16
        if c >= 48 && c <= 57 { acc = acc + c - 48 }
        else if c >= 97 && c <= 102 { acc = acc + c - 87 }
        else if c >= 65 && c <= 70 { acc = acc + c - 55 }
        i = i + 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc % n
}

// Optional policy flags from env (passed as bencode "flags" list-ish string).
// Media plane still external; this only shapes ng command policy.
// SIP_RTPENGINE_PROFILE expands named profiles into flag strings:
//   ice-srtp  → ICE,SRTP,DTLS
//   srtp      → SRTP
//   ice       → ICE
//   plain     → (empty)
// SIP_RTPENGINE_FLAGS overrides / extends the profile when both set.
fn rtp_profile_flags() -> string {
    let profile = str_to_lower(str_trim_space(env_get_or("SIP_RTPENGINE_PROFILE", "")))
    if len(profile) == 0 || str_eq(profile, "plain") || str_eq(profile, "none") { return "" }
    if str_eq(profile, "ice-srtp") || str_eq(profile, "webrtc") { return "ICE,SRTP,DTLS" }
    if str_eq(profile, "srtp") || str_eq(profile, "sdes") { return "SRTP" }
    if str_eq(profile, "ice") { return "ICE" }
    if str_eq(profile, "dtls-srtp") { return "ICE,DTLS,SRTP" }
    return ""
}

fn rtp_policy_flags() -> string {
    let explicit = str_trim_space(env_get_or("SIP_RTPENGINE_FLAGS", ""))
    if len(explicit) > 0 {
        if len(explicit) > 512 { return "" }
        if str_index(explicit, "\r") >= 0 || str_index(explicit, "\n") >= 0 { return "" }
        return explicit
    }
    return rtp_profile_flags()
}

// Send ng command to rtpengine and get response.
// Single attempt with evloop-based wait to avoid blocking the SIP worker.
// Total worst-case latency: 50ms (down from 250ms).
fn rtp_send(host: string, port: int, command: string) -> string {
    if len(host) == 0 || len(command) > 65500 { return "" }
    // Unix socket: host is a path (starts with /)
    if str_has_prefix(host, "/") {
        let fd = unix_connect(host)
        if fd < 0 { return "" }
        let cookie = rtp_cookie()
        let msg = cookie + " " + command
        let _ = unix_write(fd, msg)
        let resp = unix_read(fd, 65536)
        let _ = unix_close(fd)
        if len(resp) == 0 { return "" }
        let prefix = cookie + " "
        if str_has_prefix(resp, prefix) { return resp[len(prefix):] }
        return ""
    }
    // UDP path
    if port <= 0 || port > 65535 { return "" }
    let fd = nb_udp_bind(0)
    if fd < 0 { return "" }
    let cookie = rtp_cookie()
    let msg = cookie + " " + command
    let _ = udp_send_to(fd, host, port, msg)
    // Use evloop for bounded wait instead of busy-loop sleep. This yields
    // the thread to the OS scheduler instead of spinning.
    let el = evloop_new()
    let _ = evloop_add(el, fd, 1)
    let ready = evloop_wait(el, 50)
    let _ = evloop_close(el)
    let mut resp = ""
    if ready > 0 { resp = nb_udp_recv(fd) }
    let _ = udp_close(fd)
    if len(resp) == 0 { return "" }
    let prefix = cookie + " "
    if str_has_prefix(resp, prefix) { return resp[len(prefix):] }
    return ""
}

// Multi-node: try preferred node then rotate on empty/malformed response.
// Remembers last good node for call-id so delete hits the same media node.
fn rtp_send_call(cache: CMap, call_id: string, command: string, host: string, port: int) -> string {
    let n = rtp_node_count()
    if n < 1 {
        return rtp_send(host, port, command)
    }
    // Sticky: reuse node bound to this call if present.
    let bind_key = "rtp_node|" + call_id
    let mut start = rtp_node_index_for(call_id)
    if cmap_has(cache, bind_key) == 1 {
        match parse_int(cmap_get(cache, bind_key)) {
            Ok(v) => {
                if v >= 0 && v < n { start = v }
            }
            Err(_) => {}
        }
    }
    let mut attempt = 0
    while attempt < n {
        let mut use = start + attempt
        while use >= n { use = use - n }
        let entry = rtp_node_at(use)
        let nh = rtp_node_host(entry)
        let np = rtp_node_port(entry)
        if len(nh) > 0 && np > 0 {
            let resp = rtp_send(nh, np, command)
            if len(resp) > 0 {
                cmap_set(cache, bind_key, string(use))
                return resp
            }
        }
        attempt = attempt + 1
    }
    return ""
}

// Load rtpengine config from DB
fn rtp_config_apply_env(result: []string) []string {
    // Explicit environment values are useful for standalone workers and
    // smoke tests that intentionally run without a database.  They also
    // override DB values so an operator can disable a stale media target
    // during a controlled restart without changing application data.
    let mut adjusted = make([]string, 3)
    adjusted[0] = result[0]
    adjusted[1] = result[1]
    adjusted[2] = result[2]
    let env_enabled = str_to_lower(str_trim_space(env_get_or("SIP_RTPENGINE_ENABLED", "")))
    if len(env_enabled) > 0 {
        adjusted[0] = "0"
        if str_eq(env_enabled, "1") || str_eq(env_enabled, "true") || str_eq(env_enabled, "yes") {
            adjusted[0] = "1"
        }
    }
    let env_host = str_trim_space(env_get_or("SIP_RTPENGINE_HOST", ""))
    if len(env_host) > 0 && len(env_host) <= 512 {
        adjusted[1] = env_host
    }
    let env_port = str_trim_space(env_get_or("SIP_RTPENGINE_PORT", ""))
    if len(env_port) > 0 {
        adjusted[2] = string(rtp_port_value(env_port))
    }
    return adjusted
}

fn rtp_config(db: SqlDB, db_ok: int, cache: CMap) -> []string {
    // Returns [enabled, host, port]
    let mut result = make([]string, 3)
    result[0] = "0"
    result[1] = "127.0.0.1"
    result[2] = "2223"

    let key = "rtpengine_cfg"
    if cmap_has(cache, key) == 1 {
        let cached = cmap_get(cache, key)
        let parts = str_split(cached, "|")
        if len(parts) >= 3 {
            result[0] = parts[0]
            result[1] = parts[1]
            result[2] = string(rtp_port_value(parts[2]))
        }
        result = rtp_config_apply_env(result)
        return result
    }

    if db_ok == 1 {
        let enabled = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "rtpengine_enabled")
        let host = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "rtpengine_host")
        let port = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "rtpengine_port")
        if str_eq(enabled, "true") { result[0] = "1" }
        if len(host) > 0 { result[1] = host }
        if len(port) > 0 { result[2] = port }
    }
    result[2] = string(rtp_port_value(result[2]))
    result = rtp_config_apply_env(result)

    // Start from a fresh buffer.  Array elements are owned by `result`;
    // consuming result[0] with the in-place concat path would leave the
    // array slot pointing at realloc-freed storage.
    let cache_value = "" + result[0] + "|" + result[1] + "|" + result[2]
    cmap_set(cache, key, cache_value)
    return result
}

// OFFER: called when forwarding an INVITE (caller's SDP)
// Sends SDP to rtpengine, gets back rewritten SDP with relay addresses
fn rtp_offer(host: string, port: int, call_id: string, from_tag: string, sdp: string) -> string {
    return rtp_offer_cache(cmap_new(), host, port, call_id, from_tag, sdp)
}

// Detect WebRTC SDP: presence of ICE candidates, DTLS fingerprint, or
// RTP/SAVPF media lines indicates a WebRTC endpoint.
fn rtp_sdp_is_webrtc(sdp: string) -> int {
    if str_contains(sdp, "a=ice-ufrag") { return 1 }
    if str_contains(sdp, "a=fingerprint") { return 1 }
    if str_contains(sdp, "RTP/SAVPF") { return 1 }
    if str_contains(sdp, "RTP/SAVP ") { return 1 }
    return 0
}

// WebRTC-to-SIP bridging flags for RTPEngine. When the offerer is WebRTC,
// tell RTPEngine to accept ICE/DTLS on the caller side and provide plain
// RTP on the callee side (and vice versa for the answer).
fn rtp_webrtc_bridge_flags(is_webrtc_offer: int) -> string {
    if is_webrtc_offer == 1 {
        // Caller is WebRTC: accept ICE+DTLS, provide plain RTP to callee
        return "ICE=force DTLS=passive SDES-off rtcp-mux-offer rtcp-mux-accept"
    }
    return ""
}

fn rtp_offer_cache(cache: CMap, host: string, port: int, call_id: string, from_tag: string, sdp: string) -> string {
    if rtp_dialog_tag_safe(from_tag) == 0 { return "" }
    let mut flags = rtp_policy_flags()
    // Auto-detect WebRTC and apply bridging flags when no explicit profile set
    if len(flags) == 0 && rtp_sdp_is_webrtc(sdp) == 1 {
        flags = rtp_webrtc_bridge_flags(1)
        let _ = bounded_cache_set(cache, "rtp_seq", "rtp_ring|", "rtp_webrtc|" + call_id, "1", 65536)
    }
    let mut cmd = ""
    if len(flags) > 0 {
        cmd = bencode_dict_5(
            "command", "offer",
            "call-id", call_id,
            "from-tag", from_tag,
            "sdp", sdp,
            "flags", flags
        )
    } else {
        cmd = bencode_dict_4(
            "command", "offer",
            "call-id", call_id,
            "from-tag", from_tag,
            "sdp", sdp
        )
    }
    let resp = rtp_send_call(cache, call_id, cmd, host, port)
    let _ = rtp_debug_exchange("offer", call_id, resp)
    if len(resp) == 0 { return "" }
    let new_sdp = bencode_get(resp, "sdp")
    let result = bencode_get(resp, "result")
    if str_eq(result, "ok") { return new_sdp }
    return ""
}

// ANSWER: called when forwarding 200 OK (callee's SDP)
fn rtp_answer(host: string, port: int, call_id: string, from_tag: string, to_tag: string, sdp: string) -> string {
    return rtp_answer_cache(cmap_new(), host, port, call_id, from_tag, to_tag, sdp)
}

// Optional operator-visible ng exchange diagnostics; off by default.
fn rtp_debug_enabled() -> int {
    let v = str_to_lower(str_trim_space(env_get_or("SIP_RTPENGINE_DEBUG", "0")))
    return if str_eq(v, "1") || str_eq(v, "true") || str_eq(v, "yes") { 1 } else { 0 }
}

fn rtp_debug_exchange(op: string, call_id: string, resp: string) -> int {
    if rtp_debug_enabled() == 0 { return 0 }
    if len(resp) == 0 {
        slog("  RTP:     " + op + " exchange failed (no response) call-id=" + call_id)
        return 0
    }
    let result = bencode_get(resp, "result")
    if not str_eq(result, "ok") {
        slog("  RTP:     " + op + " rejected result=" + result + " reason=" + bencode_get(resp, "error-reason") + " call-id=" + call_id)
    }
    return 1
}

fn rtp_answer_cache(cache: CMap, host: string, port: int, call_id: string, from_tag: string, to_tag: string, sdp: string) -> string {
    if rtp_dialog_tag_safe(from_tag) == 0 || rtp_dialog_tag_safe(to_tag) == 0 { return "" }
    // If the offer was WebRTC, the answer is from a SIP phone — tell RTPEngine
    let mut answer_flags = ""
    if cmap_has(cache, "rtp_webrtc|" + call_id) == 1 {
        answer_flags = "rtcp-mux-accept"
    }
    let mut cmd = ""
    if len(answer_flags) > 0 {
        cmd = bencode_dict_5(
            "command", "answer",
            "call-id", call_id,
            "from-tag", from_tag,
            "to-tag", to_tag,
            "sdp", sdp
        )
        // Append flags to the bencode — insert before closing 'e'
        cmd = cmd[0:len(cmd) - 1] + bencode_str("flags") + bencode_str(answer_flags) + "e"
    } else {
    cmd = bencode_dict_5(
        "command", "answer",
        "call-id", call_id,
        "from-tag", from_tag,
        "to-tag", to_tag,
        "sdp", sdp
    )
    }
    let resp = rtp_send_call(cache, call_id, cmd, host, port)
    let _ = rtp_debug_exchange("answer", call_id, resp)
    if len(resp) == 0 { return "" }
    let new_sdp = bencode_get(resp, "sdp")
    let result = bencode_get(resp, "result")
    if str_eq(result, "ok") { return new_sdp }
    return ""
}

// DELETE: called on BYE/CANCEL to tear down RTP session
fn rtp_delete(host: string, port: int, call_id: string) -> int {
    return rtp_delete_cache(cmap_new(), host, port, call_id)
}

fn rtp_delete_cache(cache: CMap, host: string, port: int, call_id: string) -> int {
    let cmd = bencode_dict_2(
        "command", "delete",
        "call-id", call_id
    )
    let resp = rtp_send_call(cache, call_id, cmd, host, port)
    let result = bencode_get(resp, "result")
    // Best-effort delete on all nodes tried: also wipe sticky binding.
    let _ = cmap_del(cache, "rtp_node|" + call_id)
    if str_eq(result, "ok") { return 1 }
    return 0
}

// High-level: process SDP through rtpengine for an INVITE
// Returns the message with SDP rewritten by rtpengine, or original if rtpengine is off
fn rtp_process_offer(msg: string, msglen: int, call_id: string, from_tag: string, db: SqlDB, db_ok: int, cache: CMap) -> string {
    let cfg = rtp_config(db, db_ok, cache)
    if str_eq(cfg[0], "0") { return msg }

    let sdp = sip_body(msg)
    if len(sdp) == 0 { return msg }
    if rtp_sdp_content_type_safe(msg) == 0 || rtp_sdp_body_safe(sdp) == 0 { return msg }

    let mut rtp_port = 2223
    match parse_int(cfg[2]) {
        Ok(v) => { rtp_port = v }
        Err(_) => {}
    }

    let new_sdp = rtp_offer_cache(cache, cfg[1], rtp_port, call_id, from_tag, sdp)
    if len(new_sdp) == 0 { return msg }
    let _ = bounded_cache_set(cache, "rtp_seq", "rtp_ring|", "rtp_state|" + call_id, "offer|" + string(mono_ms()), 65536)
    let _ = msglen
    return msg_set_body(msg, new_sdp)
}

// High-level: process SDP through rtpengine for a 200 OK response
fn rtp_process_answer(msg: string, msglen: int, call_id: string, from_tag: string, to_tag: string, db: SqlDB, db_ok: int, cache: CMap) -> string {
    let cfg = rtp_config(db, db_ok, cache)
    if rtp_debug_enabled() == 1 { slog("  RTP:     answer enter call-id=" + call_id + " enabled=" + cfg[0] + " sdp=" + string(len(sip_body(msg)))) }
    if str_eq(cfg[0], "0") { return msg }

    let sdp = sip_body(msg)
    if len(sdp) == 0 { return msg }
    if rtp_sdp_content_type_safe(msg) == 0 || rtp_sdp_body_safe(sdp) == 0 {
        if rtp_debug_enabled() == 1 { slog("  RTP:     answer gate rejected call-id=" + call_id + " ct=" + string(rtp_sdp_content_type_safe(msg)) + " body=" + string(rtp_sdp_body_safe(sdp))) }
        return msg
    }

    let mut rtp_port = 2223
    match parse_int(cfg[2]) {
        Ok(v) => { rtp_port = v }
        Err(_) => {}
    }

    let new_sdp = rtp_answer_cache(cache, cfg[1], rtp_port, call_id, from_tag, to_tag, sdp)
    if len(new_sdp) == 0 { return msg }
    let _ = bounded_cache_set(cache, "rtp_seq", "rtp_ring|", "rtp_state|" + call_id, "answer|" + string(mono_ms()), 65536)
    let _ = msglen
    return msg_set_body(msg, new_sdp)
}

// High-level: tear down RTP session on BYE/CANCEL
fn rtp_process_delete(call_id: string, db: SqlDB, db_ok: int, cache: CMap) -> int {
    let cfg = rtp_config(db, db_ok, cache)
    if str_eq(cfg[0], "0") { return 0 }

    let mut rtp_port = 2223
    match parse_int(cfg[2]) {
        Ok(v) => { rtp_port = v }
        Err(_) => {}
    }

    let result = rtp_delete_cache(cache, cfg[1], rtp_port, call_id)
    if result == 1 { let _ = cmap_del(cache, "rtp_state|" + call_id) }
    return result
}
