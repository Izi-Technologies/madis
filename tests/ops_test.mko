// SIP worker admin-plane pure boundary tests.
pull . "../main.mko"

fn TestProxyAdminSecretComparison() {
    assert_eq(proxy_admin_secret_equal("0123456789abcdef", "0123456789abcdef"), 1)
    assert_eq(proxy_admin_secret_equal("0123456789abcdee", "0123456789abcdef"), 0)
    assert_eq(proxy_admin_secret_equal("short", "0123456789abcdef"), 0)
    assert_eq(proxy_admin_secret_equal("", "0123456789abcdef"), 0)
}

fn TestProxyConfigReloadClearsRuntimeOverrides() {
    let cache = cmap_new()
    let _ = cmap_set(cache, "config_epoch", "4")
    let _ = cmap_set(cache, "rtpengine_cfg", "stale")
    let _ = cmap_set(cache, "shaken|v2", "stale")
    let _ = cmap_set(cache, "sec_enabled", "stale")
    assert_eq(proxy_config_reload(cache), 5)
    assert_eq_str(cmap_get(cache, "config_epoch"), "5")
    assert_eq(cmap_has(cache, "rtpengine_cfg"), 0)
    assert_eq(cmap_has(cache, "shaken|v2"), 0)
    assert_eq(cmap_has(cache, "sec_enabled"), 0)
    assert_eq(if len(cmap_get(cache, "config_reloaded_at")) > 0 { 1 } else { 0 }, 1)
}

fn TestProxyCacheRingCount() {
    let cache = cmap_new()
    let _ = cmap_set(cache, "dialog_ring|0", "dialog|live")
    let _ = cmap_set(cache, "dialog_ring|1", "dialog|gone")
    let _ = cmap_set(cache, "dialog|live", "confirmed|1")
    assert_eq(proxy_cache_ring_count(cache, "dialog_ring|", "", 4), 1)

    let _ = cmap_set(cache, "txn_ring|0", "branch-a|1 INVITE")
    let _ = cmap_set(cache, "txn_ring|1", "branch-b|1 INVITE")
    let _ = cmap_set(cache, "txn|branch-a|1 INVITE", "SIP/2.0 200 OK\r\nContent-Length: 0\r\n\r\n")
    assert_eq(proxy_cache_ring_count(cache, "txn_ring|", "txn|", 4), 1)
}

fn TestProxyClientTransactionMethodCount() {
    let cache = cmap_new()
    let invite = "INVITE sip:b@example.com SIP/2.0\r\nVia: SIP/2.0/UDP 192.0.2.10:5060;branch=z9hG4bK-inv\r\nFrom: <sip:a@example.com>;tag=a\r\nTo: <sip:b@example.com>\r\nCall-ID: inv@example.com\r\nCSeq: 1 INVITE\r\nContent-Length: 0\r\n\r\n"
    let bye = "BYE sip:b@example.com SIP/2.0\r\nVia: SIP/2.0/UDP 192.0.2.10:5060;branch=z9hG4bK-bye\r\nFrom: <sip:a@example.com>;tag=a\r\nTo: <sip:b@example.com>;tag=b\r\nCall-ID: bye@example.com\r\nCSeq: 2 BYE\r\nContent-Length: 0\r\n\r\n"
    let options = "OPTIONS sip:b@example.com SIP/2.0\r\nVia: SIP/2.0/UDP 192.0.2.10:5060;branch=z9hG4bK-opt\r\nFrom: <sip:a@example.com>;tag=a\r\nTo: <sip:b@example.com>\r\nCall-ID: opt@example.com\r\nCSeq: 3 OPTIONS\r\nContent-Length: 0\r\n\r\n"
    let _ = sip_client_txn_record(invite, "example.com:5060", "udp", 9, cache)
    let _ = sip_client_txn_record(bye, "example.com:5060", "udp", 9, cache)
    let _ = sip_client_txn_record(options, "example.com:5060", "udp", 9, cache)
    assert_eq(proxy_client_txn_method_count(cache, "INVITE"), 1)
    assert_eq(proxy_client_txn_method_count(cache, "BYE"), 1)
    assert_eq(proxy_client_txn_method_count(cache, "OTHER"), 1)
}
