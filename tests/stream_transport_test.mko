fn log_info_if(cache: CMap, component: string, msg: string) int { return 0 }
fn log_warn_if(cache: CMap, component: string, msg: string) int { return 0 }
fn log_debug_if(cache: CMap, component: string, msg: string) int { return 0 }
fn log_error_always(component: string, msg: string) int { return 0 }
