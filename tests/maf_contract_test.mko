fn TestMafEveryHttpRouteIsAllowlisted() {
    assert_eq(maf_api_route("POST", "/admin/api/v1/maf/calls"), 1)
    assert_eq(maf_api_route("GET", "/admin/api/v1/maf/calls/call-12345678"), 2)
    assert_eq(maf_api_route("POST", "/admin/api/v1/maf/calls/call-12345678/answer"), 3)
    assert_eq(maf_api_route("POST", "/admin/api/v1/maf/calls/call-12345678/reject"), 4)
    assert_eq(maf_api_route("POST", "/admin/api/v1/maf/calls/call-12345678/hangup"), 5)
    assert_eq(maf_api_route("POST", "/admin/api/v1/maf/calls/call-12345678/bridges"), 6)
    assert_eq(maf_api_route("POST", "/admin/api/v1/maf/calls/call-12345678/media"), 7)
    assert_eq(maf_api_route("GET", "/admin/api/v1/maf/events"), 8)
    assert_eq(maf_api_route("POST", "/admin/api/v1/maf/calls/call-12345678/headers"), 9)
    assert_eq(maf_api_ws_route("GET", "/admin/api/v1/maf/events/ws"), 1)
    assert_eq(maf_api_ws_route("POST", "/admin/api/v1/maf/events/ws"), 0)
    assert_eq(maf_api_write_required(1), 1)
    assert_eq(maf_api_write_required(2), 0)
    assert_eq(maf_api_write_required(3), 1)
    assert_eq(maf_api_write_required(7), 1)
    assert_eq(maf_api_write_required(9), 1)
    assert_eq(maf_api_write_required(8), 0)
}

fn TestMafRejectsPathConfusionAndUnsafeIdentifiers() {
    assert_eq(maf_api_route("GET", "/admin/api/v1/maf/calls/short"), 0)
    assert_eq(maf_api_route("GET", "/admin/api/v1/maf/calls/call-12345678/extra"), 0)
    assert_eq(maf_api_route("GET", "/admin/api/v1/maf/calls/call-12345678%2F.."), 0)
    assert_eq(maf_api_route("GET", "/admin/api/v1/maf/calls/call-12345678/../events"), 0)
    assert_eq(maf_api_identifier_ok("call-12345678", 8, 128), 1)
    assert_eq(maf_api_identifier_ok("call/12345678", 8, 128), 0)
    assert_eq(maf_api_identifier_ok("call-12345678\r\nX-Evil: 1", 8, 128), 0)
    assert_eq(maf_api_identifier_ok("", 1, 128), 0)
    assert_eq(maf_api_identifier_ok("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz", 8, 128), 0)
}

fn TestMafAuthComparisonAndFramingBoundaries() {
    assert(len(html_esc("maf")) > 0)
    assert_eq(maf_api_token_equal("0123456789abcdef", "0123456789abcdef"), 1)
    assert_eq(maf_api_token_equal("0123456789abcdee", "0123456789abcdef"), 0)
    assert_eq(maf_api_token_equal("short", "0123456789abcdef"), 0)
    let request = "POST /admin/api/v1/maf/calls HTTP/1.1\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}"
    assert_eq(maf_api_body_ok(request, len(request), 1), 1)
    let wrong_type = "POST /admin/api/v1/maf/calls HTTP/1.1\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\n{}"
    assert_eq(maf_api_body_ok(wrong_type, len(wrong_type), 1), 0)
    let missing_body = "POST /admin/api/v1/maf/calls HTTP/1.1\r\nContent-Type: application/json\r\nContent-Length: 0\r\n\r\n"
    assert_eq(maf_api_body_ok(missing_body, len(missing_body), 1), 0)
}

fn TestMafWorkerEndpointAndInviteBoundaries() {
    assert_eq(maf_worker_endpoint_ok("sip:alice@example.net"), 1)
    assert_eq(maf_worker_endpoint_ok("sips:bob@example.net:5061"), 1)
    assert_eq(maf_worker_endpoint_ok("https://evil.example.net"), 0)
    assert_eq(maf_worker_endpoint_ok("sip:alice@example.net\r\nX-Evil: 1"), 0)
    let invite = maf_worker_invite("call-12345678", "sip:alice@example.net", "sip:bob@example.net", "node1", "127.0.0.1", "udp")
    assert_eq(sip_validate_message(invite, len(invite)), 1)
    assert(str_contains(invite, "CSeq: 1 INVITE"))
    assert(str_contains(invite, "Call-ID: call-12345678@node1"))
}

fn TestMafCursorAndBoundedQueryValues() {
    assert_eq(maf_api_parse_cursor(""), 0)
    assert_eq(maf_api_parse_cursor("cursor=42"), 42)
    assert_eq(maf_api_parse_cursor("cursor=-1"), -1)
    assert_eq(maf_api_parse_cursor("cursor=abc"), -1)
    assert_eq(maf_api_limit(""), 100)
    assert_eq(maf_api_limit("limit=0"), 1)
    assert_eq(maf_api_limit("limit=1000"), 100)
    assert_eq(maf_api_limit("limit=not-a-number"), 100)
}

fn TestMafInboundCallIdentifiers() {
    let wire_id = maf_worker_inbound_call_id("default", "sip-call@example.net")
    assert(str_has_prefix(wire_id, "call-in-"))
    assert(str_eq(wire_id, maf_worker_inbound_call_id("default", "sip-call@example.net")))
    assert(wire_id != maf_worker_inbound_call_id("other", "sip-call@example.net"))
    assert(str_eq(maf_worker_inbound_call_id("default", "bad\r\nCall-ID"), ""))
}

fn TestMafInboundAnswerSdpBoundaries() {
    let sdp = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=MAF\r\nt=0 0\r\nm=audio 4000 RTP/AVP 0\r\n"
    assert_eq(maf_worker_answer_sdp_ok(sdp), 1)
}

fn TestMafInboundAnswerSdpRequiresMedia() {
    assert_eq(maf_worker_answer_sdp_ok("v=0\r\ns=missing-media\r\n"), 0)
}

fn TestMafInboundAnswerSdpRequiresSessionVersion() {
    assert_eq(maf_worker_answer_sdp_ok("m=audio 4000 RTP/AVP 0\r\n"), 0)
}

fn TestMafInboundAnswerSdpRejectsControls() {
    let b = str_builder()
    builder_write(b, "v=0\r\nm=audio 4000 RTP/AVP 0\r\n")
    builder_write_byte(b, byte(0))
    assert_eq(maf_worker_answer_sdp_ok(builder_string(b)), 0)
}

fn TestMafInboundAnswerMessage() {
    let sdp = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=MAF\r\nt=0 0\r\nm=audio 4000 RTP/AVP 0\r\n"
    let invite = maf_worker_invite("call-in-1234567890", "sip:alice@example.net", "sip:madis@example.net", "node1", "127.0.0.1", "udp")
    let answer = maf_worker_build_inbound_answer(invite, sdp, "sip:madis@127.0.0.1", "maf-in-testtag")
    assert_eq(sip_validate_message(answer, len(answer)), 1)
    assert_eq(sip_status_code(answer), 200)
    assert(str_contains(answer, "To: <sip:madis@example.net>;tag=maf-in-testtag"))
    assert(str_contains(answer, "Content-Type: application/sdp"))
    assert(str_contains(answer, "m=audio 4000 RTP/AVP 0"))
}

fn TestMafJsonEscapingAndCredentialScopes() {
    assert_eq_str(maf_api_json_escape("quote=\" slash=\\"), "quote=\\\" slash=\\\\")
    assert_eq_str(maf_api_json_escape("line\nnext"), "line\\nnext")

    let _ = env_set("SIP_MAF_API_TOKEN", "0123456789abcdef")
    let _ = env_set("SIP_MAF_API_READ_TOKEN", "fedcba9876543210")
    let write_request = "GET /admin/api/v1/maf/events HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdef\r\nContent-Length: 0\r\n\r\n"
    let read_request = "GET /admin/api/v1/maf/events HTTP/1.1\r\nAuthorization: bearer fedcba9876543210\r\nContent-Length: 0\r\n\r\n"
    let bad_request = "GET /admin/api/v1/maf/events HTTP/1.1\r\nAuthorization: Bearer 0123456789abcdee\r\nContent-Length: 0\r\n\r\n"
    assert_eq(maf_api_scope(write_request, len(write_request)), 2)
    assert_eq(maf_api_scope(read_request, len(read_request)), 1)
    assert_eq(maf_api_scope(bad_request, len(bad_request)), 0)
    let _ = env_set("SIP_MAF_API_TOKEN", "")
    let _ = env_set("SIP_MAF_API_READ_TOKEN", "")
}

fn TestMafCommandIdentityAndBodyLimits() {
    let body = "{\"command_id\":\"body-command-123\"}"
    let with_header = "POST /admin/api/v1/maf/calls HTTP/1.1\r\nIdempotency-Key: header-command-123\r\nContent-Type: application/json\r\nContent-Length: " + string(len(body)) + "\r\n\r\n" + body
    let without_header = "POST /admin/api/v1/maf/calls HTTP/1.1\r\nContent-Type: application/json\r\nContent-Length: " + string(len(body)) + "\r\n\r\n" + body
    assert_eq_str(maf_api_command_id(with_header, len(with_header), body), "header-command-123")
    assert_eq_str(maf_api_command_id(without_header, len(without_header), body), "body-command-123")
    let with_parameter = "POST /admin/api/v1/maf/calls HTTP/1.1\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: 2\r\n\r\n{}"
    assert_eq(maf_api_body_ok(with_parameter, len(with_parameter), 1), 1)
    let wrong_content = "POST /admin/api/v1/maf/calls HTTP/1.1\r\nContent-Type: application/json-patch+json\r\nContent-Length: 2\r\n\r\n{}"
    assert_eq(maf_api_body_ok(wrong_content, len(wrong_content), 1), 0)
}
