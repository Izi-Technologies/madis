// --- JSON escape dedup ---

fn TestMafHeadersJsonEscapeDelegates() {
    let input = "hello \"world\""
    let from_worker = maf_worker_json_escape(input)
    let from_headers = maf_headers_json_escape(input)
    assert_eq_str(from_worker, from_headers)
}

fn TestMafJsonEscapeSpecialChars() {
    assert_eq_str(maf_worker_json_escape("a\"b"), "a\\\"b")
    assert_eq_str(maf_worker_json_escape("a\\b"), "a\\\\b")
    assert_eq_str(maf_worker_json_escape("a\nb"), "a\\nb")
    assert_eq_str(maf_worker_json_escape("a\tb"), "a\\tb")
}

fn TestMafWorkerJsonCompactForExtract() {
    let raw = "{\"to\": \"sip:15551234567@carrier.example.net:5060\", \"from\": \"sip:alice@example.net\", \"application_data\": {\"purpose\": \"smoke:ok\"}}"
    let compact = maf_worker_json_compact_for_extract(raw)
    assert_eq_str(json_get_string(compact, "from"), "sip:alice@example.net")
    assert_eq_str(json_get_string(compact, "to"), "sip:15551234567@carrier.example.net:5060")
    assert(str_contains(compact, "\"purpose\":\"smoke:ok\""))
}

// --- Tenant validation ---

fn TestMafWorkerTenantDefault() {
    // Without SIP_MAF_TENANT set, returns "default"
    let t = maf_worker_tenant()
    assert_eq(if len(t) > 0 { 1 } else { 0 }, 1)
}

// --- Text safety ---

fn TestMafWorkerTextSafe() {
    assert_eq(maf_worker_text_safe("hello", 10), 1)
    assert_eq(maf_worker_text_safe("hello", 3), 0)
    assert_eq(maf_worker_text_safe("", 10), 1)
}

fn TestMafWorkerTextSafeRejectsControlChars() {
    // NUL can't be embedded in Mako string literals; test \n and \r.
    assert_eq(maf_worker_text_safe("a\nb", 10), 0)
    assert_eq(maf_worker_text_safe("a\rb", 10), 0)
}

// --- Endpoint validation ---

fn TestMafWorkerEndpointOk() {
    assert_eq(maf_worker_endpoint_ok("sip:alice@example.com"), 1)
    assert_eq(maf_worker_endpoint_ok("sip:15550002222@example.net"), 1)
    assert_eq(maf_worker_endpoint_ok("sip:15551234567@carrier.example.net:5060"), 1)
    assert_eq(maf_worker_endpoint_ok(""), 0)
}

fn TestMafWorkerInviteNumericTargetValid() {
    let invite = maf_worker_invite("call-test", "sip:+15550002222@example.net", "sip:15551234567@carrier.example.net:5060", "node1", "proxy.example.net:5060", "udp")
    assert_eq(sip_validate_message(invite, len(invite)), 1)
    let loopback_invite = maf_worker_invite("call-test", "sip:+15550002222@example.net", "sip:15551234567@carrier.example.net:5060", "node1", "127.0.0.1", "udp")
    assert_eq(sip_validate_message(loopback_invite, len(loopback_invite)), 1)
}

fn TestMafWorkerInviteWithSdp() {
    let sdp = "v=0\r\no=- 1 1 IN IP4 192.0.2.10\r\ns=-\r\nt=0 0\r\nm=audio 40000 RTP/AVP 0\r\n"
    let invite = maf_worker_invite_with_sdp(maf_worker_invite("call-test", "sip:alice@example.net", "sip:15551234567@carrier.example.net:5060", "node1", "proxy.example.net:5060", "udp"), sdp)
    assert(str_contains(invite, "Content-Type: application/sdp"))
    assert(str_contains(invite, "Content-Length: " + string(len(sdp))))
    assert(str_contains(invite, "m=audio 40000 RTP/AVP 0"))
    assert_eq(madis_header_count(invite, "Content-Length"), 1)
    assert_eq(sip_validate_message(invite, len(invite)), 1)
    let escaped = maf_worker_json_unescape("v=0\\r\\no=- 1 1 IN IP4 192.0.2.10\\r\\ns=-\\r\\nt=0 0\\r\\nm=audio 40000 RTP/AVP 0\\r\\n")
    let escaped_invite = maf_worker_invite_with_sdp(maf_worker_invite("call-test", "sip:alice@example.net", "sip:15551234567@carrier.example.net:5060", "node1", "proxy.example.net:5060", "udp"), escaped)
    assert(str_contains(escaped_invite, "v=0\r\no=- 1 1 IN IP4 192.0.2.10\r\n"))
    assert_eq(sip_validate_message(escaped_invite, len(escaped_invite)), 1)
}

fn TestMafWorkerRouteInviteNumericEndpointWithTransportParam() {
    let sdp =
        "v=0\r\n" +
        "o=facility 1 1 IN IP4 192.0.2.20\r\n" +
        "s=madis-e2e\r\n" +
        "c=IN IP4 192.0.2.20\r\n" +
        "t=0 0\r\n" +
        "m=audio 40000 RTP/AVP 0 101\r\n" +
        "a=rtpmap:0 PCMU/8000\r\n" +
        "a=rtpmap:101 telephone-event/8000\r\n" +
        "a=sendrecv\r\n"
    let target = "sip:15551234567@198.51.100.20:5060;transport=udp"
    let invite = maf_worker_invite_with_sdp(maf_worker_invite("call-in-test", "sip:facility@example.net", target, "node1", "198.51.100.10:5060", "udp"), sdp)
    assert_eq(sip_validate_message(invite, len(invite)), 1)
}

fn TestMafWorkerCachedInviteUnescapesJsonEnvelope() {
    let invite = maf_worker_invite("call-in-test", "sip:facility@example.net", "sip:15551234567@example.net", "node1", "198.51.100.10:5060", "udp")
    let packed = maf_worker_inbound_cache_value(invite, "192.0.2.20", 5062, "udp")
    let decoded = maf_worker_cached_invite(packed)
    assert(str_eq(sip_header(decoded, "From"), "<sip:facility@example.net>;tag=maf-" + sha256("call-in-test|from")[0:20]))
    assert_eq(sip_validate_message(decoded, len(decoded)), 1)
}

fn TestMafWorkerInboundCancelBuilds487() {
    let cache = cmap_new()
    let invite =
        "INVITE sip:b@example.com SIP/2.0\r\n" +
        "Via: SIP/2.0/UDP 192.0.2.20:5062;branch=z9hG4bK-maf-cancel\r\n" +
        "From: <sip:a@example.com>;tag=a\r\n" +
        "To: <sip:b@example.com>\r\n" +
        "Call-ID: wire-cancel@example.net\r\n" +
        "CSeq: 42 INVITE\r\n" +
        "Content-Length: 0\r\n\r\n"
    cmap_set(cache, "maf_inbound|call-in-cancel", maf_worker_inbound_cache_value(invite, "192.0.2.20", 5062, "udp"))
    let response = maf_worker_inbound_cancel_response(cache, "call-in-cancel")
    assert_eq(sip_status_code(response), 487)
    assert_eq_str(sip_header(response, "CSeq"), "42 INVITE")
    assert(str_contains(response, "Request Terminated"))
    assert_eq(sip_validate_message(response, len(response)), 1)
}

fn TestMafWorkerAck2xxUsesRemoteTagAndContactTarget() {
    let invite = maf_worker_invite("call-test", "sip:alice@example.net", "sip:bob@example.net", "node1", "proxy.example.net:5060", "udp")
    let response = "SIP/2.0 200 OK\r\nVia: SIP/2.0/UDP proxy.example.net:5060;branch=z9hG4bK-maf-test\r\nFrom: <sip:alice@example.net>;tag=maf-local\r\nTo: <sip:bob@example.net>;tag=remote-1\r\nCall-ID: call-test@node1\r\nCSeq: 1 INVITE\r\nContact: <sip:bob@carrier.example.net:5060>\r\nContent-Length: 0\r\n\r\n"
    let ack = maf_worker_build_ack_2xx(invite, response, "sip:bob@carrier.example.net:5060", "proxy.example.net:5060", "udp")
    assert(str_has_prefix(ack, "ACK sip:bob@carrier.example.net:5060 SIP/2.0"))
    assert(str_contains(ack, "To: <sip:bob@example.net>;tag=remote-1"))
    assert(str_contains(ack, "CSeq: 1 ACK"))
    assert_eq(sip_validate_message(ack, len(ack)), 1)
}

fn TestMafWorkerOutboundByeConsumesOwnedDialog() {
    let cache = cmap_new()
    let invite = maf_worker_invite("call-test", "sip:alice@example.net", "sip:bob@carrier.example.net:5060", "node1", "proxy.example.net:5060", "udp")
    cmap_set(cache, "maf_invite|call-test", invite)
    let bye =
        "BYE sip:madis@proxy.example.net:5060 SIP/2.0\r\n" +
        "Via: SIP/2.0/UDP carrier.example.net:5060;branch=z9hG4bK-bye\r\n" +
        "From: <sip:bob@carrier.example.net>;tag=remote\r\n" +
        "To: <sip:alice@example.net>;tag=local\r\n" +
        "Call-ID: call-test@node1\r\n" +
        "CSeq: 2 BYE\r\n" +
        "Content-Length: 0\r\n\r\n"
    let db = sql_open_sqlite(":memory:")
    assert_eq(maf_worker_handle_outbound_request(db, 0, bye, cache), 1)
}

fn TestMafWorkerOutboundByeResponseConsumesOwnedDialog() {
    let cache = cmap_new()
    let invite = maf_worker_invite("call-test", "sip:alice@example.net", "sip:bob@carrier.example.net:5060", "node1", "proxy.example.net:5060", "udp")
    cmap_set(cache, "maf_invite|call-test", invite)
    cmap_set(cache, "maf_response|call-test", "cached")
    cmap_set(cache, "maf_target|call-test", "sip:bob@carrier.example.net:5060")
    cmap_set(cache, "maf_transport|call-test", "udp")
    let response =
        "SIP/2.0 200 OK\r\n" +
        "Via: SIP/2.0/UDP proxy.example.net:5060;branch=z9hG4bK-maf-bye\r\n" +
        "From: <sip:alice@example.net>;tag=local\r\n" +
        "To: <sip:bob@carrier.example.net>;tag=remote\r\n" +
        "Call-ID: call-test@node1\r\n" +
        "CSeq: 2 BYE\r\n" +
        "Content-Length: 0\r\n\r\n"
    let db = sql_open_sqlite(":memory:")
    assert_eq(maf_worker_handle_outbound_response(db, 0, response, cache, 0), 1)
    assert_eq(cmap_has(cache, "maf_response|call-test"), 0)
    assert_eq(cmap_has(cache, "maf_target|call-test"), 0)
    assert_eq(cmap_has(cache, "maf_transport|call-test"), 0)
}

fn TestMafWorkerOutboundInviteResponseBridgesInboundAnswer() {
    let cache = cmap_new()
    let db = sql_open_sqlite(":memory:")
    let inbound =
        "INVITE sip:15551234567@proxy.example.net SIP/2.0\r\n" +
        "Via: SIP/2.0/UDP facility.example.net:5062;rport;branch=z9hG4bK-inbound\r\n" +
        "Max-Forwards: 70\r\n" +
        "From: <sip:facility@example.net>;tag=facility\r\n" +
        "To: <sip:15551234567@proxy.example.net>\r\n" +
        "Call-ID: inbound-wire@example.net\r\n" +
        "CSeq: 1 INVITE\r\n" +
        "Contact: <sip:facility@facility.example.net:5062>\r\n" +
        "Content-Length: 0\r\n\r\n"
    let invite = maf_worker_invite("call-test", "sip:facility@example.net", "sip:15551234567@carrier.example.net:5060", "node1", "proxy.example.net:5060", "udp")
    cmap_set(cache, "maf_invite|call-test", invite)
    cmap_set(cache, "maf_target|call-test", "sip:15551234567@carrier.example.net:5060")
    cmap_set(cache, "maf_transport|call-test", "udp")
    cmap_set(cache, "maf_inbound|call-test", maf_worker_inbound_cache_value(inbound, "192.0.2.20", 5062, "udp"))
    let sdp = "v=0\r\no=- 1 2 IN IP4 198.51.100.20\r\ns=-\r\nc=IN IP4 198.51.100.20\r\nt=0 0\r\nm=audio 20000 RTP/AVP 0\r\n"
    let response =
        "SIP/2.0 200 OK\r\n" +
        "Via: SIP/2.0/UDP proxy.example.net:5060;branch=z9hG4bK-maf-test\r\n" +
        "From: <sip:facility@example.net>;tag=maf-local\r\n" +
        "To: <sip:15551234567@carrier.example.net>;tag=remote\r\n" +
        "Call-ID: call-test@node1\r\n" +
        "CSeq: 1 INVITE\r\n" +
        "Contact: <sip:15551234567@carrier.example.net:5060>\r\n" +
        "Content-Type: application/sdp\r\n" +
        "Content-Length: " + string(len(sdp)) + "\r\n\r\n" + sdp
    assert_eq(maf_worker_handle_outbound_response(db, 0, response, cache, 0), 1)
    let inbound_answer = cmap_get(cache, "maf_inbound_answer|call-test")
    assert(str_has_prefix(inbound_answer, "SIP/2.0 200 OK"))
    assert(str_contains(inbound_answer, "Call-ID: inbound-wire@example.net"))
    assert(str_contains(inbound_answer, "Content-Type: application/sdp"))
    assert_eq(sip_validate_message(inbound_answer, len(inbound_answer)), 1)
}

// --- SDP validation ---

fn TestMafWorkerAnswerSdpOk() {
    let valid_sdp = "v=0\r\no=- 1 1 IN IP4 0.0.0.0\r\ns=-\r\nt=0 0\r\nm=audio 8000 RTP/AVP 0\r\n"
    assert_eq(maf_worker_answer_sdp_ok(valid_sdp), 1)
    assert_eq(maf_worker_answer_sdp_ok("short"), 0)
    assert_eq(maf_worker_answer_sdp_ok("v=1\r\nm=audio 8000 RTP/AVP 0\r\n"), 0)
}

// --- Inbound call ID generation ---

fn TestMafWorkerInboundCallId() {
    let id = maf_worker_inbound_call_id("default", "test-call-id-123")
    assert_eq(if str_has_prefix(id, "call-in-") { 1 } else { 0 }, 1)
    assert_eq(if len(id) > 10 { 1 } else { 0 }, 1)
}

fn TestMafWorkerInboundCallIdDeterministic() {
    let a = maf_worker_inbound_call_id("default", "same-id")
    let b = maf_worker_inbound_call_id("default", "same-id")
    assert_eq_str(a, b)
}

fn TestMafWorkerInboundCallIdDiffersByTenant() {
    let a = maf_worker_inbound_call_id("tenant-a", "call-1")
    let b = maf_worker_inbound_call_id("tenant-b", "call-1")
    assert_eq(if str_eq(a, b) { 1 } else { 0 }, 0)
}

fn TestMafWorkerInboundCallIdRejectsEmpty() {
    assert_eq_str(maf_worker_inbound_call_id("", "call-1"), "")
    assert_eq_str(maf_worker_inbound_call_id("default", ""), "")
}

fn TestMafWorkerInboundCachePutUsesBoundedCacheSuccess() {
    let cache = cmap_new()
    let value = maf_worker_inbound_cache_value("INVITE sip:b@example.com SIP/2.0\r\n\r\n", "127.0.0.1", 5060, "udp")
    assert_eq(maf_worker_inbound_cache_put(cache, "call-in-test", value), 0)
}

fn TestMafWorkerMetricRequiresPromActive() {
    let cache = cmap_new()
    assert_eq(maf_worker_metric(cache, "maf_commands", "operation=\"calls.create\",status=\"processing\""), 0)
    assert_eq(cmap_has(cache, "prom|maf_commands|operation=\"calls.create\",status=\"processing\""), 0)
    let _ = cmap_set(cache, "_prom_active", "1")
    assert_eq(maf_worker_metric(cache, "maf_commands", "operation=\"calls.create\",status=\"processing\""), 1)
    assert_eq_str(cmap_get(cache, "prom|maf_commands|operation=\"calls.create\",status=\"processing\""), "1")
}

fn TestMafWorkerEnvIntBounds() {
    let _ = env_set("SIP_MAF_COMMAND_MAX_ATTEMPTS", "99")
    assert_eq(maf_worker_env_int("SIP_MAF_COMMAND_MAX_ATTEMPTS", 3, 1, 10), 10)
    let _ = env_set("SIP_MAF_COMMAND_MAX_ATTEMPTS", "0")
    assert_eq(maf_worker_env_int("SIP_MAF_COMMAND_MAX_ATTEMPTS", 3, 1, 10), 1)
    let _ = env_set("SIP_MAF_COMMAND_MAX_ATTEMPTS", "bad")
    assert_eq(maf_worker_env_int("SIP_MAF_COMMAND_MAX_ATTEMPTS", 3, 1, 10), 3)
    let _ = env_set("SIP_MAF_COMMAND_MAX_ATTEMPTS", "")
}

fn TestMafWorkerIntText() {
    assert_eq(maf_worker_int_text("7"), 7)
    assert_eq(maf_worker_int_text("-2"), 0)
    assert_eq(maf_worker_int_text("bad"), 0)
}

// --- MAF API route coverage ---

fn TestMafApiRouteEvents() {
    assert_eq(maf_api_route("GET", "/admin/api/v1/maf/events"), 8)
}

fn TestMafApiRouteHeaders() {
    assert_eq(maf_api_route("POST", "/admin/api/v1/maf/calls/call-abc/headers"), 9)
}

fn TestMafApiWsRoute() {
    assert_eq(maf_api_ws_route("GET", "/admin/api/v1/maf/events/ws"), 1)
    assert_eq(maf_api_ws_route("POST", "/admin/api/v1/maf/events/ws"), 0)
}

fn TestMafApiRouteRejectsUnknown() {
    assert_eq(maf_api_route("DELETE", "/admin/api/v1/maf/calls"), 0)
    assert_eq(maf_api_route("GET", "/admin/api/v1/maf/unknown"), 0)
}

// --- MAF header policy ---

fn TestMafHeadersProtectedHeaders() {
    assert_eq(maf_headers_protected("Via"), 1)
    assert_eq(maf_headers_protected("via"), 1)
    assert_eq(maf_headers_protected("Call-ID"), 1)
    assert_eq(maf_headers_protected("From"), 1)
    assert_eq(maf_headers_protected("Content-Length"), 1)
    assert_eq(maf_headers_protected("Authorization"), 1)
    assert_eq(maf_headers_protected("X-Custom"), 0)
    assert_eq(maf_headers_protected("P-Asserted-Identity"), 0)
}

fn TestMafHeadersActionOk() {
    assert_eq(maf_headers_action_ok("add"), 1)
    assert_eq(maf_headers_action_ok("set"), 1)
    assert_eq(maf_headers_action_ok("remove"), 1)
    assert_eq(maf_headers_action_ok("rename"), 1)
    assert_eq(maf_headers_action_ok("copy"), 1)
    assert_eq(maf_headers_action_ok("move"), 1)
    assert_eq(maf_headers_action_ok("delete"), 0)
    assert_eq(maf_headers_action_ok("inject"), 0)
}

fn TestMafHeadersDirectionOk() {
    assert_eq(maf_headers_direction_ok("inbound"), 1)
    assert_eq(maf_headers_direction_ok("outbound"), 1)
    assert_eq(maf_headers_direction_ok("both"), 1)
    assert_eq(maf_headers_direction_ok("sideways"), 0)
}
