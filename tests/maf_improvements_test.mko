fn nat_fix_sdp(msg: string, msglen: int, source_ip: string) string { return msg }
fn msg_set_body(msg: string, new_body: string) string {
    let end = str_index(msg, "\r\n\r\n")
    let headers = if end >= 0 { msg[0:end] } else { msg }
    let mut out = ""
    let mut line_start = 0
    while line_start < len(headers) {
        let rel = str_index(headers[line_start:], "\r\n")
        let line_end = if rel >= 0 { line_start + rel } else { len(headers) }
        let line = headers[line_start:line_end]
        let low = str_to_lower(line)
        if not str_has_prefix(low, "content-length:") && not str_has_prefix(low, "l:") {
            out = out + line + "\r\n"
        }
        if rel < 0 { break }
        line_start = line_end + 2
    }
    return out + "Content-Length: " + string(len(new_body)) + "\r\n\r\n" + new_body
}
