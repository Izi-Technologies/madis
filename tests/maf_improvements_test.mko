// Tests for MAF improvements: adaptive poll, event filtering, transport
// selection, JSON escape dedup, and event ID uniqueness.
pull . "../parser.mko"
pull . "../admin/http.mko"
pull . "../admin/ui.mko"
pull . "../maf_api.mko"

fn sip_forward_first(targets: string, msg: string, cache: CMap, cid: string, out_fd: int) string { return "" }
fn sip_forward_target(target: string, msg: string, tr: string, cache: CMap, out_fd: int) int { return 0 }
fn sip_transport_param(target: string, fallback: string) string {
    let low = str_to_lower(target)
    if str_has_prefix(low, "sips:") { return "tls" }
    let p = str_index(low, "transport=")
    if p >= 0 {
        let start = p + 10
        let mut end = start
        while end < len(target) {
            let c = int(target[end])
            if c == 59 || c == 62 || c == 32 { break }
            end = end + 1
        }
        if end > start { return str_to_lower(target[start:end]) }
    }
    return fallback
}
fn sip_prepend_header(msg: string, name: string, value: string) string { return msg }
fn sip_header_n(msg: string, name: string, index: int) string { return sip_header(msg, name) }
