// Admin password verifier tests. The legacy case proves migration compatibility
// without retaining unsalted hashes for newly created or changed passwords.
pull . "../admin/http.mko"

fn TestAdminPasswordHashing() {
    let stored = admin_password_hash("correct horse battery staple")
    assert(str_has_prefix(stored, "v1$"))
    assert_eq(admin_password_valid(stored, "correct horse battery staple"), 1)
    assert_eq(admin_password_valid(stored, "wrong password"), 0)
    assert_eq(admin_password_valid(stored, ""), 0)
}

fn TestAdminLegacyHashCompatibility() {
    let legacy = sha256("legacy-password")
    assert_eq(admin_password_valid(legacy, "legacy-password"), 1)
    assert_eq(admin_password_valid(legacy, "wrong-password"), 0)
    assert_eq(admin_password_is_modern(legacy), 0)
}
