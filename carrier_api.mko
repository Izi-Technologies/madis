// Versioned language-neutral carrier API helpers for the standalone WebUI.
// The endpoint is deliberately bounded and authenticated before any query.

fn carrier_cap(s: string, max: int) -> string {
    if max < 1 { return "" }
    if len(s) <= max { return s }
    return s[0:max]
}

fn carrier_json_escape(s: string) -> string {
    let mut b = str_builder()
    let mut i = 0
    while i < len(s) {
        let c = int(s[i])
        if c == 34 { builder_write(b, "\\\"") }
        else { if c == 92 { builder_write(b, "\\\\") } else { if c < 32 { builder_write_byte(b, byte(32)) } else { builder_write_byte(b, byte(c)) } } }
        i = i + 1
    }
    return builder_string(b)
}

fn carrier_api_token_ok(raw: string, n: int) -> int {
    let expected = env_get_or("SIP_CARRIER_API_TOKEN", "")
    if len(expected) == 0 { return 0 }
    let header = parse_header(raw, n, "Authorization")
    if not str_has_prefix(str_to_lower(header), "bearer ") { return 0 }
    let actual = str_trim_space(header[7:])
    if len(actual) == 0 || len(actual) > 256 { return 0 }
    return if str_eq(actual, expected) { 1 } else { 0 }
}

fn carrier_api_control_token_ok(raw: string, n: int) -> int {
    let expected = env_get_or("SIP_CONTROL_API_TOKEN", "")
    if len(expected) == 0 { return 0 }
    let header = parse_header(raw, n, "Authorization")
    if not str_has_prefix(str_to_lower(header), "bearer ") { return 0 }
    let actual = str_trim_space(header[7:])
    if len(actual) == 0 || len(actual) > 256 { return 0 }
    return if str_eq(actual, expected) { 1 } else { 0 }
}

fn carrier_api_json_request_ok(raw: string, n: int) -> int {
    let content_type = str_to_lower(parse_header(raw, n, "Content-Type"))
    if not str_has_prefix(content_type, "application/json") { return 0 }
    let body = parse_body(raw, n)
    if len(body) == 0 || len(body) > 65536 { return 0 }
    return 1
}

fn carrier_api_limit(q: string) -> int {
    let mut limit = 100
    let raw = query_val(q, "limit")
    if len(raw) > 0 {
        match parse_int(raw) { Ok(v) => { limit = v } Err(_) => {} }
    }
    if limit < 1 { limit = 1 }
    if limit > 100 { limit = 100 }
    return limit
}

fn carrier_api_capabilities() -> string {
    let mut app_enabled = "false"
    if len(str_trim_space(env_get_or("SIP_APP_URL", ""))) > 0 && len(env_get_or("SIP_APP_TOKEN", "")) >= 16 { app_enabled = "true" }
    let mut module_enabled = "false"
    if len(str_trim_space(env_get_or("SIP_MODULE_URL", ""))) > 0 && len(env_get_or("SIP_MODULE_TOKEN", "")) >= 16 { module_enabled = "true" }
    return "{"
        + "\"schema\":\"madis.capabilities.v1\","
        + "\"version\":\"" + carrier_json_escape(carrier_cap(env_get_or("MADIS_VERSION", "dev"), 128)) + "\","
        + "\"mako_version\":\"0.4.16\","
        + "\"transports\":[\"udp\",\"tcp\",\"tls\",\"ws\",\"wss\"],"
        + "\"contracts\":[\"billing-event-v1\",\"charging-request-v1\",\"diameter-rfc8506-v1\",\"diameter-rfc6733-peer-v1\",\"ims-cx-dx-v1\",\"ims-sh-v1\",\"ims-session-v1\",\"ss7-m3ua-envelope-v1\"],"
        + "\"charging\":{\"outbox\":true,\"preauth_http_adapter\":true,\"diameter_native\":true,\"diameter_transport\":\"tcp_tls_sctp\",\"diameter_persistent_peer\":true,\"diameter_sctp\":true,\"diameter_sctp_runtime\":\"platform_dependent\",\"diameter_peer_failover\":false},"
        + "\"ims\":{\"cx_dx_wire_contract\":true,\"cx_register_uar_sar\":true,\"sh_wire_contract\":true,\"hss_native\":false,\"scscf_service_logic\":false},"
        + "\"ss7\":{\"native_sctp_m3ua\":false,\"external_adapter\":true},"
        + "\"memory_safety\":{\"bounded_http_body\":true,\"bounded_outbox_page\":true,\"parameterized_sql\":true},"
        + "\"control\":{\"schema\":\"madis.control.v1\",\"authenticated\":true,\"routing_rules\":true,\"b2bua_policy\":true,\"arbitrary_code_execution\":false},"
        + "\"sip_application\":{\"schema\":\"madis.sip.event.v1\",\"command_schema\":\"madis.sip.command.v1\",\"signed\":true,\"bounded\":true,\"enabled\":" + app_enabled + "},"
        + "\"module_bus\":{\"schema\":\"madis.module.request.v1\",\"modules\":[\"tts\",\"stt\",\"llm\",\"media\",\"recording\",\"fraud\",\"billing\"],\"signed\":true,\"bounded\":true,\"enabled\":" + module_enabled + "},"
        + "\"extensions\":{}"
        + "}"
}

fn carrier_api_rule_value_safe(value: string, max: int) -> int {
    if len(value) > max { return 0 }
    let mut i = 0
    while i < len(value) {
        let c = int(value[i])
        if c == 0 || c == 10 || c == 13 || c == 124 { return 0 }
        i = i + 1
    }
    return 1
}

fn carrier_api_rule_field(body: string, key: string, max: int) -> string {
    let value = json_get_string(body, key)
    if carrier_api_rule_value_safe(value, max) == 0 { return "" }
    return value
}

fn carrier_api_rule_action_ok(action: string) -> int {
    if str_eq(action, "continue") || str_eq(action, "lcr") { return 1 }
    let prefixes = ["route:", "b2bua:", "dispatch:", "reject:", "redirect:", "failover:"]
    let mut i = 0
    while i < len(prefixes) {
        if str_has_prefix(action, prefixes[i]) {
            let spec = action[len(prefixes[i]):]
            if len(spec) == 0 || str_contains(spec, ",") && str_eq(prefixes[i], "b2bua:") { return 0 }
            return 1
        }
        i = i + 1
    }
    return 0
}

fn carrier_api_rule_id(path: string) -> string {
    let prefix = "/admin/api/v1/control/routing-rules/"
    if not str_has_prefix(path, prefix) { return "" }
    let rest = path[len(prefix):]
    let slash = str_index(rest, "/")
    if slash <= 0 { return "" }
    let id = rest[0:slash]
    let action = rest[slash + 1:]
    if not str_eq(action, "enable") && not str_eq(action, "disable") { return "" }
    match parse_int(id) {
        Ok(v) => { if v > 0 && v <= 2147483647 { return id } }
        Err(_) => {}
    }
    return ""
}

fn carrier_api_rule_state(path: string) -> string {
    let prefix = "/admin/api/v1/control/routing-rules/"
    let rest = path[len(prefix):]
    let slash = str_index(rest, "/")
    if slash <= 0 { return "" }
    return rest[slash + 1:]
}

fn carrier_api_control_status() -> string {
    let mode = str_to_lower(str_trim_space(env_get_or("SIP_B2BUA_MODE", "proxy")))
    let mut enabled = "false"
    if str_eq(mode, "1") || str_eq(mode, "enabled") || str_eq(mode, "b2bua") { enabled = "true" }
    return "{\"schema\":\"madis.control.v1\",\"mako_version\":\"0.4.16\",\"b2bua\":{\"enabled\":" + enabled + ",\"mode\":\"" + carrier_json_escape(carrier_cap(mode, 32)) + "\"},\"operations\":[\"routing-rules.read\",\"routing-rules.create\",\"routing-rules.enable\",\"routing-rules.disable\"]}"
}

fn carrier_api_control_rules(db: SqlDB, ok: int, limit: int) -> string {
    let rows = tbl_query(db, ok, "SELECT json_build_object('id', id, 'match_prefix', COALESCE(match_prefix,''), 'match_caller', COALESCE(match_caller,''), 'match_src_ip', COALESCE(match_src_ip,''), 'match_time_start', COALESCE(match_time_start,''), 'match_time_end', COALESCE(match_time_end,''), 'match_day', COALESCE(match_day,''), 'action', action, 'priority', priority, 'enabled', enabled, 'description', COALESCE(description,''))::text FROM routing_rules ORDER BY priority ASC, id ASC", limit)
    let mut out = "{\"schema\":\"madis.control.routing-rules.v1\",\"rules\":["
    let mut i = 0
    while i < len(rows) {
        if len(out) + len(rows[i]) + 2 > 262144 { break }
        if i > 0 { out = out + "," }
        out = out + rows[i]
        i = i + 1
    }
    return out + "]}"
}

fn carrier_api_control_create_rule(db: SqlDB, ok: int, body: string) -> int {
    if ok == 0 || len(body) == 0 || len(body) > 65536 { return -1 }
    let action_raw = json_get_string(body, "action")
    let prefix_raw = json_get_string(body, "match_prefix")
    let caller_raw = json_get_string(body, "match_caller")
    let src_ip_raw = json_get_string(body, "match_src_ip")
    let time_start_raw = json_get_string(body, "match_time_start")
    let time_end_raw = json_get_string(body, "match_time_end")
    let day_raw = json_get_string(body, "match_day")
    let description_raw = json_get_string(body, "description")
    let priority_raw = json_get_string(body, "priority")
    if carrier_api_rule_value_safe(action_raw, 512) == 0 || carrier_api_rule_value_safe(prefix_raw, 256) == 0 || carrier_api_rule_value_safe(caller_raw, 256) == 0 || carrier_api_rule_value_safe(src_ip_raw, 128) == 0 || carrier_api_rule_value_safe(time_start_raw, 16) == 0 || carrier_api_rule_value_safe(time_end_raw, 16) == 0 || carrier_api_rule_value_safe(day_raw, 32) == 0 || carrier_api_rule_value_safe(description_raw, 512) == 0 || carrier_api_rule_value_safe(priority_raw, 16) == 0 { return -1 }
    let action = action_raw
    if len(action) == 0 || carrier_api_rule_action_ok(action) == 0 { return -1 }
    let prefix = prefix_raw
    let caller = caller_raw
    let src_ip = src_ip_raw
    let time_start = time_start_raw
    let time_end = time_end_raw
    let day = day_raw
    let description = description_raw
    let mut priority = 10
    if len(priority_raw) > 0 {
        match parse_int(priority_raw) { Ok(v) => { priority = v } Err(_) => { return -1 } }
    } else {
        if str_index(body, "\"priority\"") >= 0 { priority = json_get_int(body, "priority") }
    }
    if priority < 0 || priority > 100000 { return -1 }
    // The JSON document is one bound value; the SQL text contains no caller
    // data. The extracted fields were validated above before this insert.
    let packed = "{\"match_prefix\":\"" + carrier_json_escape(prefix) + "\",\"match_caller\":\"" + carrier_json_escape(caller) + "\",\"match_src_ip\":\"" + carrier_json_escape(src_ip) + "\",\"match_time_start\":\"" + carrier_json_escape(time_start) + "\",\"match_time_end\":\"" + carrier_json_escape(time_end) + "\",\"match_day\":\"" + carrier_json_escape(day) + "\",\"action\":\"" + carrier_json_escape(action) + "\",\"priority\":" + string(priority) + ",\"description\":\"" + carrier_json_escape(description) + "\"}"
    let rc = sql_exec_str4(db, "INSERT INTO routing_rules (match_prefix, match_caller, match_src_ip, match_time_start, match_time_end, match_day, action, priority, enabled, description) SELECT COALESCE($4::jsonb->>'match_prefix',''), COALESCE($4::jsonb->>'match_caller',''), COALESCE($4::jsonb->>'match_src_ip',''), COALESCE($4::jsonb->>'match_time_start',''), COALESCE($4::jsonb->>'match_time_end',''), COALESCE($4::jsonb->>'match_day',''), $4::jsonb->>'action', COALESCE(($4::jsonb->>'priority')::int, 10), true, COALESCE($4::jsonb->>'description','')", "", "", "", packed)
    if rc < 0 { return -2 }
    return rc
}

fn carrier_api_events(db: SqlDB, ok: int, limit: int) -> string {
    let rows = tbl_query(db, ok, "SELECT json_build_object('event_id', event_id, 'call_id', call_id, 'event_type', event_type, 'payload', payload_json, 'occurred_at', occurred_at, 'attempts', attempts)::text FROM billing_events WHERE delivered_at IS NULL ORDER BY occurred_at ASC, event_id ASC", limit)
    let mut out = "{\"schema\":\"madis.billing.batch.v1\",\"events\":["
    let mut truncated = 0
    let mut i = 0
    while i < len(rows) {
        if len(out) + len(rows[i]) + 2 > 262144 { truncated = 1; break }
        if i > 0 { out = out + "," }
        out = out + rows[i]
        i = i + 1
    }
    let mut trunc_text = "false"
    if truncated == 1 { trunc_text = "true" }
    return out + "],\"truncated\":" + trunc_text + "}"
}

fn carrier_api_event_id_ok(event_id: string) -> int {
    if len(event_id) < 16 || len(event_id) > 128 { return 0 }
    let mut i = 0
    while i < len(event_id) {
        let c = int(event_id[i])
        let safe = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 58 || c == 95
        if not safe { return 0 }
        i = i + 1
    }
    return 1
}

fn carrier_api_ack(db: SqlDB, ok: int, event_id: string) -> int {
    if ok == 0 || carrier_api_event_id_ok(event_id) == 0 { return -1 }
    return sql_exec_str4(db, "UPDATE billing_events SET delivered_at = NOW(), attempts = attempts + 1 WHERE event_id = $1", event_id, "", "", "")
}

fn carrier_api_publish(db: SqlDB, ok: int, body: string) -> int {
    if ok == 0 || len(body) == 0 || len(body) > 65536 { return -1 }
    let event_type = json_get_string(body, "event_type")
    if len(event_type) == 0 || len(event_type) > 128 { return -1 }
    let mut event_id = json_get_string(body, "event_id")
    if len(event_id) == 0 { event_id = sha256(body) }
    if carrier_api_event_id_ok(event_id) == 0 { return -1 }
    let subject = json_get_string(body, "session_id")
    return sql_exec_str4(db, "INSERT INTO billing_events (event_id, call_id, event_type, payload_json) VALUES ($1, $2, $3, $4::jsonb) ON CONFLICT (event_id) DO NOTHING", event_id, carrier_cap(subject, 512), carrier_cap(event_type, 128), body)
}

fn carrier_api_route(method: string, path: string) -> int {
    if str_eq(method, "GET") && str_eq(path, "/admin/api/v1/capabilities") { return 1 }
    if str_eq(method, "GET") && str_eq(path, "/admin/api/v1/billing/events") { return 2 }
    if str_eq(method, "POST") && str_eq(path, "/admin/api/v1/billing/events") { return 3 }
    if str_eq(method, "POST") && str_eq(path, "/admin/api/v1/billing/events/ack") { return 4 }
    if str_eq(method, "GET") && str_eq(path, "/admin/api/v1/control/status") { return 5 }
    if str_eq(method, "GET") && str_eq(path, "/admin/api/v1/control/routing-rules") { return 6 }
    if str_eq(method, "POST") && str_eq(path, "/admin/api/v1/control/routing-rules") { return 7 }
    if str_eq(method, "POST") && len(carrier_api_rule_id(path)) > 0 { return 8 }
    return 0
}

fn carrier_api_requires_control(kind: int) -> int {
    if kind >= 5 { return 1 }
    return 0
}

fn carrier_api_handle(db: SqlDB, ok: int, method: string, path: string, raw: string, n: int) -> string {
    let kind = carrier_api_route(method, path)
    if kind == 1 { return http_resp(200, "application/json", carrier_api_capabilities(), "Cache-Control: no-store\r\n") }
    if kind == 2 {
        if ok == 0 { return http_resp(503, "application/json", "{\"ok\":false,\"error\":\"database unavailable\"}\n", "") }
        return http_resp(200, "application/json", carrier_api_events(db, ok, carrier_api_limit(parse_query(raw, n))), "Cache-Control: no-store\r\n")
    }
    if kind == 3 {
        if carrier_api_json_request_ok(raw, n) == 0 { return http_resp(400, "application/json", "{\"ok\":false,\"error\":\"application/json body required\"}\n", "") }
        if ok == 0 { return http_resp(503, "application/json", "{\"ok\":false,\"error\":\"database unavailable\"}\n", "") }
        let rc = carrier_api_publish(db, ok, parse_body(raw, n))
        if rc < 0 { return http_resp(400, "application/json", "{\"ok\":false,\"error\":\"invalid event\"}\n", "") }
        return http_resp(202, "application/json", "{\"ok\":true,\"accepted\":true}\n", "")
    }
    if kind == 4 {
        if ok == 0 { return http_resp(503, "application/json", "{\"ok\":false,\"error\":\"database unavailable\"}\n", "") }
        let rc = carrier_api_ack(db, ok, query_val(parse_query(raw, n), "event_id"))
        if rc < 0 { return http_resp(400, "application/json", "{\"ok\":false,\"error\":\"invalid event_id\"}\n", "") }
        return http_resp(200, "application/json", "{\"ok\":true,\"acknowledged\":true}\n", "")
    }
    if kind == 5 { return http_resp(200, "application/json", carrier_api_control_status(), "Cache-Control: no-store\r\n") }
    if kind == 6 {
        if ok == 0 { return http_resp(503, "application/json", "{\"ok\":false,\"error\":\"database unavailable\"}\n", "") }
        return http_resp(200, "application/json", carrier_api_control_rules(db, ok, carrier_api_limit(parse_query(raw, n))), "Cache-Control: no-store\r\n")
    }
    if kind == 7 {
        if carrier_api_json_request_ok(raw, n) == 0 { return http_resp(400, "application/json", "{\"ok\":false,\"error\":\"application/json body required\"}\n", "") }
        if ok == 0 { return http_resp(503, "application/json", "{\"ok\":false,\"error\":\"database unavailable\"}\n", "") }
        let rc = carrier_api_control_create_rule(db, ok, parse_body(raw, n))
        if rc == -1 { return http_resp(400, "application/json", "{\"ok\":false,\"error\":\"invalid routing rule\"}\n", "") }
        if rc < 0 { return http_resp(500, "application/json", "{\"ok\":false,\"error\":\"routing rule could not be stored\"}\n", "") }
        return http_resp(201, "application/json", "{\"ok\":true,\"created\":true}\n", "")
    }
    if kind == 8 {
        if ok == 0 { return http_resp(503, "application/json", "{\"ok\":false,\"error\":\"database unavailable\"}\n", "") }
        let id = carrier_api_rule_id(path)
        if len(sql_query_str(db, "SELECT id::text FROM routing_rules WHERE id = $1", id)) == 0 { return http_resp(404, "application/json", "{\"ok\":false,\"error\":\"routing rule not found\"}\n", "") }
        let mut value = "false"
        if str_eq(carrier_api_rule_state(path), "enable") { value = "true" }
        let rc = sql_exec_str4(db, "UPDATE routing_rules SET enabled = $2::boolean WHERE id = $1", id, value, "", "")
        if rc < 0 { return http_resp(500, "application/json", "{\"ok\":false,\"error\":\"routing rule could not be updated\"}\n", "") }
        return http_resp(200, "application/json", "{\"ok\":true,\"updated\":true}\n", "")
    }
    return http_resp(404, "application/json", "{\"ok\":false,\"error\":\"not found\"}\n", "")
}
