// ============ DISPATCHER / LOAD BALANCER ============
// dispatch_sets table: groups of servers with algorithm
//   Algorithms: round-robin, weight, priority, hash, broadcast
//   Failover: if primary fails, try next in set
//   Health: track server availability via OPTIONS pings
//
// ============ ADVANCED ROUTING ENGINE ============
// Evaluates routing_rules table top-to-bottom (by priority).
// Each rule has match conditions and an action.
//
// Match conditions (all must match for rule to fire):
//   match_prefix      — longest prefix on callee ('' = any)
//   match_caller      — prefix on caller ('' = any)
//   match_src_ip      — source IP ('' = any)
//   match_time_start  — time-of-day start HH:MM ('' = any)
//   match_time_end    — time-of-day end HH:MM ('' = any)
//   match_day         — day of week 0-6 ('' = any, csv "1,2,3,4,5" = weekdays)
//   match_header      — SIP header=value condition ('' = any)
//   match_user_tag    — tag on the user record ('' = any)
//
// Actions:
//   route:gateway_name             — direct to gateway
//   dispatch:set_name              — use dispatch set (LB)
//   reject:code:reason             — reject with SIP status
//   redirect:sip_uri               — 302 redirect
//   forward:ip:port                — forward to IP directly
//   lcr                            — least-cost routing (pick cheapest gateway for prefix)
//   failover:gw1,gw2,gw3           — try gateways in order
//   b2bua:gateway_name             — terminate both SIP dialogs locally
//   b2bua:host:port                — terminate both SIP dialogs locally
//   continue                       — skip this rule, try next

// Get current hour:minute as "HHMM" int for time comparison
fn current_time_int() -> int {
    // Use now_ms to get approximate hour (good enough for routing)
    // In production: use a proper time function
    let ms = now_ms()
    let secs = ms / 1000
    let day_secs = secs - (secs / 86400) * 86400
    let hours = day_secs / 3600
    let mins = (day_secs - hours * 3600) / 60
    return hours * 100 + mins
}

fn parse_hhmm(s: string) -> int {
    // "09:00" → 900, "17:30" → 1730 (no str_split allocation)
    let colon = str_index(s, ":")
    if colon < 1 { return 0 }
    let mut h = 0
    let mut m = 0
    match parse_int(s[0:colon]) { Ok(v) => { h = v } Err(_) => {} }
    match parse_int(s[colon + 1:]) { Ok(v) => { m = v } Err(_) => {} }
    return h * 100 + m
}

fn time_in_range(now_hhmm: int, start: string, end: string) -> int {
    if len(start) == 0 { return 1 }
    let s = parse_hhmm(start)
    let e = parse_hhmm(end)
    if s <= e {
        // Normal range: 09:00-17:00
        if now_hhmm >= s { if now_hhmm <= e { return 1 } }
        return 0
    } else {
        // Overnight: 22:00-06:00
        if now_hhmm >= s { return 1 }
        if now_hhmm <= e { return 1 }
        return 0
    }
    return 0
}

fn current_day_of_week() -> int {
    // 0=Sun .. 6=Sat — approximate from epoch
    let days = now_ms() / 86400000
    return (days + 4) - ((days + 4) / 7) * 7  // epoch was Thursday (4)
}

fn day_matches(rule_days: string, today: int) -> int {
    if len(rule_days) == 0 { return 1 }
    // Single digit 0-6 — check with str_contains instead of str_split
    let today_str = string(today)
    if str_contains("," + rule_days + ",", "," + today_str + ",") { return 1 }
    return 0
}

// Escape SQL LIKE wildcards in user input to prevent % and _ injection.
fn sql_like_escape(s: string) -> string {
    if str_index(s, "%") < 0 && str_index(s, "_") < 0 && str_index(s, "\\") < 0 { return s }
    let mut b = str_builder()
    let mut i = 0
    while i < len(s) {
        let c = int(s[i])
        if c == 37 || c == 95 || c == 92 { builder_write(b, "\\") }
        builder_write_byte(b, byte(c))
        i = i + 1
    }
    return builder_string(b)
}

fn prefix_matches(number: string, prefix: string) -> int {
    if len(prefix) == 0 { return 1 }
    if str_eq(prefix, "*") { return 1 }
    if str_has_prefix(number, prefix) { return 1 }
    return 0
}

// Dispatch helpers (kept from before)
fn dispatch_next_rr(set_id: int, count: int, cache: CMap) -> int {
    let key = "dsp_rr|" + string(set_id)
    let mut idx = 0
    if cmap_has(cache, key) == 1 {
        match parse_int(cmap_get(cache, key)) {
            Ok(v) => { idx = v }
            Err(_) => { idx = 0 }
        }
    }
    let next = idx + 1
    if next >= count { cmap_set(cache, key, "0") } else { cmap_set(cache, key, string(next)) }
    return idx
}

fn dispatch_hash(key: string, count: int) -> int {
    let mut h = 2166136261
    let mut i = 0
    let n = len(key)
    while i < n {
        h = h ^ int(key[i])
        h = h * 16777619
        i = i + 1
    }
    if h < 0 { h = 0 - h }
    return h - (h / count) * count
}

fn dispatch_is_healthy(addr: string, cache: CMap) -> int {
    let key = "health|" + addr
    let until_key = "health_until|" + addr
    if cmap_has(cache, until_key) == 1 {
        let mut until = 0
        match parse_int(cmap_get(cache, until_key)) { Ok(v) => { until = v } Err(_) => {} }
        if until > mono_ms() { return 0 }
        let _ = cmap_del(cache, until_key)
        let _ = bounded_cache_set(cache, "health_state_seq", "health_state_ring|", key, "half-open", 16384)
    }
    if cmap_has(cache, key) == 1 {
        if str_eq(cmap_get(cache, key), "down") { return 0 }
    }
    return 1
}

fn dispatch_health_note(addr: string, ok: int, cache: CMap) -> int {
    let fail_key = "health_fail|" + addr
    let key = "health|" + addr
    if ok == 1 {
        let _ = bounded_cache_set(cache, "health_state_seq", "health_state_ring|", key, "up", 16384)
        let _ = bounded_cache_set(cache, "health_fail_seq", "health_fail_ring|", fail_key, "0", 16384)
        let _ = cmap_del(cache, "health_until|" + addr)
        return 1
    }
    let failures = cmap_incr(cache, fail_key, 1)
    if failures >= 3 {
        let mut backoff = failures * 1000
        if backoff > 60000 { backoff = 60000 }
        let _ = bounded_cache_set(cache, "health_state_seq", "health_state_ring|", key, "down", 16384)
        let _ = bounded_cache_set(cache, "health_until_seq", "health_until_ring|", "health_until|" + addr, string(mono_ms() + backoff), 16384)
    }
    return 0
}

// Resolve a dispatch set to comma-separated targets.
// The set metadata (id, algorithm, member list) is cached for 5s so repeated
// INVITEs within a burst don't issue the same JOIN per call.
fn resolve_dispatch_set(db: SqlDB, set_name: string, from_user: string, call_id: string, cache: CMap) -> string {
    let meta_key = "dsp_meta|" + set_name
    let meta_ts_key = "dsp_meta_ts|" + set_name
    let now_dsp = mono_ms()
    let mut algo = ""
    let mut set_id = 0
    let mut member_csv = ""
    let mut meta_fresh = 0

    if cmap_has(cache, meta_key) == 1 && cmap_has(cache, meta_ts_key) == 1 {
        let mut at = 0
        match parse_int(cmap_get(cache, meta_ts_key)) { Ok(v) => { at = v } Err(_) => {} }
        if at > 0 && now_dsp - at < 5000 {
            meta_fresh = 1
            let cached = cmap_get(cache, meta_key)
            // Format: "set_id|algo|addr1,addr2,..."
            let pipe1 = str_index(cached, "|")
            if pipe1 > 0 {
                match parse_int(cached[0:pipe1]) { Ok(v) => { set_id = v } Err(_) => {} }
                let rest = "" + cached[pipe1 + 1:]
                let pipe2 = str_index(rest, "|")
                if pipe2 >= 0 {
                    algo = "" + rest[0:pipe2]
                    member_csv = "" + rest[pipe2 + 1:]
                }
            }
        }
    }

    if meta_fresh == 0 {
        let set_info = sql_query_str(db, "SELECT id || '|' || algorithm FROM dispatch_sets WHERE name = $1 AND enabled = true", set_name)
        let pipe = str_index(set_info, "|")
        if pipe < 1 { return "" }
        match parse_int(set_info[0:pipe]) { Ok(v) => { set_id = v } Err(_) => { return "" } }
        algo = set_info[pipe + 1:]

        let member_rows = sql_query_rows_str(db, "SELECT g.address || ':' || g.port FROM dispatch_members dm JOIN gateways g ON dm.gateway_id = g.id WHERE dm.set_id = $1 AND dm.enabled = true AND g.enabled = true ORDER BY dm.priority ASC, dm.weight DESC LIMIT 8", set_info[0:pipe])
        let mut first = 1
        if sql_rows_ok(member_rows) == 1 {
            while sql_rows_next(member_rows) == 1 {
                let m = sql_rows_str(member_rows, 0)
                if len(m) > 0 {
                    if first == 1 { member_csv = m; first = 0 }
                    else { member_csv = member_csv + "," + m }
                }
            }
        }
        let _ = sql_rows_close(member_rows)
        cmap_set(cache, meta_key, string(set_id) + "|" + algo + "|" + member_csv)
        cmap_set(cache, meta_ts_key, string(now_dsp))
    }

    if len(member_csv) == 0 { return "" }

    // Filter by health
    let all = str_split(member_csv, ",")
    let mut members = make([]string, 0, 8)
    let mut mi = 0
    while mi < len(all) {
        let m = str_trim_space(all[mi])
        if len(m) > 0 && dispatch_is_healthy(m, cache) == 1 { members = append(members, m) }
        mi = mi + 1
    }
    let count = len(members)
    if count == 0 { return "" }

    // Apply algorithm
    let mut start_idx = 0
    if str_eq(algo, "round-robin") { start_idx = dispatch_next_rr(set_id, count, cache) }
    if str_eq(algo, "hash") { start_idx = dispatch_hash(call_id, count) }
    if str_eq(algo, "hash-user") { start_idx = dispatch_hash(from_user, count) }

    let mut result = members[start_idx]
    let mut i = 1
    while i < count {
        let fi = (start_idx + i) - ((start_idx + i) / count) * count
        result = result + "," + members[fi]
        i = i + 1
    }
    return result
}

// Resolve gateway name to addr:port (cached 10s)
fn resolve_gateway(db: SqlDB, gw_name: string) -> string {
    // ponytail: gateway addresses rarely change; cache avoids a DB hit per call
    return sql_query_str(db, "SELECT address || ':' || port FROM gateways WHERE name = $1 AND enabled = true", gw_name)
}

fn resolve_gateway_cached(db: SqlDB, gw_name: string, cache: CMap) -> string {
    let key = "gw|" + gw_name
    let ts_key = "gw_ts|" + gw_name
    if cmap_has(cache, key) == 1 && cmap_has(cache, ts_key) == 1 {
        let mut at = 0
        match parse_int(cmap_get(cache, ts_key)) { Ok(v) => { at = v } Err(_) => {} }
        if at > 0 && mono_ms() - at < 30000 { return cmap_get(cache, key) }
    }
    let addr = sql_query_str(db, "SELECT address || ':' || port FROM gateways WHERE name = $1 AND enabled = true", gw_name)
    if len(addr) > 0 {
        let _ = bounded_cache_set(cache, "gw_seq", "gw_ring|", key, addr, 4096)
        cmap_set(cache, ts_key, string(mono_ms()))
    }
    return addr
}

// Main routing engine: evaluates routing_rules table
// Returns: "action_type|targets" (e.g. "route|10.0.0.1:5060" or "reject|404|Not Found")
// Check if a number falls within an ANI group's ranges
fn ani_in_group(db: SqlDB, db_ok: int, number: string, group_name: string, cache: CMap) -> int {
    if db_ok == 0 { return 0 }
    if len(group_name) == 0 { return 0 }

    // Cache: "ani|group|number" -> "1" or "0"
    let key = "ani|" + group_name + "|" + number
    if cmap_has(cache, key) == 1 {
        if str_eq(cmap_get(cache, key), "1") { return 1 }
        return 0
    }

    // Strip non-numeric for comparison (keep digits only)
    let mut clean = number
    if str_has_prefix(clean, "+") { clean = clean[1:] }

    // Query: check if number falls in any range of this group
    let hit = sql_query_str(db, "SELECT 1 FROM ani_ranges ar JOIN ani_groups ag ON ar.group_id = ag.id WHERE ag.name = $1 AND ag.enabled = true AND ar.enabled = true AND $1 >= ar.range_start AND $1 <= ar.range_end LIMIT 1", clean)
    if len(hit) > 0 {
        let _ = bounded_cache_set(cache, "ani_seq", "ani_ring|", key, "1", 16384)
        return 1
    }
    let _ = bounded_cache_set(cache, "ani_seq", "ani_ring|", key, "0", 16384)
    return 0
}

fn db_route_call(db: SqlDB, db_ok: int, callee: string, caller: string, src_ip: string, msg: string, msglen: int, from_user: string, call_id: string, cache: CMap) -> string {
    if db_ok == 0 { return "" }

    let now_time = current_time_int()
    let today = current_day_of_week()

    // Cache routing rules for 10s to avoid DB round-trip per INVITE
    let rule_cache_key = "routing_rules_cache"
    let rule_ts_key = "routing_rules_ts"
    let mut rule_rows = make([]string, 0, 50)
    let now_cache = mono_ms()
    let mut rules_fresh = 0
    if cmap_has(cache, rule_cache_key) == 1 && cmap_has(cache, rule_ts_key) == 1 {
        let mut rule_at = 0
        match parse_int(cmap_get(cache, rule_ts_key)) { Ok(v) => { rule_at = v } Err(_) => {} }
        if rule_at > 0 && now_cache - rule_at < 10000 {
            rules_fresh = 1
            rule_rows = str_split(cmap_get(cache, rule_cache_key), "\n")
        }
    }
    if rules_fresh == 0 {
        rule_rows = sql_query_col_str(db, "SELECT match_prefix || chr(1) || COALESCE(match_caller,'') || chr(1) || COALESCE(match_src_ip,'') || chr(1) || COALESCE(match_time_start,'') || chr(1) || COALESCE(match_time_end,'') || chr(1) || COALESCE(match_day,'') || chr(1) || action || chr(1) || COALESCE(match_ani_group,'') FROM routing_rules WHERE enabled = true ORDER BY priority ASC LIMIT 50", 50)
        let mut rule_joined = ""
        let mut rj = 0
        while rj < len(rule_rows) {
            if rj > 0 { rule_joined = rule_joined + "\n" }
            rule_joined = rule_joined + rule_rows[rj]
            rj = rj + 1
        }
        cmap_set(cache, rule_cache_key, rule_joined)
        cmap_set(cache, rule_ts_key, string(now_cache))
    }
    let mut ri = 0
    while ri < len(rule_rows) {
        let rule_data = rule_rows[ri]

        let parts = str_split(rule_data, "\x01")
        if len(parts) < 7 {
            ri = ri + 1
            continue
        }

        let r_prefix = parts[0]
        let r_caller = parts[1]
        let r_src_ip = parts[2]
        let r_time_s = parts[3]
        let r_time_e = parts[4]
        let r_day = parts[5]
        let r_action = parts[6]
        let mut r_ani = ""
        if len(parts) >= 8 { r_ani = parts[7] }

        // Check all conditions
        let mut matched = 1

        // Prefix match on callee
        if prefix_matches(callee, r_prefix) == 0 { matched = 0 }

        // Caller prefix match
        if matched == 1 {
            if len(r_caller) > 0 {
                if prefix_matches(caller, r_caller) == 0 { matched = 0 }
            }
        }

        // ANI group match (caller number in range)
        if matched == 1 {
            if len(r_ani) > 0 {
                if ani_in_group(db, db_ok, caller, r_ani, cache) == 0 { matched = 0 }
            }
        }

        // Source IP match
        if matched == 1 {
            if len(r_src_ip) > 0 {
                if r_src_ip != "*" {
                    if r_src_ip != src_ip { matched = 0 }
                }
            }
        }

        // Time-of-day match
        if matched == 1 {
            if time_in_range(now_time, r_time_s, r_time_e) == 0 { matched = 0 }
        }

        // Day-of-week match
        if matched == 1 {
            if day_matches(r_day, today) == 0 { matched = 0 }
        }

        if matched == 0 {
            ri = ri + 1
            continue
        }

        // --- Rule matched: execute action ---

        // continue → skip to next rule
        if str_eq(r_action, "continue") {
            ri = ri + 1
            continue
        }

        // reject:code:reason
        if str_has_prefix(r_action, "reject:") {
            return r_action
        }

        // redirect:sip_uri
        if str_has_prefix(r_action, "redirect:") {
            return r_action
        }

        // route:gateway_name
        if str_has_prefix(r_action, "route:") {
            let gw_name = r_action[6:]
            let addr = resolve_gateway_cached(db, gw_name, cache)
            if len(addr) > 0 { return "route|" + addr }
        }

        // dispatch:set_name or dispatch:set_name|egress:egress_set
        if str_has_prefix(r_action, "dispatch:") {
            // Check for egress combo
            let pipe_idx = str_index(r_action, "|egress:")
            if pipe_idx > 0 {
                // Combo: ingress dispatch + egress carrier group
                let ingress_name = r_action[9:pipe_idx]
                let egress_name = r_action[pipe_idx + 8:]
                let ingress_targets = resolve_dispatch_set(db, ingress_name, from_user, call_id, cache)
                let egress_targets = resolve_dispatch_set(db, egress_name, from_user, call_id, cache)
                // Store egress for when the PBX sends the call back out
                if len(egress_targets) > 0 {
                    let _ = bounded_cache_set(cache, "egress_seq", "egress_ring|", "egress|" + call_id, egress_targets, 65536)
                }
                if len(ingress_targets) > 0 { return "dispatch|" + ingress_targets }
            } else {
                let set_name = r_action[9:]
                let targets = resolve_dispatch_set(db, set_name, from_user, call_id, cache)
                if len(targets) > 0 { return "dispatch|" + targets }
            }
        }

        // forward:ip:port
        if str_has_prefix(r_action, "forward:") {
            return "route|" + r_action[8:]
        }

        // failover:gw1,gw2,gw3
        if str_has_prefix(r_action, "failover:") {
            let gw_names = str_split(r_action[9:], ",")
            let mut targets = ""
            let mut fi = 0
            while fi < len(gw_names) {
                let addr = resolve_gateway_cached(db, str_trim_space(gw_names[fi]), cache)
                if len(addr) > 0 {
                    if dispatch_is_healthy(addr, cache) == 1 {
                        if len(targets) > 0 { targets = targets + "," }
                        targets = targets + addr
                    }
                }
                fi = fi + 1
            }
            if len(targets) > 0 { return "route|" + targets }
        }

        // b2bua:<gateway-name> or b2bua:<host>:<port>. This is intentionally
        // separate from route/dispatch so ordinary rules remain proxy legs.
        if str_has_prefix(r_action, "b2bua:") {
            let spec = r_action[6:]
            let mut target = resolve_gateway_cached(db, spec, cache)
            if len(target) == 0 { target = spec }
            if len(target) > 0 { return "b2bua|" + target }
        }

        // lcr — least-cost routing: find cheapest gateway for this prefix
        if str_eq(r_action, "lcr") {
            let addr = sql_query_str(db, "SELECT g.address || ':' || g.port FROM routes r JOIN gateways g ON r.gateway_id = g.id WHERE $1 LIKE r.prefix || '%' AND r.enabled = true AND g.enabled = true ORDER BY r.cost_per_min ASC, r.priority ASC LIMIT 1", sql_like_escape(callee))
            if len(addr) > 0 { return "route|" + addr }
        }

        // If action didn't resolve, try next rule
        ri = ri + 1
    }

    // No rule matched — try legacy prefix routing as fallback.
    // Use a single longest-prefix-match query instead of N queries.
    let lpm_key = "lpm|" + callee
    if cmap_has(cache, lpm_key) == 1 {
        let cached_lpm = cmap_get(cache, lpm_key)
        if len(cached_lpm) > 0 { return cached_lpm }
    }
    let gw = sql_query_str(db, "SELECT g.address || ':' || g.port FROM routes r JOIN gateways g ON r.gateway_id = g.id WHERE r.enabled = true AND g.enabled = true AND $1 LIKE r.prefix || '%' ORDER BY length(r.prefix) DESC, r.priority ASC LIMIT 1", sql_like_escape(callee))
    if len(gw) > 0 {
        let lpm_result = "route|" + gw
        let _ = bounded_cache_set(cache, "lpm_seq", "lpm_ring|", lpm_key, lpm_result, 16384)
        return lpm_result
    }
    // Default route
    let def = sql_query_str(db, "SELECT g.address || ':' || g.port FROM routes r JOIN gateways g ON r.gateway_id = g.id WHERE r.prefix = '*' AND r.enabled = true AND g.enabled = true ORDER BY r.priority ASC LIMIT 1", "")
    if len(def) > 0 { return "route|" + def }

    return ""
}
