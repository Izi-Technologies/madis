// ============ SIP HEADER MANIPULATION ENGINE ============
// DB-driven: header_rules table defines add/remove/modify/set per direction + method
// Actions: add, remove, modify, set, rename, copy, move
// Supports standard headers AND X-headers (X-Account-ID, X-Billing-Code, etc.)

fn hdr_text_safe(value: string) -> int {
    let mut i = 0
    while i < len(value) {
        let c = int(value[i])
        if c == 0 || c == 10 || c == 13 { return 0 }
        i = i + 1
    }
    return 1
}

fn hdr_name_safe(value: string) -> int {
    if len(value) == 0 { return 0 }
    let mut i = 0
    while i < len(value) {
        let c = int(value[i])
        let token = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
        if not token { return 0 }
        i = i + 1
    }
    return 1
}

// Add a header to the message (before Content-Length)
fn hdr_add(msg: string, name: string, value: string) -> string {
    if hdr_name_safe(name) == 0 || hdr_text_safe(value) == 0 { return msg }
    let n = len(msg)
    let cl_idx = str_index(str_to_lower(msg), "content-length:")
    if cl_idx >= 0 {
        return msg[0:cl_idx] + name + ": " + value + "\r\n" + msg[cl_idx:]
    }
    // No Content-Length: add before \r\n\r\n
    let mut i = 0
    while i + 3 < n {
        if int(msg[i]) == 13 {
            if int(msg[i+1]) == 10 {
                if int(msg[i+2]) == 13 {
                    if int(msg[i+3]) == 10 {
                        return msg[0:i] + "\r\n" + name + ": " + value + msg[i:]
                    }
                }
            }
        }
        i = i + 1
    }
    return msg
}

// Remove ALL instances of a header by name
fn hdr_remove(msg: string, name: string) -> string {
    // Single-pass removal: build result with str_builder, skip matching lines.
    // Avoids O(N²) rescanning on messages with many duplicate headers.
    let namelen = len(name)
    let n = len(msg)
    let mut b = str_builder()
    let mut i = 0
    let mut any_removed = 0
    // Copy request line
    while i < n {
        if int(msg[i]) == 10 { i = i + 1; break }
        i = i + 1
    }
    builder_write(b, msg[0:i])
    // Scan headers
    while i < n {
        if int(msg[i]) == 13 { break }
        let line_start = i
        // Check if this line matches the header name
        let mut match_ok = 0
        if i + namelen + 1 < n {
            let mut ok = 1
            let mut j = 0
            while j < namelen {
                let mut c1 = int(msg[i + j])
                let mut c2 = int(name[j])
                if c1 >= 65 { if c1 <= 90 { c1 = c1 + 32 } }
                if c2 >= 65 { if c2 <= 90 { c2 = c2 + 32 } }
                if c1 != c2 { ok = 0; break }
                j = j + 1
            }
            if ok == 1 && int(msg[i + namelen]) == 58 { match_ok = 1 }
        }
        // Advance past this line
        while i < n {
            if int(msg[i]) == 10 { i = i + 1; break }
            i = i + 1
        }
        if match_ok == 0 {
            builder_write(b, msg[line_start:i])
        } else {
            any_removed = 1
        }
    }
    if any_removed == 0 { return msg }
    // Copy body separator + body
    if i < n { builder_write(b, msg[i:]) }
    return builder_string(b)
}

// Set header value (remove existing + add new)
fn hdr_set(msg: string, name: string, value: string) -> string {
    if hdr_name_safe(name) == 0 || hdr_text_safe(value) == 0 { return msg }
    let cleaned = hdr_remove(msg, name)
    return hdr_add(cleaned, name, value)
}

// Apply DB-driven header rules
// header_rules table: match_method, match_direction, action, header_name, header_value, priority
fn db_apply_header_rules(db: SqlDB, db_ok: int, msg: string, method: string, direction: string, cache: CMap) -> string {
    if db_ok == 0 { return msg }

    let mut result = msg

    // Fetch the bounded direction set once, then apply method-specific rules
    // in memory. This also avoids binding the direction as match_method.
    let rule_rows = sql_query_rows_str(db, "SELECT match_method || '|' || action || '|' || header_name || '|' || COALESCE(header_value,'') FROM header_rules WHERE match_direction = $1 AND enabled = true ORDER BY priority ASC LIMIT 20", direction)
    if sql_rows_ok(rule_rows) == 1 {
        while sql_rows_next(rule_rows) == 1 {
            let rule = sql_rows_str(rule_rows, 0)
            let parts = str_split(rule, "|")
            if len(parts) < 3 { continue }
            let match_method = parts[0]
            if not str_eq(match_method, "*") {
                if not str_eq(str_to_upper(match_method), str_to_upper(method)) { continue }
            }
            let action = parts[1]
            let hname = parts[2]
            let mut hval = ""
            if len(parts) >= 4 { hval = parts[3] }

            if str_eq(action, "add") { result = hdr_add(result, hname, hval) }
            if str_eq(action, "remove") { result = hdr_remove(result, hname) }
            if str_eq(action, "set") { result = hdr_set(result, hname, hval) }
        }
    }
    let _ = sql_rows_close(rule_rows)
    return result
}
