    _request(client, "POST", "/api/v1/maf/number", {"number": number, "carrier": carrier, "type": number_type, "country": country, "spam_score": spam_score}, null)
}

// === Webhooks ===

fn webhooks(client) -> Result { _request(client, "GET", "/api/v1/maf/webhooks", null, null) }
fn create_webhook(client, url, events, secret) -> Result {
    mut body := {"url": url}
    if events != null { body["events"] = events }
    if secret != null && secret != "" { body["secret"] = secret }
    _request(client, "POST", "/api/v1/maf/webhooks", body, null)
}
fn delete_webhook(client, id) -> Result { _request(client, "DELETE", "/api/v1/maf/webhooks/" + string(id), null, null) }

// === Queues ===

fn queues(client) -> Result { _request(client, "GET", "/api/v1/maf/queues", null, null) }
fn create_queue(client, name, strategy, max_wait) -> Result {
    _request(client, "POST", "/api/v1/maf/queues", {"name": name, "strategy": strategy, "max_wait_sec": max_wait}, null)
}
fn add_queue_member(client, queue_id, agent_uri, priority) -> Result {
    _request(client, "POST", "/api/v1/maf/queues/" + string(queue_id) + "/members", {"agent_uri": agent_uri, "priority": priority}, null)
}
fn remove_queue_member(client, queue_id, member_id) -> Result {
    _request(client, "DELETE", "/api/v1/maf/queues/" + string(queue_id) + "/members/" + string(member_id), null, null)
}

