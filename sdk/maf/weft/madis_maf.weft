    _request(client, "POST", "/api/v1/maf/conferences", {"name": name, "pin": pin, "max_participants": max_participants, "record": record}, null)
}

// === Scheduled Calls ===

fn scheduled_calls(client) -> Result { _request(client, "GET", "/api/v1/maf/scheduled-calls", null, null) }
fn schedule_call(client, from_uri, to_uri, scheduled_at, app_data) -> Result {
    mut body := {"from": from_uri, "to": to_uri, "scheduled_at": scheduled_at}
    if app_data != null { body["application_data"] = app_data }
    _request(client, "POST", "/api/v1/maf/scheduled-calls", body, null)
}
fn cancel_scheduled_call(client, id) -> Result { _request(client, "DELETE", "/api/v1/maf/scheduled-calls/" + string(id), null, null) }

// === Events ===

fn events(client, cursor, event_type, limit) -> Result {
    mut q := "?cursor=" + string(if cursor != null { cursor } else { 0 })
    q = q + "&limit=" + string(if limit != null { limit } else { 100 })
    if event_type != null { q = q + "&event_type=" + event_type }
    _request(client, "GET", "/api/v1/maf/events" + q, null, null)
}

fn publish_event(client, event_type, call_id, payload) -> Result {
    mut body := {"event_type": event_type}
    if call_id != null { body["call_id"] = call_id }
    if payload != null { body["payload"] = if type_of(payload) == "string" { payload } else { json.stringify(payload) } }
    _request(client, "POST", "/api/v1/maf/events", body, null)
}

fn ws_url(client, cursor, event_type, call_id) -> string {
    base := str.replace(str.replace(client.base_url, "https://", "wss://"), "http://", "ws://")
    mut q := "?cursor=" + string(if cursor != null { cursor } else { 0 })
    if event_type != null { q = q + "&event_type=" + event_type }
    if call_id != null { q = q + "&call_id=" + call_id }
    base + "/api/v1/maf/events/ws" + q
}

// === Subscribe (HTTP long-poll) ===

fn subscribe(client, event_type, call_id, handler) -> Result {
    mut cursor := 0
    mut interval := 200
    loop {
        mut q := "?cursor=" + string(cursor) + "&limit=100"
        if event_type != null { q = q + "&event_type=" + event_type }
        if call_id != null { q = q + "&call_id=" + call_id }
        page := _request(client, "GET", "/api/v1/maf/events" + q, null, null)?
        evts := if page["events"] != null { page["events"] } else { [] }
        if len(evts) > 0 {
            interval = 200
            for evt in evts { handler(evt) }
            if page["next_cursor"] != null {
                nc := int(page["next_cursor"])
                if nc > cursor { cursor = nc }
            }
        } else {
            interval = if interval * 2 > 2000 { 2000 } else { interval * 2 }
        }
        time.sleep_ms(interval)
    }
}
