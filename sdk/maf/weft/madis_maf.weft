fn gateways(client) -> Result { _request(client, "GET", "/api/v1/maf/gateways", null, null) }
fn create_gateway(client, name, address, port, transport) -> Result {
    _request(client, "POST", "/api/v1/maf/gateways", {"name": name, "address": address, "port": port, "transport": transport}, null)
}
fn delete_gateway(client, id) -> Result { _request(client, "DELETE", "/api/v1/maf/gateways/" + string(id), null, null) }

