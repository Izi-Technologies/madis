// === Security ===

fn bans(client) -> Result { _request(client, "GET", "/api/v1/maf/security/bans", null, null) }
fn ban_ip(client, source_ip, reason, permanent, duration_min) -> Result {
    perm := if permanent { "true" } else { "false" }
    _request(client, "POST", "/api/v1/maf/security/bans", {"source_ip": source_ip, "reason": reason, "permanent": perm, "duration_min": duration_min}, null)
}
fn unban_ip(client, source_ip) -> Result { _request(client, "DELETE", "/api/v1/maf/security/bans/" + source_ip, null, null) }
fn security_events(client) -> Result { _request(client, "GET", "/api/v1/maf/security/events", null, null) }

