fn routing_rules(client) -> Result { _request(client, "GET", "/api/v1/maf/routing/rules", null, null) }
fn create_routing_rule(client, body) -> Result { _request(client, "POST", "/api/v1/maf/routing/rules", body, null) }
fn delete_routing_rule(client, id) -> Result { _request(client, "DELETE", "/api/v1/maf/routing/rules/" + string(id), null, null) }
fn routing_intelligence(client) -> Result { _request(client, "GET", "/api/v1/maf/routing/intelligence", null, null) }

// === Dialplans ===

fn dialplans(client) -> Result { _request(client, "GET", "/api/v1/maf/dialplans", null, null) }
fn create_dialplan(client, body) -> Result { _request(client, "POST", "/api/v1/maf/dialplans", body, null) }
