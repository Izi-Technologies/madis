# Madis SIP Proxy configuration
# Copy to /etc/madis/madis.env and edit before starting.

# Database (required)
SIP_DB_URL=postgres://madis:changeme@127.0.0.1:5432/madis

# Network
SIP_UDP_PORT=5060
SIP_TLS_PORT=5061
SIP_WSS_PORT=8443
SIP_ADMIN_PORT=8080
SIP_METRICS_HOST=127.0.0.1
SIP_METRICS_PORT=8080
SIP_BIND_IP=0.0.0.0
# SIP_PUBLIC_IP=
SIP_IPV6=1

# Identity
SIP_REALM=madis.local
SIP_NODE_ID=node1
SIP_NODE_ADDR=127.0.0.1
SIP_REGION=default

# Workers
SIP_UDP_WORKERS=1
SIP_TCP_WORKERS=1
SIP_SCHED_WORKERS=0

# B2BUA (opt-in)
SIP_B2BUA_MODE=proxy

# Auth
SIP_DIGEST_ALGORITHM=md5
# SIP_ADMIN_TOKEN=
# SIP_CARRIER_API_TOKEN=
# SIP_CONTROL_API_TOKEN=
# SIP_CONTROL_API_READ_TOKEN=
# SIP_IMS_SUBSCRIBER_TOKEN=
# SIP_APP_TOKEN=
# SIP_MODULE_TOKEN=

# Billing
SIP_BILLING_MODE=outbox
SIP_BILLING_TENANT=default

# WebUI
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080
ADMIN_SECURE_COOKIE=1
ADMIN_SESSION_TTL_SECS=86400
ADMIN_LOGIN_MAX_FAILS=5
ADMIN_LOGIN_LOCK_SECS=900
# SIP_ADMIN_PASSWORD=

# TLS (uncomment and set paths to enable)
# SIP_TLS_CERT=/etc/madis/tls/cert.pem
# SIP_TLS_KEY=/etc/madis/tls/key.pem

# Registration
SIP_MAX_REG_EXPIRES=3600
SIP_MIN_EXPIRES=60

# STIR/SHAKEN (disabled by default)
# STIR_SHAKEN_ENABLED=true
# STIR_SHAKEN_CERT_URL=
# STIR_SHAKEN_ATTESTATION=C
# STIR_SHAKEN_PRIVATE_KEY=
