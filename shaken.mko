// ============ STIR/SHAKEN (RFC 8224/8225/8226) ============
// Signing: HS256 lab mode or platform ECDSA P-256 / ES256 with a PEM key.
// Verification: HS256 secret, RS256 PEM, ES256 PEM, and/or JWKS.

// PASSporT JSON claims (compact)
fn shaken_passport_payload(orig_tn: string, dest_tn: string, attest: string, origid: string, iat: int) -> string {
    return "{\"attest\":\"" + attest + "\",\"dest\":{\"tn\":[\"" + dest_tn + "\"]},\"iat\":" + string(iat) + ",\"orig\":{\"tn\":\"" + orig_tn + "\"},\"origid\":\"" + origid + "\"}"
}

// Extract JWT from Identity header value (token before first ';')
fn shaken_identity_token(identity: string) -> string {
    let semi = str_index(identity, ";")
    if semi < 0 { return identity }
    return identity[0:semi]
}

// Attestation claim from verified JWT payload
fn shaken_attest_from_payload(payload: string) -> string {
    let aidx = str_index(payload, "\"attest\":\"")
    if aidx < 0 { return "" }
    let astart = aidx + 10
    if astart >= len(payload) { return "" }
    let attest_char = payload[astart:astart + 1]
    if str_eq(attest_char, "A") { return "A" }
    if str_eq(attest_char, "B") { return "B" }
    if str_eq(attest_char, "C") { return "C" }
    return ""
}

// Load PEM/JWKS material: if value looks like a path, read_file; else use inline
fn shaken_load_material(value: string) -> string {
    if len(value) == 0 { return "" }
    if str_has_prefix(value, "-----") { return value }
    if str_has_prefix(value, "{") { return value }
    if str_has_prefix(value, "/") {
        let body = read_file(value)
        return body
    }
    // relative path
    if str_contains(value, ".pem") {
        let body = read_file(value)
        if len(body) > 0 { return body }
    }
    if str_contains(value, ".json") {
        let body = read_file(value)
        if len(body) > 0 { return body }
    }
    return value
}

// Optional JWKS fetch over verified HTTPS (empty ca uses platform trust)
fn shaken_fetch_jwks(url: string) -> string {
    if len(url) == 0 { return "" }
    if str_has_prefix(url, "https://") {
        let body = https_get(url, "", 5000)
        if len(body) > 0 { return body }
        return ""
    }
    if str_has_prefix(url, "http://") {
        // cleartext only for lab; prefer https
        return http_get(url)
    }
    return shaken_load_material(url)
}

// Sign PASSporT with HS256 (lab / interop only). Identity alg=HS256.
fn shaken_sign(orig_tn: string, dest_tn: string, attest: string, cert_url: string, secret: string) -> string {
    if len(secret) == 0 { return "" }
    let origid = base64_encode(random_bytes(16))
    let iat = now_ms() / 1000
    let payload = shaken_passport_payload(orig_tn, dest_tn, attest, origid, iat)
    let token = jwt_sign(payload, secret)
    if len(token) == 0 { return "" }
    let mut info = cert_url
    if len(info) == 0 { info = "https://localhost/sti.pem" }
    return token + ";info=<" + info + ">;alg=HS256;ppt=shaken"
}

fn shaken_sign_cfg(orig_tn: string, dest_tn: string, attest: string, cert_url: string, cfg: []string) -> string {
    if len(cfg) < 5 { return "" }
    let material = shaken_load_material(cfg[3])
    if len(material) == 0 { return "" }
    let origid = base64_encode(random_bytes(16))
    let iat = now_ms() / 1000
    let payload = shaken_passport_payload(orig_tn, dest_tn, attest, origid, iat)
    let mut token = ""
    let mut alg = "HS256"
    if str_eq(str_to_lower(cfg[4]), "es256") {
        token = jwt_sign_es256(payload, material)
        alg = "ES256"
    } else {
        token = jwt_sign(payload, material)
    }
    if len(token) == 0 { return "" }
    let mut info = cert_url
    if len(info) == 0 { info = "https://localhost/sti.pem" }
    return token + ";info=<" + info + ">;alg=" + alg + ";ppt=shaken"
}

// Verify Identity using configured material.
// cfg: [enabled, cert_url, attest, secret, mode, pubkey, jwks]
// mode: hs256 | rs256 | jwks | auto (default)
// Returns "A"/"B"/"C" or ""
fn shaken_verify_cfg(msg: string, msglen: int, cfg: []string) -> string {
    let _ = msglen
    let identity = sip_header(msg, "Identity")
    if len(identity) == 0 { return "" }
    let token = shaken_identity_token(identity)
    if len(token) < 10 { return "" }

    let mut mode = "auto"
    let mut secret = ""
    let mut pubkey = ""
    let mut jwks = ""
    if len(cfg) >= 4 { secret = cfg[3] }
    if len(cfg) >= 5 {
        if len(cfg[4]) > 0 { mode = cfg[4] }
    }
    if len(cfg) >= 6 { pubkey = shaken_load_material(cfg[5]) }
    if len(cfg) >= 7 { jwks = shaken_load_material(cfg[6]) }

    let mut ok = 0
    if str_eq(mode, "hs256") {
        if len(secret) > 0 {
            if jwt_verify(token, secret) == 1 { ok = 1 }
        }
    } else {
    if str_eq(mode, "rs256") {
        if len(pubkey) > 0 {
            if jwt_verify_rs256(token, pubkey) == 1 { ok = 1 }
        }
    } else {
    if str_eq(mode, "es256") {
        if len(pubkey) > 0 {
            if jwt_verify_es256(token, pubkey) == 1 { ok = 1 }
        }
    } else {
    if str_eq(mode, "jwks") {
        if len(jwks) > 0 {
            if jwt_verify_jwks(token, jwks) == 1 { ok = 1 }
        }
    } else {
        // auto: try strongest configured material first
        if len(jwks) > 0 {
            if jwt_verify_jwks(token, jwks) == 1 { ok = 1 }
        }
        if ok == 0 {
            if len(pubkey) > 0 {
                if jwt_verify_rs256(token, pubkey) == 1 { ok = 1 }
            }
        }
        if ok == 0 {
            if len(secret) > 0 {
                if jwt_verify(token, secret) == 1 { ok = 1 }
            }
        }
    }}}}

    if ok == 0 { return "" }
    let payload = jwt_payload(token)
    return shaken_attest_from_payload(payload)
}

// Back-compat: secret-only HS256 verify
fn shaken_verify(msg: string, msglen: int, secret: string) -> string {
    let mut cfg = make([]string, 7)
    cfg[0] = "1"
    cfg[1] = ""
    cfg[2] = "C"
    cfg[3] = secret
    cfg[4] = "hs256"
    cfg[5] = ""
    cfg[6] = ""
    return shaken_verify_cfg(msg, msglen, cfg)
}

fn shaken_add_identity(msg: string, orig_tn: string, dest_tn: string, attest: string, cert_url: string, secret: string) -> string {
    let identity_val = shaken_sign(orig_tn, dest_tn, attest, cert_url, secret)
    if len(identity_val) == 0 { return msg }
    let mut result = hdr_add(msg, "Identity", identity_val)
    result = hdr_add(result, "P-Attestation-Indicator", attest)
    return result
}

fn shaken_add_identity_cfg(msg: string, orig_tn: string, dest_tn: string, attest: string, cfg: []string) -> string {
    let identity_val = shaken_sign_cfg(orig_tn, dest_tn, attest, cfg[1], cfg)
    if len(identity_val) == 0 { return msg }
    let mut result = hdr_add(msg, "Identity", identity_val)
    result = hdr_add(result, "P-Attestation-Indicator", attest)
    return result
}

fn shaken_verify_and_annotate(msg: string, msglen: int, secret: string) -> string {
    let mut cfg = make([]string, 7)
    cfg[0] = "1"
    cfg[1] = ""
    cfg[2] = "C"
    cfg[3] = secret
    cfg[4] = "auto"
    cfg[5] = ""
    cfg[6] = ""
    return shaken_verify_and_annotate_cfg(msg, msglen, cfg)
}

fn shaken_verify_and_annotate_cfg(msg: string, msglen: int, cfg: []string) -> string {
    let attest = shaken_verify_cfg(msg, msglen, cfg)
    if len(attest) > 0 {
        let mut result = hdr_set(msg, "P-Attestation-Indicator", attest)
        result = hdr_add(result, "P-Identity-Verified", "true")
        return result
    }

    let identity = sip_header(msg, "Identity")
    if len(identity) > 0 {
        let mut result = hdr_add(msg, "P-Identity-Verified", "false")
        result = hdr_add(result, "P-Identity-Error", "signature-validation-failed")
        return result
    }
    let _ = msglen
    return msg
}

// DB-driven STIR/SHAKEN config
// Returns [enabled, cert_url, attest_default, secret, mode, public_key, jwks]
fn db_shaken_config(db: SqlDB, db_ok: int, cache: CMap) -> []string {
    let mut result = make([]string, 7)
    result[0] = "0"
    result[1] = ""
    result[2] = "C"
    result[3] = ""
    result[4] = "auto"
    result[5] = ""
    result[6] = ""

    if db_ok == 0 {
        // Env overrides for standalone mode
        let env_en = env_get_or("STIR_SHAKEN_ENABLED", "")
        if str_eq(env_en, "true") { result[0] = "1" }
        result[1] = env_get_or("STIR_SHAKEN_CERT_URL", "")
        result[2] = env_get_or("STIR_SHAKEN_ATTESTATION", "C")
        result[3] = env_get_or("STIR_SHAKEN_SECRET", env_get_or("STIR_SHAKEN_PRIVATE_KEY", ""))
        result[4] = env_get_or("STIR_SHAKEN_MODE", "auto")
        result[5] = env_get_or("STIR_SHAKEN_PUBLIC_KEY", "")
        let jwks_env = env_get_or("STIR_SHAKEN_JWKS", "")
        let jwks_url = env_get_or("STIR_SHAKEN_JWKS_URL", "")
        if len(jwks_env) > 0 {
            result[6] = jwks_env
        } else {
            if len(jwks_url) > 0 { result[6] = shaken_fetch_jwks(jwks_url) }
        }
        return result
    }

    // Per-field cache (JWKS JSON may contain separators)
    let ck = "shaken|v2|" + proxy_cache_epoch(cache)
    if cmap_has(cache, ck) == 1 {
        result[0] = cmap_get(cache, "shaken|en")
        result[1] = cmap_get(cache, "shaken|cert")
        result[2] = cmap_get(cache, "shaken|attest")
        result[3] = cmap_get(cache, "shaken|secret")
        result[4] = cmap_get(cache, "shaken|mode")
        result[5] = cmap_get(cache, "shaken|pubkey")
        result[6] = cmap_get(cache, "shaken|jwks")
        return result
    }

    let enabled = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "stir_shaken_enabled")
    let cert = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "stir_shaken_cert_url")
    let attest = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "stir_shaken_attestation")
    let secret = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "stir_shaken_secret")
    let private_key = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "stir_shaken_private_key")
    let mode = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "stir_shaken_mode")
    let pubkey = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "stir_shaken_public_key")
    let jwks = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "stir_shaken_jwks")
    let jwks_url = sql_query_str(db, "SELECT value FROM config WHERE key = $1", "stir_shaken_jwks_url")

    if str_eq(enabled, "true") { result[0] = "1" }
    if len(cert) > 0 { result[1] = cert }
    if len(attest) > 0 { result[2] = attest }
    if len(secret) > 0 { result[3] = secret }
    if len(mode) > 0 { result[4] = mode }
    if str_eq(str_to_lower(result[4]), "es256") && len(private_key) > 0 { result[3] = private_key }
    if len(pubkey) > 0 { result[5] = pubkey }
    if len(jwks) > 0 {
        result[6] = jwks
    } else {
        if len(jwks_url) > 0 { result[6] = shaken_fetch_jwks(jwks_url) }
    }

    cmap_set(cache, ck, "1")
    cmap_set(cache, "shaken|en", result[0])
    cmap_set(cache, "shaken|cert", result[1])
    cmap_set(cache, "shaken|attest", result[2])
    cmap_set(cache, "shaken|secret", result[3])
    cmap_set(cache, "shaken|mode", result[4])
    cmap_set(cache, "shaken|pubkey", result[5])
    cmap_set(cache, "shaken|jwks", result[6])
    return result
}
