// MAF worker-side command handoff.
//
// The admin process accepts authenticated commands into PostgreSQL. SIP
// workers claim those commands with a compare-and-set token, perform only
// bounded operations they own, and publish the resulting state transition.
// Unsupported operations fail explicitly; they are never reported complete.

fn maf_worker_json_escape(s: string) -> string {
    let mut b = str_builder()
    let mut i = 0
    while i < len(s) {
        let c = int(s[i])
        if c == 34 { builder_write(b, "\\\"") }
        else if c == 92 { builder_write(b, "\\\\") }
        else if c == 10 { builder_write(b, "\\n") }
        else if c == 13 { builder_write(b, "\\r") }
        else if c == 9 { builder_write(b, "\\t") }
        else if c < 32 || c == 127 { builder_write_byte(b, byte(32)) }
        else { builder_write_byte(b, byte(c)) }
        i = i + 1
    }
    return builder_string(b)
}

fn maf_worker_text_safe(s: string, max: int) -> int {
    if len(s) > max { return 0 }
    let mut i = 0
    while i < len(s) {
        let c = int(s[i])
        if c == 0 || c == 10 || c == 13 { return 0 }
        i = i + 1
    }
    return 1
}

// MAF can use its own database via SIP_MAF_DB_URL, falling back to SIP_DB_URL.
// This lets operators isolate MAF state (calls, events, commands) from the core
// SIP proxy tables, or point MAF at a different cluster entirely.
fn maf_worker_db_url() -> string {
    let maf_url = env_get_or("SIP_MAF_DB_URL", "")
    if len(maf_url) > 0 { return maf_url }
    return env_get_or("SIP_DB_URL", "")
}

fn maf_worker_tenant() -> string {
    let tenant = str_trim_space(env_get_or("SIP_MAF_TENANT", "default"))
    if len(tenant) < 1 || len(tenant) > 128 { return "default" }
    let mut i = 0
    while i < len(tenant) {
        let c = int(tenant[i])
        let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 58 || c == 64 || c == 95
        if not ok { return "default" }
        i = i + 1
    }
    return tenant
}

fn maf_worker_bootstrap(db: SqlDB) -> int {
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_calls (call_id TEXT PRIMARY KEY, tenant_id TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'created', version BIGINT NOT NULL DEFAULT 1, from_uri TEXT NOT NULL, to_uri TEXT NOT NULL, application_data JSONB NOT NULL DEFAULT '{}'::jsonb, created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW(), ended_at TIMESTAMP)")
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_channels (channel_id TEXT PRIMARY KEY, call_id TEXT NOT NULL REFERENCES maf_calls(call_id) ON DELETE CASCADE, tenant_id TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'created', direction TEXT NOT NULL, endpoint TEXT NOT NULL, version BIGINT NOT NULL DEFAULT 1, created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW())")
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_commands (command_id TEXT PRIMARY KEY, idempotency_key TEXT NOT NULL UNIQUE, tenant_id TEXT NOT NULL, call_id TEXT NOT NULL DEFAULT '', operation TEXT NOT NULL, request_json JSONB NOT NULL DEFAULT '{}'::jsonb, request_hash TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'accepted', resource_id TEXT NOT NULL DEFAULT '', trace_id TEXT NOT NULL DEFAULT '', error_code TEXT NOT NULL DEFAULT '', error_message TEXT NOT NULL DEFAULT '', claim_token TEXT NOT NULL DEFAULT '', claimed_at TIMESTAMP, created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW())")
    let _ = sql_exec_plain(db, "ALTER TABLE maf_commands ADD COLUMN IF NOT EXISTS request_hash TEXT NOT NULL DEFAULT ''")
    let _ = sql_exec_plain(db, "ALTER TABLE maf_commands ADD COLUMN IF NOT EXISTS claim_token TEXT NOT NULL DEFAULT ''")
    let _ = sql_exec_plain(db, "ALTER TABLE maf_commands ADD COLUMN IF NOT EXISTS claimed_at TIMESTAMP")
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_events (event_id TEXT PRIMARY KEY, sequence BIGSERIAL UNIQUE NOT NULL, tenant_id TEXT NOT NULL, event_type TEXT NOT NULL, event_version INT NOT NULL DEFAULT 1, call_id TEXT NOT NULL DEFAULT '', channel_id TEXT NOT NULL DEFAULT '', payload_json JSONB NOT NULL DEFAULT '{}'::jsonb, trace_id TEXT NOT NULL DEFAULT '', occurred_at TIMESTAMP DEFAULT NOW(), CONSTRAINT maf_event_payload_size CHECK (octet_length(payload_json::text) <= 65536))")
    let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_maf_commands_pending ON maf_commands (tenant_id, status, created_at)")
    let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_maf_events_tenant_sequence ON maf_events (tenant_id, sequence)")
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_bridges (bridge_id TEXT PRIMARY KEY, tenant_id TEXT NOT NULL, call_id TEXT NOT NULL REFERENCES maf_calls(call_id) ON DELETE CASCADE, channel_ids JSONB NOT NULL, state TEXT NOT NULL DEFAULT 'active', created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW())")
    let _ = sql_exec_plain(db, "CREATE UNIQUE INDEX IF NOT EXISTS idx_maf_bridges_call_channels ON maf_bridges (tenant_id, call_id, md5(channel_ids::text))")
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_media_operations (media_id TEXT PRIMARY KEY, tenant_id TEXT NOT NULL, call_id TEXT NOT NULL REFERENCES maf_calls(call_id) ON DELETE CASCADE, operation TEXT NOT NULL, resource TEXT NOT NULL DEFAULT '', state TEXT NOT NULL DEFAULT 'accepted', error_code TEXT NOT NULL DEFAULT '', error_message TEXT NOT NULL DEFAULT '', created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW())")
    let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_maf_media_call ON maf_media_operations (tenant_id, call_id, created_at)")
    let _ = maf_headers_bootstrap(db)
    // PG trigger: NOTIFY on event insert so WS subscribers wake instantly.
    let _ = sql_exec_plain(db, "CREATE OR REPLACE FUNCTION maf_notify_event() RETURNS trigger AS $$ BEGIN PERFORM pg_notify('maf_events', NEW.tenant_id || '|' || NEW.event_type || '|' || NEW.call_id || '|' || NEW.sequence::text); RETURN NEW; END; $$ LANGUAGE plpgsql")
    let _ = sql_exec_plain(db, "DROP TRIGGER IF EXISTS maf_event_notify ON maf_events")
    let _ = sql_exec_plain(db, "CREATE TRIGGER maf_event_notify AFTER INSERT ON maf_events FOR EACH ROW EXECUTE FUNCTION maf_notify_event()")
    return 1
}

fn maf_worker_emit_event(db: SqlDB, ok: int, tenant: string, event_type: string, call_id: string, payload: string, trace: string) -> int {
    if ok == 0 || len(event_type) == 0 || len(event_type) > 128 || len(payload) == 0 || len(payload) > 65536 { return -1 }
    // Reject payloads that could corrupt the packed JSONB document.
    // The payload must be a valid JSON object or array.
    let p0 = int(payload[0])
    if p0 != 123 && p0 != 91 { return -1 }  // must start with { or [
    // mono_ms for uniqueness; payload hash breaks ties if two events of the
    // same type fire in the same millisecond for the same call.
    let event_id = sha256("madis.maf.event.v1|" + tenant + "|" + event_type + "|" + call_id + "|" + trace + "|" + string(mono_ms()) + "|" + sha256(payload))
    let packed = "{\"event_id\":\"" + maf_worker_json_escape(event_id) + "\",\"tenant_id\":\"" + maf_worker_json_escape(tenant) + "\",\"event_type\":\"" + maf_worker_json_escape(event_type) + "\",\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"channel_id\":\"\",\"trace_id\":\"" + maf_worker_json_escape(trace) + "\",\"payload\":" + payload + "}"
    return sql_exec_str4(db, "INSERT INTO maf_events (event_id, tenant_id, event_type, event_version, call_id, channel_id, payload_json, trace_id) SELECT $1::jsonb->>'event_id', $1::jsonb->>'tenant_id', $1::jsonb->>'event_type', 1, $1::jsonb->>'call_id', $1::jsonb->>'channel_id', $1::jsonb->'payload', $1::jsonb->>'trace_id' ON CONFLICT (event_id) DO NOTHING", packed, "", "", "")
}

fn maf_worker_call_state(db: SqlDB, ok: int, tenant: string, call_id: string, state: string, trace: string) -> int {
    return maf_worker_call_state_detail(db, ok, tenant, call_id, state, trace, "")
}

fn maf_worker_call_state_detail(db: SqlDB, ok: int, tenant: string, call_id: string, state: string, trace: string, detail: string) -> int {
    if ok == 0 || len(call_id) == 0 || len(state) == 0 { return 0 }
    let rc = sql_exec_str4(db, "UPDATE maf_calls SET state = $2, version = version + 1, updated_at = NOW(), ended_at = CASE WHEN $2 IN ('ended','failed') THEN NOW() ELSE ended_at END WHERE tenant_id = $3 AND call_id = $1 AND state <> $2", call_id, state, tenant, "")
    if rc < 0 { return 0 }
    if rc == 0 { return 1 }
    let mut payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"state\":\"" + maf_worker_json_escape(state) + "\",\"source\":\"sip-worker\""
    if len(detail) > 0 { payload = payload + "," + detail }
    payload = payload + "}"
    let _ = maf_worker_emit_event(db, ok, tenant, "call." + state, call_id, payload, trace)
    return 1
}

fn maf_worker_command_state(db: SqlDB, ok: int, tenant: string, command_id: string, claim: string, status: string, code: string, message: string, call_id: string, trace: string) -> int {
    if ok == 0 || len(command_id) == 0 || len(claim) == 0 { return 0 }
    let packed = "{\"status\":\"" + maf_worker_json_escape(status) + "\",\"error_code\":\"" + maf_worker_json_escape(code) + "\",\"error_message\":\"" + maf_worker_json_escape(message) + "\"}"
    let rc = sql_exec_str4(db, "UPDATE maf_commands SET status = $4::jsonb->>'status', error_code = $4::jsonb->>'error_code', error_message = $4::jsonb->>'error_message', updated_at = NOW() WHERE tenant_id = $3 AND command_id = $1 AND claim_token = $2 AND status = 'processing'", command_id, claim, tenant, packed)
    if rc < 0 { return 0 }
    let event_type = if str_eq(status, "completed") { "command.completed" } else { "command.failed" }
    let payload = "{\"command_id\":\"" + maf_worker_json_escape(command_id) + "\",\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"status\":\"" + maf_worker_json_escape(status) + "\",\"error_code\":\"" + maf_worker_json_escape(code) + "\"}"
    let _ = maf_worker_emit_event(db, ok, tenant, event_type, call_id, payload, trace)
    return 1
}

fn maf_worker_claim(db: SqlDB, ok: int, tenant: string, command_id: string, claim: string) -> int {
    if ok == 0 || len(command_id) == 0 || len(claim) == 0 { return 0 }
    // The WHERE status = 'accepted' guard makes this atomic: exactly one
    // worker wins the UPDATE. No verify SELECT needed.
    let rc = sql_exec_str4(db, "UPDATE maf_commands SET status = 'processing', claim_token = $2, claimed_at = NOW(), updated_at = NOW() WHERE tenant_id = $3 AND command_id = $1 AND status = 'accepted'", command_id, claim, tenant, "")
    if rc < 0 { return 0 }
    return 1
}

fn maf_worker_endpoint_ok(value: string) -> int {
    if len(value) == 0 || len(value) > 512 || sip_uri_syntax_valid(value) == 0 { return 0 }
    return 1
}

fn maf_worker_inbound_call_id(tenant: string, wire_call_id: string) -> string {
    if len(tenant) == 0 || len(tenant) > 128 || len(wire_call_id) == 0 || len(wire_call_id) > 512 {
        return ""
    }
    if maf_worker_text_safe(wire_call_id, 512) == 0 { return "" }
    return "call-in-" + sha256("madis.maf.inbound|" + tenant + "|" + wire_call_id)[0:32]
}

fn maf_worker_answer_sdp_ok(sdp: string) -> int {
    if len(sdp) < 8 || len(sdp) > 32768 { return 0 }
    if not str_has_prefix(str_trim_space(sdp), "v=0") { return 0 }
    if str_index(sdp, "m=") < 0 { return 0 }
    // Reject SDP containing the SIP header/body separator. A crafted
    // answer_sdp with \r\n\r\n could cause header injection in downstream
    // stacks that don't use Content-Length framing.
    if str_index(sdp, "\r\n\r\n") >= 0 { return 0 }
    let mut i = 0
    while i < len(sdp) {
        let c = int(sdp[i])
        if c == 0 || c == 127 || (c < 32 && c != 9 && c != 10 && c != 13) { return 0 }
        i = i + 1
    }
    return 1
}

fn maf_worker_build_inbound_answer(invite: string, answer_sdp: string, contact_uri: string, to_tag: string) -> string {
    if len(invite) == 0 || maf_worker_answer_sdp_ok(answer_sdp) == 0 || len(contact_uri) == 0 || len(to_tag) == 0 {
        return ""
    }
    let extra = "Contact: <" + contact_uri + ">\r\nContent-Type: application/sdp\r\n"
    let response = sip_reply_with_to_tag(invite, 200, "OK", extra, answer_sdp, to_tag)
    if sip_validate_message(response, len(response)) == 0 { return "" }
    return response
}

fn maf_worker_inbound_cache_value(invite: string, ip: string, port: int, transport: string) -> string {
    return "{\"invite\":\"" + maf_worker_json_escape(invite) + "\",\"ip\":\"" +
        maf_worker_json_escape(ip) + "\",\"port\":\"" + string(port) +
        "\",\"transport\":\"" + maf_worker_json_escape(transport) + "\"}"
}

fn maf_worker_inbound_cache_put(cache: CMap, call_id: string, value: string) -> int {
    if len(call_id) == 0 || len(value) == 0 || len(value) > 65536 { return 0 }
    return bounded_cache_set(cache, "maf_inbound_seq", "maf_inbound_ring|", "maf_inbound|" + call_id, value, 4096)
}

fn maf_worker_inbound_cache_get(cache: CMap, call_id: string) -> string {
    if len(call_id) == 0 { return "" }
    return cmap_get(cache, "maf_inbound|" + call_id)
}

fn maf_worker_inbound_call_for_wire(cache: CMap, tenant: string, wire_call_id: string) -> string {
    let call_id = maf_worker_inbound_call_id(tenant, wire_call_id)
    if len(call_id) > 0 && len(maf_worker_inbound_cache_get(cache, call_id)) > 0 { return call_id }
    return ""
}

fn maf_worker_ingress_invite(db: SqlDB, ok: int, tenant: string, msg: string, ip: string, port: int, transport: string, cache: CMap) -> string {
    if ok == 0 || len(msg) == 0 || not str_eq(str_to_upper(str_trim_space(madis_method(msg))), "INVITE") { return "" }
    let wire_call_id = sip_header(msg, "Call-ID")
    let call_id = maf_worker_inbound_call_id(tenant, wire_call_id)
    if len(call_id) == 0 { return "" }
    let from_uri = sip_contact_addr(sip_header(msg, "From"))
    let to_uri = sip_contact_addr(sip_header(msg, "To"))
    if maf_worker_text_safe(from_uri, 512) == 0 || maf_worker_text_safe(to_uri, 512) == 0 { return "" }
    let existing = sql_query_str2(db, "SELECT call_id FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if len(existing) == 0 {
        let nat_status = if nat_detected(msg, ip) == 1 { "true" } else { "false" }
        let req_uri = sip_request_uri(msg)
        let ua = sip_header(msg, "User-Agent")
        let pai = sip_header(msg, "P-Asserted-Identity")
        let identity = sip_header(msg, "Identity")
        let verified = sip_header(msg, "P-Identity-Verified")
        let sdp = sip_body(msg)
        let mut app = "{\"sip_call_id\":\"" + maf_worker_json_escape(wire_call_id) + "\",\"direction\":\"inbound\",\"transport\":\"" + maf_worker_json_escape(transport) + "\",\"nat\":\"" + nat_status + "\",\"source_ip\":\"" + maf_worker_json_escape(ip) + "\",\"source_port\":" + string(port) + ",\"request_uri\":\"" + maf_worker_json_escape(req_uri) + "\",\"user_agent\":\"" + maf_worker_json_escape(ua) + "\""
        if len(pai) > 0 { app = app + ",\"p_asserted_identity\":\"" + maf_worker_json_escape(pai) + "\"" }
        if len(identity) > 0 { app = app + ",\"identity\":\"" + maf_worker_json_escape(identity) + "\"" }
        if len(verified) > 0 { app = app + ",\"identity_verified\":\"" + maf_worker_json_escape(verified) + "\"" }
        if len(sdp) > 0 && len(sdp) < 8192 { app = app + ",\"sdp\":\"" + maf_worker_json_escape(sdp) + "\"" }
        // Emergency and access-network metadata
        if sip_is_emergency(req_uri) == 1 { app = app + ",\"emergency\":true" }
        let pani = sip_header(msg, "P-Access-Network-Info")
        if len(pani) > 0 { app = app + ",\"p_access_network_info\":\"" + maf_worker_json_escape(pani) + "\"" }
        app = app + "}"
        let document = "{\"from\":\"" + maf_worker_json_escape(from_uri) + "\",\"to\":\"" + maf_worker_json_escape(to_uri) + "\",\"application_data\":" + app + "}"
        let call_rc = sql_exec_str4(db, "INSERT INTO maf_calls (call_id, tenant_id, state, version, from_uri, to_uri, application_data) SELECT $1, $2, 'ringing', 1, $3::jsonb->>'from', $3::jsonb->>'to', $3::jsonb->'application_data' ON CONFLICT (call_id) DO NOTHING", call_id, tenant, document, "")
        if call_rc < 0 { return "" }
        let channel_id = "chan-" + sha256(call_id + "|inbound")[0:32]
        let _ = sql_exec_str4(db, "INSERT INTO maf_channels (channel_id, call_id, tenant_id, state, direction, endpoint) VALUES ($1, $2, $3, 'ringing', 'inbound', $4) ON CONFLICT (channel_id) DO NOTHING", channel_id, call_id, tenant, from_uri)
        let trace = sha256("madis.maf.inbound.trace|" + tenant + "|" + wire_call_id)[0:32]
        let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"direction\":\"inbound\",\"sip_call_id\":\"" + maf_worker_json_escape(wire_call_id) + "\"}"
        let _ = maf_worker_emit_event(db, ok, tenant, "call.created", call_id, payload, trace)
    }
    let received = via_add_received(msg, len(msg), ip, port)
    if len(received) == 0 { return "" }
    // NAT: fix SDP and Contact for NATted inbound callers before caching
    let public_ip = env_get_or("SIP_PUBLIC_IP", ip)
    let nat_fixed = nat_fix_message(received, ip, port, public_ip)
    if maf_worker_inbound_cache_put(cache, call_id, maf_worker_inbound_cache_value(nat_fixed, ip, port, transport)) != 0 { return "" }
    cmap_set(cache, "maf_created_ms|" + call_id, string(mono_ms()))
    return call_id
}

fn maf_worker_inbound_contact_uri() -> string {
    let configured = env_get_or("SIP_MAF_CONTACT_URI", "")
    if len(configured) > 0 {
        if maf_worker_endpoint_ok(configured) == 1 { return configured }
        return ""
    }
    let host = env_get_or("SIP_PUBLIC_IP", env_get_or("SIP_NODE_ADDR", "127.0.0.1"))
    if len(host) == 0 || maf_worker_text_safe(host, 128) == 0 { return "" }
    let mut authority = host
    if str_index(host, ":") >= 0 && not str_has_prefix(host, "[") { authority = "[" + host + "]" }
    return "sip:madis@" + authority
}

fn maf_worker_inbound_answer(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string, cache: CMap, out_fd: int) -> string {
    let packed = maf_worker_inbound_cache_get(cache, call_id)
    if len(packed) == 0 { return "inbound_dialog_unavailable|the worker does not own this inbound dialog" }
    let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if not str_eq(current, "ringing") { return "answer_state_conflict|the inbound call is not ringing" }
    let invite = json_get_string(packed, "invite")
    let answer_sdp = json_get_string(request, "answer_sdp")
    let contact_uri = maf_worker_inbound_contact_uri()
    if len(invite) == 0 || maf_worker_answer_sdp_ok(answer_sdp) == 0 || len(contact_uri) == 0 {
        return "invalid_answer|answer_sdp and a reachable contact URI are required"
    }
    let to_tag = "maf-in-" + sha256(call_id + "|answer")[0:20]
    let response = maf_headers_apply(db, ok, tenant, call_id, maf_worker_build_inbound_answer(invite, answer_sdp, contact_uri, to_tag), "INVITE", "inbound")
    if len(response) == 0 { return "invalid_answer|the generated SIP response failed validation" }
    let ip = json_get_string(packed, "ip")
    let tr = json_get_string(packed, "transport")
    let mut port = 5060
    match parse_int(json_get_string(packed, "port")) { Ok(v) => { port = v } Err(_) => {} }
    let _ = sip_server_txn_record(invite, response, ip, port, tr, out_fd, cache)
    if sip_forward_reply(response, cache, out_fd) == 0 { return "answer_delivery_failed|the worker could not deliver the SIP response" }
    let _ = maf_worker_inbound_cache_put(cache, call_id, maf_worker_inbound_cache_value(invite, ip, port, tr))
    cmap_set(cache, "maf_inbound_answer|" + call_id, response)
    if maf_worker_call_state(db, ok, tenant, call_id, "answered", trace) == 0 { return "answer_state_failed|the call state could not be updated" }
    return "ok"
}

fn maf_worker_inbound_reject(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string, cache: CMap, out_fd: int) -> string {
    let packed = maf_worker_inbound_cache_get(cache, call_id)
    if len(packed) == 0 { return "inbound_dialog_unavailable|the worker does not own this inbound dialog" }
    let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if str_eq(current, "answered") { return "reject_state_conflict|answered calls must be hung up" }
    let invite = json_get_string(packed, "invite")
    let mut code = json_get_int(request, "sip_code")
    if code < 300 || code > 699 { code = 486 }
    let reason = if code == 487 { "Request Terminated" } else if code == 603 { "Decline" } else { "Busy Here" }
    let to_tag = "maf-in-" + sha256(call_id + "|reject")[0:20]
    let response = maf_headers_apply(db, ok, tenant, call_id, sip_reply_with_to_tag(invite, code, reason, "", "", to_tag), "INVITE", "inbound")
    if sip_validate_message(response, len(response)) == 0 { return "invalid_reject|the generated SIP response failed validation" }
    let ip = json_get_string(packed, "ip")
    let tr = json_get_string(packed, "transport")
    let mut port = 5060
    match parse_int(json_get_string(packed, "port")) { Ok(v) => { port = v } Err(_) => {} }
    let _ = sip_server_txn_record(invite, response, ip, port, tr, out_fd, cache)
    if sip_forward_reply(response, cache, out_fd) == 0 { return "reject_delivery_failed|the worker could not deliver the SIP response" }
    let _ = maf_worker_call_state(db, ok, tenant, call_id, "ended", trace)
    return "ok"
}

fn maf_worker_inbound_bye(db: SqlDB, ok: int, tenant: string, call_id: string, trace: string, cache: CMap, out_fd: int) -> string {
    let packed = maf_worker_inbound_cache_get(cache, call_id)
    let answer = cmap_get(cache, "maf_inbound_answer|" + call_id)
    if len(packed) == 0 || len(answer) == 0 { return "dialog_unavailable|the inbound dialog is not confirmed" }
    let target = sip_contact_addr(sip_header(json_get_string(packed, "invite"), "Contact"))
    let from_header = sip_header(answer, "To")
    let to_header = sip_header(answer, "From")
    let wire_call_id = sip_header(answer, "Call-ID")
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    let local_contact = maf_worker_inbound_contact_uri()
    if len(target) == 0 || maf_worker_endpoint_ok(target) == 0 || len(from_header) == 0 || len(to_header) == 0 || len(wire_call_id) == 0 || len(local_contact) == 0 || maf_worker_text_safe(node_addr, 128) == 0 { return "dialog_unavailable|the inbound dialog has no safe remote target" }
    let mut tr = str_to_lower(json_get_string(packed, "transport"))
    if str_eq(tr, "sips") { tr = "tls" }
    if len(tr) == 0 { tr = sip_transport_param(target, "udp") }
    let branch = "z9hG4bK-maf-in-bye-" + sha256(call_id + "|bye|" + string(now_ms()))[0:24]
    let bye = maf_headers_apply(db, ok, tenant, call_id, "BYE " + target + " SIP/2.0\r\n" +
        "Via: SIP/2.0/" + str_to_upper(tr) + " " + node_addr + ";branch=" + branch + "\r\n" +
        "Max-Forwards: 70\r\n" + "From: " + from_header + "\r\n" +
        "To: " + to_header + "\r\n" + "Call-ID: " + wire_call_id + "\r\n" +
    "CSeq: 1 BYE\r\n" + "Contact: <" + local_contact + ">\r\n" +
        "Content-Length: 0\r\n\r\n", "BYE", "inbound")
    if sip_validate_message(bye, len(bye)) == 0 { return "dialog_unavailable|the generated BYE failed validation" }
    if sip_forward_target(target, bye, tr, cache, out_fd) == 0 { return "dialog_unavailable|the worker could not send BYE" }
    return "ok"
}

fn maf_worker_invite(call_id: string, from_uri: string, to_uri: string, node_id: string, node_addr: string, transport: string) -> string {
    let branch = "z9hG4bK-maf-" + sha256(call_id + "|branch")[0:24]
    let tag = "maf-" + sha256(call_id + "|from")[0:20]
    let call_ref = call_id + "@" + node_id
    let via_tr = str_to_upper(transport)
    return "INVITE " + to_uri + " SIP/2.0\r\n" +
        "Via: SIP/2.0/" + via_tr + " " + node_addr + ";branch=" + branch + "\r\n" +
        "Max-Forwards: 70\r\n" +
        "From: <" + from_uri + ">;tag=" + tag + "\r\n" +
        "To: <" + to_uri + ">\r\n" +
        "Call-ID: " + call_ref + "\r\n" +
        "CSeq: 1 INVITE\r\n" +
        "Contact: <sip:madis@" + node_addr + ">\r\n" +
        "Content-Length: 0\r\n\r\n"
}

fn maf_worker_start_call(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string, cache: CMap, out_fd: int, node_id: string) -> int {
    let from_uri = json_get_string(request, "from")
    let to_uri = json_get_string(request, "to")
    if maf_worker_endpoint_ok(from_uri) == 0 || maf_worker_endpoint_ok(to_uri) == 0 { return 0 }
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    if len(node_addr) == 0 || len(node_addr) > 128 || maf_worker_text_safe(node_addr, 128) == 0 { return 0 }
    // Derive transport from the target URI scheme/params (sips:→TLS, transport=tcp, etc.)
    let tr = sip_transport_param(to_uri, "udp")
    let mut invite = maf_headers_apply(db, ok, tenant, call_id, maf_worker_invite(call_id, from_uri, to_uri, node_id, node_addr, tr), "INVITE", "outbound")
    // Apply externally-signed Identity if present.
    invite = maf_identity_apply(cache, call_id, invite)
    if sip_validate_message(invite, len(invite)) == 0 { return 0 }
    let target = sip_forward_first(to_uri, invite, cache, call_id, out_fd)
    if len(target) == 0 { return 0 }
    let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_invite|" + call_id, invite, 65536)
    let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_target|" + call_id, target, 65536)
    let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_transport|" + call_id, tr, 65536)
    cmap_set(cache, "maf_created_ms|" + call_id, string(mono_ms()))
    let _ = maf_worker_call_state(db, ok, tenant, call_id, "ringing", trace)
    return 1
}

fn maf_worker_cancel_call(db: SqlDB, ok: int, tenant: string, call_id: string, trace: string, cache: CMap, out_fd: int) -> int {
    let invite = cmap_get(cache, "maf_invite|" + call_id)
    let target = cmap_get(cache, "maf_target|" + call_id)
    if len(invite) == 0 || len(target) == 0 { return 0 }
    let mut tr = cmap_get(cache, "maf_transport|" + call_id)
    if len(tr) == 0 { tr = sip_transport_param(target, "udp") }
    let cancel = maf_headers_apply(db, ok, tenant, call_id, sip_build_cancel(invite), "CANCEL", "outbound")
    if len(cancel) == 0 || sip_forward_target(target, cancel, tr, cache, out_fd) == 0 { return 0 }
    let _ = maf_worker_call_state(db, ok, tenant, call_id, "ending", trace)
    return 1
}

fn maf_worker_bye_call(db: SqlDB, ok: int, tenant: string, call_id: string, trace: string, cache: CMap, out_fd: int) -> int {
    let invite = cmap_get(cache, "maf_invite|" + call_id)
    let response = cmap_get(cache, "maf_response|" + call_id)
    let fallback = cmap_get(cache, "maf_target|" + call_id)
    if len(invite) == 0 || len(response) == 0 { return 0 }
    let remote_to = sip_header(response, "To")
    let from_header = sip_header(invite, "From")
    let call_header = sip_header(invite, "Call-ID")
    if len(remote_to) == 0 || len(from_header) == 0 || len(call_header) == 0 { return 0 }
    let contact = sip_contact_addr(sip_header(response, "Contact"))
    let target = if maf_worker_endpoint_ok(contact) == 1 { contact } else { fallback }
    if len(target) == 0 || maf_worker_endpoint_ok(target) == 0 { return 0 }
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    if maf_worker_text_safe(node_addr, 128) == 0 { return 0 }
    let mut tr = cmap_get(cache, "maf_transport|" + call_id)
    if len(tr) == 0 { tr = sip_transport_param(target, "udp") }
    let branch = "z9hG4bK-maf-bye-" + sha256(call_id + "|bye|" + string(now_ms()))[0:24]
    let bye = maf_headers_apply(db, ok, tenant, call_id, "BYE " + target + " SIP/2.0\r\n" +
        "Via: SIP/2.0/" + str_to_upper(tr) + " " + node_addr + ";branch=" + branch + "\r\n" +
        "Max-Forwards: 70\r\n" +
        "From: " + from_header + "\r\n" +
        "To: " + remote_to + "\r\n" +
        "Call-ID: " + call_header + "\r\n" +
        "CSeq: 2 BYE\r\n" +
        "Contact: <sip:madis@" + node_addr + ">\r\n" +
        "Content-Length: 0\r\n\r\n", "BYE", "outbound")
    if sip_validate_message(bye, len(bye)) == 0 { return 0 }
    if sip_forward_target(target, bye, tr, cache, out_fd) == 0 { return 0 }
    let _ = maf_worker_call_state(db, ok, tenant, call_id, "ending", trace)
    return 1
}

fn maf_worker_bridge(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string) string {
    let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if not str_eq(current, "answered") && not str_eq(current, "bridged") { return "bridge_state_conflict|bridging requires an answered call" }
    let count_raw = sql_query_str(db, "SELECT jsonb_array_length($1::jsonb->'channel_ids')::text", request)
    let mut count = -1
    match parse_int(count_raw) { Ok(v) => { count = v } Err(_) => {} }
    if count < 2 || count > 8 { return "invalid_bridge|channel_ids must contain 2 to 8 channels" }
    let owned_packed = "{\"request\":" + request + ",\"tenant_id\":\"" + maf_worker_json_escape(tenant) + "\",\"call_id\":\"" + maf_worker_json_escape(call_id) + "\"}"
    let owned_raw = sql_query_str(db, "SELECT COUNT(*)::text FROM maf_channels WHERE tenant_id = $1::jsonb->>'tenant_id' AND call_id = $1::jsonb->>'call_id' AND channel_id IN (SELECT jsonb_array_elements_text($1::jsonb->'request'->'channel_ids'))", owned_packed)
    let mut owned = -1
    match parse_int(owned_raw) { Ok(v) => { owned = v } Err(_) => {} }
    if owned != count { return "invalid_bridge|all channels must belong to the call" }
    let bridge_id = "bridge-" + sha256("madis.maf.bridge|" + tenant + "|" + call_id + "|" + sha256(request))[0:32]
    let existing = sql_query_str2(db, "SELECT state FROM maf_bridges WHERE tenant_id = $1 AND bridge_id = $2", tenant, bridge_id)
    if str_eq(existing, "active") { return "ok" }
    let rc = sql_exec_str4(db, "INSERT INTO maf_bridges (bridge_id, tenant_id, call_id, channel_ids, state) SELECT $1, $2, $3, $4::jsonb->'channel_ids', 'active' ON CONFLICT (bridge_id) DO UPDATE SET state = 'active', updated_at = NOW()", bridge_id, tenant, call_id, request)
    if rc < 0 { return "bridge_persist_failed|the bridge relationship could not be stored" }
    let mode = str_to_lower(str_trim_space(json_get_string(request, "mode")))
    let bridge_mode = if str_eq(mode, "conference") { "conference" } else { "bridge" }
    let bridge_payload = "{\"bridge_id\":\"" + maf_worker_json_escape(bridge_id) + "\",\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"mode\":\"" + maf_worker_json_escape(bridge_mode) + "\",\"state\":\"active\"}"
    let _ = maf_worker_emit_event(db, ok, tenant, "bridge.created", call_id, bridge_payload, trace)
    if maf_worker_call_state(db, ok, tenant, call_id, "bridged", trace) == 0 { return "bridge_state_failed|the call state could not be updated" }
    return "ok"
}

fn maf_worker_media_event(db: SqlDB, ok: int, tenant: string, call_id: string, media_id: string, operation: string, state: string, code: string, message: string, trace: string) int {
    let payload = "{\"media_id\":\"" + maf_worker_json_escape(media_id) + "\",\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"operation\":\"" + maf_worker_json_escape(operation) + "\",\"state\":\"" + maf_worker_json_escape(state) + "\",\"error_code\":\"" + maf_worker_json_escape(code) + "\",\"error_message\":\"" + maf_worker_json_escape(message) + "\"}"
    return maf_worker_emit_event(db, ok, tenant, "media." + state, call_id, payload, trace)
}

fn maf_worker_media_execute(db: SqlDB, ok: int, tenant: string, call_id: string, command_id: string, request: string, trace: string) string {
    let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if not str_eq(current, "answered") && not str_eq(current, "bridged") { return "media_state_conflict|media operations require an answered or bridged call" }
    let operation = str_to_lower(str_trim_space(json_get_string(request, "operation")))
    if not str_eq(operation, "play") && not str_eq(operation, "record") && not str_eq(operation, "stop") && not str_eq(operation, "pause") && not str_eq(operation, "resume") { return "invalid_media|the media operation is not allowlisted" }
    let resource = json_get_string(request, "resource")
    if len(resource) > 2048 || maf_worker_text_safe(resource, 2048) == 0 { return "invalid_media|the media resource is not safe" }
    let media_id = "media-" + sha256("madis.maf.media|" + tenant + "|" + call_id + "|" + command_id + "|" + operation + "|" + sha256(request))[0:32]
    let existing = sql_query_str2(db, "SELECT state FROM maf_media_operations WHERE tenant_id = $1 AND media_id = $2", tenant, media_id)
    if str_eq(existing, "completed") { return "ok" }
    let media_packed = "{\"operation\":\"" + maf_worker_json_escape(operation) + "\",\"resource\":\"" + maf_worker_json_escape(resource) + "\"}"
    let inserted = sql_exec_str4(db, "INSERT INTO maf_media_operations (media_id, tenant_id, call_id, operation, resource, state) SELECT $1, $2, $3, $4::jsonb->>'operation', $4::jsonb->>'resource', 'processing' ON CONFLICT (media_id) DO UPDATE SET state = 'processing', error_code = '', error_message = '', updated_at = NOW()", media_id, tenant, call_id, media_packed)
    if inserted < 0 { return "media_persist_failed|the media operation could not be stored" }
    let module = if str_eq(operation, "pause") || str_eq(operation, "resume") { "recording" } else { "media" }
    let synthetic = "INVITE sip:maf-media@local SIP/2.0\r\n" +
        "From: <sip:madis@local>;tag=maf-media\r\n" +
        "To: <sip:maf-media@local>\r\n" +
        "Call-ID: " + call_id + "\r\n" +
        "CSeq: 1 INVITE\r\n" +
        "Content-Length: 0\r\n\r\n"
    let payload = "{\"schema\":\"madis.maf.media.v1\",\"tenant_id\":\"" + maf_worker_json_escape(tenant) + "\",\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"operation\":\"" + maf_worker_json_escape(operation) + "\",\"resource\":\"" + maf_worker_json_escape(resource) + "\"}"
    let raw = module_gateway_call(synthetic, "127.0.0.1", 0, "maf", "maf", module, operation, payload)
    if len(raw) == 0 || str_eq(raw, "__MODULE_FAIL__") { let _ = sql_exec_str4(db, "UPDATE maf_media_operations SET state = 'failed', error_code = 'media_backend_unavailable', error_message = 'the configured media module did not accept the operation', updated_at = NOW() WHERE tenant_id = $1 AND media_id = $2", tenant, media_id, "", ""); let _ = maf_worker_media_event(db, ok, tenant, call_id, media_id, operation, "failed", "media_backend_unavailable", "the configured media module did not accept the operation", trace); return "media_backend_unavailable|the configured media module did not accept the operation" }
    if module_gateway_command_valid(raw, synthetic, "maf", module, operation, payload, 0) == 0 { let _ = sql_exec_str4(db, "UPDATE maf_media_operations SET state = 'failed', error_code = 'media_backend_invalid', error_message = 'the media module response failed signature validation', updated_at = NOW() WHERE tenant_id = $1 AND media_id = $2", tenant, media_id, "", ""); let _ = maf_worker_media_event(db, ok, tenant, call_id, media_id, operation, "failed", "media_backend_invalid", "the media module response failed signature validation", trace); return "media_backend_invalid|the media module response failed signature validation" }
    let action = module_gateway_action(raw, synthetic, "maf", module, operation, payload)
    if not str_eq(action, "continue") { let _ = sql_exec_str4(db, "UPDATE maf_media_operations SET state = 'failed', error_code = 'media_backend_rejected', error_message = 'the media module rejected the operation', updated_at = NOW() WHERE tenant_id = $1 AND media_id = $2", tenant, media_id, "", ""); let _ = maf_worker_media_event(db, ok, tenant, call_id, media_id, operation, "failed", "media_backend_rejected", "the media module rejected the operation", trace); return "media_backend_rejected|the media module rejected the operation" }
    let _ = sql_exec_str4(db, "UPDATE maf_media_operations SET state = 'completed', updated_at = NOW() WHERE tenant_id = $1 AND media_id = $2", tenant, media_id, "", "")
    let _ = maf_worker_media_event(db, ok, tenant, call_id, media_id, operation, "completed", "", "", trace)
    return "ok"
}

fn maf_worker_transfer(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string, cache: CMap, out_fd: int) -> string {
    let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if not str_eq(current, "answered") && not str_eq(current, "bridged") { return "transfer_state_conflict|transfer requires an answered or bridged call" }
    let transfer_type = str_to_lower(str_trim_space(json_get_string(request, "type")))
    if not str_eq(transfer_type, "blind") && not str_eq(transfer_type, "attended") { return "invalid_transfer|type must be blind or attended" }
    // Resolve dialog state from cache (outbound) or inbound cache
    let invite = cmap_get(cache, "maf_invite|" + call_id)
    let response = cmap_get(cache, "maf_response|" + call_id)
    let inbound_packed = maf_worker_inbound_cache_get(cache, call_id)
    let inbound_answer = cmap_get(cache, "maf_inbound_answer|" + call_id)
    let is_inbound = if len(inbound_packed) > 0 && len(inbound_answer) > 0 { 1 } else { 0 }
    let is_outbound = if len(invite) > 0 && len(response) > 0 { 1 } else { 0 }
    if is_inbound == 0 && is_outbound == 0 { return "dialog_unavailable|the worker does not own a confirmed dialog for this call" }
    // Build REFER
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    if maf_worker_text_safe(node_addr, 128) == 0 { return "dialog_unavailable|node address is not safe" }
    let local_contact = maf_worker_inbound_contact_uri()
    if len(local_contact) == 0 { return "dialog_unavailable|no contact URI available" }
    let mut from_header = ""
    let mut to_header = ""
    let mut wire_call_id = ""
    let mut target = ""
    let mut tr = ""
    if is_inbound == 1 {
        from_header = sip_header(inbound_answer, "To")
        to_header = sip_header(inbound_answer, "From")
        wire_call_id = sip_header(inbound_answer, "Call-ID")
        target = sip_contact_addr(sip_header(json_get_string(inbound_packed, "invite"), "Contact"))
        tr = str_to_lower(json_get_string(inbound_packed, "transport"))
    } else {
        from_header = sip_header(invite, "From")
        to_header = sip_header(response, "To")
        wire_call_id = sip_header(invite, "Call-ID")
        let contact = sip_contact_addr(sip_header(response, "Contact"))
        let fallback = cmap_get(cache, "maf_target|" + call_id)
        target = if maf_worker_endpoint_ok(contact) == 1 { contact } else { fallback }
        tr = cmap_get(cache, "maf_transport|" + call_id)
    }
    if str_eq(tr, "sips") { tr = "tls" }
    if len(tr) == 0 { tr = sip_transport_param(target, "udp") }
    if len(from_header) == 0 || len(to_header) == 0 || len(wire_call_id) == 0 || len(target) == 0 || maf_worker_endpoint_ok(target) == 0 {
        return "dialog_unavailable|dialog headers are incomplete"
    }
    let mut refer_to = ""
    if str_eq(transfer_type, "blind") {
        let dest = json_get_string(request, "target")
        if len(dest) == 0 || maf_worker_endpoint_ok(dest) == 0 { return "invalid_transfer|target must be a valid SIP URI for blind transfer" }
        refer_to = dest
    } else {
        let other_call_id = json_get_string(request, "other_call_id")
        if len(other_call_id) == 0 { return "invalid_transfer|other_call_id is required for attended transfer" }
        let other_target = json_get_string(request, "target")
        if len(other_target) == 0 || maf_worker_endpoint_ok(other_target) == 0 { return "invalid_transfer|target must be a valid SIP URI for attended transfer" }
        refer_to = other_target + "?Replaces=" + other_call_id
    }
    let branch = "z9hG4bK-maf-refer-" + sha256(call_id + "|refer|" + string(now_ms()))[0:24]
    let referred_by = sip_contact_addr(from_header)
    let refer = maf_headers_apply(db, ok, tenant, call_id, "REFER " + target + " SIP/2.0\r\n" +
        "Via: SIP/2.0/" + str_to_upper(tr) + " " + node_addr + ";branch=" + branch + "\r\n" +
        "Max-Forwards: 70\r\n" +
        "From: " + from_header + "\r\n" +
        "To: " + to_header + "\r\n" +
        "Call-ID: " + wire_call_id + "\r\n" +
        "CSeq: 3 REFER\r\n" +
        "Contact: <" + local_contact + ">\r\n" +
        "Refer-To: <" + refer_to + ">\r\n" +
        "Referred-By: <" + referred_by + ">\r\n" +
        "Content-Length: 0\r\n\r\n", "REFER", if is_inbound == 1 { "inbound" } else { "outbound" })
    if sip_validate_message(refer, len(refer)) == 0 { return "invalid_transfer|the generated REFER failed validation" }
    if sip_forward_target(target, refer, tr, cache, out_fd) == 0 { return "transfer_delivery_failed|the worker could not send REFER" }
    let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"type\":\"" + maf_worker_json_escape(transfer_type) + "\",\"state\":\"transferring\"}"
    let _ = maf_worker_emit_event(db, ok, tenant, "call.transferring", call_id, payload, trace)
    let _ = maf_worker_call_state(db, ok, tenant, call_id, "transferring", trace)
    return "ok"
}

fn maf_worker_reinvite_sdp(db: SqlDB, ok: int, tenant: string, call_id: string, sdp_attr: string, trace: string, cache: CMap, out_fd: int) -> string {
    let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if not str_eq(current, "answered") && not str_eq(current, "bridged") { return "hold_state_conflict|hold/unhold requires an answered or bridged call" }
    let invite = cmap_get(cache, "maf_invite|" + call_id)
    let response = cmap_get(cache, "maf_response|" + call_id)
    let inbound_packed = maf_worker_inbound_cache_get(cache, call_id)
    let inbound_answer = cmap_get(cache, "maf_inbound_answer|" + call_id)
    let is_inbound = if len(inbound_packed) > 0 && len(inbound_answer) > 0 { 1 } else { 0 }
    let is_outbound = if len(invite) > 0 && len(response) > 0 { 1 } else { 0 }
    if is_inbound == 0 && is_outbound == 0 { return "dialog_unavailable|the worker does not own a confirmed dialog" }
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    if maf_worker_text_safe(node_addr, 128) == 0 { return "dialog_unavailable|node address is not safe" }
    let local_contact = maf_worker_inbound_contact_uri()
    if len(local_contact) == 0 { return "dialog_unavailable|no contact URI available" }
    let mut from_header = ""
    let mut to_header = ""
    let mut wire_call_id = ""
    let mut target = ""
    let mut tr = ""
    if is_inbound == 1 {
        from_header = sip_header(inbound_answer, "To")
        to_header = sip_header(inbound_answer, "From")
        wire_call_id = sip_header(inbound_answer, "Call-ID")
        target = sip_contact_addr(sip_header(json_get_string(inbound_packed, "invite"), "Contact"))
        tr = str_to_lower(json_get_string(inbound_packed, "transport"))
    } else {
        from_header = sip_header(invite, "From")
        to_header = sip_header(response, "To")
        wire_call_id = sip_header(invite, "Call-ID")
        let contact = sip_contact_addr(sip_header(response, "Contact"))
        let fallback = cmap_get(cache, "maf_target|" + call_id)
        target = if maf_worker_endpoint_ok(contact) == 1 { contact } else { fallback }
        tr = cmap_get(cache, "maf_transport|" + call_id)
    }
    if str_eq(tr, "sips") { tr = "tls" }
    if len(tr) == 0 { tr = sip_transport_param(target, "udp") }
    if len(from_header) == 0 || len(to_header) == 0 || len(wire_call_id) == 0 || len(target) == 0 || maf_worker_endpoint_ok(target) == 0 {
        return "dialog_unavailable|dialog headers are incomplete"
    }
    // ponytail: minimal SDP with just the direction attribute; real media negotiation is the media module's job
    let sdp_body = "v=0\r\no=madis 0 0 IN IP4 0.0.0.0\r\ns=-\r\nc=IN IP4 0.0.0.0\r\nt=0 0\r\nm=audio 0 RTP/AVP 0\r\na=" + sdp_attr + "\r\n"
    let branch = "z9hG4bK-maf-reinv-" + sha256(call_id + "|reinvite|" + sdp_attr + "|" + string(now_ms()))[0:24]
    let reinvite = maf_headers_apply(db, ok, tenant, call_id, "INVITE " + target + " SIP/2.0\r\n" +
        "Via: SIP/2.0/" + str_to_upper(tr) + " " + node_addr + ";branch=" + branch + "\r\n" +
        "Max-Forwards: 70\r\n" +
        "From: " + from_header + "\r\n" +
        "To: " + to_header + "\r\n" +
        "Call-ID: " + wire_call_id + "\r\n" +
        "CSeq: 2 INVITE\r\n" +
        "Contact: <" + local_contact + ">\r\n" +
        "Content-Type: application/sdp\r\n" +
        "Content-Length: " + string(len(sdp_body)) + "\r\n\r\n" + sdp_body, "INVITE", if is_inbound == 1 { "inbound" } else { "outbound" })
    if sip_validate_message(reinvite, len(reinvite)) == 0 { return "invalid_reinvite|the generated re-INVITE failed validation" }
    if sip_forward_target(target, reinvite, tr, cache, out_fd) == 0 { return "reinvite_delivery_failed|the worker could not send re-INVITE" }
    return "ok"
}

fn maf_worker_hold(db: SqlDB, ok: int, tenant: string, call_id: string, trace: string, cache: CMap, out_fd: int) -> string {
    let result = maf_worker_reinvite_sdp(db, ok, tenant, call_id, "sendonly", trace, cache, out_fd)
    if not str_eq(result, "ok") { return result }
    let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"state\":\"held\"}"
    let _ = maf_worker_emit_event(db, ok, tenant, "call.held", call_id, payload, trace)
    return "ok"
}

fn maf_worker_unhold(db: SqlDB, ok: int, tenant: string, call_id: string, trace: string, cache: CMap, out_fd: int) -> string {
    let result = maf_worker_reinvite_sdp(db, ok, tenant, call_id, "sendrecv", trace, cache, out_fd)
    if not str_eq(result, "ok") { return result }
    let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"state\":\"unheld\"}"
    let _ = maf_worker_emit_event(db, ok, tenant, "call.unheld", call_id, payload, trace)
    return "ok"
}

fn maf_worker_dtmf(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string, cache: CMap, out_fd: int) -> string {
    let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if not str_eq(current, "answered") && not str_eq(current, "bridged") { return "dtmf_state_conflict|DTMF requires an answered or bridged call" }
    let digit = str_trim_space(json_get_string(request, "digit"))
    if len(digit) != 1 { return "invalid_dtmf|digit must be a single character" }
    let d = int(digit[0])
    let valid = (d >= 48 && d <= 57) || d == 42 || d == 35 || (d >= 65 && d <= 68) || (d >= 97 && d <= 100)
    if not valid { return "invalid_dtmf|digit must be 0-9, *, #, or A-D" }
    let mut duration = json_get_int(request, "duration")
    if duration <= 0 { duration = 250 }
    if duration > 5000 { duration = 5000 }
    let invite = cmap_get(cache, "maf_invite|" + call_id)
    let response = cmap_get(cache, "maf_response|" + call_id)
    let inbound_packed = maf_worker_inbound_cache_get(cache, call_id)
    let inbound_answer = cmap_get(cache, "maf_inbound_answer|" + call_id)
    let is_inbound = if len(inbound_packed) > 0 && len(inbound_answer) > 0 { 1 } else { 0 }
    let is_outbound = if len(invite) > 0 && len(response) > 0 { 1 } else { 0 }
    if is_inbound == 0 && is_outbound == 0 { return "dialog_unavailable|the worker does not own a confirmed dialog" }
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    if maf_worker_text_safe(node_addr, 128) == 0 { return "dialog_unavailable|node address is not safe" }
    let local_contact = maf_worker_inbound_contact_uri()
    if len(local_contact) == 0 { return "dialog_unavailable|no contact URI available" }
    let mut from_header = ""
    let mut to_header = ""
    let mut wire_call_id = ""
    let mut target = ""
    let mut tr = ""
    if is_inbound == 1 {
        from_header = sip_header(inbound_answer, "To")
        to_header = sip_header(inbound_answer, "From")
        wire_call_id = sip_header(inbound_answer, "Call-ID")
        target = sip_contact_addr(sip_header(json_get_string(inbound_packed, "invite"), "Contact"))
        tr = str_to_lower(json_get_string(inbound_packed, "transport"))
    } else {
        from_header = sip_header(invite, "From")
        to_header = sip_header(response, "To")
        wire_call_id = sip_header(invite, "Call-ID")
        let contact = sip_contact_addr(sip_header(response, "Contact"))
        let fallback = cmap_get(cache, "maf_target|" + call_id)
        target = if maf_worker_endpoint_ok(contact) == 1 { contact } else { fallback }
        tr = cmap_get(cache, "maf_transport|" + call_id)
    }
    if str_eq(tr, "sips") { tr = "tls" }
    if len(tr) == 0 { tr = sip_transport_param(target, "udp") }
    if len(from_header) == 0 || len(to_header) == 0 || len(wire_call_id) == 0 || len(target) == 0 || maf_worker_endpoint_ok(target) == 0 {
        return "dialog_unavailable|dialog headers are incomplete"
    }
    let info_body = "Signal=" + str_to_upper(digit) + "\r\nDuration=" + string(duration)
    let branch = "z9hG4bK-maf-info-" + sha256(call_id + "|info|" + digit + "|" + string(now_ms()))[0:24]
    let info = maf_headers_apply(db, ok, tenant, call_id, "INFO " + target + " SIP/2.0\r\n" +
        "Via: SIP/2.0/" + str_to_upper(tr) + " " + node_addr + ";branch=" + branch + "\r\n" +
        "Max-Forwards: 70\r\n" +
        "From: " + from_header + "\r\n" +
        "To: " + to_header + "\r\n" +
        "Call-ID: " + wire_call_id + "\r\n" +
        "CSeq: 4 INFO\r\n" +
        "Contact: <" + local_contact + ">\r\n" +
        "Content-Type: application/dtmf-relay\r\n" +
        "Content-Length: " + string(len(info_body)) + "\r\n\r\n" + info_body, "INFO", if is_inbound == 1 { "inbound" } else { "outbound" })
    if sip_validate_message(info, len(info)) == 0 { return "invalid_dtmf|the generated INFO failed validation" }
    if sip_forward_target(target, info, tr, cache, out_fd) == 0 { return "dtmf_delivery_failed|the worker could not send INFO" }
    let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"digit\":\"" + maf_worker_json_escape(str_to_upper(digit)) + "\",\"duration\":" + string(duration) + "}"
    let _ = maf_worker_emit_event(db, ok, tenant, "call.dtmf", call_id, payload, trace)
    return "ok"
}

fn maf_worker_execute(db: SqlDB, ok: int, tenant: string, operation: string, call_id: string, command_id: string, request: string, trace: string, cache: CMap, out_fd: int, node_id: string) string {
    if str_eq(operation, "calls.create") {
        return if maf_worker_start_call(db, ok, tenant, call_id, request, trace, cache, out_fd, node_id) == 1 { "ok" } else { "transport_or_endpoint_rejected|outbound INVITE was not sent" }
    }
    if str_eq(operation, "calls.reject") {
        if len(maf_worker_inbound_cache_get(cache, call_id)) > 0 {
            return maf_worker_inbound_reject(db, ok, tenant, call_id, request, trace, cache, out_fd)
        }
        return if maf_worker_cancel_call(db, ok, tenant, call_id, trace, cache, out_fd) == 1 { "ok" } else { "no_early_dialog|the worker has no cancellable early dialog" }
    }
    if str_eq(operation, "calls.hangup") {
        let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
        if len(maf_worker_inbound_cache_get(cache, call_id)) > 0 {
            if str_eq(current, "ringing") {
                let inbound_request = "{\"sip_code\":487}"
                return maf_worker_inbound_reject(db, ok, tenant, call_id, inbound_request, trace, cache, out_fd)
            }
            if str_eq(current, "answered") {
                return maf_worker_inbound_bye(db, ok, tenant, call_id, trace, cache, out_fd)
            }
        }
        if str_eq(current, "ringing") {
            return if maf_worker_cancel_call(db, ok, tenant, call_id, trace, cache, out_fd) == 1 { "ok" } else { "dialog_unavailable|the worker could not send CANCEL" }
        }
        if str_eq(current, "answered") {
            return if maf_worker_bye_call(db, ok, tenant, call_id, trace, cache, out_fd) == 1 { "ok" } else { "dialog_unavailable|the worker could not build or send BYE" }
        }
        return "dialog_executor_pending|BYE execution requires confirmed-dialog ownership"
    }
    if str_eq(operation, "calls.headers") {
        return if maf_headers_store(db, ok, tenant, call_id, request) == 1 { "ok" } else { "header_policy_rejected|the header policy was not valid or could not be stored" }
    }
    if str_eq(operation, "calls.answer") {
        if len(maf_worker_inbound_cache_get(cache, call_id)) > 0 {
            return maf_worker_inbound_answer(db, ok, tenant, call_id, request, trace, cache, out_fd)
        }
        let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
        if str_eq(current, "answered") { return "ok" }
        return "inbound_dialog_unavailable|answer requires an owned inbound dialog"
    }
    if str_eq(operation, "calls.bridge") { return maf_worker_bridge(db, ok, tenant, call_id, request, trace) }
    if str_eq(operation, "calls.media") { return maf_worker_media_execute(db, ok, tenant, call_id, command_id, request, trace) }
    if str_eq(operation, "calls.transfer") { return maf_worker_transfer(db, ok, tenant, call_id, request, trace, cache, out_fd) }
    if str_eq(operation, "calls.hold") { return maf_worker_hold(db, ok, tenant, call_id, trace, cache, out_fd) }
    if str_eq(operation, "calls.unhold") { return maf_worker_unhold(db, ok, tenant, call_id, trace, cache, out_fd) }
    if str_eq(operation, "calls.dtmf") { return maf_worker_dtmf(db, ok, tenant, call_id, request, trace, cache, out_fd) }
    if str_eq(operation, "calls.route") { return maf_worker_route(db, ok, tenant, call_id, request, trace, cache, out_fd) }
    if str_eq(operation, "calls.rtp") { return maf_worker_rtp(db, ok, tenant, call_id, request, trace, cache) }
    if str_eq(operation, "calls.identity") { return maf_worker_identity(db, ok, tenant, call_id, request, trace, cache) }
    return "unknown_operation|operation is not allowlisted"
}

// MAF RTPEngine control: let the SDK trigger offer/answer/delete and set
// flags (ICE, SRTP, codec strip, etc.) per call. This replaces the automatic
// RTPEngine integration for MAF-controlled calls.
fn maf_worker_rtp(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string, cache: CMap) -> string {
    let action = str_to_lower(str_trim_space(json_get_string(request, "action")))
    if not str_eq(action, "offer") && not str_eq(action, "answer") && not str_eq(action, "delete") && not str_eq(action, "query") {
        return "invalid_rtp|action must be offer, answer, delete, or query"
    }
    let cfg = rtp_config(db, ok, cache)
    if str_eq(cfg[0], "0") { return "rtp_disabled|rtpengine is not enabled" }
    let mut rtp_port = 2223
    match parse_int(cfg[2]) { Ok(v) => { rtp_port = v } Err(_) => {} }

    // Resolve wire call-id from MAF call-id. Outbound calls use
    // "call_id@node_id" as the SIP Call-ID; append only if not present.
    let mut wire_cid = call_id
    if str_index(wire_cid, "@") < 0 {
        wire_cid = wire_cid + "@" + env_get_or("SIP_NODE_ID", "node1")
    }
    // Check inbound: use the SIP Call-ID from the cached invite
    let inbound = maf_worker_inbound_cache_get(cache, call_id)
    if len(inbound) > 0 {
        let inv = json_get_string(inbound, "invite")
        if len(inv) > 0 { wire_cid = sip_header(inv, "Call-ID") }
    }
    // Check outbound: use the cached invite Call-ID
    let outbound_inv = cmap_get(cache, "maf_invite|" + call_id)
    if len(outbound_inv) > 0 {
        let out_cid = sip_header(outbound_inv, "Call-ID")
        if len(out_cid) > 0 { wire_cid = out_cid }
    }

    if str_eq(action, "delete") {
        let rc = rtp_delete_cache(cache, cfg[1], rtp_port, wire_cid)
        let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"action\":\"delete\",\"result\":\"" + if rc == 1 { "ok" } else { "failed" } + "\"}"
        let _ = maf_worker_emit_event(db, ok, tenant, "rtp.deleted", call_id, payload, trace)
        return if rc == 1 { "ok" } else { "rtp_delete_failed|rtpengine did not accept the delete" }
    }

    if str_eq(action, "query") {
        // Return current RTP state for this call
        let state_key = "rtp_state|" + wire_cid
        let mut state = "none"
        if cmap_has(cache, state_key) == 1 { state = cmap_get(cache, state_key) }
        let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"action\":\"query\",\"state\":\"" + maf_worker_json_escape(state) + "\"}"
        let _ = maf_worker_emit_event(db, ok, tenant, "rtp.query", call_id, payload, trace)
        return "ok"
    }

    let sdp = json_get_string(request, "sdp")
    if len(sdp) == 0 || not str_has_prefix(str_trim_space(sdp), "v=0") {
        return "invalid_rtp|sdp is required for offer/answer"
    }
    let from_tag = json_get_string(request, "from_tag")
    if len(from_tag) == 0 { return "invalid_rtp|from_tag is required" }

    // SDK can override RTPEngine flags per call
    let mut flags = str_trim_space(json_get_string(request, "flags"))
    if len(flags) == 0 { flags = rtp_policy_flags() }
    if len(flags) > 512 { flags = "" }

    if str_eq(action, "offer") {
        let mut cmd = ""
        if len(flags) > 0 {
            cmd = bencode_dict_5("command", "offer", "call-id", wire_cid, "from-tag", from_tag, "sdp", sdp, "flags", flags)
        } else {
            cmd = bencode_dict_4("command", "offer", "call-id", wire_cid, "from-tag", from_tag, "sdp", sdp)
        }
        let resp = rtp_send_call(cache, wire_cid, cmd, cfg[1], rtp_port)
        if len(resp) == 0 { return "rtp_offer_failed|rtpengine did not respond" }
        let result = bencode_get(resp, "result")
        if not str_eq(result, "ok") { return "rtp_offer_rejected|rtpengine rejected the offer" }
        let new_sdp = bencode_get(resp, "sdp")
        let _ = bounded_cache_set(cache, "rtp_seq", "rtp_ring|", "rtp_state|" + wire_cid, "offer|" + string(mono_ms()), 65536)
        // Store the rewritten SDP so the SDK can retrieve it
        let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_rtp_sdp|" + call_id, new_sdp, 65536)
        let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"action\":\"offer\",\"result\":\"ok\"}"
        let _ = maf_worker_emit_event(db, ok, tenant, "rtp.offer", call_id, payload, trace)
        return "ok"
    }

    if str_eq(action, "answer") {
        let to_tag = json_get_string(request, "to_tag")
        if len(to_tag) == 0 { return "invalid_rtp|to_tag is required for answer" }
        let mut cmd = bencode_dict_5("command", "answer", "call-id", wire_cid, "from-tag", from_tag, "to-tag", to_tag, "sdp", sdp)
        if len(flags) > 0 {
            cmd = cmd[0:len(cmd) - 1] + bencode_str("flags") + bencode_str(flags) + "e"
        }
        let resp = rtp_send_call(cache, wire_cid, cmd, cfg[1], rtp_port)
        if len(resp) == 0 { return "rtp_answer_failed|rtpengine did not respond" }
        let result = bencode_get(resp, "result")
        if not str_eq(result, "ok") { return "rtp_answer_rejected|rtpengine rejected the answer" }
        let new_sdp = bencode_get(resp, "sdp")
        let _ = bounded_cache_set(cache, "rtp_seq", "rtp_ring|", "rtp_state|" + wire_cid, "answer|" + string(mono_ms()), 65536)
        let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_rtp_sdp|" + call_id, new_sdp, 65536)
        let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"action\":\"answer\",\"result\":\"ok\"}"
        let _ = maf_worker_emit_event(db, ok, tenant, "rtp.answer", call_id, payload, trace)
        return "ok"
    }
    return "invalid_rtp|unsupported action"
}

// MAF routing: let the SDK decide where to send an inbound call.
// The SDK posts calls.route with a target SIP URI (or list) and optional
// transport. The worker forwards the cached inbound INVITE to that target,
// replacing the built-in routing engine for this call.
fn maf_worker_route(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string, cache: CMap, out_fd: int) -> string {
    let packed = maf_worker_inbound_cache_get(cache, call_id)
    if len(packed) == 0 { return "inbound_dialog_unavailable|route requires an owned inbound dialog" }
    let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if not str_eq(current, "ringing") && not str_eq(current, "created") { return "route_state_conflict|the call is not in a routable state" }
    let target = json_get_string(request, "target")
    if len(target) == 0 || maf_worker_endpoint_ok(target) == 0 { return "invalid_route|target must be a valid SIP URI" }
    let invite = json_get_string(packed, "invite")
    if len(invite) == 0 { return "dialog_unavailable|cached invite is missing" }
    let ip = json_get_string(packed, "ip")
    let tr_from = json_get_string(packed, "transport")
    let mut port_val = 5060
    match parse_int(json_get_string(packed, "port")) { Ok(v) => { port_val = v } Err(_) => {} }
    // Transport for outbound leg: SDK can override, else derive from target URI
    let mut tr = str_to_lower(str_trim_space(json_get_string(request, "transport")))
    if len(tr) == 0 { tr = sip_transport_param(target, "udp") }
    let public_ip = env_get_or("SIP_PUBLIC_IP", ip)
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    let udp_port_str = env_get_or("SIP_UDP_PORT", "5060")
    let mut udp_port = 5060
    match parse_int(udp_port_str) { Ok(v) => { udp_port = v } Err(_) => {} }
    // B2BUA mode: terminate both legs locally instead of proxy forwarding
    let mode = str_to_lower(str_trim_space(json_get_string(request, "mode")))
    if str_eq(mode, "b2bua") && b2bua_enabled() == 1 {
        let b2_msg = b2bua_prepare_invite(invite, target, tr, public_ip + ":" + string(udp_port), tr, cache)
        if len(b2_msg) == 0 { return "b2bua_build_failed|could not build B2BUA INVITE" }
        if sip_forward_target(target, b2_msg, tr, cache, out_fd) == 0 {
            let failed_key = b2bua_lookup_in(invite, cache)
            if len(failed_key) > 0 { let _ = b2bua_cleanup(failed_key, cache) }
            return "route_delivery_failed|could not forward B2BUA INVITE to target"
        }
    } else {
    // Build the outbound INVITE: add Via, Record-Route, NAT-fix SDP
    // Apply externally-signed Identity if present.
    let signed_invite = maf_identity_apply(cache, call_id, invite)
    let hopped = proxy_hop(signed_invite, public_ip, udp_port, tr)
    let fwd = nat_fix_sdp(hopped, len(hopped), public_ip)
    if sip_forward_target(target, fwd, tr, cache, out_fd) == 0 { return "route_delivery_failed|could not forward INVITE to target" }
    }
    // Track dialog so responses route back
    let wire_cid = sip_header(invite, "Call-ID")
    let _ = bounded_cache_set(cache, "dialog_seq", "dialog_ring|", "dialog_dst|" + wire_cid, target, 131072)
    let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_invite|" + call_id, invite, 65536)
    let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_target|" + call_id, target, 65536)
    let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_transport|" + call_id, tr, 65536)
    let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"target\":\"" + maf_worker_json_escape(target) + "\",\"transport\":\"" + maf_worker_json_escape(tr) + "\"}"
    let _ = maf_worker_emit_event(db, ok, tenant, "call.routed", call_id, payload, trace)
    let _ = maf_worker_call_state(db, ok, tenant, call_id, "ringing", trace)
    return "ok"
}

// MAF STIR/SHAKEN identity control: let the SDK manage signing and
// verification through external services instead of local key material.
//
// Operations:
//   sign    — SDK provides a pre-signed Identity header value to attach
//   verify  — returns the current verification result from the cached SIP data
//   attest  — set the attestation level for this call
//   clear   — remove Identity/P-Attestation-Indicator headers
fn maf_worker_identity(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string, cache: CMap) -> string {
    let action = str_to_lower(str_trim_space(json_get_string(request, "action")))
    if not str_eq(action, "sign") && not str_eq(action, "verify") && not str_eq(action, "attest") && not str_eq(action, "clear") {
        return "invalid_identity|action must be sign, verify, attest, or clear"
    }

    if str_eq(action, "sign") {
        // The SDK obtained a signed Identity header from an external service
        // and provides it here.
        let identity_value = json_get_string(request, "identity")
        if len(identity_value) == 0 || len(identity_value) > 4096 {
            return "invalid_identity|identity header value required (max 4KB)"
        }
        // Reject CRLF/null — prevents SIP header injection via Identity value
        if maf_worker_text_safe(identity_value, 4096) == 0 {
            return "invalid_identity|identity must not contain CR, LF, or null bytes"
        }
        // Validate it looks like a JWT;info=<url>;alg=...;ppt=shaken
        if str_index(identity_value, ";info=<") < 0 || str_index(identity_value, ";ppt=shaken") < 0 {
            return "invalid_identity|identity must contain ;info=<url>;ppt=shaken"
        }
        // Derive attestation from the JWT payload, not client-supplied value.
        // Trusting client-declared attestation enables robocall fraud.
        let token = shaken_identity_token(identity_value)
        let jwt_claims = jwt_payload(token)
        let mut attestation = shaken_attest_from_payload(jwt_claims)
        if len(attestation) == 0 { attestation = "C" }
        // Store for the worker to apply when forwarding
        let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_identity|" + call_id, identity_value, 65536)
        let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_attest|" + call_id, attestation, 65536)
        let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"action\":\"sign\",\"attest\":\"" + attestation + "\",\"source\":\"external\"}"
        let _ = maf_worker_emit_event(db, ok, tenant, "identity.signed", call_id, payload, trace)
        return "ok"
    }

    if str_eq(action, "verify") {
        // Return the verification result from the inbound SIP data
        let packed = maf_worker_inbound_cache_get(cache, call_id)
        let outbound_inv = cmap_get(cache, "maf_invite|" + call_id)
        let mut msg = ""
        if len(packed) > 0 { msg = json_get_string(packed, "invite") }
        if len(msg) == 0 && len(outbound_inv) > 0 { msg = outbound_inv }
        if len(msg) == 0 { return "dialog_unavailable|no cached SIP message for this call" }
        let identity = sip_header(msg, "Identity")
        if len(identity) == 0 {
            let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"action\":\"verify\",\"result\":\"none\",\"reason\":\"no Identity header\"}"
            let _ = maf_worker_emit_event(db, ok, tenant, "identity.verified", call_id, payload, trace)
            return "ok"
        }
        let verified = sip_header(msg, "P-Identity-Verified")
        let attest_hdr = sip_header(msg, "P-Attestation-Indicator")
        let error_hdr = sip_header(msg, "P-Identity-Error")
        let info_url = shaken_identity_info(identity)
        let token = shaken_identity_token(identity)
        let jwt_payload = jwt_payload(token)
        let orig = shaken_orig_from_payload(jwt_payload)
        let dest = shaken_dest_from_payload(jwt_payload)
        let iat = shaken_iat_from_payload(jwt_payload)
        // Emit metadata only — do not leak the full JWT token in events
        let alg = shaken_identity_alg(identity)
        let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"action\":\"verify\",\"result\":\"" + maf_worker_json_escape(if str_eq(verified, "true") { "verified" } else { "failed" }) + "\",\"attest\":\"" + maf_worker_json_escape(attest_hdr) + "\",\"error\":\"" + maf_worker_json_escape(error_hdr) + "\",\"orig\":\"" + maf_worker_json_escape(orig) + "\",\"dest\":\"" + maf_worker_json_escape(dest) + "\",\"iat\":" + string(iat) + ",\"info\":\"" + maf_worker_json_escape(info_url) + "\",\"alg\":\"" + maf_worker_json_escape(alg) + "\"}"
        let _ = maf_worker_emit_event(db, ok, tenant, "identity.verified", call_id, payload, trace)
        return "ok"
    }

    if str_eq(action, "attest") {
        let attest = str_to_upper(str_trim_space(json_get_string(request, "attest")))
        if not str_eq(attest, "A") && not str_eq(attest, "B") && not str_eq(attest, "C") {
            return "invalid_identity|attest must be A, B, or C"
        }
        let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_attest|" + call_id, attest, 65536)
        let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"action\":\"attest\",\"attest\":\"" + attest + "\"}"
        let _ = maf_worker_emit_event(db, ok, tenant, "identity.attest", call_id, payload, trace)
        return "ok"
    }

    if str_eq(action, "clear") {
        let _ = cmap_del(cache, "maf_identity|" + call_id)
        let _ = cmap_del(cache, "maf_attest|" + call_id)
        let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"action\":\"clear\"}"
        let _ = maf_worker_emit_event(db, ok, tenant, "identity.cleared", call_id, payload, trace)
        return "ok"
    }
    return "invalid_identity|unsupported action"
}

fn maf_worker_poll(db: SqlDB, ok: int, cache: CMap, out_fd: int, node_id: string) -> int {
    if ok == 0 { return 0 }
    // Adaptive backoff: skip poll if last poll was empty and interval hasn't
    // elapsed. Starts at 100ms, backs off to 2s when idle, resets on work.
    let now = mono_ms()
    let mut last_poll = 0
    if cmap_has(cache, "maf_poll_at") == 1 {
        match parse_int(cmap_get(cache, "maf_poll_at")) { Ok(v) => { last_poll = v } Err(_) => {} }
    }
    let mut interval = 100
    if cmap_has(cache, "maf_poll_interval") == 1 {
        match parse_int(cmap_get(cache, "maf_poll_interval")) { Ok(v) => { interval = v } Err(_) => {} }
    }
    if last_poll > 0 && now - last_poll < interval { return 0 }
    cmap_set(cache, "maf_poll_at", string(now))
    let tenant = maf_worker_tenant()
    let packed = "{\"tenant_id\":\"" + maf_worker_json_escape(tenant) + "\"}"
    let rows = sql_query_rows_str(db, "SELECT command_id FROM maf_commands WHERE tenant_id = $1::jsonb->>'tenant_id' AND status = 'accepted' ORDER BY created_at ASC LIMIT 8", packed)
    if sql_rows_ok(rows) == 0 {
        slog("  MAF:     command poll query returned no row handle")
        // Back off: double interval up to 2s
        if interval < 2000 { cmap_set(cache, "maf_poll_interval", string(interval * 2)) }
        return 0
    }
    let mut acted = 0
    while sql_rows_next(rows) == 1 {
        let command_id = sql_rows_str(rows, 0)
        if len(command_id) == 0 { continue }
        let call_id = sql_query_str2(db, "SELECT call_id FROM maf_commands WHERE tenant_id = $1 AND command_id = $2", tenant, command_id)
        let operation = sql_query_str2(db, "SELECT operation FROM maf_commands WHERE tenant_id = $1 AND command_id = $2", tenant, command_id)
        let request = sql_query_str2(db, "SELECT request_json::text FROM maf_commands WHERE tenant_id = $1 AND command_id = $2", tenant, command_id)
        let trace = sql_query_str2(db, "SELECT trace_id FROM maf_commands WHERE tenant_id = $1 AND command_id = $2", tenant, command_id)
        if len(call_id) == 0 || len(operation) == 0 || len(request) == 0 { continue }
        let claim = sha256("madis.maf.claim|" + node_id + "|" + command_id + "|" + string(now_ms()))
        if maf_worker_claim(db, ok, tenant, command_id, claim) == 0 { continue }
        let result = maf_worker_execute(db, ok, tenant, operation, call_id, command_id, request, trace, cache, out_fd, node_id)
        let result_parts = str_split(result, "|")
        let result_code = if len(result_parts) > 0 { result_parts[0] } else { "worker_error" }
        let result_message = if len(result_parts) > 1 { result_parts[1] } else { "worker execution failed" }
        if str_eq(result, "ok") {
            let _ = maf_worker_command_state(db, ok, tenant, command_id, claim, "completed", "", "", call_id, trace)
        } else {
            let _ = maf_worker_command_state(db, ok, tenant, command_id, claim, "failed", result_code, result_message, call_id, trace)
            if str_eq(operation, "calls.create") { let _ = maf_worker_call_state(db, ok, tenant, call_id, "failed", trace) }
        }
        acted = acted + 1
    }
    let _ = sql_rows_close(rows)
    // Reset backoff when work was found
    if acted > 0 { cmap_set(cache, "maf_poll_interval", "100") }
    else {
        if interval < 2000 { cmap_set(cache, "maf_poll_interval", string(interval * 2)) }
    }
    return acted
}

fn maf_worker_sync_sip(db: SqlDB, ok: int, msg: string, cache: CMap) -> int {
    if ok == 0 { return 0 }
    let wire_call_id = sip_header(msg, "Call-ID")
    if len(wire_call_id) == 0 { return 0 }
    // Fast path: most SIP messages are not MAF-originated. Skip the DB query
    // unless the Call-ID matches a known MAF pattern or has a cached inbound
    // mapping. This eliminates a JOIN per message at high CPS.
    let inbound_tenant = maf_worker_tenant()
    let inbound_call_id = maf_worker_inbound_call_for_wire(cache, inbound_tenant, wire_call_id)
    let is_maf_call = if len(inbound_call_id) > 0 { 1 }
        else if str_has_prefix(wire_call_id, "call-") { 1 }
        else if str_index(wire_call_id, "@") > 0 && cmap_has(cache, "maf_invite|" + wire_call_id[0:str_index(wire_call_id, "@")]) == 1 { 1 }
        else { 0 }
    if is_maf_call == 0 { return 0 }
    if len(inbound_call_id) > 0 {
        let inbound_method = str_to_upper(str_trim_space(madis_method(msg)))
        let inbound_cseq_parts = str_split(sip_header(msg, "CSeq"), " ")
        let inbound_cseq_method = if len(inbound_cseq_parts) >= 2 { str_to_upper(str_trim_space(inbound_cseq_parts[1])) } else { inbound_method }
        if str_eq(inbound_method, "BYE") || str_eq(inbound_method, "CANCEL") || str_eq(inbound_cseq_method, "BYE") || str_eq(inbound_cseq_method, "CANCEL") {
            let inbound_trace = sha256("madis.maf.inbound.state|" + inbound_call_id + "|" + inbound_cseq_method)[0:32]
            let mut end_detail = "\"ended_by\":\"" + maf_worker_json_escape(if str_eq(inbound_method, "BYE") { "BYE" } else { "CANCEL" }) + "\""
            let created_key = "maf_created_ms|" + inbound_call_id
            if cmap_has(cache, created_key) == 1 {
                let mut created_ms = 0
                match parse_int(cmap_get(cache, created_key)) { Ok(v) => { created_ms = v } Err(_) => {} }
                if created_ms > 0 { end_detail = end_detail + ",\"duration_ms\":" + string(mono_ms() - created_ms) }
            }
            return if maf_worker_call_state_detail(db, ok, inbound_tenant, inbound_call_id, "ended", inbound_trace, end_detail) == 1 { 1 } else { 0 }
        }
    }
    let mut call_id = wire_call_id
    let at = str_index(call_id, "@")
    if at > 0 { call_id = call_id[0:at] }
    let row = sql_query_str(db, "SELECT tenant_id || '|' || state || '|' || trace_id FROM maf_calls c LEFT JOIN maf_commands m ON m.call_id = c.call_id AND m.operation = 'calls.create' WHERE c.call_id = $1 ORDER BY m.created_at ASC LIMIT 1", call_id)
    if len(row) == 0 { return 0 }
    let parts = str_split(row, "|")
    if len(parts) < 3 { return 0 }
    let tenant = parts[0]
    let current = parts[1]
    let trace = parts[2]
    let mut next = current
    let cseq_parts = str_split(sip_header(msg, "CSeq"), " ")
    let cseq_method = if len(cseq_parts) >= 2 { str_to_upper(str_trim_space(cseq_parts[1])) } else { "" }
    let mut sip_detail = ""
    if sip_is_response(msg) == 1 {
        let code = sip_status_code(msg)
        if str_eq(cseq_method, "BYE") || str_eq(cseq_method, "CANCEL") { next = "ended" }
        else {
            if code >= 180 && code < 200 { next = "ringing" }
            if code >= 200 && code < 300 { next = "answered" }
            if code >= 300 && not str_eq(current, "ending") && not str_eq(current, "ended") { next = "failed" }
        }
        // Build SIP-level detail for the event payload
        let reason_phrase = sip_header(msg, "Reason")
        let remote_party = sip_header(msg, "P-Asserted-Identity")
        sip_detail = "\"sip_code\":" + string(code)
        if len(reason_phrase) > 0 { sip_detail = sip_detail + ",\"sip_reason\":\"" + maf_worker_json_escape(reason_phrase) + "\"" }
        if len(remote_party) > 0 { sip_detail = sip_detail + ",\"remote_party\":\"" + maf_worker_json_escape(remote_party) + "\"" }
        if code >= 200 && code < 300 && str_eq(cseq_method, "INVITE") {
            // NAT: fix SDP in cached response so subsequent MAF operations
            // (bridge, media) use the correct media address.
            let maf_public = env_get_or("SIP_PUBLIC_IP", "")
            let maf_resp = if len(maf_public) > 0 { nat_fix_sdp(msg, len(msg), maf_public) } else { msg }
            let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_response|" + call_id, maf_resp, 65536)
            // Store response SIP details in application_data for SDK inspection
            let resp_sdp = sip_body(maf_resp)
            let resp_contact = sip_contact_addr(sip_header(maf_resp, "Contact"))
            let resp_ua = sip_header(maf_resp, "User-Agent")
            let mut sip_json = "{\"remote_sdp\":\"" + maf_worker_json_escape(resp_sdp) + "\",\"remote_contact\":\"" + maf_worker_json_escape(resp_contact) + "\""
            if len(resp_ua) > 0 { sip_json = sip_json + ",\"remote_user_agent\":\"" + maf_worker_json_escape(resp_ua) + "\"" }
            sip_json = sip_json + "}"
            let _ = sql_exec_str4(db, "UPDATE maf_calls SET application_data = application_data || $2::jsonb WHERE call_id = $1", call_id, sip_json, "", "")
            // Include remote SDP and Contact in answered event
            let remote_sdp = sip_body(maf_resp)
            let remote_contact = sip_contact_addr(sip_header(maf_resp, "Contact"))
            if len(remote_sdp) > 0 && len(remote_sdp) < 8192 { sip_detail = sip_detail + ",\"remote_sdp\":\"" + maf_worker_json_escape(remote_sdp) + "\"" }
            if len(remote_contact) > 0 { sip_detail = sip_detail + ",\"remote_contact\":\"" + maf_worker_json_escape(remote_contact) + "\"" }
        }
        // Duration for ended/failed events
        if (str_eq(next, "ended") || str_eq(next, "failed")) && cmap_has(cache, "maf_invite|" + call_id) == 1 {
            let created_key = "maf_created_ms|" + call_id
            if cmap_has(cache, created_key) == 1 {
                let mut created_ms = 0
                match parse_int(cmap_get(cache, created_key)) { Ok(v) => { created_ms = v } Err(_) => {} }
                if created_ms > 0 {
                    let duration_ms = mono_ms() - created_ms
                    sip_detail = sip_detail + ",\"duration_ms\":" + string(duration_ms)
                }
            }
        }
    } else {
        let method = str_to_upper(str_trim_space(madis_method(msg)))
        if str_eq(method, "BYE") || str_eq(method, "CANCEL") {
            next = "ended"
            sip_detail = "\"ended_by\":\"" + maf_worker_json_escape(method) + "\""
            let created_key = "maf_created_ms|" + call_id
            if cmap_has(cache, created_key) == 1 {
                let mut created_ms = 0
                match parse_int(cmap_get(cache, created_key)) { Ok(v) => { created_ms = v } Err(_) => {} }
                if created_ms > 0 {
                    let duration_ms = mono_ms() - created_ms
                    sip_detail = sip_detail + ",\"duration_ms\":" + string(duration_ms)
                }
            }
        }
    }
    if str_eq(next, current) { return 0 }
    return maf_worker_call_state_detail(db, ok, tenant, call_id, next, trace, sip_detail)
}
