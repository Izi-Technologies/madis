// MAF worker-side command handoff.
//
// The admin process accepts authenticated commands into PostgreSQL. SIP
// workers claim those commands with a compare-and-set token, perform only
// bounded operations they own, and publish the resulting state transition.
// Unsupported operations fail explicitly; they are never reported complete.

fn maf_worker_json_escape(s: string) -> string {
    let mut b = str_builder()
    let mut i = 0
    while i < len(s) {
        let c = int(s[i])
        if c == 34 { builder_write(b, "\\\"") }
        else if c == 92 { builder_write(b, "\\\\") }
        else if c == 10 { builder_write(b, "\\n") }
        else if c == 13 { builder_write(b, "\\r") }
        else if c == 9 { builder_write(b, "\\t") }
        else if c < 32 || c == 127 { builder_write_byte(b, byte(32)) }
        else { builder_write_byte(b, byte(c)) }
        i = i + 1
    }
    return builder_string(b)
}

fn maf_worker_text_safe(s: string, max: int) -> int {
    if len(s) > max { return 0 }
    let mut i = 0
    while i < len(s) {
        let c = int(s[i])
        if c == 0 || c == 10 || c == 13 { return 0 }
        i = i + 1
    }
    return 1
}

fn maf_worker_tenant() -> string {
    let tenant = str_trim_space(env_get_or("SIP_MAF_TENANT", "default"))
    if len(tenant) < 1 || len(tenant) > 128 { return "default" }
    let mut i = 0
    while i < len(tenant) {
        let c = int(tenant[i])
        let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 58 || c == 64 || c == 95
        if not ok { return "default" }
        i = i + 1
    }
    return tenant
}

fn maf_worker_bootstrap(db: SqlDB) -> int {
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_calls (call_id TEXT PRIMARY KEY, tenant_id TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'created', version BIGINT NOT NULL DEFAULT 1, from_uri TEXT NOT NULL, to_uri TEXT NOT NULL, application_data JSONB NOT NULL DEFAULT '{}'::jsonb, created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW(), ended_at TIMESTAMP)")
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_channels (channel_id TEXT PRIMARY KEY, call_id TEXT NOT NULL REFERENCES maf_calls(call_id) ON DELETE CASCADE, tenant_id TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'created', direction TEXT NOT NULL, endpoint TEXT NOT NULL, version BIGINT NOT NULL DEFAULT 1, created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW())")
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_commands (command_id TEXT PRIMARY KEY, idempotency_key TEXT NOT NULL UNIQUE, tenant_id TEXT NOT NULL, call_id TEXT NOT NULL DEFAULT '', operation TEXT NOT NULL, request_json JSONB NOT NULL DEFAULT '{}'::jsonb, request_hash TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'accepted', resource_id TEXT NOT NULL DEFAULT '', trace_id TEXT NOT NULL DEFAULT '', error_code TEXT NOT NULL DEFAULT '', error_message TEXT NOT NULL DEFAULT '', claim_token TEXT NOT NULL DEFAULT '', claimed_at TIMESTAMP, created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW())")
    let _ = sql_exec_plain(db, "ALTER TABLE maf_commands ADD COLUMN IF NOT EXISTS request_hash TEXT NOT NULL DEFAULT ''")
    let _ = sql_exec_plain(db, "ALTER TABLE maf_commands ADD COLUMN IF NOT EXISTS claim_token TEXT NOT NULL DEFAULT ''")
    let _ = sql_exec_plain(db, "ALTER TABLE maf_commands ADD COLUMN IF NOT EXISTS claimed_at TIMESTAMP")
    let _ = sql_exec_plain(db, "CREATE TABLE IF NOT EXISTS maf_events (event_id TEXT PRIMARY KEY, sequence BIGSERIAL UNIQUE NOT NULL, tenant_id TEXT NOT NULL, event_type TEXT NOT NULL, event_version INT NOT NULL DEFAULT 1, call_id TEXT NOT NULL DEFAULT '', channel_id TEXT NOT NULL DEFAULT '', payload_json JSONB NOT NULL DEFAULT '{}'::jsonb, trace_id TEXT NOT NULL DEFAULT '', occurred_at TIMESTAMP DEFAULT NOW(), CONSTRAINT maf_event_payload_size CHECK (octet_length(payload_json::text) <= 65536))")
    let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_maf_commands_pending ON maf_commands (tenant_id, status, created_at)")
    let _ = sql_exec_plain(db, "CREATE INDEX IF NOT EXISTS idx_maf_events_tenant_sequence ON maf_events (tenant_id, sequence)")
    return 1
}

fn maf_worker_emit_event(db: SqlDB, ok: int, tenant: string, event_type: string, call_id: string, payload: string, trace: string) -> int {
    if ok == 0 || len(event_type) == 0 || len(event_type) > 128 || len(payload) == 0 || len(payload) > 65536 { return -1 }
    let event_id = sha256("madis.maf.event.v1|" + tenant + "|" + event_type + "|" + call_id + "|" + trace + "|" + string(now_ms()))
    let packed = "{\"event_id\":\"" + maf_worker_json_escape(event_id) + "\",\"tenant_id\":\"" + maf_worker_json_escape(tenant) + "\",\"event_type\":\"" + maf_worker_json_escape(event_type) + "\",\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"channel_id\":\"\",\"trace_id\":\"" + maf_worker_json_escape(trace) + "\",\"payload\":" + payload + "}"
    return sql_exec_str4(db, "INSERT INTO maf_events (event_id, tenant_id, event_type, event_version, call_id, channel_id, payload_json, trace_id) SELECT $4::jsonb->>'event_id', $4::jsonb->>'tenant_id', $4::jsonb->>'event_type', 1, $4::jsonb->>'call_id', $4::jsonb->>'channel_id', $4::jsonb->'payload', $4::jsonb->>'trace_id' ON CONFLICT (event_id) DO NOTHING", "", "", "", packed)
}

fn maf_worker_call_state(db: SqlDB, ok: int, tenant: string, call_id: string, state: string, trace: string) -> int {
    if ok == 0 || len(call_id) == 0 || len(state) == 0 { return 0 }
    let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if len(current) == 0 { return 0 }
    if str_eq(current, state) { return 1 }
    let rc = sql_exec_str4(db, "UPDATE maf_calls SET state = $2, version = version + 1, updated_at = NOW(), ended_at = CASE WHEN $2 IN ('ended','failed') THEN NOW() ELSE ended_at END WHERE tenant_id = $3 AND call_id = $1 AND state <> $2", call_id, state, tenant, "")
    if rc < 0 { return 0 }
    let payload = "{\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"state\":\"" + maf_worker_json_escape(state) + "\",\"source\":\"sip-worker\"}"
    let _ = maf_worker_emit_event(db, ok, tenant, "call." + state, call_id, payload, trace)
    return 1
}

fn maf_worker_command_state(db: SqlDB, ok: int, tenant: string, command_id: string, claim: string, status: string, code: string, message: string, call_id: string, trace: string) -> int {
    if ok == 0 || len(command_id) == 0 || len(claim) == 0 { return 0 }
    let packed = "{\"status\":\"" + maf_worker_json_escape(status) + "\",\"error_code\":\"" + maf_worker_json_escape(code) + "\",\"error_message\":\"" + maf_worker_json_escape(message) + "\"}"
    let rc = sql_exec_str4(db, "UPDATE maf_commands SET status = $4::jsonb->>'status', error_code = $4::jsonb->>'error_code', error_message = $4::jsonb->>'error_message', updated_at = NOW() WHERE tenant_id = $3 AND command_id = $1 AND claim_token = $2 AND status = 'processing'", command_id, claim, tenant, packed)
    if rc < 0 { return 0 }
    let event_type = if str_eq(status, "completed") { "command.completed" } else { "command.failed" }
    let payload = "{\"command_id\":\"" + maf_worker_json_escape(command_id) + "\",\"call_id\":\"" + maf_worker_json_escape(call_id) + "\",\"status\":\"" + maf_worker_json_escape(status) + "\",\"error_code\":\"" + maf_worker_json_escape(code) + "\"}"
    let _ = maf_worker_emit_event(db, ok, tenant, event_type, call_id, payload, trace)
    return 1
}

fn maf_worker_claim(db: SqlDB, ok: int, tenant: string, command_id: string, claim: string) -> int {
    if ok == 0 || len(command_id) == 0 || len(claim) == 0 { return 0 }
    let rc = sql_exec_str4(db, "UPDATE maf_commands SET status = 'processing', claim_token = $2, claimed_at = NOW(), updated_at = NOW() WHERE tenant_id = $3 AND command_id = $1 AND status = 'accepted'", command_id, claim, tenant, "")
    if rc < 0 { return 0 }
    let owner = sql_query_str2(db, "SELECT status FROM maf_commands WHERE tenant_id = $1 AND command_id = $2 AND claim_token = $3", tenant, command_id)
    if str_eq(owner, "processing") { return 1 }
    return 0
}

fn maf_worker_endpoint_ok(value: string) -> int {
    if len(value) == 0 || len(value) > 512 || sip_uri_syntax_valid(value) == 0 { return 0 }
    return 1
}

fn maf_worker_invite(call_id: string, from_uri: string, to_uri: string, node_id: string, node_addr: string) -> string {
    let branch = "z9hG4bK-maf-" + sha256(call_id + "|branch")[0:24]
    let tag = "maf-" + sha256(call_id + "|from")[0:20]
    let call_ref = call_id + "@" + node_id
    return "INVITE " + to_uri + " SIP/2.0\r\n" +
        "Via: SIP/2.0/UDP " + node_addr + ";branch=" + branch + "\r\n" +
        "Max-Forwards: 70\r\n" +
        "From: <" + from_uri + ">;tag=" + tag + "\r\n" +
        "To: <" + to_uri + ">\r\n" +
        "Call-ID: " + call_ref + "\r\n" +
        "CSeq: 1 INVITE\r\n" +
        "Contact: <sip:madis@" + node_addr + ">\r\n" +
        "Content-Length: 0\r\n\r\n"
}

fn maf_worker_start_call(db: SqlDB, ok: int, tenant: string, call_id: string, request: string, trace: string, cache: CMap, out_fd: int, node_id: string) -> int {
    let from_uri = json_get_string(request, "from")
    let to_uri = json_get_string(request, "to")
    if maf_worker_endpoint_ok(from_uri) == 0 || maf_worker_endpoint_ok(to_uri) == 0 { return 0 }
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    if len(node_addr) == 0 || len(node_addr) > 128 || maf_worker_text_safe(node_addr, 128) == 0 { return 0 }
    let invite = maf_worker_invite(call_id, from_uri, to_uri, node_id, node_addr)
    if sip_validate_message(invite, len(invite)) == 0 { return 0 }
    let target = sip_forward_first(to_uri, invite, cache, call_id, out_fd)
    if len(target) == 0 { return 0 }
    let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_invite|" + call_id, invite, 65536)
    let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_target|" + call_id, target, 65536)
    let _ = maf_worker_call_state(db, ok, tenant, call_id, "ringing", trace)
    return 1
}

fn maf_worker_cancel_call(db: SqlDB, ok: int, tenant: string, call_id: string, trace: string, cache: CMap, out_fd: int) -> int {
    let invite = cmap_get(cache, "maf_invite|" + call_id)
    let target = cmap_get(cache, "maf_target|" + call_id)
    if len(invite) == 0 || len(target) == 0 { return 0 }
    let cancel = sip_build_cancel(invite)
    if len(cancel) == 0 || sip_forward_target(target, cancel, "udp", cache, out_fd) == 0 { return 0 }
    let _ = maf_worker_call_state(db, ok, tenant, call_id, "ending", trace)
    return 1
}

fn maf_worker_bye_call(db: SqlDB, ok: int, tenant: string, call_id: string, trace: string, cache: CMap, out_fd: int) -> int {
    let invite = cmap_get(cache, "maf_invite|" + call_id)
    let response = cmap_get(cache, "maf_response|" + call_id)
    let fallback = cmap_get(cache, "maf_target|" + call_id)
    if len(invite) == 0 || len(response) == 0 { return 0 }
    let remote_to = sip_header(response, "To")
    let from_header = sip_header(invite, "From")
    let call_header = sip_header(invite, "Call-ID")
    if len(remote_to) == 0 || len(from_header) == 0 || len(call_header) == 0 { return 0 }
    let contact = sip_contact_addr(sip_header(response, "Contact"))
    let target = if maf_worker_endpoint_ok(contact) == 1 { contact } else { fallback }
    if len(target) == 0 || maf_worker_endpoint_ok(target) == 0 { return 0 }
    let node_addr = env_get_or("SIP_NODE_ADDR", "127.0.0.1")
    if maf_worker_text_safe(node_addr, 128) == 0 { return 0 }
    let branch = "z9hG4bK-maf-bye-" + sha256(call_id + "|bye|" + string(now_ms()))[0:24]
    let bye = "BYE " + target + " SIP/2.0\r\n" +
        "Via: SIP/2.0/UDP " + node_addr + ";branch=" + branch + "\r\n" +
        "Max-Forwards: 70\r\n" +
        "From: " + from_header + "\r\n" +
        "To: " + remote_to + "\r\n" +
        "Call-ID: " + call_header + "\r\n" +
        "CSeq: 2 BYE\r\n" +
        "Contact: <sip:madis@" + node_addr + ">\r\n" +
        "Content-Length: 0\r\n\r\n"
    if sip_validate_message(bye, len(bye)) == 0 { return 0 }
    if sip_forward_target(target, bye, "udp", cache, out_fd) == 0 { return 0 }
    let _ = maf_worker_call_state(db, ok, tenant, call_id, "ending", trace)
    return 1
}

fn maf_worker_execute(db: SqlDB, ok: int, tenant: string, operation: string, call_id: string, request: string, trace: string, cache: CMap, out_fd: int, node_id: string) string {
    if str_eq(operation, "calls.create") {
        return if maf_worker_start_call(db, ok, tenant, call_id, request, trace, cache, out_fd, node_id) == 1 { "ok" } else { "transport_or_endpoint_rejected|outbound INVITE was not sent" }
    }
    if str_eq(operation, "calls.reject") {
        return if maf_worker_cancel_call(db, ok, tenant, call_id, trace, cache, out_fd) == 1 { "ok" } else { "no_early_dialog|the worker has no cancellable early dialog" }
    }
    if str_eq(operation, "calls.hangup") {
        let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
        if str_eq(current, "ringing") {
            return if maf_worker_cancel_call(db, ok, tenant, call_id, trace, cache, out_fd) == 1 { "ok" } else { "dialog_unavailable|the worker could not send CANCEL" }
        }
        if str_eq(current, "answered") {
            return if maf_worker_bye_call(db, ok, tenant, call_id, trace, cache, out_fd) == 1 { "ok" } else { "dialog_unavailable|the worker could not build or send BYE" }
        }
        return "dialog_executor_pending|BYE execution requires confirmed-dialog ownership"
    }
    if str_eq(operation, "calls.answer") {
        let current = sql_query_str2(db, "SELECT state FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
        if str_eq(current, "answered") { return "ok" }
        return "answer_executor_pending|answer requires an owned inbound dialog"
    }
    if str_eq(operation, "calls.bridge") { return "bridge_executor_pending|bridge execution requires worker dialog and media ownership" }
    if str_eq(operation, "calls.media") { return "media_executor_pending|media execution requires worker media ownership" }
    return "unknown_operation|operation is not allowlisted"
}

fn maf_worker_poll(db: SqlDB, ok: int, cache: CMap, out_fd: int, node_id: string) -> int {
    if ok == 0 { return 0 }
    let tenant = maf_worker_tenant()
    let rows = sql_query_rows_str(db, "SELECT json_build_object('command_id',command_id,'tenant_id',tenant_id,'call_id',call_id,'operation',operation,'request_json',request_json::text,'trace_id',trace_id)::text FROM maf_commands WHERE tenant_id = $1 AND status = 'accepted' ORDER BY created_at ASC LIMIT 8", tenant)
    if sql_rows_ok(rows) == 0 { return 0 }
    let mut acted = 0
    while sql_rows_next(rows) == 1 {
        let row = sql_rows_str(rows, 0)
        let command_id = json_get_string(row, "command_id")
        let call_id = json_get_string(row, "call_id")
        let operation = json_get_string(row, "operation")
        let request = json_get_string(row, "request_json")
        let trace = json_get_string(row, "trace_id")
        if len(command_id) == 0 { continue }
        let claim = sha256("madis.maf.claim|" + node_id + "|" + command_id + "|" + string(now_ms()))
        if maf_worker_claim(db, ok, tenant, command_id, claim) == 0 { continue }
        let result = maf_worker_execute(db, ok, tenant, operation, call_id, request, trace, cache, out_fd, node_id)
        let result_parts = str_split(result, "|")
        let result_code = if len(result_parts) > 0 { result_parts[0] } else { "worker_error" }
        let result_message = if len(result_parts) > 1 { result_parts[1] } else { "worker execution failed" }
        if str_eq(result, "ok") {
            let _ = maf_worker_command_state(db, ok, tenant, command_id, claim, "completed", "", "", call_id, trace)
        } else {
            let _ = maf_worker_command_state(db, ok, tenant, command_id, claim, "failed", result_code, result_message, call_id, trace)
            if str_eq(operation, "calls.create") { let _ = maf_worker_call_state(db, ok, tenant, call_id, "failed", trace) }
        }
        acted = acted + 1
    }
    let _ = sql_rows_close(rows)
    return acted
}

fn maf_worker_sync_sip(db: SqlDB, ok: int, msg: string, cache: CMap) -> int {
    if ok == 0 { return 0 }
    let wire_call_id = sip_header(msg, "Call-ID")
    if len(wire_call_id) == 0 { return 0 }
    let mut call_id = wire_call_id
    let at = str_index(call_id, "@")
    if at > 0 { call_id = call_id[0:at] }
    let row = sql_query_str(db, "SELECT tenant_id || '|' || state || '|' || trace_id FROM maf_calls c LEFT JOIN maf_commands m ON m.call_id = c.call_id AND m.operation = 'calls.create' WHERE c.call_id = $1 ORDER BY m.created_at ASC LIMIT 1", call_id)
    if len(row) == 0 { return 0 }
    let parts = str_split(row, "|")
    if len(parts) < 3 { return 0 }
    let tenant = parts[0]
    let current = parts[1]
    let trace = parts[2]
    let mut next = current
    let cseq_parts = str_split(sip_header(msg, "CSeq"), " ")
    let cseq_method = if len(cseq_parts) >= 2 { str_to_upper(str_trim_space(cseq_parts[1])) } else { "" }
    if sip_is_response(msg) == 1 {
        let code = sip_status_code(msg)
        if str_eq(cseq_method, "BYE") || str_eq(cseq_method, "CANCEL") { next = "ended" }
        else {
            if code >= 180 && code < 200 { next = "ringing" }
            if code >= 200 && code < 300 { next = "answered" }
            if code >= 300 && not str_eq(current, "ending") && not str_eq(current, "ended") { next = "failed" }
        }
        if code >= 200 && code < 300 && str_eq(cseq_method, "INVITE") {
            let _ = bounded_cache_set(cache, "maf_cache_seq", "maf_cache_ring|", "maf_response|" + call_id, msg, 65536)
        }
    } else {
        let method = str_to_upper(str_trim_space(madis_method(msg)))
        if str_eq(method, "BYE") || str_eq(method, "CANCEL") { next = "ended" }
    }
    if str_eq(next, current) { return 0 }
    return maf_worker_call_state(db, ok, tenant, call_id, next, trace)
}
