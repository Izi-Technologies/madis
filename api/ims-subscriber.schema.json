{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madis.example/schemas/ims-subscriber-authorization.v1.json",
  "title": "Madis IMS subscriber authorization contract",
  "description": "Bounded HTTPS contract used by Madis to authorize an IMS REGISTER through an external subscriber service.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/provision" }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "service_profile": {
      "type": "object",
      "properties": {
        "associated_uris": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identity" }
        },
        "initial_filter_criteria": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identity" }
        }
      },
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "required": ["schema", "operation", "request_id", "public_identity", "private_identity", "visited_network", "server_name"],
      "properties": {
        "schema": { "const": "madis.ims.subscriber.authorization.v1" },
        "operation": { "const": "authorize-register" },
        "request_id": { "type": "string", "minLength": 32, "maxLength": 32 },
        "public_identity": { "$ref": "#/$defs/identity" },
        "private_identity": { "$ref": "#/$defs/identity", "maxLength": 1024 },
        "visited_network": { "$ref": "#/$defs/identity" },
        "server_name": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["schema", "operation", "request_id", "public_identity", "private_identity", "decision"],
      "properties": {
        "schema": { "const": "madis.ims.subscriber.authorization.v1" },
        "operation": { "const": "authorize-register" },
        "request_id": { "type": "string", "minLength": 32, "maxLength": 32 },
        "public_identity": { "$ref": "#/$defs/identity" },
        "private_identity": { "$ref": "#/$defs/identity", "maxLength": 1024 },
        "decision": { "enum": ["allow", "deny"] },
        "reason": { "type": "string", "maxLength": 256 },
        "assigned_server_name": { "$ref": "#/$defs/identity" },
        "service_profile": { "$ref": "#/$defs/service_profile" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "allow" } } },
          "then": { "required": ["assigned_server_name"] }
        }
      ]
    },
    "provision": {
      "type": "object",
      "required": ["schema", "operation", "public_identity", "private_identity", "assigned_server_name"],
      "properties": {
        "schema": { "const": "madis.ims.subscriber.provision.v1" },
        "operation": { "const": "provision" },
        "public_identity": { "$ref": "#/$defs/identity" },
        "private_identity": { "$ref": "#/$defs/identity", "maxLength": 1024 },
        "realm": { "$ref": "#/$defs/identity" },
        "assigned_server_name": { "$ref": "#/$defs/identity" },
        "service_profile": { "$ref": "#/$defs/service_profile" }
      },
      "additionalProperties": false
    }
  }
}
