FROM rust:1.94-bookworm AS mako-build

ARG MAKO_VERSION=0.4.18
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 --branch "v${MAKO_VERSION}" https://github.com/loreste/mako.git /mako
WORKDIR /mako
RUN cargo build --release

FROM debian:bookworm-slim AS madis-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang ca-certificates python3 libssl-dev libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=mako-build /mako/target/release/mako /usr/local/bin/mako
COPY --from=mako-build /mako/runtime /usr/local/lib/mako/runtime
COPY . /src
WORKDIR /src
RUN rm -f /src/main.c \
    && if ! MAKO_RUNTIME=/usr/local/lib/mako/runtime \
        /usr/local/bin/mako build --emit-c --release --strip --no-incremental \
        main.mko -o /tmp/madis-mako > /tmp/mako-build.log 2>&1; then \
        test -s /src/main.c || (cat /tmp/mako-build.log && exit 1); \
    fi \
    && cc -std=c11 -O3 -DNDEBUG -w \
        -I/usr/local/lib/mako/runtime -I/usr/include/postgresql \
        -DMAKO_HAS_OPENSSL -DMAKO_USE_OPENSSL -DMAKO_HAS_LIBPQ \
        /src/main.c /src/madis_memory.c -o /src/madis \
        -pthread -lm -ldl -lresolv -lssl -lcrypto -lpq

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libpq5 libssl3 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --no-create-home --shell /usr/sbin/nologin madis
COPY --from=madis-build /src/madis /usr/local/bin/madis
RUN chmod 0755 /usr/local/bin/madis
USER madis
EXPOSE 5060/udp 8080/tcp
ENTRYPOINT ["/usr/local/bin/madis"]
