// ============ SIP PARSING / HOP HELPERS ============
// Thin adapters over platform sip_* builtins (mako_sip.h / std/sip).
// Do NOT define free names that shadow builtins (sip_method, sip_branch,
// sip_strip_via, sip_via_host, sip_via_port, sip_dialog_id, …).

// Header value (msglen kept for call-site compatibility; platform is length-aware)
fn sip_hdr(msg: string, name: string, msglen: int) -> string {
    let _ = msglen
    return sip_header(msg, name)
}

// User/host from a name-addr or URI (From/To/Contact/R-URI)
fn sip_user(uri: string) -> string {
    return sip_uri_user(uri)
}

fn sip_domain(uri: string) -> string {
    return sip_uri_host(uri)
}

fn sip_contact_addr(c: string) -> string {
    let n = len(c)
    let mut i = 0
    while i < n {
        if int(c[i]) == 60 { i = i + 1; break }
        i = i + 1
    }
    let s = i
    while i < n {
        if int(c[i]) == 62 { return c[s:i] }
        i = i + 1
    }
    return c
}

// Split a Contact header on list commas without breaking a quoted display
// name or a comma inside a name-addr URI. str_split() is not sufficient for
// RFC 3261 §20.10 because Contact is a comma-separated header value with
// quoted-string and angle-bracketed components.
fn sip_split_contact_values(value: string) -> []string {
    let mut parts = make([]string, 0, 8)
    if len(value) == 0 { return parts }
    let mut start = 0
    let mut quoted = 0
    let mut angle = 0
    let mut escaped = 0
    let mut i = 0
    while i < len(value) {
        let c = int(value[i])
        if escaped == 1 {
            escaped = 0
        } else {
            if quoted == 1 && c == 92 {
                escaped = 1
            } else {
                if c == 34 { if quoted == 1 { quoted = 0 } else { quoted = 1 } }
                if quoted == 0 {
                    if c == 60 { angle = angle + 1 }
                    if c == 62 && angle > 0 { angle = angle - 1 }
                    if c == 44 && angle == 0 {
                        parts = append(parts, value[start:i])
                        start = i + 1
                    }
                }
            }
        }
        i = i + 1
    }
    parts = append(parts, value[start:])
    return parts
}

fn sip_route_target(route: string) -> string {
    let values = sip_split_contact_values(route)
    if len(values) == 0 { return "" }
    return sip_contact_addr(str_trim_space(values[0]))
}

// Remove only the proxy's top Via value. Some UAs serialize multiple Via hops
// as one comma-separated header line; removing the whole header would lose
// the caller's next hop and route the response back to the terminating UA.
fn sip_strip_top_via(msg: string) -> string {
    let first = str_index(msg, "\r\n")
    if first < 0 { return msg }
    let mut i = first + 2
    while i < len(msg) {
        let rel_end = str_index(msg[i:], "\r\n")
        if rel_end < 0 { return msg }
        let end = i + rel_end
        if end == i { return msg }
        let line = msg[i:end]
        let low = str_to_lower(line)
        let mut value_start = -1
        if str_has_prefix(low, "via:") { value_start = 4 }
        if str_has_prefix(low, "v:") { value_start = 2 }
        if value_start >= 0 {
            let value = line[value_start:]
            let comma = str_index(value, ",")
            if comma >= 0 {
                let rest = str_trim_space(value[comma + 1:])
                return msg[0:i] + "Via: " + rest + "\r\n" + msg[end + 2:]
            }
            return msg[0:i] + msg[end + 2:]
        }
        i = end + 2
    }
    return msg
}

// Proxy hop: top Via + Record-Route (RFC 3261 §16.6)
fn proxy_hop(msg: string, ip: string, port: int, tr: string) -> string {
    let mut out = sip_insert_via(msg, sip_via_value_rport(tr, ip, port, sip_branch()))
    out = sip_prepend_header(out, "Record-Route", sip_record_route(ip, port, tr))
    return out
}

// Via only (ACK/BYE mid-dialog style)
fn proxy_hop_via(msg: string, ip: string, port: int, tr: string) -> string {
    return sip_insert_via(msg, sip_via_value_rport(tr, ip, port, sip_branch()))
}

// Build a final response (optional To-tag)
fn sip_resp(st: int, reason: string, msg: string, n: int, tag: string) -> string {
    let _ = n
    if len(tag) > 0 {
        return sip_reply_with_to_tag(msg, st, reason, "", "", tag)
    }
    return sip_reply(msg, st, reason, "", "")
}

fn sip_options_response(msg: string) -> string {
    let allow = "Allow: INVITE, ACK, BYE, CANCEL, OPTIONS, REGISTER, PRACK, UPDATE\r\n"
        + "Accept: application/sdp, application/pidf+xml, application/simple-message-summary\r\n"
    return sip_reply(msg, 200, "OK", allow, "")
}

fn sip_method_not_allowed(msg: string) -> string {
    return sip_reply(msg, 405, "Method Not Allowed", "Allow: INVITE, ACK, BYE, CANCEL, OPTIONS, REGISTER, PRACK, UPDATE\r\n", "")
}

fn sip_cseq_valid(msg: string, is_response: int) -> int {
    let cseq = str_trim_space(sip_header(msg, "CSeq"))
    let mut i = 0
    while i < len(cseq) && (int(cseq[i]) == 32 || int(cseq[i]) == 9) { i = i + 1 }
    let seq_start = i
    while i < len(cseq) && int(cseq[i]) >= 33 && int(cseq[i]) != 127 { i = i + 1 }
    if i <= seq_start { return 0 }
    let mut seq = 0
    match parse_int(cseq[seq_start:i]) {
        Ok(v) => { seq = v }
        Err(_) => { return 0 }
    }
    if seq < 0 || seq > 2147483647 { return 0 }
    while i < len(cseq) && (int(cseq[i]) == 32 || int(cseq[i]) == 9) { i = i + 1 }
    let method_start = i
    while i < len(cseq) && int(cseq[i]) >= 33 && int(cseq[i]) != 127 { i = i + 1 }
    if i <= method_start { return 0 }
    let cseq_method = cseq[method_start:i]
    let mut mi = 0
    while mi < len(cseq_method) {
        if sip_token_char(int(cseq_method[mi])) == 0 { return 0 }
        mi = mi + 1
    }
    while i < len(cseq) && (int(cseq[i]) == 32 || int(cseq[i]) == 9) { i = i + 1 }
    if i != len(cseq) { return 0 }
    if is_response == 0 {
        let method = madis_method(msg)
        // SIP method names are case-sensitive.  A lowercase CSeq method is
        // not equivalent to the request-line method.
        if not str_eq(method, cseq_method) { return 0 }
    }
    return 1
}

fn sip_cseq_number(msg: string) -> string {
    let value = str_trim_space(sip_header(msg, "CSeq"))
    let mut i = 0
    while i < len(value) && (int(value[i]) == 32 || int(value[i]) == 9) { i = i + 1 }
    let start = i
    while i < len(value) && int(value[i]) >= 33 && int(value[i]) != 127 { i = i + 1 }
    if i <= start { return "" }
    return value[start:i]
}

fn sip_token_char(c: int) -> int {
    if c >= 48 && c <= 57 { return 1 }
    if c >= 65 && c <= 90 { return 1 }
    if c >= 97 && c <= 122 { return 1 }
    if c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 { return 1 }
    if c == 42 || c == 43 || c == 45 || c == 46 { return 1 }
    if c == 94 || c == 95 || c == 96 || c == 124 || c == 126 { return 1 }
    return 0
}

// Rebuild an INVITE-derived request while retaining the original Via branch.
// ACK for a non-2xx INVITE and CANCEL are in the same server transaction and
// therefore must use the INVITE branch, but each has its own CSeq method.
fn sip_build_transaction_request(msg: string, method: string) -> string {
    let header_end = str_index(msg, "\r\n\r\n")
    if header_end < 0 { return "" }
    let first_end = str_index(msg, "\r\n")
    if first_end < 0 { return "" }
    let first_space = str_index(msg[0:first_end], " ")
    if first_space < 0 { return "" }
    let mut out = method + msg[first_space:first_end] + "\r\n"
    let cseq_no = sip_cseq_number(msg)
    if len(cseq_no) == 0 { return "" }
    // header_end points at the CRLF that terminates the final header line;
    // include that delimiter in the scan window so the final line is seen.
    let scan_end = header_end + 2
    let mut line_start = first_end + 2
    while line_start < scan_end {
        let rel_end = str_index(msg[line_start:scan_end], "\r\n")
        if rel_end < 0 { return "" }
        let line_end = line_start + rel_end
        if line_end == line_start { break }
        let line = msg[line_start:line_end]
        let low = str_to_lower(line)
        if str_has_prefix(low, "cseq:") {
            out = out + "CSeq: " + cseq_no + " " + method + "\r\n"
        } else if str_has_prefix(low, "content-length:") || str_has_prefix(low, "l:") {
            let colon = str_index(line, ":")
            if colon >= 0 { out = out + line[0:colon + 1] + " 0\r\n" }
        } else {
            out = out + line + "\r\n"
        }
        line_start = line_end + 2
    }
    return out + "\r\n"
}

fn sip_build_ack_non2xx(invite: string) -> string {
    return sip_build_transaction_request(invite, "ACK")
}

fn sip_build_cancel(invite: string) -> string {
    return sip_build_transaction_request(invite, "CANCEL")
}

fn sip_hex_char(c: int) -> int {
    if c >= 48 && c <= 57 { return 1 }
    if c >= 65 && c <= 70 { return 1 }
    if c >= 97 && c <= 102 { return 1 }
    return 0
}

fn sip_range_eq_ci(text: string, start: int, end: int, literal: string) -> int {
    if start < 0 || end < start || end - start != len(literal) { return 0 }
    let mut i = 0
    while i < len(literal) {
        let a = int(text[start + i])
        let b = int(literal[i])
        let aa = if a >= 65 && a <= 90 { a + 32 } else { a }
        let bb = if b >= 65 && b <= 90 { b + 32 } else { b }
        if aa != bb { return 0 }
        i = i + 1
    }
    return 1
}

fn sip_range_int(text: string, start: int, end: int) -> int {
    if start < 0 || end <= start || end > len(text) { return -1 }
    let mut value = 0
    let mut i = start
    while i < end {
        let c = int(text[i])
        if c < 48 || c > 57 { return -1 }
        value = value * 10 + c - 48
        if value > 2147483647 { return -1 }
        i = i + 1
    }
    return value
}

fn sip_uri_port_range_valid(text: string, start: int, end: int) -> int {
    let value = sip_range_int(text, start, end)
    if value <= 0 || value > 65535 { return 0 }
    return 1
}

fn sip_uri_percent_valid(value: string) -> int {
    let mut i = 0
    while i < len(value) {
        let c = int(value[i])
        if c == 37 {
            if i + 2 >= len(value) || sip_hex_char(int(value[i + 1])) == 0 || sip_hex_char(int(value[i + 2])) == 0 { return 0 }
            i = i + 3
        } else {
            if c == 0 || c == 13 || c == 10 || c == 127 || c < 32 { return 0 }
            i = i + 1
        }
    }
    return 1
}

fn sip_uri_port_valid(value: string) -> int {
    if len(value) == 0 { return 0 }
    let mut i = 0
    while i < len(value) {
        let c = int(value[i])
        if c < 48 || c > 57 { return 0 }
        i = i + 1
    }
    match parse_int(value) {
        Ok(v) => { if v <= 0 || v > 65535 { return 0 } }
        Err(_) => { return 0 }
    }
    return 1
}

// Validate a SIP sent-by/URI hostport, including the mandatory brackets for
// IPv6 literals.  Hostnames are deliberately kept to RFC 3261 hostname/IPv4
// characters; escaped bytes belong in user/parameter values, not the host.
fn sip_hostport_valid(value: string) -> int {
    let hostport = str_trim_space(value)
    if len(hostport) == 0 { return 0 }
    if int(hostport[0]) == 91 {
        let rb = str_index(hostport, "]")
        if rb <= 1 { return 0 }
        let mut i = 1
        while i < rb {
            let c = int(hostport[i])
            if not ((c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) || c == 58 || c == 46) { return 0 }
            i = i + 1
        }
        if rb + 1 == len(hostport) { return 1 }
        if int(hostport[rb + 1]) != 58 { return 0 }
        return sip_uri_port_valid(hostport[rb + 2:])
    }
    let mut colon = -1
    let mut colon_count = 0
    let mut i = 0
    while i < len(hostport) {
        if int(hostport[i]) == 58 { colon = i; colon_count = colon_count + 1 }
        i = i + 1
    }
    if colon_count > 1 { return 0 }
    let host = if colon >= 0 { hostport[0:colon] } else { hostport }
    if len(host) == 0 { return 0 }
    if colon >= 0 && sip_uri_port_valid(hostport[colon + 1:]) == 0 { return 0 }
    if int(host[0]) == 45 || int(host[len(host) - 1]) == 45 { return 0 }
    let mut previous_dot = 0
    i = 0
    while i < len(host) {
        let c = int(host[i])
        if c == 46 {
            if previous_dot == 1 { return 0 }
            previous_dot = 1
        } else {
            if not ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45) { return 0 }
            previous_dot = 0
        }
        i = i + 1
    }
    return 1
}

fn sip_uri_component_valid(value: string) -> int {
    if len(value) == 0 { return 0 }
    if sip_uri_percent_valid(value) == 0 { return 0 }
    let mut i = 0
    while i < len(value) {
        let c = int(value[i])
        if c == 32 || c == 9 || c == 13 || c == 10 || c == 60 || c == 62 { return 0 }
        i = i + 1
    }
    return 1
}

fn sip_uri_syntax_valid(uri: string) -> int {
    if sip_uri_percent_valid(uri) == 0 { return 0 }
    let colon = str_index(uri, ":")
    if colon <= 0 { return 0 }
    let scheme = str_to_lower(uri[0:colon])
    if not str_eq(scheme, "sip") && not str_eq(scheme, "sips") { return 0 }
    let rest = uri[colon + 1:]
    let semi = str_index(rest, ";")
    let question = str_index(rest, "?")
    let mut authority_end = len(rest)
    if semi >= 0 && semi < authority_end { authority_end = semi }
    if question >= 0 && question < authority_end { authority_end = question }
    let authority = rest[0:authority_end]
    if len(authority) == 0 { return 0 }

    let mut at = -1
    let mut i = 0
    while i < len(authority) {
        if int(authority[i]) == 64 { at = i }
        i = i + 1
    }
    if at == 0 { return 0 }
    if at >= 0 {
        if sip_uri_component_valid(authority[0:at]) == 0 { return 0 }
    }
    let hostport = if at >= 0 { authority[at + 1:] } else { authority }
    if sip_hostport_valid(hostport) == 0 { return 0 }

    if semi >= 0 {
        let param_end = if question >= 0 && question > semi { question } else { len(rest) }
        let param_text = rest[semi + 1:param_end]
        if len(param_text) == 0 { return 0 }
        if sip_uri_params_valid(param_text) == 0 { return 0 }
    }
    if question >= 0 {
        let query = rest[question + 1:]
        if len(query) == 0 { return 0 }
        if sip_uri_query_valid(query) == 0 { return 0 }
    }
    return 1
}

fn sip_uri_range_component_valid(text: string, start: int, end: int) -> int {
    if start < 0 || end <= start || end > len(text) { return 0 }
    let mut i = start
    while i < end {
        let c = int(text[i])
        if c == 37 {
            if i + 2 >= end || sip_hex_char(int(text[i + 1])) == 0 || sip_hex_char(int(text[i + 2])) == 0 { return 0 }
            i = i + 3
        } else {
            if c == 32 || c == 9 || c == 13 || c == 10 || c == 60 || c == 62 { return 0 }
            i = i + 1
        }
    }
    return 1
}

fn sip_uri_range_token_valid(text: string, start: int, end: int) -> int {
    if start < 0 || end <= start || end > len(text) { return 0 }
    let mut i = start
    while i < end {
        if sip_token_char(int(text[i])) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Scan URI parameter pairs without allocating a split array. This matters on
// the ingress path, where a hostile peer can repeat validation thousands of
// times per second.
fn sip_uri_params_valid(text: string) -> int {
    let mut valid = 1
    let mut start = 0
    while start < len(text) && valid == 1 {
        let mut end = start
        while end < len(text) && int(text[end]) != 59 { end = end + 1 }
        let mut eq = -1
        let mut i = start
        while i < end {
            if int(text[i]) == 61 { eq = i; break }
            i = i + 1
        }
        let name_end = if eq >= 0 { eq } else { end }
        if sip_uri_range_token_valid(text, start, name_end) == 0 { valid = 0 }
        if valid == 1 && eq >= 0 && sip_uri_range_component_valid(text, eq + 1, end) == 0 { valid = 0 }
        if end >= len(text) { break }
        start = end + 1
        if start >= len(text) { valid = 0 }
    }
    return valid
}

fn sip_uri_query_valid(text: string) -> int {
    let mut valid = 1
    let mut start = 0
    while start < len(text) && valid == 1 {
        let mut end = start
        while end < len(text) && int(text[end]) != 38 { end = end + 1 }
        let mut eq = -1
        let mut i = start
        while i < end {
            if int(text[i]) == 61 { eq = i; break }
            i = i + 1
        }
        if eq <= start || sip_uri_range_token_valid(text, start, eq) == 0 { valid = 0 }
        if valid == 1 && sip_uri_range_component_valid(text, eq + 1, end) == 0 { valid = 0 }
        if end >= len(text) { break }
        start = end + 1
        if start >= len(text) { valid = 0 }
    }
    return valid
}

fn sip_request_uri_valid(msg: string) -> int {
    let uri = sip_request_uri(msg)
    if len(uri) == 0 { return 0 }
    if str_eq(uri, "*") {
        if str_eq(str_to_upper(madis_method(msg)), "OPTIONS") { return 1 }
        return 0
    }
    return sip_uri_syntax_valid(uri)
}

fn sip_via_valid(msg: string) -> int {
    let via = sip_header(msg, "Via")
    if len(via) == 0 { return 0 }
    let values = sip_split_contact_values(via)
    if len(values) == 0 { return 0 }
    let top = str_trim_space(values[0])
    let space = str_index(top, " ")
    if space <= 0 || space + 1 >= len(top) { return 0 }
    let protocol = str_to_lower(top[0:space])
    if not str_has_prefix(protocol, "sip/2.0/") { return 0 }
    let transport = protocol[8:]
    if len(transport) == 0 { return 0 }
    let mut ti = 0
    while ti < len(transport) {
        if sip_token_char(int(transport[ti])) == 0 { return 0 }
        ti = ti + 1
    }
    let rest = str_trim_space(top[space + 1:])
    let valid = sip_via_params_valid(rest)
    return valid
}

fn sip_via_params_valid(rest: string) -> int {
    let mut valid = 1
    let mut branch = ""
    let first_end = str_index(rest, ";")
    if first_end < 0 { return 0 }
    let mut start = first_end + 1
    while start < len(rest) && valid == 1 {
        let mut end = start
        while end < len(rest) && int(rest[end]) != 59 { end = end + 1 }
        let mut left = start
        while left < end && (int(rest[left]) == 32 || int(rest[left]) == 9) { left = left + 1 }
        let mut right = end
        while right > left && (int(rest[right - 1]) == 32 || int(rest[right - 1]) == 9) { right = right - 1 }
        let mut eq = -1
        let mut i = left
        while i < right {
            if int(rest[i]) == 61 { eq = i; break }
            i = i + 1
        }
        let mut name_end = if eq >= 0 { eq } else { right }
        while name_end > left && (int(rest[name_end - 1]) == 32 || int(rest[name_end - 1]) == 9) { name_end = name_end - 1 }
        if sip_uri_range_token_valid(rest, left, name_end) == 0 { valid = 0 }
        let name_is_branch = sip_range_eq_ci(rest, left, name_end, "branch")
        let name_is_rport = sip_range_eq_ci(rest, left, name_end, "rport")
        let name_is_ttl = sip_range_eq_ci(rest, left, name_end, "ttl")
        let name_is_received = sip_range_eq_ci(rest, left, name_end, "received")
        let name_is_maddr = sip_range_eq_ci(rest, left, name_end, "maddr")
        if valid == 1 && eq >= 0 {
            let mut value_start = eq + 1
            while value_start < right && (int(rest[value_start]) == 32 || int(rest[value_start]) == 9) { value_start = value_start + 1 }
            if value_start >= right || sip_uri_range_component_valid(rest, value_start, right) == 0 { valid = 0 }
            if name_is_branch == 1 { branch = str_trim_space(rest[value_start:right]) }
            if name_is_rport == 1 && sip_uri_port_range_valid(rest, value_start, right) == 0 { valid = 0 }
            if name_is_ttl == 1 {
                let ttl = sip_range_int(rest, value_start, right)
                if ttl < 0 || ttl > 255 { valid = 0 }
            }
            if (name_is_received == 1 || name_is_maddr == 1) && sip_hostport_valid(str_trim_space(rest[value_start:right])) == 0 { valid = 0 }
        } else if name_is_branch == 1 {
            valid = 0
        }
        if end >= len(rest) { break }
        start = end + 1
    }
    if valid == 1 && len(branch) > 0 {
        let branch_low = str_to_lower(branch)
        if len(branch) <= 7 || not str_has_prefix(branch_low, "z9hg4bk") { valid = 0 }
    }
    return valid
}

fn sip_call_id_valid(value: string) -> int {
    let v = str_trim_space(value)
    if len(v) == 0 { return 0 }
    let mut i = 0
    while i < len(v) {
        let c = int(v[i])
        if c == 32 || c == 9 || c == 13 || c == 10 || c == 0 || c == 127 || c < 32 { return 0 }
        i = i + 1
    }
    return 1
}

fn sip_name_addr_valid(value: string) -> int {
    let v = str_trim_space(value)
    if len(v) == 0 { return 0 }
    let lt = str_index(v, "<")
    let gt = str_index(v, ">")
    let mut uri = v
    if lt >= 0 {
        if gt <= lt || gt + 1 < len(v) && str_index(v[gt + 1:], "<") >= 0 { return 0 }
        uri = v[lt + 1:gt]
    } else {
        let semi = str_index(v, ";")
        if semi >= 0 { uri = v[0:semi] }
    }
    return sip_uri_syntax_valid(str_trim_space(uri))
}

// Cheap ingress validation before any DB lookup or header allocation. Stream
// workers already frame messages, but UDP and WebSocket input need the same
// limits and control-character checks.
fn sip_ingress_header_safe(msg: string, n: int) -> int {
    if n < 1 || n > 1048576 { return 0 }
    let mut i = 0
    while i + 3 < n {
        if int(msg[i]) == 13 && int(msg[i + 1]) == 10 && int(msg[i + 2]) == 13 && int(msg[i + 3]) == 10 {
            return 1
        }
        let c = int(msg[i])
        if c == 0 || c == 127 || (c < 32 && c != 9 && c != 10 && c != 13) { return 0 }
        i = i + 1
    }
    return 0
}

fn madis_method(msg: string) -> string {
    let end = str_index(msg, " ")
    if end <= 0 { return "" }
    return msg[0:end]
}

fn madis_header_name_matches(msg: string, start: int, width: int, target: string) -> int {
    if width == len(target) {
        let mut i = 0
        while i < width {
            let mut a = int(msg[start + i])
            let mut b = int(target[i])
            if a >= 65 && a <= 90 { a = a + 32 }
            if b >= 65 && b <= 90 { b = b + 32 }
            if a != b { return 0 }
            i = i + 1
        }
        return 1
    }
    if width != 1 { return 0 }
    let c = int(msg[start])
    if str_eq(target, "From") && (c == 70 || c == 102) { return 1 }
    if str_eq(target, "To") && (c == 84 || c == 116) { return 1 }
    if str_eq(target, "Call-ID") && (c == 73 || c == 105) { return 1 }
    if str_eq(target, "Content-Length") && (c == 76 || c == 108) { return 1 }
    return 0
}

fn madis_header_count(msg: string, target: string) -> int {
    let mut header_end = str_index(msg, "\r\n\r\n")
    if header_end >= 0 { header_end = header_end + 2 }
    let first_crlf = str_index(msg, "\r\n")
    if header_end <= first_crlf || first_crlf < 0 { return 0 }
    let mut line_start = first_crlf + 2
    let mut count = 0
    while line_start < header_end {
        let mut line_end = line_start
        while line_end < header_end && not (int(msg[line_end]) == 13 && int(msg[line_end + 1]) == 10) {
            line_end = line_end + 1
        }
        if line_end >= header_end { return count }
        if int(msg[line_start]) != 32 && int(msg[line_start]) != 9 {
            let mut colon = line_start
            while colon < line_end && int(msg[colon]) != 58 { colon = colon + 1 }
            if colon < line_end && madis_header_name_matches(msg, line_start, colon - line_start, target) == 1 {
                count = count + 1
            }
        }
        line_start = line_end + 2
    }
    return count
}

// Validate header-line framing and token syntax without building a line array.
fn sip_header_block_valid(msg: string, header_end: int) -> int {
    let first_crlf = str_index(msg, "\r\n")
    if first_crlf < 0 || first_crlf >= header_end { return 0 }
    let mut line_start = first_crlf + 2
    let mut header_count = 1
    let mut have_header = 0
    while line_start < header_end {
        let mut line_end = line_start
        while line_end < header_end {
            if int(msg[line_end]) == 13 && int(msg[line_end + 1]) == 10 { break }
            line_end = line_end + 1
        }
        if line_end >= header_end || int(msg[line_end]) != 13 || int(msg[line_end + 1]) != 10 { return 0 }
        let width = line_end - line_start
        if width <= 0 || width > 8192 { return 0 }
        let first = int(msg[line_start])
        if first == 32 || first == 9 {
            if have_header == 0 { return 0 }
        } else {
            let mut colon = -1
            let mut i = line_start
            while i < line_end {
                if int(msg[i]) == 58 { colon = i; break }
                i = i + 1
            }
            if colon <= line_start { return 0 }
            let name_width = colon - line_start
            i = line_start
            while i < colon {
                if sip_token_char(int(msg[i])) == 0 { return 0 }
                i = i + 1
            }
            if name_width <= 0 { return 0 }
            have_header = 1
        }
        header_count = header_count + 1
        line_start = line_end + 2
    }
    if line_start != header_end || header_count < 2 || header_count > 129 { return 0 }
    return 1
}

fn sip_validate_message(msg: string, n: int) -> int {
    if n < 12 || n > 65535 { return 0 }
    if sip_ingress_header_safe(msg, n) == 0 { return 0 }
    if sip_ok(msg) == 0 { return 0 }
    let mut header_end = -1
    let mut i = 0
    while i + 3 < n {
        if int(msg[i]) == 13 && int(msg[i + 1]) == 10 && int(msg[i + 2]) == 13 && int(msg[i + 3]) == 10 {
            // Include the terminating CRLF of the final header line. The
            // validation helpers use this as an exclusive line boundary.
            header_end = i + 2
            break
        }
        i = i + 1
    }
    if header_end < 0 { return 0 }

    let response = sip_is_response(msg)
    let version = sip_version(msg)
    if not str_eq(version, "SIP/2.0") { return 0 }
    if response == 1 {
        let code = sip_status_code(msg)
        if code < 100 || code > 699 { return 0 }
    } else {
        if sip_request_uri_valid(msg) == 0 { return 0 }
    }
    let via = sip_header(msg, "Via")
    let from = sip_header(msg, "From")
    let to = sip_header(msg, "To")
    let call_id = sip_header(msg, "Call-ID")
    if len(via) == 0 || len(from) == 0 || len(to) == 0 || len(call_id) == 0 { return 0 }
    if sip_name_addr_valid(from) == 0 { return 0 }
    if sip_name_addr_valid(to) == 0 { return 0 }
    if sip_call_id_valid(call_id) == 0 { return 0 }
    if sip_cseq_valid(msg, response) == 0 { return 0 }
    if sip_via_valid(msg) == 0 { return 0 }

    // These are singleton headers in a SIP message.  Accepting duplicates
    // would make different stacks validate different identity/transaction
    // contexts because the platform accessor returns only one occurrence.
    if sip_header_block_valid(msg, header_end) == 0 { return 0 }
    if madis_header_count(msg, "From") != 1 || madis_header_count(msg, "To") != 1 || madis_header_count(msg, "Call-ID") != 1 || madis_header_count(msg, "CSeq") != 1 { return 0 }
    if madis_header_count(msg, "Max-Forwards") > 1 { return 0 }

    // Reject NUL and other C0 characters in the start line/header area. HTAB
    // is valid horizontal whitespace; the body is left to SDP/RTP handling.
    i = 0
    while i < header_end {
        let c = int(msg[i])
        if c == 0 || c == 127 || (c < 32 && c != 9 && c != 10 && c != 13) { return 0 }
        i = i + 1
    }
    let body = sip_body(msg)
    let content_length_count = madis_header_count(msg, "Content-Length")
    if content_length_count == 0 { return 0 }
    let mut declared_length = -1
    let mut content_i = 0
    while content_i < content_length_count {
        let raw_length = str_trim_space(sip_header_n(msg, "Content-Length", content_i))
        if len(raw_length) == 0 { return 0 }
        match parse_int(raw_length) {
            Ok(v) => {
                if v < 0 || v > 1048576 { return 0 }
                if declared_length >= 0 && declared_length != v { return 0 }
                declared_length = v
            }
            Err(_) => { return 0 }
        }
        content_i = content_i + 1
    }
    if declared_length != len(body) { return 0 }
    return 1
}
