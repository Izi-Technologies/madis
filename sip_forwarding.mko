// Target resolution, next-hop authority, and forking helpers.

fn sip_target_authority(target: string) -> string {
    let mut t = target
    let lt = str_index(t, "<")
    if lt >= 0 {
        let gt = str_index(t, ">")
        if gt > lt { t = t[lt + 1:gt] }
    }
    // Fast path: most URIs are lowercase. Only str_to_lower the scheme (≤6 bytes).
    if str_has_prefix(t, "sip:") { t = t[4:] }
    else if str_has_prefix(t, "sips:") { t = t[5:] }
    else if str_has_prefix(t, "tcp://") { t = t[6:] }
    else if str_has_prefix(t, "tls://") { t = t[6:] }
    else if str_has_prefix(t, "ws://") { t = t[5:] }
    else if str_has_prefix(t, "wss://") { t = t[6:] }
    else if len(t) >= 4 {
        let mut scheme_len = 6
        if len(t) < 6 { scheme_len = len(t) }
        let low = str_to_lower(t[0:scheme_len])
        if str_has_prefix(low, "sip:") { t = t[4:] }
        else if str_has_prefix(low, "sips:") { t = t[5:] }
        else if str_has_prefix(low, "tcp://") { t = t[6:] }
        else if str_has_prefix(low, "tls://") { t = t[6:] }
        else if str_has_prefix(low, "ws://") { t = t[5:] }
        else if str_has_prefix(low, "wss://") { t = t[6:] }
    }
    let at = str_index(t, "@")
    if at >= 0 { t = t[at + 1:] }
    let semi = str_index(t, ";")
    if semi >= 0 { t = t[0:semi] }
    let query = str_index(t, "?")
    if query >= 0 { t = t[0:query] }
    let slash = str_index(t, "/")
    if slash >= 0 { t = t[0:slash] }
    return t
}

fn sip_target_host(target: string) -> string {
    let t = sip_target_authority(target)
    if len(t) == 0 { return "" }
    if int(t[0]) == 91 {
        let close = str_index(t, "]")
        if close > 1 { return t[1:close] }
    }
    let colon = str_index(t, ":")
    if colon >= 0 {
        // An unbracketed IPv6 literal is invalid in a SIP hostport, but
        // retaining it here lets the transport layer fail closed rather than
        // truncating it to the first hextet.
        if str_index(t[colon + 1:], ":") >= 0 { return t }
        return t[0:colon]
    }
    return t
}

// Returns 1 for a valid explicit port, 0 when no port is present, and -1 for
// a malformed/out-of-range explicit port. Callers must reject -1 instead of
// silently falling back to a different service port.
fn sip_target_port_state(target: string) -> int {
    let t = sip_target_authority(target)
    if len(t) == 0 { return 0 }
    let mut colon = str_index(t, ":")
    if int(t[0]) == 91 {
        let close = str_index(t, "]")
        if close >= 0 && close + 1 < len(t) && int(t[close + 1]) == 58 { colon = close + 1 }
        else { colon = -1 }
    } else if colon >= 0 && str_index(t[colon + 1:], ":") >= 0 {
        colon = -1
    }
    if colon < 0 { return 0 }
    match parse_int(t[colon + 1:]) {
        Ok(v) => { if v > 0 && v <= 65535 { return 1 } }
        Err(_) => {}
    }
    return -1
}

fn sip_target_port(target: string, default_port: int) -> int {
    let t = sip_target_authority(target)
    let state = sip_target_port_state(target)
    if state == 0 { return default_port }
    if state < 0 { return -1 }
    let mut colon = str_index(t, ":")
    if len(t) > 0 && int(t[0]) == 91 {
        let close = str_index(t, "]")
        colon = close + 1
    }
    let mut port = -1
    match parse_int(t[colon + 1:]) {
        Ok(v) => { port = v }
        Err(_) => {}
    }
    return port
}

fn sip_forward_udp(target: string, msg: string, cache: CMap, out_fd: int) -> int {
    let host = sip_target_host(target)
    let port = sip_target_port(target, 5060)
    if len(host) == 0 || port <= 0 { return 0 }
    if sip_outbound_target_safe(host) == 0 { return 0 }
    // Reuse the worker's UDP socket when available. Creating and closing an
    // ephemeral socket for every forwarded request is expensive under load.
    let mut fd = out_fd
    let mut owns_fd = 0
    if fd < 0 {
        fd = nb_udp_bind(0)
        owns_fd = 1
    }
    if fd < 0 { return 0 }
    let mut sent = udp_send_to(fd, host, port, msg)
    if owns_fd == 0 && sent < 0 {
        let retry_fd = nb_udp_bind(0)
        if retry_fd >= 0 {
            sent = udp_send_to(retry_fd, host, port, msg)
            let _ = udp_close(retry_fd)
        }
    }
    if owns_fd == 1 { let _ = udp_close(fd) }
    if sent >= 0 {
        cmap_set(cache, "last_forward_target", host + ":" + string(port))
        let _ = log_debug_if(cache, "transport", "udp-sent host=" + host + " port=" + string(port))
        return 1
    }
    return 0
}

fn sip_forward_first(targets: string, msg: string, cache: CMap, cid: string, out_fd: int) -> string {
    let target_list = str_split(targets, ",")
    if len(target_list) == 0 { return "" }
    let primary = str_trim_space(target_list[0])
    if len(primary) == 0 { return "" }
    let ok = sip_forward_target(primary, msg, "udp", cache, out_fd)
    if ok == 1 {
        let method = madis_method(msg)
        if not str_eq(method, "ACK") && not str_eq(method, "") {
            let _ = sip_client_txn_record(msg, primary, sip_transport_param(primary, "udp"), out_fd, cache)
        }
        let _ = bounded_cache_set(cache, "dispatch_seq", "dispatch_ring|", "dispatch|" + cid, targets, 65536)
        let _ = bounded_cache_set(cache, "dispatch_idx_seq", "dispatch_idx_ring|", "dispatch_idx|" + cid, "0", 65536)
        return primary
    }
    return ""
}

fn sip_forward_fork(targets: string, base_msg: string, ip: string, port: int, tr: string, public_ip: string, cache: CMap, cid: string, out_fd: int) -> string {
    let target_list = str_split(targets, ",")
    let mut primary = ""
    let mut expected = 0
    let mut i = 0
    while i < len(target_list) {
        let target = str_trim_space(target_list[i])
        if len(target) > 0 {
            let out_tr = sip_transport_param(target, tr)
            let raw = proxy_hop(base_msg, ip, port, out_tr)
            let fwd = nat_fix_sdp(raw, len(raw), public_ip)
            if sip_forward_target(target, fwd, out_tr, cache, out_fd) == 1 {
                if len(primary) == 0 { primary = target }
                let branch = sip_via_branch(sip_header(fwd, "Via"))
                if sip_fork_register_branch(cid, branch, target, cache) == 1 {
                    let _ = sip_fork_store_request(cid, branch, fwd, cache)
                    expected = expected + 1
                }
            }
        }
        i = i + 1
    }
    if expected > 0 {
        cmap_set(cache, "fork_expected|" + cid, string(expected))
        cmap_set(cache, "fork_done|" + cid, "0")
        cmap_set(cache, "fork_complete|" + cid, "0")
    }
    return primary
}

// RFC 3261 §16.7: after a fork produces a 2xx, cancel all still-pending
// branches. The CANCEL is derived from the exact forwarded INVITE so it uses
// the same branch and hop-by-hop transaction identifiers.
fn sip_send_fork_cancels(cid: string, except_branch: string, cache: CMap, out_fd: int) -> int {
    let list_key = "fork_branches|" + cid
    if cmap_has(cache, list_key) == 0 { return 0 }
    let branches = str_split(cmap_get(cache, list_key), ",")
    let mut sent = 0
    let mut i = 0
    while i < len(branches) {
        let branch = str_trim_space(branches[i])
        if len(branch) > 0 && not str_eq(branch, except_branch) && sip_fork_is_pending(cid, branch, cache) == 1 {
            let req_key = "fork_request|" + cid + "|" + branch
            if cmap_has(cache, req_key) == 1 {
                let cancel = sip_build_cancel(cmap_get(cache, req_key))
                let target = cmap_get(cache, "fork_target|" + cid + "|" + branch)
                let tr = sip_transport_param(target, "udp")
                if len(cancel) > 0 && len(target) > 0 {
                    let _ = sip_forward_target(target, cancel, tr, cache, out_fd)
                    sent = sent + 1
                }
                let _ = sip_fork_mark_cancelled(cid, branch, cache)
            }
        }
        i = i + 1
    }
    return sent
}

// Reply next-hop after our Via is stripped (RFC 3261 / 3581)
fn proxy_reply_host(msg: string) -> string {
    return sip_msg_response_host(msg)
}

fn proxy_reply_port(msg: string) -> int {
    let p = sip_msg_response_port(msg)
    if p > 0 { return p }
    return 5060
}

fn sip_proxy_hop_with_branch(msg: string, ip: string, port: int, tr: string, branch: string) -> string {
    return sip_insert_via(msg, sip_via_value_rport(tr, ip, port, branch))
}
