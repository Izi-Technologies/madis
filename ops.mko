// ============ OBSERVABILITY / ADMIN PLANE ============

// ============ CONFIG VALIDATION ============
// Validates environment variables before the worker starts. Returns a list
// of errors as a newline-separated string. Empty string = valid.

fn proxy_validate_config() -> string {
    let mut errors = ""
    let mut b = str_builder()

    // Required for production
    let db = env_get_or("SIP_DB_URL", "")
    if len(db) == 0 {
        builder_write(b, "WARNING: SIP_DB_URL not set — running in standalone/memory mode\n")
    }

    // Port ranges
    let ports = ["SIP_UDP_PORT", "SIP_TCP_PORT", "SIP_TLS_PORT", "SIP_WSS_PORT", "SIP_ADMIN_PORT"]
    let mut pi = 0
    while pi < len(ports) {
        let raw = env_get_or(ports[pi], "")
        if len(raw) > 0 {
            let mut valid = 0
            match parse_int(raw) { Ok(v) => { if v > 0 && v <= 65535 { valid = 1 } } Err(_) => {} }
            if valid == 0 { builder_write(b, "ERROR: " + ports[pi] + "=" + raw + " is not a valid port (1-65535)\n") }
        }
        pi = pi + 1
    }

    // Worker counts
    let workers = ["SIP_UDP_WORKERS", "SIP_TCP_WORKERS", "SIP_TLS_WORKERS", "SIP_WSS_WORKERS"]
    let mut wi = 0
    while wi < len(workers) {
        let raw = env_get_or(workers[wi], "")
        if len(raw) > 0 {
            let mut valid = 0
            match parse_int(raw) { Ok(v) => { if str_eq(workers[wi], "SIP_UDP_WORKERS") { if v >= 1 && v <= 8 { valid = 1 } } else { if v >= 0 && v <= 8 { valid = 1 } } } Err(_) => {} }
            if valid == 0 { builder_write(b, "ERROR: " + workers[wi] + "=" + raw + " must be 0-8, with UDP 1-8\n") }
        }
        wi = wi + 1
    }

    // Token lengths
    let tokens = ["SIP_ADMIN_TOKEN", "SIP_CARRIER_API_TOKEN", "SIP_CONTROL_API_TOKEN", "SIP_CONTROL_API_READ_TOKEN"]
    let mut ti = 0
    while ti < len(tokens) {
        let raw = env_get_or(tokens[ti], "")
        if len(raw) > 0 && len(raw) < 16 {
            builder_write(b, "ERROR: " + tokens[ti] + " is too short (minimum 16 characters)\n")
        }
        ti = ti + 1
    }

    // TLS cert paths
    let cert = env_get_or("SIP_TLS_CERT", "")
    let key = env_get_or("SIP_TLS_KEY", "")
    if len(cert) > 0 && len(key) == 0 {
        builder_write(b, "ERROR: SIP_TLS_CERT set but SIP_TLS_KEY is missing\n")
    }
    if len(key) > 0 && len(cert) == 0 {
        builder_write(b, "ERROR: SIP_TLS_KEY set but SIP_TLS_CERT is missing\n")
    }
    if len(cert) > 0 && path_file_size(cert) < 0 {
        builder_write(b, "ERROR: SIP_TLS_CERT file not found: " + cert + "\n")
    }
    if len(key) > 0 && path_file_size(key) < 0 {
        builder_write(b, "ERROR: SIP_TLS_KEY file not found: " + key + "\n")
    }

    // PROXY protocol
    if proxy_protocol_enabled() == 1 {
        let trusted = env_get_or("SIP_PROXY_TRUSTED_IPS", "")
        if len(trusted) == 0 {
            builder_write(b, "WARNING: SIP_PROXY_PROTOCOL=1 but SIP_PROXY_TRUSTED_IPS not set — only loopback trusted\n")
        }
    }

    // Bind IP
    let bind = str_trim_space(env_get_or("SIP_BIND_IP", ""))
    if len(bind) > 0 && sip_bind_ip_valid(bind) == 0 {
        builder_write(b, "ERROR: SIP_BIND_IP=" + bind + " is not a valid IPv4 address\n")
    }

    // Rate limits
    let inv_rate = env_get_or("SIP_INVITE_RATE_LIMIT", "")
    if len(inv_rate) > 0 {
        match parse_int(inv_rate) { Ok(_) => {} Err(_) => { builder_write(b, "ERROR: SIP_INVITE_RATE_LIMIT=" + inv_rate + " is not an integer\n") } }
    }

    // Realm
    let realm = env_get_or("SIP_REALM", "")
    if len(realm) == 0 {
        builder_write(b, "WARNING: SIP_REALM not set — using default 'mako.local'\n")
    }

    return builder_string(b)
}

fn proxy_cache_epoch(cache: CMap) -> string {
    if cmap_has(cache, "config_epoch") == 1 { return cmap_get(cache, "config_epoch") }
    cmap_set(cache, "config_epoch", "0")
    return "0"
}

fn proxy_config_reload(cache: CMap) -> int {
    let mut epoch = 0
    match parse_int(proxy_cache_epoch(cache)) { Ok(v) => { epoch = v } Err(_) => {} }
    epoch = epoch + 1
    cmap_set(cache, "config_epoch", string(epoch))
    let _ = cmap_del(cache, "rtpengine_cfg")
    let _ = cmap_del(cache, "shaken|v2")
    let _ = cmap_del(cache, "sec_enabled")
    // Security: flush cached bans, ACL, IP auth, whitelist, and config values
    // so changes take effect immediately instead of waiting for ring eviction.
    let _ = cmap_del(cache, "sec_auth_thresh")
    let _ = cmap_del(cache, "sec_ban_dur")
    let _ = cmap_del(cache, "fraud_pfx")
    let _ = cmap_del(cache, "rl_limit")
    // Flush all ban cache entries (ban|<ip>) by resetting the ring sequence.
    // The next lookup will re-query the database.
    cmap_set(cache, "ban_seq", "0")
    // Flush ACL cache entries
    cmap_set(cache, "acl_seq", "0")
    // Flush whitelist cache
    cmap_set(cache, "wl_seq", "0")
    // Flush IP auth cache
    cmap_set(cache, "ipauth_seq", "0")
    cmap_set(cache, "config_reloaded_at", string(now_ms()))
    metric_add(7, 1)
    let _ = log_info_if(cache, "ops", "config-reloaded epoch=" + string(epoch))
    return epoch
}

// Bulk-load DB config keys into the worker CMap so MAF config changes
// take effect without restart. Called every heartbeat (1s). Keys are
// cached with a _cfg| prefix to avoid collision with other cache entries.
// The worker code can read these via cached_env which checks CMap first.
fn proxy_config_sync_db(db: SqlDB, db_ok: int, cache: CMap) -> int {
    if db_ok == 0 { return 0 }
    let ts_key = "_cfg_sync_ts"
    let now = mono_ms()
    if cmap_has(cache, ts_key) == 1 {
        let mut last = 0
        match parse_int(cmap_get(cache, ts_key)) { Ok(v) => { last = v } Err(_) => {} }
        if now - last < 5000 { return 0 }
    }
    cmap_set(cache, ts_key, string(now))
    let tenant = env_get_or("SIP_MAF_TENANT", "default")
    let rows = sql_query_rows_str(db, "SELECT key || chr(1) || value FROM config WHERE tenant_id = $1 OR tenant_id = '' LIMIT 200", tenant)
    if sql_rows_ok(rows) == 0 { return 0 }
    let mut loaded = 0
    while sql_rows_next(rows) == 1 {
        let row = sql_rows_str(rows, 0)
        let sep = str_index(row, "\x01")
        if sep > 0 {
            let k = row[0:sep]
            let v = row[sep + 1:]
            // Map config key to the cache key that cached_env uses
            // Config keys use underscore naming; env vars use uppercase.
            // Store with the _cfg| prefix so cached_env can check it.
            cmap_set(cache, "_cfg|" + k, v)
        }
        loaded = loaded + 1
    }
    let _ = sql_rows_close(rows)
    return loaded
}

fn proxy_metric_message(msg: string, reply: string, elapsed: int, calls: CMap) -> int {
    metric_add(0, 1) // sip_messages_total
    if sip_is_response(msg) == 1 {
        metric_add(2, 1) // sip_responses_total
    } else {
        metric_add(1, 1) // sip_requests_total
    }
    if len(reply) > 0 {
        let code = sip_status_code(reply)
        if code >= 200 && code < 300 { metric_add(3, 1) }
        if code >= 400 && code < 500 { metric_add(4, 1) }
        if code >= 500 { metric_add(5, 1) }
    }
    hist_observe(0, elapsed)
    gauge_set(0, cmap_len(calls))
    return 0
}

// ============ LABELED METRICS (CMap-backed) ============
// Prometheus-style counters with method/transport/code labels stored in CMap.
// The fixed metric_add slots stay for backward compatibility; these add
// per-label breakdown for debugging production traffic patterns.

fn proxy_metric_labeled(msg: string, reply: string, tr: string, method: string, cache: CMap) -> int {
    // Per-method counter — method is already parsed by the caller
    if len(method) > 0 {
        // Build the CMap key directly to avoid intermediate label string
        let _ = cmap_incr(cache, "prom|sip_requests|method=\"" + method + "\",transport=\"" + tr + "\"", 1)
    }
    // Per-code counter
    if len(reply) > 0 {
        let code = sip_status_code(reply)
        if code > 0 {
            let _ = cmap_incr(cache, "prom|sip_responses|code=\"" + string(code) + "\",class=\"" + string(code / 100) + "xx\"", 1)
        }
    }
    return 0
}

// Connection gauge tracking per transport
fn proxy_conn_incr(cache: CMap, transport: string) -> int {
    let _ = cmap_incr(cache, "prom|sip_connections|transport=\"" + transport + "\"", 1)
    return 1
}

fn proxy_conn_decr(cache: CMap, transport: string) -> int {
    let key = "prom|sip_connections|transport=\"" + transport + "\""
    let mut val = 0
    if cmap_has(cache, key) == 1 {
        match parse_int(cmap_get(cache, key)) { Ok(v) => { val = v } Err(_) => {} }
    }
    if val > 0 { val = val - 1 }
    cmap_set(cache, key, string(val))
    return 1
}

// Render all labeled metrics as Prometheus text exposition format.
// Scans CMap for keys starting with "prom|".
fn proxy_metrics_labeled_export(cache: CMap) -> string {
    let mut b = str_builder()
    // Counters: sip_requests_total, sip_responses_total
    // Gauges: sip_connections
    let metrics = ["sip_requests", "sip_responses", "sip_connections"]
    let types = ["counter", "counter", "gauge"]
    let mut mi = 0
    while mi < len(metrics) {
        let name = metrics[mi]
        let metric_type = types[mi]
        let prefix = "prom|" + name + "|"
        // Scan the known label combinations from cache
        let mut found = 0
        let mut si = 0
        // Check transport labels
        let transports = ["UDP", "TCP", "TLS", "WS"]
        let mut ti = 0
        while ti < len(transports) {
            let key = prefix + "transport=\"" + transports[ti] + "\""
            if cmap_has(cache, key) == 1 {
                if found == 0 {
                    builder_write(b, "# TYPE madis_" + name + "_total " + metric_type + "\n")
                    found = 1
                }
                builder_write(b, "madis_" + name + "_total{" + "transport=\"" + transports[ti] + "\"} " + cmap_get(cache, key) + "\n")
            }
            ti = ti + 1
        }
        // Check method labels
        let methods = ["INVITE", "REGISTER", "BYE", "CANCEL", "OPTIONS", "ACK", "PRACK", "UPDATE", "REFER", "INFO", "MESSAGE", "NOTIFY"]
        let mut mti = 0
        while mti < len(methods) {
            let mut tti = 0
            while tti < len(transports) {
                let key = prefix + "method=\"" + methods[mti] + "\",transport=\"" + transports[tti] + "\""
                if cmap_has(cache, key) == 1 {
                    if found == 0 {
                        builder_write(b, "# TYPE madis_" + name + "_total " + metric_type + "\n")
                        found = 1
                    }
                    builder_write(b, "madis_" + name + "_total{method=\"" + methods[mti] + "\",transport=\"" + transports[tti] + "\"} " + cmap_get(cache, key) + "\n")
                }
                tti = tti + 1
            }
            mti = mti + 1
        }
        // Check code labels (2xx-6xx)
        let mut code = 200
        while code < 700 {
            let class = string(code / 100) + "xx"
            let key = prefix + "code=\"" + string(code) + "\",class=\"" + class + "\""
            if cmap_has(cache, key) == 1 {
                if found == 0 {
                    builder_write(b, "# TYPE madis_" + name + "_total " + metric_type + "\n")
                    found = 1
                }
                builder_write(b, "madis_" + name + "_total{code=\"" + string(code) + "\",class=\"" + class + "\"} " + cmap_get(cache, key) + "\n")
            }
            code = code + 1
        }
        mi = mi + 1
    }
    let mut maf_found = 0
    let maf_ops = ["calls.create", "calls.answer", "calls.reject", "calls.hangup", "calls.route", "calls.rtp", "calls.identity", "calls.bridge", "calls.media", "calls.transfer", "calls.hold", "calls.unhold", "calls.dtmf"]
    let maf_status = ["processing", "completed"]
    let mut moi = 0
    while moi < len(maf_ops) {
        let mut msi = 0
        while msi < len(maf_status) {
            let key = "prom|maf_commands|operation=\"" + maf_ops[moi] + "\",status=\"" + maf_status[msi] + "\""
            if cmap_has(cache, key) == 1 {
                if maf_found == 0 {
                    builder_write(b, "# TYPE madis_maf_commands_total counter\n")
                    maf_found = 1
                }
                builder_write(b, "madis_maf_commands_total{operation=\"" + maf_ops[moi] + "\",status=\"" + maf_status[msi] + "\"} " + cmap_get(cache, key) + "\n")
            }
            msi = msi + 1
        }
        moi = moi + 1
    }
    let maf_errors = ["transport_or_endpoint_rejected", "unsupported_operation", "bad_request", "worker_error", "state_conflict", "not_found"]
    let mut mei = 0
    while mei < len(maf_errors) {
        let mut meoi = 0
        while meoi < len(maf_ops) {
            let key = "prom|maf_commands|operation=\"" + maf_ops[meoi] + "\",status=\"failed\",error=\"" + maf_errors[mei] + "\""
            if cmap_has(cache, key) == 1 {
                if maf_found == 0 {
                    builder_write(b, "# TYPE madis_maf_commands_total counter\n")
                    maf_found = 1
                }
                builder_write(b, "madis_maf_commands_total{operation=\"" + maf_ops[meoi] + "\",status=\"failed\",error=\"" + maf_errors[mei] + "\"} " + cmap_get(cache, key) + "\n")
            }
            meoi = meoi + 1
        }
        mei = mei + 1
    }
    let mut inbound_found = 0
    let inbound_transports = ["UDP", "TCP", "TLS", "WSS"]
    let mut iti = 0
    while iti < len(inbound_transports) {
        let key = "prom|maf_inbound_calls|transport=\"" + inbound_transports[iti] + "\""
        if cmap_has(cache, key) == 1 {
            if inbound_found == 0 {
                builder_write(b, "# TYPE madis_maf_inbound_calls_total counter\n")
                inbound_found = 1
            }
            builder_write(b, "madis_maf_inbound_calls_total{transport=\"" + inbound_transports[iti] + "\"} " + cmap_get(cache, key) + "\n")
        }
        iti = iti + 1
    }
    let mut recovery_found = 0
    let recovery_actions = ["requeued", "failed"]
    let mut rai = 0
    while rai < len(recovery_actions) {
        let key = "prom|maf_command_recoveries|action=\"" + recovery_actions[rai] + "\""
        if cmap_has(cache, key) == 1 {
            if recovery_found == 0 {
                builder_write(b, "# TYPE madis_maf_command_recoveries_total counter\n")
                recovery_found = 1
            }
            builder_write(b, "madis_maf_command_recoveries_total{action=\"" + recovery_actions[rai] + "\"} " + cmap_get(cache, key) + "\n")
        }
        rai = rai + 1
    }
    let mut route_found = 0
    let route_transports = ["udp", "tcp", "tls", "ws", "wss"]
    let route_statuses = ["sent", "failed"]
    let mut rti = 0
    while rti < len(route_transports) {
        let mut rsi = 0
        while rsi < len(route_statuses) {
            let key = "prom|maf_route_attempts|transport=\"" + route_transports[rti] + "\",status=\"" + route_statuses[rsi] + "\""
            if cmap_has(cache, key) == 1 {
                if route_found == 0 {
                    builder_write(b, "# TYPE madis_maf_route_attempts_total counter\n")
                    route_found = 1
                }
                builder_write(b, "madis_maf_route_attempts_total{transport=\"" + route_transports[rti] + "\",status=\"" + route_statuses[rsi] + "\"} " + cmap_get(cache, key) + "\n")
            }
            rsi = rsi + 1
        }
        rti = rti + 1
    }
    let mut rtp_found = 0
    let rtp_actions = ["offer", "answer", "delete", "query"]
    let rtp_results = ["ok", "failed"]
    let mut rai2 = 0
    while rai2 < len(rtp_actions) {
        let mut rri = 0
        while rri < len(rtp_results) {
            let key = "prom|maf_rtp_actions|action=\"" + rtp_actions[rai2] + "\",result=\"" + rtp_results[rri] + "\""
            if cmap_has(cache, key) == 1 {
                if rtp_found == 0 {
                    builder_write(b, "# TYPE madis_maf_rtp_actions_total counter\n")
                    rtp_found = 1
                }
                builder_write(b, "madis_maf_rtp_actions_total{action=\"" + rtp_actions[rai2] + "\",result=\"" + rtp_results[rri] + "\"} " + cmap_get(cache, key) + "\n")
            }
            rri = rri + 1
        }
        rai2 = rai2 + 1
    }
    let stale_key = "prom|maf_stale_cleanups|reason=\"timer_expired\""
    if cmap_has(cache, stale_key) == 1 {
        builder_write(b, "# TYPE madis_maf_stale_cleanups_total counter\n")
        builder_write(b, "madis_maf_stale_cleanups_total{reason=\"timer_expired\"} " + cmap_get(cache, stale_key) + "\n")
    }
    return builder_string(b)
}

fn proxy_cache_ring_count(cache: CMap, ring_prefix: string, value_prefix: string, capacity: int) -> int {
    let mut count = 0
    let mut i = 0
    while i < capacity {
        if cmap_has3i(cache, ring_prefix, "", i) == 1 {
            let key = cmap_get3i(cache, ring_prefix, "", i)
            if len(value_prefix) == 0 {
                if len(key) > 0 && cmap_has(cache, key) == 1 { count = count + 1 }
            } else {
                if len(key) > 0 && cmap_has2(cache, value_prefix, key) == 1 { count = count + 1 }
            }
        }
        i = i + 1
    }
    return count
}

fn proxy_client_txn_method_count(cache: CMap, expected: string) -> int {
    let mut count = 0
    let mut i = 0
    while i < 16384 {
        if cmap_has3i(cache, "client_ring|", "", i) == 1 {
            let key = cmap_get3i(cache, "client_ring|", "", i)
            if len(key) > 0 && cmap_has2(cache, "client_req|", key) == 1 {
                let method = cmap_get2(cache, "client_method|", key)
                if str_eq(expected, "OTHER") {
                    if not str_eq(method, "INVITE") && not str_eq(method, "BYE") && not str_eq(method, "CANCEL") && not str_eq(method, "REGISTER") {
                        count = count + 1
                    }
                } else if str_eq(method, expected) {
                    count = count + 1
                }
            }
        }
        i = i + 1
    }
    return count
}

fn proxy_cache_family_state(cache: CMap) -> string {
    if not str_eq(env_get_or("SIP_STATE_CACHE_FAMILIES", "0"), "1") {
        return ""
    }
    let txn = proxy_cache_ring_count(cache, "txn_ring|", "txn|", 16384)
    let client = proxy_cache_ring_count(cache, "client_ring|", "client_req|", 16384)
    let server = proxy_cache_ring_count(cache, "server_ring|", "server_resp|", 16384)
    let dialog = proxy_cache_ring_count(cache, "dialog_ring|", "", 131072)
    let fork = proxy_cache_ring_count(cache, "fork_group_ring|", "fork_branches|", 16384)
    let wl = proxy_cache_ring_count(cache, "wl_ring|", "", 16384)
    let scanner = proxy_cache_ring_count(cache, "scanner_ring|", "", 16384)
    let ban = proxy_cache_ring_count(cache, "ban_ring|", "", 16384)
    let acl = proxy_cache_ring_count(cache, "acl_ring|", "", 16384)
    let ipauth = proxy_cache_ring_count(cache, "ipauth_ring|", "", 16384)
    return ",\"cache_families\":{\"txn\":" + string(txn)
        + ",\"client\":" + string(client)
        + ",\"client_invite\":" + string(proxy_client_txn_method_count(cache, "INVITE"))
        + ",\"client_bye\":" + string(proxy_client_txn_method_count(cache, "BYE"))
        + ",\"client_cancel\":" + string(proxy_client_txn_method_count(cache, "CANCEL"))
        + ",\"client_register\":" + string(proxy_client_txn_method_count(cache, "REGISTER"))
        + ",\"client_other\":" + string(proxy_client_txn_method_count(cache, "OTHER"))
        + ",\"server\":" + string(server)
        + ",\"dialog\":" + string(dialog)
        + ",\"fork\":" + string(fork)
        + ",\"whitelist\":" + string(wl)
        + ",\"scanner\":" + string(scanner)
        + ",\"ban\":" + string(ban)
        + ",\"acl\":" + string(acl)
        + ",\"ipauth\":" + string(ipauth)
        + "}"
}

fn proxy_admin_secret_equal(actual: string, expected: string) int {
    if len(actual) == 0 || len(actual) != len(expected) { return 0 }
    let mut diff = 0
    let mut i = 0
    while i < len(actual) {
        diff = diff | (int(actual[i]) ^ int(expected[i]))
        i = i + 1
    }
    return if diff == 0 { 1 } else { 0 }
}

fn proxy_admin_authorized(c: int) -> int {
    let expected = env_get_or("SIP_ADMIN_TOKEN", "")
    if len(expected) < 16 || len(expected) > 512 { return 0 }
    let header = http_header(c, "Authorization")
    if proxy_admin_secret_equal(header, "Bearer " + expected) == 1 { return 1 }
    return 0
}

fn proxy_json_escape(s: string) -> string {
    let mut b = str_builder()
    let mut i = 0
    while i < len(s) {
        let c = int(s[i])
        if c == 34 { builder_write(b, "\\\"") }
        else if c == 92 { builder_write(b, "\\\\") }
        else if c == 10 { builder_write(b, "\\n") }
        else if c == 13 { builder_write(b, "\\r") }
        else if c == 9 { builder_write(b, "\\t") }
        else if c < 32 || c == 127 { builder_write_byte(b, byte(32)) }
        else { builder_write_byte(b, byte(c)) }
        i = i + 1
    }
    return builder_string(b)
}

fn proxy_identifier_ok(value: string, min: int, max: int) -> int {
    if len(value) < min || len(value) > max { return 0 }
    let mut i = 0
    while i < len(value) {
        let c = int(value[i])
        let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 58 || c == 64 || c == 95
        if not ok { return 0 }
        i = i + 1
    }
    return 1
}

fn proxy_maf_scope(c: int) -> int {
    let header = http_header(c, "Authorization")
    let low = str_to_lower(header)
    if not str_has_prefix(low, "bearer ") { return 0 }
    let actual = str_trim_space(header[7:])
    if len(actual) < 16 || len(actual) > 512 { return 0 }
    let write_token = env_get_or("SIP_MAF_API_TOKEN", env_get_or("MADIS_MAF_WRITE_TOKEN", ""))
    if len(write_token) >= 16 && proxy_admin_secret_equal(actual, write_token) == 1 { return 2 }
    let read_token = env_get_or("SIP_MAF_API_READ_TOKEN", env_get_or("MADIS_MAF_READ_TOKEN", ""))
    if len(read_token) >= 16 && proxy_admin_secret_equal(actual, read_token) == 1 { return 1 }
    return 0
}

fn proxy_maf_tenant() -> string {
    let tenant = str_trim_space(env_get_or("SIP_MAF_TENANT", "default"))
    if proxy_identifier_ok(tenant, 1, 128) == 0 { return "default" }
    return tenant
}

fn proxy_tbl_query_param(db: SqlDB, ok: int, sql: string, param: string, max: int) -> []string {
    let mut rows = make([]string, 0, max)
    if ok == 0 { return rows }
    let mut lim = max
    if lim < 1 { lim = 1 }
    if lim > 100 { lim = 100 }
    let rh = sql_query_rows_str(db, sql + " LIMIT " + string(lim), param)
    if sql_rows_ok(rh) == 1 {
        while sql_rows_next(rh) == 1 {
            let v = sql_rows_str(rh, 0)
            if len(v) == 0 { break }
            rows = append(rows, v)
            if len(rows) >= lim { break }
        }
    }
    let _ = sql_rows_close(rh)
    return rows
}

fn proxy_maf_events(db: SqlDB, ok: int) -> string {
    let tenant = proxy_maf_tenant()
    let rows = proxy_tbl_query_param(db, ok, "SELECT json_build_object('schema','madis.maf.event.v1','event_id',event_id,'event_type',event_type,'event_version',event_version,'tenant_id',tenant_id,'call_id',call_id,'channel_id',channel_id,'sequence',sequence,'occurred_at',occurred_at,'trace_id',trace_id,'payload',payload_json)::text FROM maf_events WHERE tenant_id = $1 ORDER BY sequence DESC", tenant, 100)
    let mut out = "{\"schema\":\"madis.maf.event-page.v1\",\"events\":["
    let mut i = 0
    while i < len(rows) {
        if i > 0 { out = out + "," }
        out = out + rows[i]
        i = i + 1
    }
    return out + "]}\n"
}

fn proxy_maf_active_calls(db: SqlDB, ok: int) -> string {
    let tenant = proxy_maf_tenant()
    let rows = proxy_tbl_query_param(db, ok, "SELECT json_build_object('call_id',call_id,'tenant_id',tenant_id,'state',state,'version',version,'from_uri',from_uri,'to_uri',to_uri,'created_at',created_at,'updated_at',updated_at)::text FROM maf_calls WHERE tenant_id = $1 AND state NOT IN ('ended','failed') ORDER BY created_at DESC", tenant, 100)
    let mut out = "{\"schema\":\"madis.maf.active-calls.v1\",\"calls\":["
    let mut i = 0
    while i < len(rows) {
        if i > 0 { out = out + "," }
        out = out + rows[i]
        i = i + 1
    }
    return out + "]}\n"
}

fn proxy_maf_call(db: SqlDB, ok: int, call_id: string) -> string {
    if proxy_identifier_ok(call_id, 8, 128) == 0 { return "" }
    return sql_query_str2(db, "SELECT json_build_object('schema','madis.maf.call.v1','call_id',call_id,'tenant_id',tenant_id,'state',state,'version',version,'from_uri',from_uri,'to_uri',to_uri,'created_at',created_at,'updated_at',updated_at)::text FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", proxy_maf_tenant(), call_id)
}

fn proxy_maf_call_id(path: string, suffix: string) -> string {
    let prefix = "/admin/api/v1/maf/calls/"
    if not str_has_prefix(path, prefix) { return "" }
    let rest = path[len(prefix):]
    if len(suffix) == 0 {
        if str_index(rest, "/") >= 0 { return "" }
        return rest
    }
    let tail = "/" + suffix
    if not str_has_suffix(rest, tail) { return "" }
    return rest[0:len(rest) - len(tail)]
}

fn proxy_maf_operation(method: string, path: string) -> string {
    if not str_eq(method, "POST") { return "" }
    if len(proxy_maf_call_id(path, "answer")) > 0 { return "calls.answer" }
    if len(proxy_maf_call_id(path, "reject")) > 0 { return "calls.reject" }
    if len(proxy_maf_call_id(path, "hangup")) > 0 { return "calls.hangup" }
    if len(proxy_maf_call_id(path, "route")) > 0 { return "calls.route" }
    return ""
}

fn proxy_maf_command(db: SqlDB, ok: int, path: string, operation: string, body: string, idempotency: string) -> string {
    if ok == 0 { return "{\"ok\":false,\"error\":\"database unavailable\"}\n" }
    let mut req_body = body
    if len(req_body) == 0 { req_body = "{}" }
    if len(req_body) > 65536 { return "{\"ok\":false,\"error\":\"request too large\"}\n" }
    let mut idem = idempotency
    if len(idem) == 0 { idem = "cmd-" + sha256(operation + "|" + path + "|" + req_body + "|" + string(now_ms()))[0:32] }
    if proxy_identifier_ok(idem, 8, 128) == 0 { return "{\"ok\":false,\"error\":\"invalid Idempotency-Key\"}\n" }
    let call_id = if str_eq(operation, "calls.answer") { proxy_maf_call_id(path, "answer") } else if str_eq(operation, "calls.reject") { proxy_maf_call_id(path, "reject") } else if str_eq(operation, "calls.hangup") { proxy_maf_call_id(path, "hangup") } else { proxy_maf_call_id(path, "route") }
    if proxy_identifier_ok(call_id, 8, 128) == 0 { return "{\"ok\":false,\"error\":\"invalid call_id\"}\n" }
    let tenant = proxy_maf_tenant()
    let exists = sql_query_str2(db, "SELECT call_id FROM maf_calls WHERE tenant_id = $1 AND call_id = $2", tenant, call_id)
    if len(exists) == 0 { return "{\"ok\":false,\"error\":\"call not found\"}\n" }
    let command_id = idem
    let trace = sha256("madis.maf.trace|" + tenant + "|" + command_id + "|" + string(now_ms()))[0:32]
    let packed = "{\"command_id\":\"" + proxy_json_escape(command_id) + "\",\"idempotency_key\":\"" + proxy_json_escape(idem) + "\",\"tenant_id\":\"" + proxy_json_escape(tenant) + "\",\"call_id\":\"" + proxy_json_escape(call_id) + "\",\"operation\":\"" + proxy_json_escape(operation) + "\",\"resource_id\":\"" + proxy_json_escape(call_id) + "\",\"trace_id\":\"" + proxy_json_escape(trace) + "\",\"request_hash\":\"" + sha256(req_body) + "\",\"request\":" + req_body + "}"
    let rc = sql_exec_str4(db, "INSERT INTO maf_commands (command_id, idempotency_key, tenant_id, call_id, operation, request_json, request_hash, status, resource_id, trace_id) SELECT $1::jsonb->>'command_id', $1::jsonb->>'idempotency_key', $1::jsonb->>'tenant_id', $1::jsonb->>'call_id', $1::jsonb->>'operation', $1::jsonb->'request', $1::jsonb->>'request_hash', 'accepted', $1::jsonb->>'resource_id', $1::jsonb->>'trace_id' ON CONFLICT (command_id) DO NOTHING", packed, "", "", "")
    if rc < 0 { return "{\"ok\":false,\"error\":\"command rejected\"}\n" }
    return "{\"schema\":\"madis.maf.command-receipt.v1\",\"command_id\":\"" + proxy_json_escape(command_id) + "\",\"status\":\"accepted\",\"resource_id\":\"" + proxy_json_escape(call_id) + "\",\"trace_id\":\"" + proxy_json_escape(trace) + "\"}\n"
}

fn proxy_admin_worker(reg: CMap, calls: CMap, cache: CMap) -> int {
    let db_url = env_get_or("SIP_DB_URL", "")
    let mut db_ok = 0
    let mut db = sql_open_postgres("")
    if len(db_url) > 0 {
        db = sql_open_postgres(db_url)
        db_ok = 1
    }
    // Default matches the documented installer layout (9090); 8080 is the
    // standalone WebUI port and must stay free on shared hosts.
    let raw_port = env_get_or("SIP_ADMIN_PORT", "9090")
    let mut port = 9090
    match parse_int(raw_port) { Ok(v) => { port = v } Err(_) => {} }
    if port <= 0 { return 0 }
    let fd = http_bind(port)
    if fd < 0 {
        slog("  Admin:   bind failed on :" + string(port))
        return 1
    }
    // http_accept uses the raw accept(2) primitive. Keep the listener
    // nonblocking so SIGTERM cannot strand this worker in accept.
    let _ = io_set_nonblocking(fd, 1)
    let _ = register_listener(fd)
    cmap_set(cache, "_prom_active", "1")
    slog("  Admin:   http://127.0.0.1:" + string(port) + " (/healthz, /readyz, /metrics)")
    while shutdown_requested() == 0 {
        if io_read_ready(fd, 100) <= 0 { continue }
        let c = http_accept(fd)
        if c < 0 {
            if should_stop_accepting() == 1 { break }
            continue
        }
        let path = http_path(c)
        let method = http_method(c)
        let maf_operation = proxy_maf_operation(method, path)
        if str_eq(method, "GET") && str_eq(path, "/admin/api/v1/maf/events") {
            if proxy_maf_scope(c) < 1 {
                let _ = http_respond_json(c, 401, "{\"ok\":false,\"error\":\"MAF bearer token required\"}\n")
            } else {
                let _ = http_respond_json(c, 200, proxy_maf_events(db, db_ok))
            }
        } else if str_eq(method, "GET") && str_eq(path, "/admin/api/v1/maf/calls/active") {
            if proxy_maf_scope(c) < 1 {
                let _ = http_respond_json(c, 401, "{\"ok\":false,\"error\":\"MAF bearer token required\"}\n")
            } else {
                let _ = http_respond_json(c, 200, proxy_maf_active_calls(db, db_ok))
            }
        } else if str_eq(method, "GET") && len(proxy_maf_call_id(path, "")) > 0 {
            if proxy_maf_scope(c) < 1 {
                let _ = http_respond_json(c, 401, "{\"ok\":false,\"error\":\"MAF bearer token required\"}\n")
            } else {
                let resource = proxy_maf_call(db, db_ok, proxy_maf_call_id(path, ""))
                if len(resource) == 0 { let _ = http_respond_json(c, 404, "{\"ok\":false,\"error\":\"call not found\"}\n") }
                else { let _ = http_respond_json(c, 200, resource + "\n") }
            }
        } else if len(maf_operation) > 0 {
            if proxy_maf_scope(c) < 2 {
                let _ = http_respond_json(c, 401, "{\"ok\":false,\"error\":\"MAF write token required\"}\n")
            } else {
                let receipt = proxy_maf_command(db, db_ok, path, maf_operation, http_body(c), http_header(c, "Idempotency-Key"))
                let status = if str_contains(receipt, "\"error\"") { 400 } else { 202 }
                let _ = http_respond_json(c, status, receipt)
            }
        } else if proxy_admin_authorized(c) == 0 {
            let _ = http_respond_json(c, 401, "{\"ok\":false,\"error\":\"unauthorized\"}\n")
        } else if str_eq(path, "/healthz") {
            let version = env_get_or("MADIS_VERSION", "dev")
            let body = "{\"ok\":true,\"version\":\"" + version + "\",\"calls\":" + string(cmap_len(calls)) + "}\n"
            let _ = http_respond_json(c, 200, body)
        } else if str_eq(path, "/readyz") {
            let ready = cmap_get(cache, "ready")
            if str_eq(ready, "1") {
                let _ = http_respond_json(c, 200, "{\"ready\":true}\n")
            } else {
                let _ = http_respond_json(c, 503, "{\"ready\":false}\n")
            }
        } else if str_eq(path, "/metrics") {
            let _ = http_respond_ct(c, 200, "text/plain; version=0.0.4", metrics_export_prom() + proxy_metrics_labeled_export(cache))
        } else if str_eq(path, "/ims/ipsec/sa") {
            if not str_eq(http_method(c), "POST") {
                let _ = http_respond_json(c, 405, "{\"ok\":false,\"error\":\"POST required\"}\n")
            } else {
                let private_identity = json_get_string(http_body(c), "private_identity")
                if ims_aka_identity_ok(private_identity, 1024) == 0 {
                    let _ = http_respond_json(c, 400, "{\"ok\":false,\"error\":\"invalid private_identity\"}\n")
                } else {
                    let sa = ims_ipsec_get_sa(cache, private_identity)
                    if len(sa) == 0 {
                        let _ = http_respond_json(c, 404, "{\"ok\":false,\"error\":\"SA not found\"}\n")
                    } else {
                        let _ = http_respond_json(c, 200, sa + "\n")
                    }
                }
            }
        } else if str_eq(path, "/reload") {
            if str_eq(http_method(c), "POST") {
                let epoch = proxy_config_reload(cache)
                let _ = http_respond_json(c, 200, "{\"reloaded\":true,\"epoch\":" + string(epoch) + "}\n")
            } else {
                let _ = http_respond_json(c, 405, "{\"ok\":false,\"error\":\"POST required\"}\n")
            }
        } else if str_eq(path, "/check-config") {
            let errors = proxy_validate_config()
            if len(errors) == 0 {
                let _ = http_respond_json(c, 200, "{\"valid\":true}\n")
            } else {
                let _ = http_respond_ct(c, 200, "text/plain", errors)
            }
        } else if str_eq(path, "/state") {
            let body = "{\"registrations\":" + string(cmap_len(reg)) + ",\"calls\":" + string(cmap_len(calls)) + ",\"cache\":" + string(cmap_len(cache)) + proxy_cache_family_state(cache) + "}\n"
            let _ = http_respond_json(c, 200, body)
        } else {
            let _ = http_respond_json(c, 404, "{\"ok\":false,\"error\":\"not found\"}\n")
        }
        let _ = http_close(c)
    }
    let _ = http_close_listener(fd)
    return 0
}
